      <Positioned left="1078" top="524" width="464">
        <Column crossAxisAlignment="START" mainAxisSize="MIN">
          <Text color="#F2F6FC" fontSize="22" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">⑤ 加权算法 vs 错误算法</Text>
          <Container height="6"/>
          <Text color="#34D399" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">正确  2600÷10000 = 26.00%（前期）</Text>
          <Container height="6"/>
          <Text color="#34D399" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">正确  1660÷10000 = 16.60%（后期）</Text>
          <Container height="6"/>
          <Text color="#FB7185" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">错误  等权平均 20.00% → 23.50%，误判 +3.50 pp</Text>
          <Container height="6"/>
          <Text color="#FB7185" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">错误  成交数 200→960 是规模；分母差 4 倍不能等权</Text>
        </Column>
      </Positioned>
      <Positioned left="36" top="704">
        <Container width="940" height="240" color="#0F2140" borderRadius="16" border="1 SOLID #2E5080"/>
      </Positioned>
      <Positioned left="37" top="705">
        <Container width="938" height="4" color="#38BDF8" borderRadius="2"/>
