  "component_rules": {
    "card": "白底 surface + 1px line 描边 + 极淡阴影；左侧 4×22 accent 短条 + 等宽两位序号 + 卡标题；detail 独占下方并按盒宽自动折行。四种画布共用同一构件，只改尺寸与排布。",
    "hero": "accent 竖条 + 等宽 kicker + 主标题 + 副标题 + 三项时间地点元信息；窄屏把元信息竖排，宽屏排成胶囊，字段内容一字不改。",
    "cta_band": "深绿底 band，白字 CTA；宽屏在同一 band 右侧内联官网地址，窄屏把官网单独放 band 下方。CTA 原文含“扫码方式详见官网”，按题意为纯文字，不生成二维码。",
    "shared": "同一色板、同一圆角与描边语言、同一层级（kicker→title→subtitle→meta→cards→cta），装饰构件一致只重排，不新增内容。"
  },
  "layout_per_breakpoint": {
    "mobile": "单列：hero 竖排元信息 → 6 张卡竖排 → CTA band → 官网",
    "tablet": "顶部 hero（元信息横排胶囊）→ 2 列 × 3 行卡 → CTA band 内联官网",
    "desktop": "左侧 400px 信息栏（hero 竖排元信息 + CTA 区）→ 右侧 3 列 × 2 行卡 → 卡区下方 CTA band 内联官网",
    "stage": "顶部大 hero（主标题 64px）+ 右侧 CTA band 与官网 → 下方 3 列 × 2 行大卡"
  },
