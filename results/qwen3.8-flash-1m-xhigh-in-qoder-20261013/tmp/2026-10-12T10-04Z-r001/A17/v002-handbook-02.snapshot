    <Positioned left="65" top="1242.8" width="1087">
      <Text fontSize="28" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">三、常见误解与动手核对</Text>
    </Positioned>
    <Positioned left="48" top="1280.8" width="532">
      <Text fontSize="24" color="#7A4FD3" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">容易踩的坑</Text>
    </Positioned>
    <Positioned left="620" top="1280.8" width="532">
      <Text fontSize="24" color="#1F8A5F" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">动手核对</Text>
    </Positioned>
    <Positioned left="50" top="1323.8">
      <Container width="10" height="10" color="#7A4FD3" borderRadius="5"/>
    </Positioned>
    <Positioned left="72" top="1314.8" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">在 Snapshot 上写宽度后画面塌了：真正缺的是根容器尺寸，不是根标签属性。</Text>
    </Positioned>
    <Positioned left="50" top="1396.28">
      <Container width="10" height="10" color="#7A4FD3" borderRadius="5"/>
    </Positioned>
    <Positioned left="72" top="1387.28" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">把 Expanded 塞进 Container：它不是 Flex 的直接子节点，布局会报错或被忽略。</Text>
    </Positioned>
    <Positioned left="623" top="1323.8">
      <Container width="13" height="13" borderRadius="2" border="2 SOLID #1F8A5F"/>
    </Positioned>
    <Positioned left="646" top="1314.8" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">删掉根容器的宽高，观察报错或空白</Text>
    </Positioned>
    <Positioned left="623" top="1361.24">
      <Container width="13" height="13" borderRadius="2" border="2 SOLID #1F8A5F"/>
    </Positioned>
    <Positioned left="646" top="1352.24" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">把一个 flex 从 1 改成 3，确认比例随之变化</Text>
    </Positioned>
    <Positioned left="623" top="1398.68">
      <Container width="13" height="13" borderRadius="2" border="2 SOLID #1F8A5F"/>
    </Positioned>
    <Positioned left="646" top="1389.68" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">在 Row 里插入 Spacer，看两段文字是否被推到两端</Text>
    </Positioned>
    <Positioned left="48" top="1511.5">
      <Container width="1104" height="1" color="#DCE2EC"/>
    </Positioned>
