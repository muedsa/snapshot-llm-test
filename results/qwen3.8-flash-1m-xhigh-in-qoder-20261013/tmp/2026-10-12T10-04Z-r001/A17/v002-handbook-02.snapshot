<Snapshot background="#F6F7FA" type="png">
  <Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE">
    <Container width="1200" height="1600" color="#F6F7FA"/>
    <Positioned left="48" top="48">
      <Container width="1104" height="128" color="#FFFFFF" borderRadius="16" border="1 SOLID #DCE2EC"/>
    </Positioned>
    <Positioned left="72" top="64" width="1056">
      <Text fontSize="20" color="#78879C" fontFamily="Noto Sans Mono CJK SC" textAlign="LEFT" softWrap="true">Snapshot 入门手册 · 第 2 页 / 共 4 页</Text>
    </Positioned>
    <Positioned left="72" top="90" width="1056">
      <Text fontSize="40" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">尺寸来自布局，不是属性</Text>
    </Positioned>
    <Positioned left="72" top="138.4" width="1056">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">本页目标：搞清画布尺寸从哪来，以及一行里的宽度按什么规则分</Text>
    </Positioned>
    <Positioned left="48" top="214">
      <Container width="5" height="26" color="#1F8A5F" borderRadius="2"/>
    </Positioned>
    <Positioned left="65" top="210" width="1087">
      <Text fontSize="28" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">一、示例的实际渲染结果与本页要点</Text>
    </Positioned>
    <Positioned left="48" top="250">
      <Container width="432" height="413.8" color="#FFFFFF" borderRadius="14" border="1 SOLID #DCE2EC"/>
    </Positioned>
    <Positioned left="64" top="262" width="400">
      <Text fontSize="20" color="#78879C" fontFamily="Noto Sans Mono CJK SC" textAlign="LEFT" softWrap="true">example-02.png · 400×240 · 1:1</Text>
    </Positioned>
    <Positioned left="64" top="291">
      <Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE">
        <Container width="400" height="240"/>
        <Positioned left="24" top="24">
          <Text fontSize="18" color="#16233A" fontFamily="Noto Sans Mono CJK SC">Snapshot 上没有 width/height</Text>
        </Positioned>
        <Positioned left="24" top="52">
          <Text fontSize="16" color="#78879C" fontFamily="Noto Sans CJK SC">尺寸来自下面的 400×240 容器</Text>
        </Positioned>
        <Positioned left="24" top="96" width="352">
          <Row mainAxisSize="MAX" crossAxisAlignment="STRETCH">
            <Expanded flex="1">
              <Container color="#2B5BD7" borderRadius="8"/>
            </Expanded>
            <Container width="12"/>
            <Expanded flex="2">
              <Container color="#E0913B" borderRadius="8"/>
            </Expanded>
            <Container width="12"/>
            <Expanded flex="1">
              <Container color="#1F8A5F" borderRadius="8"/>
            </Expanded>
          </Row>
        </Positioned>
        <Positioned left="24" top="158">
          <Container width="352" height="48" color="#7A4FD3" borderRadius="8"/>
        </Positioned>
        <Positioned left="24" top="174" width="352">
          <Row mainAxisSize="MAX" crossAxisAlignment="CENTER">
            <Container width="14"/>
            <Text fontSize="16" color="#FFFFFF" fontFamily="Noto Sans CJK SC">Expanded 占剩余宽度</Text>
            <Spacer/>
            <Text fontSize="16" color="#FFFFFF" fontFamily="Noto Sans Mono CJK SC">352 里的 1/4</Text>
            <Container width="14"/>
          </Row>
        </Positioned>
        <Positioned left="24" top="214">
          <Text fontSize="16" color="#42536E" fontFamily="Noto Sans Mono CJK SC">flex 1 : 2 : 1</Text>
        </Positioned>
      </Stack>
    </Positioned>
    <Positioned left="64" top="543" width="400">
      <Text fontSize="20" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">看图：三条色块是同一条 Row 里的 flex 1:2:1，隔两个 12px 容器。</Text>
    </Positioned>
    <Positioned left="64" top="601.4" width="400">
      <Text fontSize="20" color="#78879C" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">插图由本页 DSL 构件直接画成，未嵌入预渲染整图。</Text>
    </Positioned>
    <Positioned left="510" top="254">
      <Container width="4" height="24" color="#2B5BD7" borderRadius="2"/>
    </Positioned>
    <Positioned left="526" top="250" width="626">
      <Text fontSize="26" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">Snapshot 标签上没有 width / height</Text>
    </Positioned>
    <Positioned left="526" top="281.56" width="626">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">根标签只接受 background / debug / type，写别的会被静默忽略</Text>
    </Positioned>
    <Positioned left="510" top="364.04">
      <Container width="4" height="24" color="#2B5BD7" borderRadius="2"/>
    </Positioned>
    <Positioned left="526" top="360.04" width="626">
      <Text fontSize="26" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">画布尺寸来自最外层有界容器</Text>
    </Positioned>
    <Positioned left="526" top="391.6" width="626">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">给它 400×240，输出图片就是这个大小</Text>
    </Positioned>
    <Positioned left="510" top="439.04">
      <Container width="4" height="24" color="#2B5BD7" borderRadius="2"/>
    </Positioned>
    <Positioned left="526" top="435.04" width="626">
      <Text fontSize="26" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">Expanded / Spacer 必须是 Flex 的直接子节点</Text>
    </Positioned>
    <Positioned left="526" top="466.6" width="626">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">隔一层就失效；flex 数字决定剩余宽度的分配比例</Text>
    </Positioned>
    <Positioned left="48" top="681.8">
      <Container width="5" height="26" color="#C97A22" borderRadius="2"/>
    </Positioned>
    <Positioned left="65" top="677.8" width="1087">
