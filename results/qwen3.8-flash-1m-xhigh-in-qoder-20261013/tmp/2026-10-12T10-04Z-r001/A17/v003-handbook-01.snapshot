    <Positioned left="65" top="1188.8" width="1087">
      <Text fontSize="28" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">三、常见误解与动手核对</Text>
    </Positioned>
    <Positioned left="48" top="1226.8" width="532">
      <Text fontSize="24" color="#7A4FD3" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">容易踩的坑</Text>
    </Positioned>
    <Positioned left="620" top="1226.8" width="532">
      <Text fontSize="24" color="#1F8A5F" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">动手核对</Text>
    </Positioned>
    <Positioned left="50" top="1269.8">
      <Container width="10" height="10" color="#7A4FD3" borderRadius="5"/>
    </Positioned>
    <Positioned left="72" top="1260.8" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">把 DSL 当 HTML 写：它不是网页，浏览器标签与 CSS 选择器在这里没有意义。</Text>
    </Positioned>
    <Positioned left="50" top="1342.28">
      <Container width="10" height="10" color="#7A4FD3" borderRadius="5"/>
    </Positioned>
    <Positioned left="72" top="1333.28" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">以为成功响应也带 JSON 外壳：200 时拿到的是图片字节，解析必然报错。</Text>
    </Positioned>
    <Positioned left="623" top="1269.8">
      <Container width="13" height="13" borderRadius="2" border="2 SOLID #1F8A5F"/>
    </Positioned>
    <Positioned left="646" top="1260.8" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">用 text/plain 发一次，确认落盘文件能被图片查看器打开</Text>
    </Positioned>
    <Positioned left="623" top="1342.28">
      <Container width="13" height="13" borderRadius="2" border="2 SOLID #1F8A5F"/>
    </Positioned>
    <Positioned left="646" top="1333.28" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">故意写错一个标签名，记下返回的 code 与 requestId</Text>
    </Positioned>
    <Positioned left="623" top="1414.76">
      <Container width="13" height="13" borderRadius="2" border="2 SOLID #1F8A5F"/>
    </Positioned>
    <Positioned left="646" top="1405.76" width="506">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">把请求体原样存成 .snapshot，再次请求应得到同一张图</Text>
    </Positioned>
    <Positioned left="48" top="1511.5">
      <Container width="1104" height="1" color="#DCE2EC"/>
    </Positioned>
    <Positioned left="48" top="1522" width="760">
      <Text fontSize="20" color="#78879C" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">第 1 页 · 真实调用契约：文本进、图片出</Text>
    </Positioned>
