    <Positioned left="72" top="90" width="1056">
      <Text fontSize="40" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">真实调用契约：文本进、图片出</Text>
    </Positioned>
    <Positioned left="72" top="138.4" width="1056">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">本页目标：看懂一次真实调用：发出去的是什么，拿回来的是什么，出错了看什么</Text>
    </Positioned>
    <Positioned left="48" top="214">
      <Container width="5" height="26" color="#1F8A5F" borderRadius="2"/>
    </Positioned>
    <Positioned left="65" top="210" width="1087">
      <Text fontSize="28" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">一、示例的实际渲染结果与本页要点</Text>
    </Positioned>
    <Positioned left="48" top="250">
      <Container width="432" height="413.8" color="#FFFFFF" borderRadius="14" border="1 SOLID #DCE2EC"/>
    </Positioned>
    <Positioned left="64" top="262" width="400">
      <Text fontSize="20" color="#78879C" fontFamily="Noto Sans Mono CJK SC" textAlign="LEFT" softWrap="true">example-01.png · 400×240 · 1:1</Text>
    </Positioned>
    <Positioned left="64" top="291">
      <Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE">
        <Container width="400" height="240"/>
        <Positioned left="24" top="28">
          <Container width="158" height="78" color="#F2F5FA" borderRadius="10" border="1 SOLID #D3DBE8"/>
        </Positioned>
        <Positioned left="218" top="28">
          <Container width="158" height="78" color="#F2F5FA" borderRadius="10" border="1 SOLID #D3DBE8"/>
        </Positioned>
        <Positioned left="188" top="63">
          <Container width="24" height="8" color="#2B5BD7" borderRadius="4"/>
        </Positioned>
        <Positioned left="38" top="42">
          <Text fontSize="18" color="#16233A" fontFamily="Noto Sans Mono CJK SC">POST /snapshot</Text>
        </Positioned>
        <Positioned left="38" top="70">
          <Text fontSize="16" color="#78879C" fontFamily="Noto Sans Mono CJK SC">text/plain</Text>
        </Positioned>
        <Positioned left="232" top="42">
          <Text fontSize="18" color="#1F8A5F" fontFamily="Noto Sans Mono CJK SC">200 image/png</Text>
        </Positioned>
        <Positioned left="232" top="70">
          <Text fontSize="16" color="#42536E" fontFamily="Noto Sans CJK SC">响应体就是图片字节</Text>
        </Positioned>
        <Positioned left="24" top="132">
          <Text fontSize="16" color="#B3261E" fontFamily="Noto Sans CJK SC">出错才有</Text>
        </Positioned>
        <Positioned left="94" top="132">
          <Text fontSize="16" color="#B3261E" fontFamily="Noto Sans Mono CJK SC">{code, message, requestId}</Text>
        </Positioned>
        <Positioned left="24" top="162">
          <Container width="352" height="1" color="#D3DBE8"/>
        </Positioned>
        <Positioned left="24" top="176">
          <Text fontSize="18" color="#16233A" fontFamily="Noto Sans CJK SC">同一份文本：请求体 = .snapshot</Text>
        </Positioned>
        <Positioned left="24" top="206">
          <Text fontSize="16" color="#78879C" fontFamily="Noto Sans CJK SC">左边发出去，右边拿回来</Text>
        </Positioned>
      </Stack>
    </Positioned>
    <Positioned left="64" top="543" width="400">
      <Text fontSize="20" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">看图：左框是发出去的，右框是拿回来的，中间蓝杠就是这一次调用。</Text>
    </Positioned>
    <Positioned left="64" top="601.4" width="400">
      <Text fontSize="20" color="#78879C" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">插图由本页 DSL 构件直接画成，未嵌入预渲染整图。</Text>
    </Positioned>
    <Positioned left="510" top="254">
      <Container width="4" height="24" color="#2B5BD7" borderRadius="2"/>
    </Positioned>
    <Positioned left="526" top="250" width="626">
      <Text fontSize="26" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">请求体是 UTF-8 纯文本，不是 JSON</Text>
    </Positioned>
    <Positioned left="526" top="281.56" width="626">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">Content-Type: text/plain; charset=utf-8，把 DSL 原文当字节流发出去</Text>
    </Positioned>
    <Positioned left="510" top="364.04">
      <Container width="4" height="24" color="#2B5BD7" borderRadius="2"/>
    </Positioned>
    <Positioned left="526" top="360.04" width="626">
      <Text fontSize="26" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">200 的响应体直接是图片字节</Text>
    </Positioned>
    <Positioned left="526" top="391.6" width="626">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">Content-Type 为 image/png，不要按 JSON 去 parse 它</Text>
    </Positioned>
    <Positioned left="510" top="439.04">
      <Container width="4" height="24" color="#2B5BD7" borderRadius="2"/>
    </Positioned>
    <Positioned left="526" top="435.04" width="626">
      <Text fontSize="26" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">只有失败才返回 JSON</Text>
    </Positioned>
    <Positioned left="526" top="466.6" width="626">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">{code, message, requestId}，requestId 用来向服务方定位那一次请求</Text>
    </Positioned>
