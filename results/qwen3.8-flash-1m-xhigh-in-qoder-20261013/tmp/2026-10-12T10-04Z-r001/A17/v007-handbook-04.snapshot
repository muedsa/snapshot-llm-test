    <Positioned left="72" top="90" width="1056">
      <Text fontSize="40" color="#16233A" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true" fontStyle="BOLD">背景滤镜 ≠ 子树滤镜</Text>
    </Positioned>
    <Positioned left="72" top="138.4" width="1056">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">本页目标：分清两种模糊各自糊什么，并把看图自检变成默认动作</Text>
    </Positioned>
    <Positioned left="48" top="214">
      <Container width="5" height="26" color="#1F8A5F" borderRadius="2"/>
    </Positioned>
    <Positioned left="65" top="210" width="1087">
