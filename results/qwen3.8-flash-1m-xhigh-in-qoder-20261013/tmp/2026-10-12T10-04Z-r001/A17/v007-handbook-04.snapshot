        <Positioned left="38" top="46">
          <Text fontSize="17" color="#16233A" fontFamily="Noto Sans Mono CJK SC">BackdropFilter</Text>
        </Positioned>
        <Positioned left="38" top="70">
          <Text fontSize="16" color="#42536E" fontFamily="Noto Sans CJK SC">字清楚，背景糊</Text>
        </Positioned>
        <Positioned left="226" top="20">
          <ClipRRect borderRadius="16" clipBehavior="ANTI_ALIAS">
            <ImageFiltered sigmaX="6" sigmaY="6" tileMode="CLAMP">
