      <Positioned left="911" top="511">
        <Container width="320" height="240" color="#FFFFFF" border="1 SOLID #26385C"/>
      </Positioned>
      <Positioned left="972" top="532">
        <ClipOval clipBehavior="ANTI_ALIAS">
          <SizedBox width="200" height="200">
            <OverflowBox minWidth="320" maxWidth="320" minHeight="240" maxHeight="240" alignment="CENTER">
              <ImageFiltered sigmaX="6" sigmaY="6" tileMode="CLAMP">
                <ColorFiltered color="#F6B94A" blendMode="MULTIPLY">
                  <Stack alignment="TOP_LEFT" clipBehavior="NONE">
                    <Container width="320" height="240" color="#FFFFFF"/>
                    <Positioned left="20" top="20">
