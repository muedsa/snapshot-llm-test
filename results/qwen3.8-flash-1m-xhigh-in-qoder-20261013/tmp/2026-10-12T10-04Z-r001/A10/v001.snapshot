        </ImageFiltered>
      </Positioned>
      <Positioned left="560" top="762" width="320">
        <Text fontSize="20" color="#A6B8D4" textAlign="LEFT" fontFamily="Noto Sans CJK SC,Inter">MULTIPLY #F6B94A 后 sigma=6，可外溢</Text>
      </Positioned>
      <Positioned left="912" top="472" width="230">
        <Text fontSize="24" color="#F2F6FC" textAlign="LEFT" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">⑥ 再加圆形裁剪</Text>
      </Positioned>
      <Positioned left="1170" top="474">
        <Container width="60" height="26" color="#16233C" borderRadius="13" border="1 SOLID #26385C"/>
      </Positioned>
      <Positioned left="1144" top="466.85" width="56">
