<Snapshot type="png" background="transparent"><Container width="1400" height="2420"><Stack alignment="TOP_LEFT" fit="EXPAND" clipBehavior="NONE"><Positioned left="10" top="10" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[本页目标：不依赖任何转述，也能正确发出第一次请求。契约只有三件事：发什么、收什么、出错时怎么]]></Text></Container></Positioned><Positioned left="10" top="50" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[读。右侧示例是一份最小可用文档。]]></Text></Container></Positioned><Positioned left="10" top="90" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[POST /snapshot，请求体是 UTF-8 纯文本 DSL 而非 JSON，Content-Type 为 text/plain。根标]]></Text></Container></Positioned><Positioned left="10" top="130" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[签 <Snapshot> 全文档仅一次，且必须有根 Widget 子节点。]]></Text></Container></Positioned><Positioned left="10" top="170" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[成功时响应体是图片二进制，格式由根标签 type 决定：png（默认）/ jpg / webp。GET /fonts 返]]></Text></Container></Positioned><Positioned left="10" top="210" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[回 text/plain，每行一个字体族；fontFamily 多字体用英文逗号分隔，逗号后不加空格。]]></Text></Container></Positioned><Positioned left="10" top="250" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[失败通常是 JSON：code / message / requestId，用 X-Request-Id 关联服务日志。400]]></Text></Container></Positioned><Positioned left="10" top="290" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[PARSE_ERROR 修 DSL 再提交；413 缩小请求体；429 与 503 按 Retry-After 重试。不要用 ?]]></Text></Container></Positioned><Positioned left="10" top="330" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[errorImage=png：它把错误改成图片，程序读不到。]]></Text></Container></Positioned><Positioned left="10" top="370" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[确认三件事：根标签只有一个、根 Widget 子节点存在、请求体是 UTF-8 纯文本。拿到响应先判断是]]></Text></Container></Positioned><Positioned left="10" top="410" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[不是图片二进制，再按根标签 type 决定扩展名。]]></Text></Container></Positioned><Positioned left="10" top="450" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[请求]]></Text></Container></Positioned><Positioned left="10" top="490" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[响应]]></Text></Container></Positioned><Positioned left="10" top="530" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[错误]]></Text></Container></Positioned><Positioned left="10" top="570" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[发出前检查单]]></Text></Container></Positioned><Positioned left="10" top="610" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="38" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[第一次调用：契约先行]]></Text></Container></Positioned><Positioned left="10" top="650" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[入门手册 · 调用契约]]></Text></Container></Positioned><Positioned left="10" top="690" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[印刷代码：example-01.snapshot 第 1–11 行（省略处已标识）]]></Text></Container></Positioned><Positioned left="10" top="730" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[<Snapshot type="png" background="#0F172A">]]></Text></Container></Positioned><Positioned left="10" top="770" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="2