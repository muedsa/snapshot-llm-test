ntFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[        </BackdropFilter>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="940.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[      </ClipRRect>]]></Raw></Text></Container></Positioned><Positioned left="48.00" top="994.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[ImageFiltered：子树高斯模糊]]></Text></Container></Positioned><Positioned left="48.00" top="1032.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[sigmaX/sigmaY 对子树结果做高斯模糊；Parser 版自动按 sigma 提供模糊输出边界，嵌进]]></Text></Container></Positioned><Positioned left="48.00" top="1064.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[ColorFiltered 时无需手配 outputBounds。]]></Text></Container></Positioned><Positioned left="48.00" top="1106.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[ColorFiltered：子树颜色混合]]></Text></Container></Positioned><Positioned left="48.00" top="1144.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[color 加 blendMode 对子树应用颜色混合，作用范围由子树绘制边界决定，合法溢出与阴影也包]]></Text></Container></Positioned><Positioned left="48.00" top="1176.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[含在内。]]></Text></Container></Positioned><Positioned left="48.00" top="1218.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[BackdropFilter：背景高斯模糊]]></Text></Container></Positioned><Positioned left="48.00" top="1256.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[模糊的是背后已绘制的内容，用来做毛玻璃；背后没有内容时没有可见效果，通常配 ClipRect 或]]></Text></Container></Positioned><Positioned left="48.00" top="1288.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[ClipRRect 限定区域。]]></Text></Container></Positioned><Positioned left="48.00" top="1330.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[自检与可复现交付]]></Text></Container></Positioned><Positioned left="48.00" top="1368.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[四层验证由稳到脆：布局断言、像素采样、Golden 比对、人工 Artifact；采样点避开抗锯齿边缘]]></Text></Container></Positioned><Positioned left="48.00" top="1400.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[。可复现：固定字体与 Surface、网络图转本地、不把时间或随机数写进图。]]></Text></Container></Positioned><Positioned left="48.00" top="1442.00" width="1104.00" height="1.00"><Container color="#E2E8F0"/></Positioned><Positioned left="48.00" top="1454.00" width="1104.00" height="24.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#94A3B8" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Snapshot DSL 入门手册 · 第 4 / 4 页 · run-run-20261013-174209]]></Text></Container></Positioned><Positioned left="48.00" top="1482.00" width="1104.00" height="24.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#94A3B8" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[来源：snapshot.muedsa.com/guides/painting/ ；snapshot.muedsa.com/guides/testing/]]></Text></Container></Positioned></Stack></Container></Snapshot>