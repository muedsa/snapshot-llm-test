0" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[  </Column>]]></Text></Container></Positioned><Positioned left="10" top="1050" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[</Container>]]></Text></Container></Positioned><Positioned left="10" top="1090" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[</Snapshot>]]></Text></Container></Positioned><Positioned left="10" top="1130" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[示例 1 实际渲染（400×240，与手册插图同一子树 1:1）]]></Text></Container></Positioned><Positioned left="10" top="1170" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Snapshot DSL 从文字到图片 · run-run-20261013-174209 · 第 1 / 4 页]]></Text></Container></Positioned><Positioned left="10" top="1210" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[来源：open-snapshot.muedsa.com/ai-guide.md ；snapshot.muedsa.com/guides/parser/]]></Text></Container></Positioned><Positioned left="10" top="1250" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[画布尺寸不是配置项，而是布局算出来的结果。本页把有界 Row/Column/Expanded 与]]></Text></Container></Positioned><Positioned left="10" top="1290" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Stack/Positioned 放进同一张 400×240 对照：上半是弹性分配，下半是绝对定位。]]></Text></Container></Positioned><Positioned left="10" top="1330" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Container 的 width/height 会收紧 constraints；没有子节点也没有约束的空 Container 在无界]]></Text></Container></Positioned><Positioned left="10" top="1370" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[根约束下收缩为零尺寸，根出图仍需非零宽高。父节点传 BoxConstraints，子节点在范围内选择尺寸]]></Text></Container></Positioned><Positioned left="10" top="1410" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[。]]></Text></Container></Positioned><Positioned left="10" top="1450" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Row 与 Column 是 Flex 的特化，管 mainAxisAlignment、mainAxisSize、crossAxisAlignment]]></Text></Container></Positioned><Positioned left="10" top="1490" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[、clipBehavior；只有 crossAxisAlignment="STRETCH" 才强制填满交叉轴。Expanded 以紧约束]]></Text></Container></Positioned><Positioned left="10" top="1530" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[占满分到的主轴空间，Flexible fit="LOOSE" 允许更小，且 Expanded/Flexible/Spacer 必须是]]></Text></Container></Positioned><Positioned left="10" top="1570" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Flex 直接子节点。弹性分配不解除交叉轴最大限制；主轴约束无限时算不出剩余空间，先用 SizedBox]]></Text></Container></Positioned><Positioned left="10" top="1610" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[或 Container 给出有限主轴尺寸。]]></Text></Container></Positioned><Positioned left="10" top="1650" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Stack 先布局非 Positioned 子节点，再按 left/top/right/bottom/width/height 放置]]></Text></Container></Positioned><Positioned left="10" top="1690" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Positioned 子节点，同一轴最多给两项。默认 clipBehavior="HARD_EDGE"：任一直接子节点越界即]]></Text></Container></Positioned><Positioned left="10" top="1730" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[启用裁剪；要允许越界绘制设 NONE。]]></Text></Container></Positioned><Positioned left="10" top="1770" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[根尺寸来自布局]]></Text></Container></Positioned><Positioned left="10" top="1810" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Flex：Row / Column / Expanded]]></Text></Container></Positioned><Positioned left="10" top="1850" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Stack / Positioned]]></Text></Container></Positioned><Positioned left="10" top="1890" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="38" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[尺寸从布局来：Flex 与 Stack 对照]]></Text></Container></Positioned><Positioned left="10" top="1930" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[入门手册 · 布局]]></Text></Container></Positioned><Positioned left="10" top="1970" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[印刷代码：example-02.snapshot 第 5–10、15–20 行（省略处已标识）]]></Text></Container></Positioned><Positioned left="10" top="2010" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[    <SizedBox width="368" height="44">]]></Text></Container><