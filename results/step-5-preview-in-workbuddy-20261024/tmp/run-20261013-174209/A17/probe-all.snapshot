<Snapshot type="png" background="transparent"><Container width="1400" height="5420"><Stack alignment="TOP_LEFT" fit="EXPAND" clipBehavior="NONE"><Positioned left="10" top="10" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[本页目标：不依赖任何转述，也能正确发出第一次请求。契约只有三件事——发什么、收什么、出错时怎么]]></Text></Container></Positioned><Positioned left="10" top="50" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[读。右侧示例是一份最小可用文档。]]></Text></Container></Positioned><Positioned left="10" top="90" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[POST /snapshot，请求体是 UTF-8 纯文本 DSL，不是 JSON；请求头 Content-Type: text/plain;]]></Text></Container></Positioned><Positioned left="10" top="130" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[charset=utf-8。根标签 <Snapshot> 只能出现一次，且最终必须有一个根 Widget 子节点，空文档直]]></Text></Container></Positioned><Positioned left="10" top="170" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[接抛 ParseException。]]></Text></Container></Positioned><Positioned left="10" top="210" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[成功时响应体是图片二进制，格式由根标签 type 决定：png（默认）/ jpg / webp，保存文件的扩展名]]></Text></Container></Positioned><Positioned left="10" top="250" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[须与格式一致。GET /fonts 返回 text/plain，每行一个字体族，与渲染接口同访问规则；]]></Text></Container></Positioned><Positioned left="10" top="290" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[fontFamily 可写多字体，英文逗号分隔且逗号后不加空格。]]></Text></Container></Positioned><Positioned left="10" top="330" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[失败响应通常是 JSON：code / message / requestId，用 X-Request-Id 关联服务日志。400]]></Text></Container></Positioned><Positioned left="10" top="370" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[PARSE_ERROR 修 DSL 再提交；IMAGE_LOAD_ERROR 查图片来源；413 缩小请求体；401 查凭据；429]]></Text></Container></Positioned><Positioned left="10" top="410" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[与部分 503 按 Retry-After 延迟重试，不要把相同的格式错误原样重试。属性错误可能附带]]></Text></Container></Positioned><Positioned left="10" top="450" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[diagnostic（attributeName / position / allowedValues）。默认不要用 ?errorImage=png：]]></Text></Container></Positioned><Positioned left="10" top="490" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[它把解析错误改成图片响应，程序读不到错误消息。]]></Text></Container></Positioned><Positioned left="10" top="530" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[请求]]></Text></Container></Positioned><Positioned left="10" top="570" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[响应]]></Text></Container></Positioned><Positioned left="10" top="610" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[错误]]></Text></Container></Positioned><Positioned left="10" top="650" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="38" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[第一次调用：契约先行]]></Text></Container></Positioned><Positioned left="10" top="690" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[入门手册 · 调用契约]]></Text></Container></Positioned><Positioned left="10" top="730" width="1300" height="40"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[印刷代码：example-01.snapshot 第 1–9 行（与独立示例逐字一致）]]></Text></Container></Positioned><Positioned left="10" top="770" width="1300" height="40"><