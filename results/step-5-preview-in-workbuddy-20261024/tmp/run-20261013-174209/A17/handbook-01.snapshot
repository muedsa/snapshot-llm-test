<Snapshot type="png" background="#FFFFFF"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT" fit="EXPAND" clipBehavior="NONE"><Positioned left="0.00" top="0.00" width="1200.00" height="1600.00"><Container color="#FFFFFF"/></Positioned><Positioned left="48.00" top="48.00" width="132.00" height="40.00"><Container color="#0F172A" borderRadius="8"/></Positioned><Positioned left="48.00" top="48.00" width="132.00" height="40.00"><Container color="transparent" alignment="CENTER"><Text fontSize="20" fontFamily="Inter Semi Bold" fontStyle="NORMAL" color="#FFFFFF" textAlign="CENTER" softWrap="false" maxLines="1"><![CDATA[01 / 04]]></Text></Container></Positioned><Positioned left="200.00" top="54.00" width="952.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#245CE4" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[入门手册 · 调用契约]]></Text></Container></Positioned><Positioned left="48.00" top="98.00" width="1104.00" height="48.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="38" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[第一次调用：契约先行]]></Text></Container></Positioned><Positioned left="48.00" top="160.00" width="1104.00" height="1.00"><Container color="#E2E8F0"/></Positioned><Positioned left="48.00" top="172.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[本页目标：不依赖任何转述，也能正确发出第一次请求。契约只有三件事：发什么、收什么、出错时]]></Text></Container></Positioned><Positioned left="48.00" top="204.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[怎么读。右侧示例是一份最小可用文档。]]></Text></Container></Positioned><Positioned left="48.00" top="246.00" width="1104.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#245CE4" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[教学插图（由本页 DSL 直接渲染，非嵌入图片）]]></Text></Container></Positioned><Positioned left="48" top="274" width="464" height="304"><Container color="#FFFFFF" border="1 SOLID #CBD5E1" borderRadius="10" padding="32"><!-- CORE-BEGIN --><Container width="400" height="240" color="#1E293B" padding="24">
  <Column crossAxisAlignment="START">
    <Text color="#38BDF8" fontSize="20" fontStyle="BOLD">POST /snapshot</Text>
    <Text color="#F8FAFC" fontSize="28" fontStyle="BOLD">text/plain in, PNG out</Text>
    <Text color="#94A3B8" fontSize="20">charset=utf-8 · 200 image/png</Text>
    <SizedBox width="352" height="12"/>
    <Text color="#F8FAFC" fontSize="20">Content-Type: text/plain</Text>
    <Text color="#94A3B8" fontSize="20">X-Request-Id 关联服务日志</Text>
    <SizedBox width="352" height="12"/>
    <Text color="#94A3B8" fontSize="20">GET /fonts 返回字体族清单</Text>
  </Column>
</Container><!-- CORE-END --></Container></Positioned><Positioned left="544.00" top="398.00" width="608.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[渲染结果]]></Text></Container></Positioned><Positioned left="544.00" top="428.00" width="608.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#64748B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[示例 1 实际渲染（400×240，与手册插图同一子树 1:1）]]></Text></Container></Positioned><Positioned left="48.00" top="594.00" width="1104.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#245CE4" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[印刷代码：example-01.snapshot 第 1–11 行（省略处已标识）]]></Text></Container></Positioned><Positioned left="48.00" top="622.00" width="1104.00" height="336.00"><Container color="#0F172A" border="1 SOLID #1E293B" borderRadius="10"/></Positioned><Positioned left="68.00" top="634.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[<Snapshot type="png" background="#0F172A">]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="660.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[<Container width="400" height="240" color="#1E293B" padding="24">]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="686.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[  <Column crossAxisAlignment="START">]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="712.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <Text color="#38BDF8" fontSize="20" fontStyle="BOLD">POST /snapshot</Text>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="738.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <Text color="#F8FAFC" fontSize="28" fontStyle="BOLD">text/plain in, PNG out</Text>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="764.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <Text color="#94A3B8" fontSize="20">charset=utf-8 · 200 image/png</Text>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="790.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <SizedBox width="352" height="12"/>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="816.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <Text color="#F8FAFC" fontSize="20">Content-Type: text/plain</Text>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="842.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <Text color="#94A3B8" fontSize="20">X-Request-Id 关联服务日志</Text>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="868.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <SizedBox width="352" height="12"/>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="894.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <Text color="#94A3B8" fontSize="20">GET /fonts 返回字体族清单</Text>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="920.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#7C8CA1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#7C8CA1"><![CDATA[…………省略 </Column>、</Container> 与 </Snapshot> 三行收尾…………]]></Raw></Text></Container></Positioned><Positioned left="48.00" top="974.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[请求]]></Text></Container></Positioned><Positioned left="48.00" top="1012.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[POST /snapshot，请求体是 UTF-8 纯文本 DSL 而非 JSON，Content-Type 为 text/plain。]]></Text></Container></Positioned><Positioned left="48.00" top="1044.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[根标签 <Snapshot> 全文档仅一次，且必须有根 Widget 子节点。]]></Text></Container></Positioned><Positioned left="48.00" top="1086.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[响应]]></Text></Container></Positioned><Positioned left="48.00" top="1124.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[成功时响应体是图片二进制，格式由根标签 type 决定：png（默认）/ jpg / webp。GET /fonts]]></Text></Container></Positioned><Positioned left="48.00" top="1156.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[返回 text/plain，每行一个字体族；fontFamily 多字体用英文逗号分隔，逗号后不加空格。]]></Text></Container></Positioned><Positioned left="48.00" top="1198.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[错误]]></Text></Container></Positioned><Positioned left="48.00" top="1236.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[失败通常是 JSON：code / message / requestId，用 X-Request-Id 关联服务日志。400]]></Text></Container></Positioned><Positioned left="48.00" top="1268.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[PARSE_ERROR 修 DSL 再提交；413 缩小请求体；429 与 503 按 Retry-After 重试。不要用 ?]]></Text></Container></Positioned><Positioned left="48.00" top="1300.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[errorImage=png：它把错误改成图片，程序读不到。]]></Text></Container></Positioned><Positioned left="48.00" top="1342.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[发出前检查单]]></Text></Container></Positioned><Positioned left="48.00" top="1380.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[确认三件事：根标签只有一个、根 Widget 子节点存在、请求体是 UTF-8 纯文本。拿到响应先判断]]></Text></Container></Positioned><Positioned left="48.00" top="1412.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[是不是图片二进制，再按根标签 type 决定扩展名。]]></Text></Container></Positioned><Positioned left="48.00" top="1454.00" width="1104.00" height="1.00"><Container color="#E2E8F0"/></Positioned><Positioned left="48.00" top="1466.00" width="1104.00" height="24.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#94A3B8" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Snapshot DSL 入门手册 · 第 1 / 4 页 · run-run-20261013-174209]]></Text></Container></Positioned><Positioned left="48.00" top="1494.00" width="1104.00" height="24.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#94A3B8" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[来源：open-snapshot.muedsa.com/ai-guide.md ；snapshot.muedsa.com/guides/parser/]]></Text></Container></Positioned></Stack></Container></Snapshot>