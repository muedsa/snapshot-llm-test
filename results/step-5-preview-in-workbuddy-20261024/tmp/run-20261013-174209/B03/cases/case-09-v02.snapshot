<Positioned left="450.00" top="1000.00" width="190.00" height="190.00"><Container color="transparent"><Text fontSize="170" color="#1F2A38" fontFamily="Noto Serif CJK SC" fontStyle="BOLD" softWrap="false" maxLines="1">汐</Text></Container></Positioned>
<Positioned left="635.00" top="1000.00" width="190.00" height="190.00"><Container color="transparent"><Text fontSize="170" color="#1F2A38" fontFamily="Noto Serif CJK SC" fontStyle="BOLD" softWrap="false" maxLines="1">的</Text></Container></Positioned>
<Positioned left="820.00" top="1000.00" width="190.00" height="190.00"><Container color="transparent"><Text fontSize="170" color="#1F2A38" fontFamily="Noto Serif CJK SC" fontStyle="BOLD" softWrap="false" maxLines="1">人</Text></Container></Positioned>
<Positioned left="1080.00" top="430.00" width="600.00" height="30.00"><Container color="transparent"><Text fontSize="22" color="#D96C3D" fontFamily="Inter" fontStyle="BOLD" letterSpacing="4" softWrap="false" maxLines="1">THE TIDE CHASERS · 秋季特辑 · VOL.11</Text></Container></Positioned>
<Positioned left="940.00" top="490.00" width="740.00" height="60.00"><Container color="transparent"><Text fontSize="20" color="#1F2A38" fontFamily="Noto Serif CJK SC" height="1.5" softWrap="false" maxLines="1">海水退去时，滩涂上留下一整天的故事。我们跟着四位渔民下了海——</Text></Container></Positioned>
<Positioned left="940.00" top="550.00" width="740.00" height="40.00"><Container color="transparent"><Text fontSize="20" color="#1F2A38" fontFamily="Noto Serif CJK SC" height="1.5" softWrap="false" maxLines="1">从凌晨三点的缯网，到黄昏最后一舱梭子蟹，潮汐表是他们唯一的钟。</Text></Container></Positioned>
<Positioned left="940.00" top="620.00" width="740.00" height="2.00"><Container width="740.00" height="2.00" color="#1F2A3830"/></Positioned>
<Positioned left="940.00" top="648.00" width="120.00" height="70.00"><Container color="transparent"><Text fontSize="52" color="#D96C3D" fontFamily="Noto Serif CJK SC" fontStyle="BOLD" softWrap="false" maxLines="1">2</Text></Container></Positioned>
<Positioned left="1032.00" top="690.00" width="40.00" height="24.00"><Container color="transparent"><Text fontSize="14" color="#6B7684" fontFamily="Noto Sans CJK SC" softWrap="false" maxLines="1">次</Text></Container></Positioned>
<Positioned left="940.00" top="726.00" width="200.00" height="22.00"><Container color="transparent"><Text fontSize="13" color="#6B7684" fontFamily="Noto Sans CJK SC" softWrap="false" maxLines="1">每日潮汐</Text></Container></Positioned>
<Positioned left="1160.00" top="650.00" width="1.00" height="90.00"><Container width="1.00" height="90.00" color="#1F2A3830"/></Positioned>
<Positioned left="1190.00" top="648.00" width="120.00" height="70.00"><Container color="transparent"><Text fontSize="52" color="#D96C3D" fontFamily="Noto Serif CJK SC" fontStyle="BOLD" softWrap="false" maxLines="1">42</Text></Container></Positioned>
<Positioned left="1282.00" top="690.00" width="40.00" height="24.00"><Container color="transparent"><Text fontSize="14" color="#6B7684" fontFamily="Noto Sans CJK SC" softWrap="false" maxLines="1">户</Text></Container></Positioned>
<Positioned left="1190.00" top="726.00" width="200.00" height="22.00"><Container color="transparent"><Text fontSize="13" color="#6B7684" fontFamily="Noto Sans CJK SC" softWrap="false" maxLines="1">跟访渔民</Text></Container></Positioned>
<Positioned left="1410.00" top="650.00" width="1.00" height="90.00"><Container width="1.00" height="90.00" color="#1F2A3830"/></Positioned>
<Positioned left="1440.00" top="648.00" width="120.00" height="70.00"><Container color="transparent"><Text fontSize="52" color="#D96C3D" fontFamily="Noto Serif CJK SC" fontStyle="BOLD" softWrap="false" maxLines="1">11</Text></Container></Positioned>
<Positioned left="1532.00" top="690.00" width="40.00" height="24.00"><Container color="transparent"><Text fontSize="14" color="#6B7684" fontFamily="Noto Sans CJK SC" softWrap="false" maxLines="1">年</Text></Container></Positioned>
<Positioned left="1440.00" top="726.00" width="200.00" height="22.00"><Container color="transparent"><Text fontSize="13" color="#6B7684" fontFamily="Noto Sans CJK SC" softWrap="false" maxLines="1">记录跨度</Text></Container></Positioned>
<Positioned left="940.00" top="790.00" width="360.00" height="150.00"><Container color="transparent"><Text fontSize="14" color="#1F2A38" fontFamily="Noto Sans CJK SC" height="1.9" softWrap="false" maxLines="1">　　老陈的船叫「潮生」，船头漆成朱红。他说这名字是父亲取的，取「潮生而生」的意思——潮水从不迟到，人也不能。</Text></Container></Positioned>
<Positioned left="940.00" top="950.00" width="360.00" height="120.00"><Container color="transparent"><Text fontSize="14" color="#1F2A38" fontFamily="Noto Sans CJK SC" height="1.9" softWrap="false" maxLines="1">　　凌晨三点半，缯网下水。浮标的铃铛在雾里响，一声，两声，像远处村镇的鸡鸣。这一网要守到日出。</Text></Container></Positioned>
<Positioned left="1330.00" top="790.00" width="360.00" height="150.00"><Container color="transparent"><Text fontSize="14" color="#1F2A38" fontFamily="Noto Sans CJK SC" height="1.9" softWrap="false" maxLines="1">　　小暑后的滩涂格外慷慨。招潮蟹在洞穴口列队，弹涂鱼甩出泥浆里的弧线，白鹭单脚立在竹架旁，等一条漏网的跳跳鱼。</Text></Container></Positioned>
<Positioned left="1330.00" top="950.00" width="360.00" height="120.00"><Container color="transparent"><Text fontSize="14" color="#1F2A38" fontFamily="Noto Sans CJK SC" height="1.9" softWrap="false" maxLines="1">　　「看潮吃饭的人，心里都装着两片海。」老陈收网时说，「一片在水里，一片在天上。」</Text></Container></Positioned>
<Positioned left="40.00" top="1190.00" width="800.00" height="50.00"><SizedOverflowBox width="800" height="50" alignment="CENTER_LEFT"><SizedBox width="1700" height="50"><Container width="1700" height="50" color="#1F2A38"/></SizedBox></SizedOverflowBox></Positioned>
