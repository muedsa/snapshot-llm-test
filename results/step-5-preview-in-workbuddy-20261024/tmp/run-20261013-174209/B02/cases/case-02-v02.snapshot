<Positioned left="140.00" top="88.00" width="400.00" height="24.00"><Container color="transparent"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#3E7C74" textAlign="LEFT" softWrap="false" maxLines="1">园区动线 · 设施 · 守则</Text></Container></Positioned>
<Positioned left="1514.00" top="56.00" width="200.00" height="28.00"><Container color="transparent"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" color="#1E3B2F" textAlign="RIGHT" softWrap="false" maxLines="1">P04 – P05</Text></Container></Positioned>
