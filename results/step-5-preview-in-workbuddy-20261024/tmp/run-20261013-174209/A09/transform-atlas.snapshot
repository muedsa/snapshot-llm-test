<Snapshot type="png" background="#F8FAFC"><Container width="1600" height="1200"><Stack alignment="TOP_LEFT" fit="EXPAND" clipBehavior="NONE"><Positioned left="0.0" top="0.0" width="1600.0" height="1200.0"><Container color="#F8FAFC"/></Positioned><Positioned left="0.0" top="0.0" width="1600.0" height="112.0"><Container color="#0F172A"/></Positioned><Positioned left="0.0" top="109.0" width="1600.0" height="3.0"><Container color="#2364DB"/></Positioned><Positioned left="48.0" top="22.0" width="1000.0"><Container color="transparent"><Text fontSize="34" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#F8FAFC" textAlign="LEFT" softWrap="true" maxLines="1">变换图谱 · 十二个非对称图形标本</Text></Container></Positioned><Positioned left="48.0" top="68.0" width="1100.0"><Container color="transparent"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#94A3B8" textAlign="LEFT" softWrap="true" maxLines="1">每格主体由 Transform.matrix 表示最终组合变换；所有步骤围绕印章局部 (60, 60) 进行</Text></Container></Positioned><Positioned left="992.0" top="26.0" width="560.0"><Container color="transparent"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#CBD5E1" textAlign="RIGHT" softWrap="true" maxLines="1">像素坐标 x 向右、y 向下，「顺时针」按图像方向</Text></Container></Positioned><Positioned left="992.0" top="52.0" width="560.0"><Container color="transparent"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#94A3B8" textAlign="RIGHT" softWrap="true" maxLines="1">mirror_horizontal = 左右镜像 · mirror_vertical = 上下镜像</Text></Container></Positioned><Positioned left="992.0" top="78.0" width="560.0"><Container color="transparent"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#94A3B8" textAlign="RIGHT" softWrap="true" maxLines="1">操作按列表顺序应用；T07 与 T08 显示操作顺序差异</Text></Container></Positioned><Positioned left="48.0" top="118.0" width="1504.0" height="46.0"><Container color="#FFFFFF" borderRadius="10" border="1 SOLID #E2E8F0"/></Positioned><Positioned left="68.0" top="132.0" width="18.0" height="18.0"><Container color