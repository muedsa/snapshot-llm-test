<Positioned left="76.00" top="648.00" width="200.00" height="28.00"><Container color="transparent"><Text fontSize="20" color="#1F2A33" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD" softWrap="false" maxLines="1">地表–3 km</Text></Container></Positioned>
<Positioned left="76.00" top="676.00" width="190.00" height="18.00"><Container color="transparent"><Text fontSize="11.5" color="#5A6B78" fontFamily="Noto Sans Mono CJK SC" softWrap="false" maxLines="1">地表–10 000 ft</Text></Container></Positioned>
<Positioned left="260.00" top="648.00" width="340.00" height="40.00"><Container color="transparent"><Text fontSize="11" color="#5A6B78" fontFamily="Noto Sans CJK SC" softWrap="false" maxLines="1">天气图上视为中云；可延伸至其他层；云底随降水持续降低</Text></Container></Positioned>
<Positioned left="460.00" top="628.00" width="260.00" height="40.00"><Container color="transparent"><Text fontSize="14" color="#1F2A33" fontFamily="Noto Serif CJK SC" fontStyle="BOLD" softWrap="false" maxLines="1">连续性雨或雪</Text></Container></Positioned>
