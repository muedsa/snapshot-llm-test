fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <Text fontSize="20" color="#0F172A"><![CDATA[CDATA: a < b & c > d 原样]]]]><![CDATA[></Text>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="842.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <Text fontSize="20" color="#0F172A">Trim 首尾空白:<Raw>|  保留  |</Raw></Text>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="868.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#7C8CA1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#7C8CA1"><![CDATA[…………省略三个半透明色块行与 Row，见图示…………]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="894.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[    <Text fontSize="20" color="#0F172A">alpha 在末两位：#FF000080 半透明</Text>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="920.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[  </Column>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="946.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[</Container>]]></Raw></Text></Container></Positioned><Positioned left="48.00" top="1000.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[误解一：实体可以在 DSL 里用]]></Text></Container></Positioned><Positioned left="48.00" top="1038.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[解析器不做 HTML 实体解码；要原样输出 < > &，用 CDATA 包裹：<Text><![CDATA[a < b & c >]]></Text></Container></Positioned><Positioned left="48.00" top="1070.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[d]]]]><![CDATA[></Text>。CDATA 未闭合时会把已读内容当文本输出，与注释的行为不同。]]></Text></Container></Positioned><Positioned left="48.00" top="1112.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[误解二：Text 会保留空白]]></Text></Container></Positioned><Positioned left="48.00" top="1150.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Text 会 trim 首尾空白；要保留首尾空格和换行用 Raw。Raw 支持文本样式属性，但不支持]]></Text></Container></Positioned><Positioned left="48.00" top="1182.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[textAlign / softWrap 等段落属性，且只能出现在最外层 Text 创建的行内内容树里。]]></Text></Container></Positioned><Positioned left="48.00" top="1224.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[误解三：富文本靠拼字符串]]></Text></Container></Positioned><Positioned left="48.00" top="1262.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Text 可嵌套 Text / Raw / Emoji / WidgetSpan 组成行内 Span 树，子 Span 继承父未覆盖]]></Text></Container></Positioned><Positioned left="48.00" top="1294.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[的样式；WidgetSpan 必须恰有一个 Widget 子节点。]]></Text></Container></Positioned><Positioned left="48.00" top="1336.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[误解四：alpha 在颜色串前面]]></Text></Container></Positioned><Positioned left="48.00" top="1374.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[颜色支持 #RGB / #RGBA / #RRGGBB / #RRGGBBAA，8 位格式的透明度在最后两位：#FF000080]]></Text></Container></Positioned><Positioned left="48.00" top="1406.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[是半透明红。多字体串不会逐项 trim，写成 Noto Sans CJK SC,Inter 时逗号后不能加空格。]]></Text></Container></Positioned><Positioned left="48.00" top="1448.00" width="1104.00" height="1.00"><Container color="#E2E8F0"/></Positioned><Positioned left="48.00" top="1460.00" width="1104.00" height="24.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#94A3B8" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Snapshot DSL 入门手册 · 第 3 / 4 页 · run-run-20261013-174209]]></Text></Container></Positioned><Positioned left="48.00" top="1488.00" width="1104.00" height="24.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#94A3B8" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[来源：snapshot.muedsa.com/guides/parser/ ；snapshot.muedsa.com/guides/media-text/]]></Text></Container></Positioned></Stack></Container></Snapshot>