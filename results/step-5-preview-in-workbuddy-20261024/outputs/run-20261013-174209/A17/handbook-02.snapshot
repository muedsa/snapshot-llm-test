amily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[        </Positioned>]]></Raw></Text></Container></Positioned><Positioned left="68.00" top="972.00" width="1064.00" height="28.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1" softWrap="false" maxLines="1"><Raw fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#CBD5E1"><![CDATA[      </Stack>]]></Raw></Text></Container></Positioned><Positioned left="48.00" top="1026.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[根尺寸来自布局]]></Text></Container></Positioned><Positioned left="48.00" top="1064.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Container 的 width/height 会收紧 constraints；没有子节点也没有约束的空 Container]]></Text></Container></Positioned><Positioned left="48.00" top="1096.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[在无界根约束下收缩为零。父节点传 BoxConstraints，子节点在范围内选择尺寸；根出图仍需非]]></Text></Container></Positioned><Positioned left="48.00" top="1128.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[零宽高。]]></Text></Container></Positioned><Positioned left="48.00" top="1170.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Flex：Row / Column / Expanded]]></Text></Container></Positioned><Positioned left="48.00" top="1208.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Row 与 Column 是 Flex 的特化，管 mainAxisAlignment、mainAxisSize、]]></Text></Container></Positioned><Positioned left="48.00" top="1240.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[crossAxisAlignment；只有 STRETCH 才填满交叉轴。Expanded 以紧约束占满主轴剩余空间，]]></Text></Container></Positioned><Positioned left="48.00" top="1272.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Flexible 允许更小；三者必须是 Flex 直接子节点。主轴无限时先用 SizedBox 给出有限尺寸。]]></Text></Container></Positioned><Positioned left="48.00" top="1314.00" width="1104.00" height="34.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="26" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" color="#0F172A" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Stack / Positioned]]></Text></Container></Positioned><Positioned left="48.00" top="1352.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Stack 先布局非 Positioned 子节点，再按 left/top/right/bottom/width/height 放置]]></Text></Container></Positioned><Positioned left="48.00" top="1384.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Positioned 子节点，同一轴最多两项。默认 clipBehavior 为 HARD_EDGE，越界即裁剪；设]]></Text></Container></Positioned><Positioned left="48.00" top="1416.00" width="1104.00" height="32.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E293B" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[NONE 允许越界绘制。]]></Text></Container></Positioned><Positioned left="48.00" top="1458.00" width="1104.00" height="1.00"><Container color="#E2E8F0"/></Positioned><Positioned left="48.00" top="1470.00" width="1104.00" height="24.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#94A3B8" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[Snapshot DSL 入门手册 · 第 2 / 4 页 · run-run-20261013-174209]]></Text></Container></Positioned><Positioned left="48.00" top="1498.00" width="1104.00" height="24.00"><Container color="transparent" alignment="TOP_LEFT"><Text fontSize="18" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#94A3B8" textAlign="LEFT" softWrap="false" maxLines="1"><![CDATA[来源：snapshot.muedsa.com/guides/layout/ ；snapshot.muedsa.com/reference/parser-tags/]]></Text></Container></Positioned></Stack></Container></Snapshot>