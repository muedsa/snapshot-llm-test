<Positioned left="1355.00" top="816.00" width="80.00" height="18.00"><Container color="transparent"><Text fontSize="12" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" color="#1E3B2F" textAlign="CENTER" softWrap="false" maxLines="1">2020</Text></Container></Positioned>
<Positioned left="1450.00" top="816.00" width="80.00" height="18.00"><Container color="transparent"><Text fontSize="12" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" color="#1E3B2F" textAlign="CENTER" softWrap="false" maxLines="1">2021</Text></Container></Positioned>
<Positioned left="1545.00" top="816.00" width="80.00" height="18.00"><Container color="transparent"><Text fontSize="12" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" color="#1E3B2F" textAlign="CENTER" softWrap="false" maxLines="1">2022</Text></Container></Positioned>
<Positioned left="1640.00" top="816.00" width="80.00" height="18.00"><Container color="transparent"><Text fontSize="12" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL" color="#1E3B2F" textAlign="CENTER" softWrap="false" maxLines="1">2023</Text></Container></Positioned>
<Positioned left="1300.00" top="840.00" width="300.00" height="18.00"><Container color="transparent"><Text fontSize="11" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#8A937E" textAlign="LEFT" softWrap="false" maxLines="1">纵轴 45 – 75</Text></Container></Positioned>
<Positioned left="40.00" top="928.00" width="600.00" height="30.00"><Container color="transparent"><Text fontSize="20" fontFamily="Noto Serif CJK SC" fontStyle="NORMAL" color="#1E3B2F" textAlign="LEFT" softWrap="false" maxLines="1">监测方法与说明</Text></Container></Positioned>
<Positioned left="40.00" top="968.00" width="1674.00" height="26.00"><Container color="transparent"><Text fontSize="15" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E3B2F" textAlign="LEFT" softWrap="false" maxLines="1">监测方法：鸟类采用样线法（每月 2 条、每条 3 km）与环志点辅助；水域面积依据年度水文测绘；</Text></Container></Positioned>
<Positioned left="40.00" top="998.00" width="1674.00" height="26.00"><Container color="transparent"><Text fontSize="15" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E3B2F" textAlign="LEFT" softWrap="false" maxLines="1">水质透明度用塞氏盘月度测量取年均值；植被覆盖率基于无人机多光谱正射影像分类。</Text></Container></Positioned>
<Positioned left="40.00" top="1028.00" width="1674.00" height="26.00"><Container color="transparent"><Text fontSize="15" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL" color="#1E3B2F" textAlign="LEFT" softWrap="false" maxLines="1">数据局限：2020 年春季受管控影响样线频次减半，该年数值或略偏低；全部数据存档于访客中心。</Text></Container></Positioned>
