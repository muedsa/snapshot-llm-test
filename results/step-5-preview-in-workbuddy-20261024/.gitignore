# Snapshot 套件运行 · 总任务根 .gitignore
# 依据 run-config.json 的 runtime_cache_policy 与 templates/gitignore-template.txt 创建。
# 仅排除运行时缓存；outputs/、tmp/、任务输入与全部过程证据（请求/响应、草稿、预览、
# 脚本、下载文档、日志、检查点）都不被忽略。

# --- 运行时缓存（合并自 templates/gitignore-template.txt）---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- 按实际工具链补充的明确缓存规则 ------
# Node.js
node_modules/
.npm/
# Python 虚拟环境与打包缓存
.venv/
venv/
*.egg-info/
.tox/
# 编辑器/系统
.vscode/
.idea/
Thumbs.db
desktop.ini
# 操作系统临时文件
*.tmp
*.temp
