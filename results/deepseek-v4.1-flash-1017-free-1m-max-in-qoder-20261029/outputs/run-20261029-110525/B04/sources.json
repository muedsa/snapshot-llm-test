  "claims": [
    {
      "id": "C01",
      "statement": "请求体是 UTF-8 纯文本 DSL；成功响应为图片二进制，失败响应为带 code、message、requestId 的 JSON。",
      "source": "S1",
      "section": "最小示例；错误处理",
      "used_in_cases": [1, 10]
    },
    {
      "id": "C02",
      "statement": "解析流水线为 Reader → Tokenizer → Element 树 → WidgetParser → Widget 树 → RenderBox → 图片字节。",
      "source": "S2",
      "section": "进阶：处理流程",
      "used_in_cases": [2]
    },
    {
      "id": "C03",
      "statement": "解析器不做 HTML 实体解码；文本中出现 < 或 > 时使用 CDATA。",
      "source": "S2",
      "section": "文本与 CDATA",
      "used_in_cases": [2]
    },
    {
      "id": "C04",
      "statement": "根 Canvas 的尺寸来自根 Widget 的布局结果；约束从根向下传，尺寸从子节点向上回传。",
      "source": "S3",
      "section": "Snapshot；约束与溢出",
      "used_in_cases": [3]
    },
    {
      "id": "C05",
      "statement": "Row/Column 只有在主轴有界时，Expanded 与 Spacer 才能分配剩余空间。",
      "source": "S3",
      "section": "Row 与 Column",
      "used_in_cases": [3, 6]
    },
    {
      "id": "C06",
      "statement": "fontSize 是逻辑像素，行高与基线由字体度量决定；字体必须来自服务实际可用列表。",
      "source": "S4",
      "section": "字体与度量；平台与字体一致性",
      "used_in_cases": [4]
    },
    {
      "id": "C07",
      "statement": "8 位颜色写作 #RRGGBBAA，最后两位是 alpha；设置渐变时 gradientColors 至少两种颜色。",
      "source": "S3",
      "section": "Container",
      "used_in_cases": [5]
    },
    {
      "id": "C08",
      "statement": "Flex 先排固定子节点，再按 flex 份额分配剩余主轴空间；Flexible 允许子节点更小，Spacer 不绘制。",
      "source": "S3",
      "section": "Row 与 Column",
      "used_in_cases": [6]
    },
    {
      "id": "C09",
      "statement": "Positioned 是唯一可用四边定位的子节点类型，且必须是 Stack 的直接子节点；Stack 默认按最大子节点收缩。",
      "source": "S3",
      "section": "Stack；Positioned",
      "used_in_cases": [7]
    },
    {
      "id": "C10",
      "statement": "Transform 需要 16 个列主序 4×4 浮点数；旋转中心可用 origin 或 alignment 指定，矩阵不改变布局尺寸。",
      "source": "S3",
      "section": "Opacity 与 Transform",
      "used_in_cases": [8]
    },
    {
      "id": "C11",
      "statement": "ImageFiltered 模糊整个子树，BackdropFilter 读取已绘制背景；裁剪可限定滤镜范围。",
      "source": "S3",
      "section": "ColorFiltered、ImageFiltered 与 BackdropFilter；ClipRect、ClipOval 与 ClipRRect",
      "used_in_cases": [9]
    },
    {
      "id": "C12",
      "statement": "400 PARSE_ERROR 应修正 DSL；429 与部分 503 可参考 Retry-After 延迟重试，不要原样重试格式错误。",
      "source": "S1",
      "section": "错误处理",
      "used_in_cases": [1, 10]
    }
  ]
}
