ned><Positioned left="120" top="804" width="640"><Text fontFamily="Noto Sans CJK SC" fontSize="10" color="#B23A2E">要问：涨幅是否封顶？</Text></Positioned><Positioned left="80" top="858" width="680" height="1"><Container width="680" height="1" color="#DCD3C4" borderRadius="0"/></Positioned><Positioned left="80" top="890"><Text fontFamily="Noto Sans Mono CJK SC" fontSize="16" color="#B23A2E" fontStyle="BOLD">05</Text></Positioned><Positioned left="120" top="892" width="300" height="26"><Container width="300" height="26" color="#F2D06B" borderRadius="2"/></Positioned><Positioned left="126" top="890"><Text fontFamily="Noto Sans CJK SC" fontSize="18" color="#1F2A2E" fontStyle="BOLD">转租</Text></Positioned><Positioned left="120" top="930" width="640"><Text fontFamily="Noto Sans CJK SC" fontSize="12" color="#1F2A2E">转租需房东书面同意。</Text></Positioned><Positioned left="120" top="964" width="640"><Text fontFamily="Noto Sans CJK SC" fontSize="10" color="#B23A2E">要问：书面同意多久给答复？</Text></Positioned><Positioned left="820" top="250" width="340" height="700"><Container width="340" height="700" color="#FFFDF8" borderRadius="12" border="1 SOLID #D8CFC0"/></Positioned><Positioned left="844" top="270"><Text fontFamily="Noto Sans CJK SC" fontSize="10" color="#6F6A60" fontStyle="BOLD" letterSpacing="1">签字当天要付</Text></Positioned><Positioned left="844" top="292"><Text fontFamily="Noto Sans Mono CJK SC" fontSize="34" color="#1F2A2E" fontStyle="BOLD">¥20,400</Text></Positioned><Positioned left="844" top="340"><Text fontFamily="Noto Sans CJK SC" fontSize="10" color="#6F6A60">押二 13,600 + 首月 6,800</Text></Positioned><Positioned left="844" top="374" width="292" height="1"><Container width="292" height="1" color="#E6DED1" borderRadius="0"/></Positioned><Positioned left="844" top="394"><Text fontFamily="Noto Sans CJK SC" fontSize="10" color="#6F6A60" fontStyle="BOLD">第二年月租</Text></Positioned><Positioned left="844" top="416"><Text fontFamily="Noto Sans Mono CJK SC" fontSize="26" color="#B23A2E" fontStyle="BOLD">¥7,140</Text></Positioned><Positioned left="844" top="454"><Text fontFamily="Noto Sans CJK SC" fontSize="9" color="#6F6A60">按每年 5% 上调</Text></Positioned><Positioned left="844" top="486" width="292" height="1"><Container width="292" height="1" color="#E6DED1" borderRadius="0"/></Positioned><Positioned left="844" top="506"><Text fontFamily="Noto Sans CJK SC" fontSize="10" color="#6F6A60" fontStyle="BOLD">提前退租</Text></Positioned><Positioned left="844" top="528"><Text fontFamily="Noto Sans Mono CJK SC" fontSize="26" color="#B23A2E" fontStyle="BOLD">−¥6,800</Text></Positioned><Positioned left="844" top="566"><Text fontFamily="Noto Sans CJK SC" fontSize="9" color="#6F6A60">未满 1 年扣 1 个月</Text></Positioned><Positioned left="844" top="598" width="292" height="1"><Container width="292" height="1" color="#E6DED1" borderRadius="0"/></Positioned><Positioned left="844" top="618"><Text fontFamily="Noto Sans CJK SC" fontSize="10" color="#6F6A60" fontStyle="BOLD">维修响应</Text></Positioned><Positioned left="844" top="640"><Text fontFamily="Noto Sans Mono CJK SC" fontSize="26" color="#3F6B4F" fontStyle="BOLD">48h</Text></Positioned><Positioned left="844" top="678"><Text fontFamily="Noto Sans CJK SC" fontSize="9" color="#6F6A60">非人为损坏；超时怎么办？</Text></Positioned><Positioned left="844" top="710" width="292" height="1"><Container width="292" height="1" color="#E6DED1" borderRadius="0"/></Positioned><Positioned left="844" top="730"><Text fontFamily="Noto Sans CJK SC" fontSize="10" color="#6F6A60" fontStyle="BOLD">通知期</Text></Positioned><Positioned left="844" top="752"><Text fontFamily="Noto Sans Mono CJK SC" fontSize="26" color="#1F2A2E" fontStyle="BOLD">30 天</Text></Positioned><Positioned left="844" top="790"><Text fontFamily="Noto Sans CJK SC" fontSize="9" color="#6F6A60">书面通知，别口头</Text></Positioned><Positioned left="80" top="1090" width="1080" height="180"><Container width="1080" height="180" color="#FFFDF8" borderRadius="12" border="1 SOLID #D8CFC0"/></Positioned><Positioned left="104" top="1108"><Text fontFamily="Noto Sans CJK SC" fontSize="11" color="#6F6A60" fontStyle="BOLD" letterSpacing="1">带着这 5 个问题去签约</Text></Positioned><Positioned left="104" top="1138"><Text fontFamily="Noto Sans CJK SC" fontSize="11" color="#1F2A2E">— 押金退还条件写清了吗？</Text></Positioned><Positioned left="454" top="1138"><Text fontFamily="Noto Sans CJK SC" fontSize="11" color="#1F2A2E">— 转租成功还扣违约金吗？</Text></Positioned><Positioned left="804" top="1138"><Text fontFamily="Noto Sans CJK SC" fontSize="11" color="#1F2A2E">— 维修超时能否自行处理？</Text></Positioned><Positioned left="104" top="1182"><Text fontFamily="Noto Sans CJK SC" fontSize="11" color="#1F2A2E">— 涨幅是否封顶？</Text></Positioned><Positioned left="454" top="1182"><Text fontFamily="Noto Sans CJK SC" fontSize="11" color="#1F2A2E">— 转租书面同意多久答复？</Text></Positioned><Positioned left="80" top="1320"><Text fontFamily="Noto Sans CJK SC" fontSize="14" color="#B23A2E" fontStyle="BOLD">把“口头承诺”写进补充条款；签字前拍照留档。</Text></Positioned><Positioned left="80" top="1370" width="1080" height="240"><Container width="1080" height="240" color="#EFE7D6" borderRadius="12"/></Positioned><Positioned left="104" top="1390"><Text fontFamily="Noto Sans CJK SC" fontSize="11" color="#6F6A60" fontStyle="BOLD" letterSpacing="1">这张卡怎么算的</Text></Positioned><Positioned left="104" top="1422"><Text fontFamily="Noto Sans CJK SC" fontSize="12" color="#1F2A2E">入住现金 = 2 个月押金 + 3 个月租金 = 20,400。</Text></Positioned><Positioned left="104" top="1460"><Text fontFamily="Noto Sans CJK SC" fontSize="12" color="#1F2A2E">第二年 = 6,800 × 1.05 = 7,140。</Text></Positioned><Positioned left="104" top="1498"><Text fontFamily="Noto Sans CJK SC" fontSize="12" color="#1F2A2E">提前退租 = 1 个月租金 = 6,800。</Text></Positioned><Positioned left="104" top="1540"><Text fontFamily="Noto Sans CJK SC" fontSize="9" color="#6F6A60">以上为虚构条款；不构成法律建议，签约前请核对合同原件。</Text></Positioned><Positioned left="80" top="1650"><Text fontFamily="Noto Sans CJK SC" fontSize="9" color="#6F6A60">租约重构 07 / 10</Text></Positioned></Stack></Container></Snapshot>