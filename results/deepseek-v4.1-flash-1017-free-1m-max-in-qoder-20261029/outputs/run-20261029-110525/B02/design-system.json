{
  "schema_version": 1,
  "project": "缝补站 / Stitch",
  "colors": {
    "paper": "#F4EFE6",
    "ink": "#16211B",
    "green": "#1F4D3A",
    "terracotta": "#C2410C",
    "sand": "#E6DCCB",
    "mint": "#DCEFE3"
  },
  "type": {
    "display": "Noto Sans CJK SC Bold",
    "body": "Noto Sans CJK SC",
    "scale": {
      "poster_title": 48,
      "phone_title": 30,
      "body": 22,
      "meta": 16
    }
  },
  "motif": {
    "name": "stitch",
    "rule": "dashed line 12/9, 3px terracotta",
    "spool": "green ring + paper core",
    "use": [
      "identity",
      "poster",
      "record",
      "social",
      "loyalty"
    ]
  },
  "components": {
    "card": "paper/white, 14-18px radius, 1px sand border",
    "button": "green pill, white label",
    "badge": "mint fill, green text"
  },
  "rules": [
    "所有触点在左上使用 STITCH / 场景 标识",
    "日期与时间先于解释",
    "绿色只用于可执行动作与关键数字",
    "纸面用大数字，手机用单列"
