<Snapshot background="#F6F7FB" type="png"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT"><Container width="1200" height="1600" color="#F6F7FB"/>
<Positioned left="48" top="40"><Row crossAxisAlignment="CENTER"><Container padding="(6,14)" color="#2563EB" borderRadius="8"><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#FFFFFF" fontStyle="BOLD">PAGE 01 / 04</Text></Container><SizedBox width="12"/><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#2563EB" fontStyle="BOLD" letterSpacing="2">SNAPSHOT HANDBOOK / 从文字到图片</Text></Row></Positioned>
<Positioned left="48" top="86"><Text fontFamily="Noto Sans CJK SC" fontSize="44" color="#0B1220" fontStyle="BOLD">01 · 一次真实请求</Text></Positioned>
<Positioned left="48" top="150" width="1104" height="1"><Container width="1104" height="1" color="#CBD5E1"/></Positioned>
<Positioned left="48" top="186" width="620"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#334155">Snapshot 的入口只有一个：POST /snapshot。请求体是 UTF-8 纯文本 DSL，不是 JSON；成功响应是图片二进制，失败响应是带 code / message / requestId 的 JSON。</Text>
<SizedBox height="12"/>
<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#334155">先确认响应类型，再判断内容。语法错误先读 diagnostic 的 attributeName 与 position，不要只按 message 文案猜。</Text>
<SizedBox height="12"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">Content-Type: text/plain; charset=utf-8</Text></Expanded></Row>
<SizedBox height="6"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">成功：HTTP 200 + image/png</Text></Expanded></Row>
<SizedBox height="6"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">失败：400 PARSE_ERROR / 422；保留错误 JSON 与 X-Request-Id</Text></Expanded></Row>
<SizedBox height="6"/>
</Column></Positioned>
<Positioned left="720" top="186" width="432"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Container width="400" height="240" border="1 SOLID #CBD5E1">  <Container width="400" height="240" color="#0B1220" padding="24">
    <Column crossAxisAlignment="START" mainAxisSize="MIN">
      <Text color="#38BDF8" fontSize="16" fontStyle="BOLD">POST /snapshot</Text>
      <SizedBox height="8"/>
      <Text color="#F8FAFC" fontSize="28" fontStyle="BOLD">让文字变成图片</Text>
      <SizedBox height="6"/>
      <Text color="#94A3B8" fontSize="16">UTF-8 text → PNG bytes</Text>
      <SizedBox height="10"/>
      <Container padding="(4,10)" color="#1E293B" borderRadius="6">
        <Text color="#7DD3FC" fontSize="14">Content-Type: text/plain</Text>
      </Container>
    </Column>
  </Container></Container>
<SizedBox height="8"/>
<Text fontFamily="Noto Sans CJK SC" fontSize="18" color="#64748B">教学插图 · 与 example-01.png 同源 1:1（400×240）</Text>
</Column></Positioned>
<Positioned left="48" top="680"><Container width="1104" height="560" color="#0B1220" borderRadius="14" padding="16"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Row crossAxisAlignment="CENTER"><Container width="8" height="8" color="#F87171" shape="CIRCLE"/><SizedBox width="6"/><Container width="8" height="8" color="#FBBF24" shape="CIRCLE"/><SizedBox width="6"/><Container width="8" height="8" color="#34D399" shape="CIRCLE"/><SizedBox width="12"/><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#94A3B8" fontStyle="BOLD">example-01.snapshot · 完整印刷 · 15 行</Text></Row>
<SizedBox height="8"/>
