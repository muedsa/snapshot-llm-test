<Positioned left="48" top="40"><Row crossAxisAlignment="CENTER"><Container padding="(6,14)" color="#2563EB" borderRadius="8"><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#FFFFFF" fontStyle="BOLD">PAGE 03 / 04</Text></Container><SizedBox width="12"/><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#2563EB" fontStyle="BOLD" letterSpacing="2">SNAPSHOT HANDBOOK / 从文字到图片</Text></Row></Positioned>
<Positioned left="48" top="86"><Text fontFamily="Noto Sans CJK SC" fontSize="44" color="#0B1220" fontStyle="BOLD">03 · 文本保真</Text></Positioned>
<Positioned left="48" top="150" width="1104" height="1"><Container width="1104" height="1" color="#CBD5E1"/></Positioned>
<Positioned left="48" top="186" width="620"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#334155">Parser 不解码 HTML 实体。含尖括号或和号的文本放进 CDATA；Raw 保留首尾与连续空格，普通 Text 会 trim。</Text>
<SizedBox height="12"/>
<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#334155">8 位颜色是 #RRGGBBAA：最后两位是 alpha，不是旧的 #AARRGGBB。嵌套 Text 共享同一段落与基线。</Text>
<SizedBox height="12"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">CDATA 原样输出尖括号、和号与双空格</Text></Expanded></Row>
<SizedBox height="6"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">#RRGGBBAA：RRGGBB + alpha</Text></Expanded></Row>
<SizedBox height="6"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">空格保真用 Raw，不要用实体占位</Text></Expanded></Row>
<SizedBox height="6"/>
</Column></Positioned>
<Positioned left="720" top="186" width="432"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Container width="400" height="240" border="1 SOLID #CBD5E1">  <Container width="400" height="240" color="#0B1220" padding="24">
    <Column crossAxisAlignment="START" mainAxisSize="MIN">
      <Text fontSize="22" color="#F8FAFC">
        <Raw>状态 Status </Raw>
        <Text color="#34D399" fontStyle="BOLD">READY</Text>
        <Raw>  ·  </Raw>
        <Text color="#94A3B8">两空格被保留</Text>
      </Text>
      <SizedBox height="12"/>
      <Text fontSize="18" color="#E2E8F0"><![CDATA[A < B & C > D]]></Text>
      <SizedBox height="12"/>
      <Container width="160" height="28" color="#38BDF8AA" borderRadius="6" alignment="CENTER">
        <Text fontSize="14" color="#FFFFFF">#RRGGBBAA</Text>
      </Container>
    </Column>
  </Container></Container>
<SizedBox height="8"/>
<Text fontFamily="Noto Sans CJK SC" fontSize="18" color="#64748B">教学插图 · 与 example-03.png 同源 1:1（400×240）</Text>
</Column></Positioned>
