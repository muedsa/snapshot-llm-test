<Snapshot background="#F6F7FB" type="png"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT"><Container width="1200" height="1600" color="#F6F7FB"/>
<Positioned left="48" top="40"><Row crossAxisAlignment="CENTER"><Container padding="(6,14)" color="#2563EB" borderRadius="8"><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#FFFFFF" fontStyle="BOLD">PAGE 02 / 04</Text></Container><SizedBox width="12"/><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#2563EB" fontStyle="BOLD" letterSpacing="2">SNAPSHOT HANDBOOK / 从文字到图片</Text></Row></Positioned>
<Positioned left="48" top="86"><Text fontFamily="Noto Sans CJK SC" fontSize="44" color="#0B1220" fontStyle="BOLD">02 · 尺寸来自布局</Text></Positioned>
<Positioned left="48" top="150" width="1104" height="1"><Container width="1104" height="1" color="#CBD5E1"/></Positioned>
<Positioned left="48" top="186" width="620"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#334155">Snapshot 根没有 width/height；画布由根 Widget 的布局尺寸决定。给外层 Container 固定 400×240，再在内部组织布局。</Text>
<SizedBox height="12"/>
<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#334155">Row/Column 只有在主轴有界时，Expanded 才有“剩余空间”可分配；Stack + Positioned 负责叠放与角标，Positioned 必须是 Stack 的直接子节点。</Text>
<SizedBox height="12"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">有界主轴 → Expanded 才能工作</Text></Expanded></Row>
<SizedBox height="6"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">Positioned 的父级必须是 Stack / IndexedStack</Text></Expanded></Row>
<SizedBox height="6"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">根尺寸 = 根 Widget 的布局尺寸，不是 HTML 视口</Text></Expanded></Row>
<SizedBox height="6"/>
</Column></Positioned>
<Positioned left="720" top="186" width="432"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Container width="400" height="240" border="1 SOLID #CBD5E1">  <Container width="400" height="240" padding="20">
    <Row crossAxisAlignment="CENTER">
      <Expanded flex="2">
        <Container height="120" color="#2563EB" borderRadius="12" alignment="CENTER">
          <Text color="#FFFFFF" fontSize="18">Expanded ×2</Text>
        </Container>
      </Expanded>
      <SizedBox width="12"/>
      <Expanded flex="1">
        <Stack alignment="TOP_LEFT">
          <Container width="120" height="120" color="#F6B94A" borderRadius="12"/>
          <Positioned left="8" top="8">
            <Text color="#0B1220" fontSize="14">Stack</Text>
          </Positioned>
        </Stack>
      </Expanded>
    </Row>
  </Container></Container>
<SizedBox height="8"/>
<Text fontFamily="Noto Sans CJK SC" fontSize="18" color="#64748B">教学插图 · 与 example-02.png 同源 1:1（400×240）</Text>
</Column></Positioned>
<Positioned left="48" top="680"><Container width="1104" height="560" color="#0B1220" borderRadius="14" padding="16"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Row crossAxisAlignment="CENTER"><Container width="8" height="8" color="#F87171" shape="CIRCLE"/><SizedBox width="6"/><Container width="8" height="8" color="#FBBF24" shape="CIRCLE"/><SizedBox width="6"/><Container width="8" height="8" color="#34D399" shape="CIRCLE"/><SizedBox width="12"/><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#94A3B8" fontStyle="BOLD">example-02.snapshot · 印刷 1–18 行 · 省略 19–20 行闭合</Text></Row>
<SizedBox height="8"/>
