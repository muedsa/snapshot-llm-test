<Snapshot background="#F6F7FB" type="png"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT"><Container width="1200" height="1600" color="#F6F7FB"/>
<Positioned left="48" top="40"><Row crossAxisAlignment="CENTER"><Container padding="(6,14)" color="#2563EB" borderRadius="8"><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#FFFFFF" fontStyle="BOLD">PAGE 04 / 04</Text></Container><SizedBox width="12"/><Text fontFamily="Noto Sans CJK SC" fontSize="16" color="#2563EB" fontStyle="BOLD" letterSpacing="2">SNAPSHOT HANDBOOK / 从文字到图片</Text></Row></Positioned>
<Positioned left="48" top="86"><Text fontFamily="Noto Sans CJK SC" fontSize="44" color="#0B1220" fontStyle="BOLD">04 · 滤镜与交付</Text></Positioned>
<Positioned left="48" top="150" width="1104" height="1"><Container width="1104" height="1" color="#CBD5E1"/></Positioned>
<Positioned left="48" top="186" width="620"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#334155">BackdropFilter 读取已绘制的背景并模糊，文字要画在滤镜之后；ImageFiltered 模糊整个子树，文字会一起变糊。两者都需要 ClipRect / ClipRRect 限定范围。</Text>
<SizedBox height="12"/>
<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#334155">交付不是“请求成功”：要打开最终 PNG，保留同名 DSL、真实响应与失败记录，并能在同一服务上复现。</Text>
<SizedBox height="12"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">背景模糊：BackdropFilter + ClipRRect</Text></Expanded></Row>
<SizedBox height="6"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">子树模糊：ImageFiltered（文字会一起糊）</Text></Expanded></Row>
<SizedBox height="6"/>
<Row crossAxisAlignment="START"><Container width="7" height="7" color="#2563EB" shape="CIRCLE" margin="(0,10,10,0)"/><Expanded><Text fontFamily="Noto Sans CJK SC" fontSize="22" color="#0B1220">交付：最终图 + DSL + 请求/失败记录</Text></Expanded></Row>
<SizedBox height="6"/>
</Column></Positioned>
<Positioned left="720" top="186" width="432"><Column crossAxisAlignment="START" mainAxisSize="MIN">
<Container width="400" height="240" border="1 SOLID #CBD5E1">  <Container width="400" height="240" color="#FFF3D6">
    <Stack alignment="TOP_LEFT">
      <Container width="400" height="240" color="#FFF3D6"/>
      <Container width="400" height="40" color="#F6B94A"/>
      <Container width="400" height="40" color="#38BDF8" margin="(0,90,0,0)"/>
      <Positioned left="70" top="40" width="260" height="160">
        <ClipRRect borderRadius="20">
          <Stack alignment="TOP_LEFT">
            <BackdropFilter sigmaX="6" sigmaY="6">
              <Container width="260" height="160" color="#0B122066"/>
            </BackdropFilter>
            <Container width="260" height="160" border="1 SOLID #FFFFFF55" borderRadius="20"/>
            <Positioned left="0" top="56" width="260">
              <Container width="260" alignment="CENTER">
                <Text color="#FFFFFF" fontSize="22" fontStyle="BOLD">SHARP / BLUR</Text>
              </Container>
            </Positioned>
          </Stack>
        </ClipRRect>
      </Positioned>
    </Stack>
  </Container></Container>
<SizedBox height="8"/>
<Text fontFamily="Noto Sans CJK SC" fontSize="18" color="#64748B">教学插图 · 与 example-04.png 同源 1:1（400×240）</Text>
</Column></Positioned>
