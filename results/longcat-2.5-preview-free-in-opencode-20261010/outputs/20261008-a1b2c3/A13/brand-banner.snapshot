<Snapshot background="#0F172A" type="png">
  <Container width="1200" height="400" padding="(32,48)">
    <Row crossAxisAlignment="CENTER">
      <!-- 图标 -->
      <Stack width="200" height="200">
        <Positioned left="0" top="0" width="80" height="80">
          <Container width="80" height="80" color="#3B82F6" borderRadius="8"/>
        </Positioned>
        <Positioned left="20" top="20" width="80" height="80">
          <Container width="80" height="80" color="#8B5CF6" borderRadius="8"/>
        </Positioned>
        <Positioned left="40" top="40" width="40" height="40">
          <Container width="40" height="40" color="#EC4899" borderRadius="20"/>
        </Positioned>
      </Stack>
      <SizedBox width="32"/>
      <!-- 文字 -->
      <Column crossAxisAlignment="START">
        <Text color="#F1F5F9" fontSize="48" fontStyle="BOLD">叠光 Layerlight</Text>
        <Text color="#94A3B8" fontSize="24">把复杂信息，组织成清晰画面</Text>
      </Column>
    </Row>
  </Container>
</Snapshot>