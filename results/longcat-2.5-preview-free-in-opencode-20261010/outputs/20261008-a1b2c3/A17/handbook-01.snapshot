<Snapshot background="#FFFFFF" type="png">
  <Container width="1200" height="1600" padding="(48,48)">
    <Column crossAxisAlignment="START">
      <Text color="#1E293B" fontSize="32" fontStyle="BOLD">第1页：真实调用契约</Text>
      <SizedBox height="24"/>
      <Text color="#64748B" fontSize="24">Snapshot DSL是一种声明式图片描述语言，通过POST请求发送到服务。</Text>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="24">请求体是UTF-8纯文本，不是JSON。</Text>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="24">成功时响应体是图片二进制（PNG/JPEG/WebP）。</Text>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="24">错误时返回JSON，包含code、message、requestId。</Text>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="24">常见错误：400 PARSE_ERROR、413 REQUEST_TOO_LARGE、401未授权、429限流。</Text>
      <SizedBox height="12"/>
      <SizedBox height="24"/>
      <Text color="#1E293B" fontSize="24" fontStyle="BOLD">示例：基本调用契约</Text>
      <SizedBox height="12"/>
      <Container width="400" height="240" background="#F8FAFC" borderRadius="8" border="1 SOLID #E2E8F0"/>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="20">完整示例见 example-01.png</Text>
    </Column>
  </Container>
</Snapshot>