<Snapshot background="#FFFFFF" type="png">
  <Container width="1200" height="1600" padding="(48,48)">
    <Column crossAxisAlignment="START">
      <Text color="#1E293B" fontSize="32" fontStyle="BOLD">第2页：布局基础</Text>
      <SizedBox height="24"/>
      <Text color="#64748B" fontSize="24">根节点是<Snapshot>，必须指定width和height。</Text>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="24">Container可以设置width、height、color、padding等属性。</Text>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="24">Row横向排列子元素，Column纵向排列子元素。</Text>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="24">Expanded在Flex中占据剩余空间。</Text>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="24">Stack允许子元素重叠，Positioned定位子元素。</Text>
      <SizedBox height="12"/>
      <SizedBox height="24"/>
      <Text color="#1E293B" fontSize="24" fontStyle="BOLD">示例：Row与Column布局</Text>
      <SizedBox height="12"/>
      <Container width="400" height="240" background="#F8FAFC" borderRadius="8" border="1 SOLID #E2E8F0"/>
      <SizedBox height="12"/>
      <Text color="#64748B" fontSize="20">完整示例见 example-02.png</Text>
    </Column>
  </Container>
</Snapshot>