<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#FFFFFF" textAlign="LEFT" fontStyle="BOLD" width="1056"><Raw><![CDATA[核心示例 · 1:1 直接绘制]]></Raw></Text>
</Positioned>
<Positioned left="56" top="326" width="1088" height="70">
<Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#334155" textAlign="LEFT" fontStyle="NORMAL" width="1088"><Raw><![CDATA[根尺寸来自布局。Row/Column 管理主轴与交叉轴；Expanded 必须是 Flex 直接子级；Positioned 必须是 Stack 直接子级。]]></Raw></Text>
</Positioned>
<Positioned left="384" top="364">
<Container width="432" height="272" color="#FFFFFF" borderRadius="20" border="1 SOLID #CBD5E1" clipBehavior="ANTI_ALIAS">

</Container>
</Positioned>
<Positioned left="400" top="380" width="400" height="240">
<!-- CORE-BEGIN -->
<Container width="400" height="240" color="#F8FAFC">
  <Stack clipBehavior="NONE">
    <Positioned left="0" top="0" width="400" height="240">
      <Container width="400" height="240" color="#E0E7FF">
        <Row padding="24" crossAxisAlignment="CENTER">
          <Container width="104" height="72" color="#4F46E5" borderRadius="12" alignment="CENTER">
            <Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#FFFFFF">固定</Text>
          </Container>
          <SizedBox width="12" />
          <Expanded>
            <Container height="72" color="#FFFFFF" borderRadius="12" alignment="CENTER">
              <Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#3730A3">Expanded 占满剩余宽度</Text>
            </Container>
          </Expanded>
        </Row>
      </Container>
    </Positioned>
    <Positioned left="252" top="150" width="120" height="60">
      <Container width="120" height="60" color="#F97316" borderRadius="12" alignment="CENTER">
        <Text fontFamily="Noto Sans CJK SC" fontSize="24" color="#FFFFFF">Stack 定位</Text>
      </Container>
    </Positioned>
  </Stack>
</Container>
<!-- CORE-END -->
</Positioned>
