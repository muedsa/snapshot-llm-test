{
  "schema_version": 1,
  "task_id": "A12",
  "path_base": "output_dir",
  "colors": {
    "paper": "#F5F7FC",
    "surface": "#FFFFFF",
    "ink": "#172033",
    "muted": "#59677D",
    "primary": "#3049A8",
    "accent": "#18A999",
    "soft": "#E9EDFA",
    "line": "#D7DFEA"
  },
  "typography": {
    "family": "Noto Sans CJK SC",
    "by_canvas": {
      "mobile": {
        "font_family": "Noto Sans CJK SC",
        "title": 40,
        "body_min": 16,
        "card_title_min": 18
      },
      "tablet": {
        "font_family": "Noto Sans CJK SC",
        "title": 64,
        "body_min": 20,
        "card_title_min": 24
      },
      "desktop": {
        "font_family": "Noto Sans CJK SC",
        "title": 64,
        "body_min": 20,
        "card_title_min": 28
      },
      "stage": {
        "font_family": "Noto Sans CJK SC",
        "title": 72,
        "body_min": 24,
        "card_title_min": 32
      }
    },
    "rules": "mobile body>=16/card title>=18; other body>=20; main title>=40"
  },
  "spacing": {
    "safe_margin_px": {
      "mobile": 16,
      "tablet": 32,
      "desktop": 64,
      "stage": 64
    },
    "card_gap_px": {
      "mobile": 6,
      "tablet": 20,
      "desktop": 20,
      "stage": 22
    },
    "corner_radius_px": {
      "card": 16,
      "cta": 14
    }
  },
  "components": [
    {
      "id": "layered-motif",
      "rule": "three offset 62px square outlines; identical order/colors; scale and reposition only"
    },
    {
      "id": "content-card",
      "rule": "surface, 16px radius, 34x6 accent bar, title then detail; mobile one column, tablet/desktop two, stage three"
    },
    {
      "id": "event-cta",
      "rule": "primary filled rounded rectangle with complete CTA text; never a QR code"
    },
    {
      "id": "independent_layouts",
      "rule": {
        "mobile": "single column compact hero + six stacked cards",
        "tablet": "wide hero + 2x3 grid",
        "desktop": "left hero + 2x3 grid",
        "stage": "left hero + 3x2 grid"
      }
    }
  ]
}
