<!DOCTYPE html><html lang="zh-CN" dir="ltr" data-theme="dark" data-has-toc data-has-sidebar class="astro-7jrn6cqt"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>TextStyle 与文本装饰 | Snapshot</title><link rel="canonical" href="https://snapshot.muedsa.com/reference/text-style/"/><link rel="sitemap" href="/sitemap-index.xml"/><link rel="shortcut icon" href="/logo_mark_mono.png" type="image/png"/><meta name="generator" content="Astro v7.3.3"/><meta name="generator" content="Starlight v0.42.2"/><meta property="og:title" content="TextStyle 与文本装饰"/><meta property="og:type" content="article"/><meta property="og:url" content="https://snapshot.muedsa.com/reference/text-style/"/><meta property="og:locale" content="zh-CN"/><meta property="og:description" content="完整的文本样式参数、继承规则、画笔优先级、字体与装饰线配置。"/><meta property="og:site_name" content="Snapshot"/><meta name="twitter:card" content="summary_large_image"/><meta name="description" content="完整的文本样式参数、继承规则、画笔优先级、字体与装饰线配置。"/><!--
  Starlight 在服务端输出时默认把页面标记为深色，再由客户端脚本读取主题。
  这里在主题确定前隐藏正文，并让空白底色跟随系统主题，避免首屏出现深色闪烁。
--><style>
  html:not([data-theme-ready]) {
    color-scheme: light dark;
    background-color: Canvas;
  }

  html:not([data-theme-ready]) body {
    visibility: hidden;
  }
</style><script data-cfasync="false">
  window.StarlightThemeProvider = (() => {
    let storedTheme = null;

    try {
      storedTheme = localStorage.getItem('starlight-theme');
    } catch {
      // 浏览器禁用存储时，继续使用系统主题。
    }

    const preferredTheme =
      storedTheme === 'light' || storedTheme === 'dark'
        ? storedTheme
        : window.matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark';

    document.documentElement.dataset.theme = preferredTheme;
    document.documentElement.dataset.themeReady = '';

    return {
      updatePickers(theme = storedTheme || 'auto') {
        document.querySelectorAll('starlight-theme-select').forEach((picker) => {
          const select = picker.querySelector('select');
          if (select) select.value = theme;

          const template = document.querySelector('#theme-icons');
          const newIcon = template?.content.querySelector(`.${theme}`);
          if (!newIcon) return;

          const oldIcon = picker.querySelector('svg.label-icon');
          oldIcon?.replaceChildren(...newIcon.cloneNode(true).childNodes);
        });
      },
    };
  })();
</script><template id="theme-icons"><svg aria-hidden="true" class="light astro-tynuvajn" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1em;"><path d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z"/></svg><svg aria-hidden="true" class="dark astro-tynuvajn" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1em;"><path d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z"/></svg><svg aria-hidden="true" class="auto astro-tynuvajn" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1em;"><path d="M21 14h-1V7a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v7H3a1 1 0 0 0-1 1v2a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3v-2a1 1 0 0 0-1-1ZM6 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v7H6V7Zm14 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1h16v1Z"/></svg></template><link rel="stylesheet" href="/_astro/print.ehPL0gv-.css" media="print"><link rel="stylesheet" href="/_astro/middleware.CuJQ4K0R.css"><style>@layer starlight.content{.sl-markdown-content .sl-heading-wrapper{--sl-anchor-icon-size:.8275em;--sl-anchor-icon-gap:.25em;--sl-anchor-icon-space:calc(var(--sl-anchor-icon-size) + var(--sl-anchor-icon-gap));