</script></div></div></div></sl-sidebar-pane></nav><div class="main-frame astro-gqodpq4l"><script data-cfasync="false" type="module">var e=document.getElementById(`starlight__sidebar`),t=e?.querySelector(`sl-sidebar-state-persist`),n=`sl-sidebar-state`,r=()=>{let r=[],i=t?.dataset.hash||``;try{let e=sessionStorage.getItem(n),t=JSON.parse(e||`{}`);Array.isArray(t.open)&&t.hash===i&&(r=t.open)}catch{}return{hash:i,open:r,scroll:e?.scrollTop||0}},i=e=>{try{sessionStorage.setItem(n,JSON.stringify(e))}catch{}},a=()=>i(r()),o=(e,t)=>{let n=r();n.open[t]=e,i(n)};t?.addEventListener(`click`,e=>{if(!(e.target instanceof Element))return;let t=e.target.closest(`summary`)?.closest(`details`);if(!t)return;let n=t.querySelector(`sl-sidebar-restore`),r=parseInt(n?.dataset.index||``);isNaN(r)||o(!t.open,r)}),addEventListener(`visibilitychange`,()=>{document.visibilityState===`hidden`&&a()});</script><div class="lg:sl-flex astro-aak7uwzb"><aside class="right-sidebar-container print:hidden astro-aak7uwzb"><div class="right-sidebar astro-aak7uwzb"><div class="lg:sl-hidden astro-7eumgze2"><mobile-starlight-toc data-min-h="2" data-max-h="3" class="astro-4feugyic"><nav aria-labelledby="starlight__on-this-page--mobile" class="astro-4feugyic"><details id="starlight__mobile-toc" class="astro-4feugyic"><summary id="starlight__on-this-page--mobile" class="sl-flex astro-4feugyic"><span class="toggle sl-flex astro-4feugyic">本页内容<svg aria-hidden="true" class="caret astro-4feugyic astro-tynuvajn" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1rem;"><path d="m14.83 11.29-4.24-4.24a1 1 0 1 0-1.42 1.41L12.71 12l-3.54 3.54a1 1 0 0 0 0 1.41 1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.24-4.24a1.002 1.002 0 0 0 0-1.42Z"/></svg></span><span class="display-current astro-4feugyic"></span></summary><div class="dropdown astro-4feugyic"><ul class="isMobile astro-ng4v3drd" style="--depth: 0;"><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#_top" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">概述</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#默认值与继承" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">默认值与继承</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#字体与度量参数" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">字体与度量参数</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#颜色画笔与装饰参数" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">颜色、画笔与装饰参数</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#decorationstyle" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">DecorationStyle</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#shadow-文本阴影" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">Shadow 文本阴影</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#fontfeature-字体特性" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">FontFeature 字体特性</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#样式继承示例" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">样式继承示例</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#字体与资源" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">字体与资源</span></a></li></ul></div></details></nav></mobile-starlight-toc><script data-cfasync="false" type="module" src="/_astro/MobileTableOfContents.astro_astro_type_script_index_0_lang.BcSo_yiZ.js"></script></div><div class="right-sidebar-panel sl-hidden lg:sl-block astro-7eumgze2"><div class="sl-container astro-7eumgze2"><starlight-toc data-min-h="2" data-max-h="3"><nav aria-labelledby="starlight__on-this-page"><h2 id="starlight__on-this-page">本页内容</h2><ul class="astro-ng4v3drd" style="--depth: 0;"><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#_top" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">概述</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#默认值与继承" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">默认值与继承</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#字体与度量参数" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">字体与度量参数</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#颜色画笔与装饰参数" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">颜色、画笔与装饰参数</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#decorationstyle" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">DecorationStyle</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#shadow-文本阴影" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">Shadow 文本阴影</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#fontfeature-字体特性" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">FontFeature 字体特性</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#样式继承示例" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">样式继承示例</span></a></li><li style="--depth: 0;" class="astro-ng4v3drd"><a href="#字体与资源" style="--depth: 0;" class="astro-ng4v3drd"><span style="--depth: 0;" class="astro-ng4v3drd">字体与资源</span></a></li></ul></nav></starlight-toc><script data-cfasync="false" type="module" src="/_astro/TableOfContents.astro_astro_type_script_index_0_lang.Csloo1VZ.js"></script></div></div></div></aside><div class="main-pane astro-aak7uwzb"><main data-pagefind-body class="astro-7jrn6cqt" lang="zh-CN" dir="ltr"><div class="content-panel astro-vdatg63d"><div class="sl-container astro-vdatg63d"><h1 id="_top" class="astro-grsobg4o">TextStyle 与文本装饰</h1></div></div><div class="content-panel astro-vdatg63d"><div class="sl-container astro-vdatg63d"><div class="sl-markdown-content"><article><p><code>com.muedsa.snapshot.paint.text.TextStyle</code> 用于 Text、TextSpan 和 WidgetSpan。它描述字形样式，不负责整段的换行、最大行数或对齐；这些行为见<a href="/reference/text-layout/">段落与行高</a>。Parser 写法见<a href="/reference/parser-text/">文本属性详解</a>。</p><div class="sl-heading-wrapper level-h2"><h2 id="默认值与继承" __collectHeading="true">默认值与继承</h2><a class="sl-anchor-link" href="#默认值与继承"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “默认值与继承”</span></a></div><p>全部 19 个构造参数的声明默认值都是 <code>null</code>：表示不覆盖祖先同名字段，<strong>不是清除样式</strong>。根节点最后与 Snapshot 的默认样式合并：黑色、字号 <code>14f</code>；其余未指定项交给 Skia。字体最终取决于运行环境。</p><p>合并以字段为单位。<code>foreground</code>、<code>decorationStyle</code>、<code>shadows</code> 等对象或列表整体继承/替换，不逐项合并。要清除祖先阴影或字体特性，使用 <code>emptyList()</code>；取消装饰线使用 <code>DecorationStyle.NONE</code>。不能用 <code>foreground = null</code> 清除祖先画笔，需要调整 Span 层级或显式提供替代画笔。</p><div class="sl-heading-wrapper level-h2"><h2 id="字体与度量参数" __collectHeading="true">字体与度量参数</h2><a class="sl-anchor-link" href="#字体与度量参数"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “字体与度量参数”</span></a></div><p>下表的“范围”是推荐的有效输入；TextStyle 自身并不统一校验这些数值，不能把未报错当作有效。</p><table><thead><tr><th>参数</th><th>Kotlin 类型</th><th>含义、单位与使用限制</th></tr></thead><tbody><tr><td><code>fontSize</code></td><td><code>Float?</code></td><td>字号，逻辑像素；使用有限正数。根回退为 14</td></tr><tr><td><code>fontFamilies</code></td><td><code>List&lt;String&gt;?</code></td><td>按顺序请求字体族，如 <code>listOf(&quot;Noto Sans SC&quot;, &quot;Arial&quot;)</code>；不会下载字体</td></tr><tr><td><code>fontStyle</code></td><td><code>FontStyle?</code></td><td>字重、宽度和倾斜；常用 <code>NORMAL</code>、<code>BOLD</code>、<code>ITALIC</code>、<code>BOLD_ITALIC</code></td></tr><tr><td><code>typeface</code></td><td><code>Typeface?</code></td><td>直接提供 Skia 字体对象；Parser 不开放此项。需在绘制完成前保持对象有效</td></tr><tr><td><code>height</code></td><td><code>Float?</code></td><td>行高倍数，不是像素高度；例如字号 20、height 1.5。未覆盖时按字体度量；最终行高还受同行其他样式和 Strut 影响</td></tr><tr><td><code>topRatio</code></td><td><code>Float?</code></td><td>ascent 占 ascent + descent 的比例；<code>0..1</code> 指定比例，<code>-1</code> 按字体上升/下降度量分配。<code>0.5f</code> 为上下均分；不是平移文字</td></tr><tr><td><code>letterSpacing</code></td><td><code>Float?</code></td><td>额外字距，逻辑像素；有限值，负值会使字形靠近</td></tr><tr><td><code>wordSpacing</code></td><td><code>Float?</code></td><td>额外词间距，逻辑像素；不是中文字符之间的统一间距</td></tr><tr><td><code>locale</code></td><td><code>String?</code></td><td>语言区域，如 <code>&quot;zh-CN&quot;</code>；影响字体塑形/选择，不做文本翻译</td></tr><tr><td><code>baselineMode</code></td><td><code>BaselineMode?</code></td><td><code>ALPHABETIC</code> 或 <code>IDEOGRAPHIC</code>；不要与行内 Widget 的 <code>baseline</code> 参数混淆</td></tr></tbody></table><div class="sl-heading-wrapper level-h2"><h2 id="颜色画笔与装饰参数" __collectHeading="true">颜色、画笔与装饰参数</h2><a class="sl-anchor-link" href="#颜色画笔与装饰参数"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “颜色、画笔与装饰参数”</span></a></div><table><thead><tr><th>参数</th><th>Kotlin 类型</th><th>含义与组合规则</th></tr></thead><tbody><tr><td><code>color</code></td><td><code>Int?</code></td><td>ARGB 字体颜色；根回退为黑色。存在前景画笔时，由画笔绘制字形</td></tr><tr><td><code>foreground</code></td><td><code>Paint?</code></td><td>字形画笔，可设置填充、描边等；优先于普通 <code>color</code></td></tr><tr><td><code>background</code></td><td><code>Paint?</code></td><td>文本运行区域的背景，不等同于给整个 Text 布局盒设置背景</td></tr><tr><td><code>decorationStyle</code></td><td><code>DecorationStyle?</code></td><td>下划线、上划线、删除线及其颜色、线型与粗细，见下节</td></tr><tr><td><code>shadows</code></td><td><code>List&lt;Shadow&gt;?</code></td><td><code>org.jetbrains.skia.paragraph.Shadow</code> 列表；偏移为逻辑像素，模糊值为 sigma；空列表取消继承</td></tr><tr><td><code>fontFeatures</code></td><td><code>List&lt;FontFeature&gt;?</code></td><td>OpenType 特性，如连字、等宽数字；字体必须实际支持，空列表取消继承</td></tr><tr><td><code>fontEdging</code></td><td><code>FontEdging?</code></td><td><code>ALIAS</code>、<code>ANTI_ALIAS</code>、<code>SUBPIXEL_ANTI_ALIAS</code>，字形边缘栅格化方式</td></tr><tr><td><code>fontHinting</code></td><td><code>FontHinting?</code></td><td><code>NONE</code>、<code>SLIGHT</code>、<code>NORMAL</code>、<code>FULL</code>，字体微调强度</td></tr><tr><td><code>subpixel</code></td><td><code>Boolean?</code></td><td>是否允许子像素字形定位；与 <code>fontEdging</code> 的边缘抗锯齿不是同一个选项</td></tr></tbody></table><div class="sl-heading-wrapper level-h2"><h2 id="decorationstyle" __collectHeading="true">DecorationStyle</h2><a class="sl-anchor-link" href="#decorationstyle"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “DecorationStyle”</span></a></div><p>类型来自 <code>org.jetbrains.skia.paragraph</code>。完整构造参数如下；直接调用构造函数时全部必填。更便捷的入口是从 <code>DecorationStyle.NONE</code> 调用 <code>withUnderline(true)</code>、<code>withColor(...)</code> 等方法。</p><table><thead><tr><th>参数</th><th>类型</th><th>含义</th></tr></thead><tbody><tr><td><code>_underline</code></td><td><code>Boolean</code></td><td>下划线</td></tr><tr><td><code>_overline</code></td><td><code>Boolean</code></td><td>上划线</td></tr><tr><td><code>_lineThrough</code></td><td><code>Boolean</code></td><td>删除线；三种线可组合</td></tr><tr><td><code>_gaps</code></td><td><code>Boolean</code></td><td>是否避让字形；NONE 中为 true</td></tr><tr><td><code>color</code></td><td><code>Int</code></td><td>ARGB 装饰线颜色；NONE 中为黑色，不是自动继承字色</td></tr><tr><td><code>lineStyle</code></td><td><code>DecorationLineStyle</code></td><td><code>SOLID</code>、<code>DOUBLE</code>、<code>DOTTED</code>、<code>DASHED</code>、<code>WAVY</code></td></tr><tr><td><code>thicknessMultiplier</code></td><td><code>Float</code></td><td>相对字体装饰线粗细的倍数，推荐有限正数；不是像素线宽</td></tr></tbody></table><div class="sl-heading-wrapper level-h2"><h2 id="shadow-文本阴影" __collectHeading="true">Shadow 文本阴影</h2><a class="sl-anchor-link" href="#shadow-文本阴影"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “Shadow 文本阴影”</span></a></div><p><code>org.jetbrains.skia.paragraph.Shadow</code> 的四个参数全部必填；它与 BoxShadow 不是同一种配置：</p><table><thead><tr><th>参数</th><th>类型</th><th>含义</th></tr></thead><tbody><tr><td><code>color</code></td><td><code>Int</code></td><td>ARGB 阴影颜色</td></tr><tr><td><code>offsetX</code> / <code>offsetY</code></td><td><code>Float</code></td><td>有限逻辑像素偏移，正值向右 / 向下</td></tr><tr><td><code>blurSigma</code></td><td><code>Double</code></td><td>有限非负高斯 sigma；注意 Kotlin 使用 Double，如 <code>2.0</code>，不是 <code>2f</code></td></tr></tbody></table><p>例如 <code>shadows = listOf(Shadow(0x66000000, 2f, 3f, 2.0))</code>。也可用 <code>Shadow(color, offset: Point, blurSigma)</code> 重载。多个阴影按列表配置，空列表清除继承；阴影不为文字额外预留布局空间，需要外层留白。</p><div class="sl-heading-wrapper level-h2"><h2 id="fontfeature-字体特性" __collectHeading="true">FontFeature 字体特性</h2><a class="sl-anchor-link" href="#fontfeature-字体特性"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “FontFeature 字体特性”</span></a></div><p>类型是 <code>org.jetbrains.skia.FontFeature</code>。常用构造是 <code>FontFeature(&quot;tnum&quot;, true)</code> 或 <code>FontFeature(&quot;kern&quot;, 0)</code>；只传 <code>FontFeature(&quot;liga&quot;)</code> 时 value 为 1。它们分别请求等宽数字、关闭字偶距和启用连字，字体不支持时不保证产生变化。</p><table><thead><tr><th>参数</th><th>类型</th><th>含义</th></tr></thead><tbody><tr><td><code>feature</code></td><td><code>String</code></td><td>四字符 OpenType 标签，如 liga、kern、tnum；底层构造也接收四字节标签整数 <code>_tag</code></td></tr><tr><td><code>value</code></td><td><code>Int</code> 或便捷重载的 <code>Boolean</code></td><td>0 关闭、1 开启；其他非负值含义由特性定义</td></tr><tr><td><code>start</code> / <code>end</code></td><td><code>UInt</code></td><td>四参数重载中的范围；省略范围的重载使用 GLOBAL_START=0u、GLOBAL_END=UInt.MAX_VALUE</td></tr></tbody></table><aside aria-label="范围语法不等于段落范围生效" class="starlight-aside starlight-aside--caution"><p class="starlight-aside__title" aria-hidden="true"><svg aria-hidden="true" class="starlight-aside__icon astro-tynuvajn" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1em;"><path d="M12 16a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm10.67 1.47-8.05-14a3 3 0 0 0-5.24 0l-8 14A3 3 0 0 0 3.94 22h16.12a3 3 0 0 0 2.61-4.53Zm-1.73 2a1 1 0 0 1-.88.51H3.94a1 1 0 0 1-.88-.51 1 1 0 0 1 0-1l8-14a1 1 0 0 1 1.78 0l8.05 14a1 1 0 0 1 .05 1.02v-.02ZM12 8a1 1 0 0 0-1 1v4a1 1 0 0 0 2 0V9a1 1 0 0 0-1-1Z"/></svg>范围语法不等于段落范围生效</p><div class="starlight-aside__content"><p>Parser 可解析 <code>smcp[2:8]</code> 并校验起止顺序，但当前 Skiko 的 TextStyle.addFontFeature 只把 tag 和 value 交给段落，未传递 start/end。需要只作用于一段文字时，应拆成不同 TextSpan 并分别设置 fontFeatures，不要依赖范围字段裁定生效位置。</p></div></aside><p>例如 <code>fontFeatures = listOf(FontFeature(&quot;tnum&quot;, true))</code>；空列表清除继承的特性。Kotlin 使用的构造类型、Parser 接受的字符串语法和底层排版效果应分别判断。</p><div class="sl-heading-wrapper level-h2"><h2 id="样式继承示例" __collectHeading="true">样式继承示例</h2><a class="sl-anchor-link" href="#样式继承示例"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “样式继承示例”</span></a></div><p>以下是 <code>SnapshotPNG { … }</code> 内的组件片段。需要 <code>com.muedsa.snapshot.widget.*</code>、<code>com.muedsa.snapshot.widget.text.*</code>、<code>com.muedsa.snapshot.paint.text.*</code> 与 <code>org.jetbrains.skia.paragraph.DecorationStyle</code>。</p><div class="expressive-code"><link rel="stylesheet" href="/_astro/ec.w36nc.css"><script data-cfasync="false" type="module" src="/_astro/ec.0vx5m.js"></script><figure class="frame not-content"><figcaption class="header"></figcaption><pre data-language="kotlin"><code><div class="ec-line"><div class="code"><span style="--0:#82AAFF;--1:#3B61B0">Container</span><span style="--0:#D6DEEB;--1:#403F53">(width </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">420f</span><span style="--0:#D6DEEB;--1:#403F53">, padding </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> com.muedsa.geometry.EdgeInsets.</span><span style="--0:#82AAFF;--1:#3B61B0">all</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#F78C6C;--1:#AA0982">24f</span><span style="--0:#D6DEEB;--1:#403F53">)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">    </span><span style="--0:#82AAFF;--1:#3B61B0">RichText</span><span style="--0:#D6DEEB;--1:#403F53"> {</span></div></div><div class="ec-line"><div class="code"><span class="indent">        </span><span style="--0:#82AAFF;--1:#3B61B0">TextSpan</span><span style="--0:#D6DEEB;--1:#403F53">(style </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">TextStyle</span><span style="--0:#D6DEEB;--1:#403F53">(</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">            </span></span><span style="--0:#D6DEEB;--1:#403F53">fontSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">24f</span><span style="--0:#D6DEEB;--1:#403F53">,</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">            </span></span><span style="--0:#D6DEEB;--1:#403F53">color </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">0xFF0369A1</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">(),</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">            </span></span><span style="--0:#D6DEEB;--1:#403F53">decorationStyle </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> DecorationStyle.NONE.</span><span style="--0:#82AAFF;--1:#3B61B0">withUnderline</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#FF6A83;--1:#A24848">true</span><span style="--0:#D6DEEB;--1:#403F53">),</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">        </span></span><span style="--0:#D6DEEB;--1:#403F53">)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">            </span><span style="--0:#82AAFF;--1:#3B61B0">TextSpan</span><span style="--0:#D6DEEB;--1:#403F53">(text </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#ECC48D;--1:#984E4D">"继承下划线 "</span><span style="--0:#D6DEEB;--1:#403F53">)</span></div></div><div class="ec-line"><div class="code"><span class="indent">            </span><span style="--0:#82AAFF;--1:#3B61B0">TextSpan</span><span style="--0:#D6DEEB;--1:#403F53">(text </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#ECC48D;--1:#984E4D">"取消装饰"</span><span style="--0:#D6DEEB;--1:#403F53">, style </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">TextStyle</span><span style="--0:#D6DEEB;--1:#403F53">(</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                </span></span><span style="--0:#D6DEEB;--1:#403F53">decorationStyle </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> DecorationStyle.NONE,</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">            </span></span><span style="--0:#D6DEEB;--1:#403F53">))</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">        </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div></code></pre><div class="copy"><div aria-live="polite"></div><button title="复制到剪贴板" data-copied="复制成功！" data-code="Container(width = 420f, padding = com.muedsa.geometry.EdgeInsets.all(24f)) {    RichText {        TextSpan(style = TextStyle(            fontSize = 24f,            color = 0xFF0369A1.toInt(),            decorationStyle = DecorationStyle.NONE.withUnderline(true),        )) {            TextSpan(text = &#x22;继承下划线 &#x22;)            TextSpan(text = &#x22;取消装饰&#x22;, style = TextStyle(                decorationStyle = DecorationStyle.NONE,            ))        }    }}"><div></div></button></div></figure></div><div class="sl-heading-wrapper level-h2"><h2 id="字体与资源" __collectHeading="true">字体与资源</h2><a class="sl-anchor-link" href="#字体与资源"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “字体与资源”</span></a></div><p>在服务端、容器或 CI 安装字体后，按它的实际族名配置 <code>fontFamilies</code>。浏览器网页使用的字体不会自动进入服务端渲染。若使用字体文件，可通过 <code>Typeface.makeFromFile(...)</code> 创建字体对象并赋给 <code>typeface</code>，在整个布局与绘制过程结束后再释放；不要在构建 TextStyle 后立即关闭仍要使用的 Paint / Typeface。</p><p>涉及换行、字号或字体变化时重新构建并布局；不要依赖已缓存的段落自动感知可变样式。需要跨机器一致的图片，还应固定字体文件、Skiko runtime 和输出环境。</p></article></div><footer class="sl-flex astro-lyrtiueh"><div class="meta sl-flex astro-lyrtiueh"></div><div class="pagination-links print:hidden astro-6i6fca44" dir="ltr"><a href="/guides/media-text/" rel="prev" class="astro-6i6fca44"><svg aria-hidden="true" class="astro-6i6fca44 astro-tynuvajn" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1.5rem;"><path d="M17 11H9.41l3.3-3.29a1.004 1.004 0 1 0-1.42-1.42l-5 5a1 1 0 0 0-.21.33 1 1 0 0 0 0 .76 1 1 0 0 0 .21.33l5 5a1.002 1.002 0 0 0 1.639-.325 1 1 0 0 0-.219-1.095L9.41 13H17a1 1 0 0 0 0-2Z"/></svg><span class="astro-6i6fca44">上一页<br class="astro-6i6fca44"><span class="link-title astro-6i6fca44">图片、文本与富文本</span></span></a><a href="/reference/text-layout/" rel="next" class="astro-6i6fca44"><svg aria-hidden="true" class="astro-6i6fca44 astro-tynuvajn" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1.5rem;"><path d="M17.92 11.62a1.001 1.001 0 0 0-.21-.33l-5-5a1.003 1.003 0 1 0-1.42 1.42l3.3 3.29H7a1 1 0 0 0 0 2h7.59l-3.3 3.29a1.002 1.002 0 0 0 .325 1.639 1 1 0 0 0 1.095-.219l5-5a1 1 0 0 0 .21-.33 1 1 0 0 0 0-.76Z"/></svg><span class="astro-6i6fca44">下一页<br class="astro-6i6fca44"><span class="link-title astro-6i6fca44">段落、行高与行内对齐</span></span></a></div></footer></div></div></main></div></div></div></div><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a4b5cd982cd46d07',t:'MTc5MjE0MDQ5MQ=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v4bc70e2c01a94c73b74392e4234840661791215815920" integrity="sha512-L0ha0OXavK/8okipN9F8BtP84dg9DUhPERbBXzwI6dgTA55d2+yweo3pn5CSFYs45/r8md2+xvUPtTdvTNRfjA==" data-cf-beacon='{"version":"2024.11.0","token":"f66e77da7c9447699a790b7cf33dfde6","r":1,"spa":2}' crossorigin="anonymous"></script>
</body></html>