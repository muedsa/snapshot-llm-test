dent"><span style="--0:#D6DEEB;--1:#403F53">                                    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent">                                    </span><span style="--0:#82AAFF;--1:#3B61B0">SizedBox</span><span style="--0:#D6DEEB;--1:#403F53">(height </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">8f</span><span style="--0:#D6DEEB;--1:#403F53">)</span></div></div><div class="ec-line"><div class="code"><span class="indent">                                    </span><span style="--0:#82AAFF;--1:#3B61B0">Text</span><span style="--0:#D6DEEB;--1:#403F53">(fit.name, style </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">TextStyle</span><span style="--0:#D6DEEB;--1:#403F53">(fontSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">12f</span><span style="--0:#D6DEEB;--1:#403F53">))</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                                </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                            </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                        </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">            </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">        </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div></code></pre><div class="copy"><div aria-live="polite"></div><button title="复制到剪贴板" data-copied="复制成功！" data-code="val png = SnapshotImage {    Row {        Container(width = 80f, height = 80f, color = 0xFF0369A1.toInt(), alignment = BoxAlignment.CENTER) {            Text(&#x22;A&#x22;, style = TextStyle(fontSize = 36f, color = 0xFFFFFFFF.toInt()))        }        Container(width = 80f, height = 80f, color = 0xFFF59E0B.toInt(), alignment = BoxAlignment.CENTER) {            Text(&#x22;B&#x22;, style = TextStyle(fontSize = 36f, color = 0xFF0F172A.toInt()))        }    }}.use { source ->    SnapshotPNG {        Padding(padding = EdgeInsets.all(16f)) {            Column(mainAxisSize = MainAxisSize.MIN, crossAxisAlignment = CrossAxisAlignment.START) {                for (group in listOf(                    listOf(BoxFit.FILL, BoxFit.CONTAIN, BoxFit.COVER, BoxFit.FIT_WIDTH),                    listOf(BoxFit.FIT_HEIGHT, BoxFit.NONE, BoxFit.SCALE_DOWN),                )) {                    Row(mainAxisSize = MainAxisSize.MIN) {                        for (fit in group) {                            Padding(padding = EdgeInsets.all(8f)) {                                Column(mainAxisSize = MainAxisSize.MIN) {                                    Container(width = 110f, height = 110f, color = 0xFFE2E8F0.toInt()) {                                        RawImage(image = source, fit = fit)                                    }                                    SizedBox(height = 8f)                                    Text(fit.name, style = TextStyle(fontSize = 12f))                                }                            }                        }                    }                }            }        }    }}"><div></div></button></div></figure></div><p>这是 fit 的比较，不是 scale 的比较。scale 表示像素密度；小图目标框较大时，SCALE_DOWN 不会像 CONTAIN 那样放大，见 <a href="/widgets/image/raw-image/">RawImage</a>。</p><div class="sl-heading-wrapper level-h2"><h2 id="三种渐变" __collectHeading="true">三种渐变</h2><a class="sl-anchor-link" href="#三种渐变"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “三种渐变”</span></a></div><p><img src="/examples/gradient-comparison.png" alt="同一组颜色对应线性、径向和扫描渐变的效果"/></p><p>颜色相同，变化的是颜色轴：LINEAR 沿直线推进，RADIAL 按距中心的距离推进，SWEEP 按绕中心的角度推进。</p><div class="expressive-code"><figure class="frame not-content"><figcaption class="header"></figcaption><pre data-language="kotlin"><code><div class="ec-line"><div class="code"><span style="--0:#C792EA;--1:#8844AE">val</span><span style="--0:#D6DEEB;--1:#403F53"> colors </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">intArrayOf</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#F78C6C;--1:#AA0982">0xFF0369A1</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">(), </span><span style="--0:#F78C6C;--1:#AA0982">0xFF38BDF8</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">(), </span><span style="--0:#F78C6C;--1:#AA0982">0xFFFBBF24</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">())</span></div></div><div class="ec-line"><div class="code"><span style="--0:#C792EA;--1:#8844AE">val</span><span style="--0:#D6DEEB;--1:#403F53"> gradients </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">listOf</span><span style="--0:#D6DEEB;--1:#403F53">(</span></div></div><div class="ec-line"><div class="code"><span class="indent">    </span><span style="--0:#ECC48D;--1:#984E4D">"LINEAR"</span><span style="--0:#D6DEEB;--1:#403F53"> to </span><span style="--0:#82AAFF;--1:#3B61B0">LinearGradient</span><span style="--0:#D6DEEB;--1:#403F53">(colors </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> colors),</span></div></div><div class="ec-line"><div class="code"><span class="indent">    </span><span style="--0:#ECC48D;--1:#984E4D">"RADIAL"</span><span style="--0:#D6DEEB;--1:#403F53"> to </span><span style="--0:#82AAFF;--1:#3B61B0">RadialGradient</span><span style="--0:#D6DEEB;--1:#403F53">(colors </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> colors, radius </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">0.5f</span><span style="--0:#D6DEEB;--1:#403F53">),</span></div></div><div class="ec-line"><div class="code"><span class="indent">    </span><span style="--0:#ECC48D;--1:#984E4D">"SWEEP"</span><span style="--0:#D6DEEB;--1:#403F53"> to </span><span style="--0:#82AAFF;--1:#3B61B0">SweepGradient</span><span style="--0:#D6DEEB;--1:#403F53">(colors </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> colors),</span></div></div><div class="ec-line"><div class="code"><span style="--0:#D6DEEB;--1:#403F53">)</span></div></div><div class="ec-line"><div class="code"><span style="--0:#C792EA;--1:#8844AE">val</span><span style="--0:#D6DEEB;--1:#403F53"> png </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">SnapshotPNG</span><span style="--0:#D6DEEB;--1:#403F53"> {</span></div></div><div class="ec-line"><div class="code"><span class="indent">    </span><span style="--0:#82AAFF;--1:#3B61B0">Padding</span><span style="--0:#D6DEEB;--1:#403F53">(padding </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> EdgeInsets.</span><span style="--0:#82AAFF;--1:#3B61B0">all</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#F78C6C;--1:#AA0982">16f</span><span style="--0:#D6DEEB;--1:#403F53">)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">        </span><span style="--0:#82AAFF;--1:#3B61B0">Row</span><span style="--0:#D6DEEB;--1:#403F53">(mainAxisSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> MainAxisSize.MIN) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">            </span><span style="--0:#C792EA;--1:#8844AE">for</span><span style="--0:#D6DEEB;--1:#403F53"> ((label, gradient) </span><span style="--0:#C792EA;--1:#8844AE">in</span><span style="--0:#D6DEEB;--1:#403F53"> gradients) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                </span><span style="--0:#82AAFF;--1:#3B61B0">Padding</span><span style="--0:#D6DEEB;--1:#403F53">(padding </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> EdgeInsets.</span><span style="--0:#82AAFF;--1:#3B61B0">all</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#F78C6C;--1:#AA0982">8f</span><span style="--0:#D6DEEB;--1:#403F53">)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                    </span><span style="--0:#82AAFF;--1:#3B61B0">Column</span><span style="--0:#D6DEEB;--1:#403F53">(mainAxisSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> MainAxisSize.MIN) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                        </span><span style="--0:#82AAFF;--1:#3B61B0">Container</span><span style="--0:#D6DEEB;--1:#403F53">(width </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">160f</span><span style="--0:#D6DEEB;--1:#403F53">, height </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">120f</span><span style="--0:#D6DEEB;--1:#403F53">, decoration </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">BoxDecoration</span><span style="--0:#D6DEEB;--1:#403F53">(gradient </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> gradient))</span></div></div><div class="ec-line"><div class="code"><span class="indent">                        </span><span style="--0:#82AAFF;--1:#3B61B0">SizedBox</span><span style="--0:#D6DEEB;--1:#403F53">(height </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">8f</span><span style="--0:#D6DEEB;--1:#403F53">)</span></div></div><div class="ec-line"><div class="code"><span class="indent">                        </span><span style="--0:#82AAFF;--1:#3B61B0">Text</span><span style="--0:#D6DEEB;--1:#403F53">(label, style </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">TextStyle</span><span style="--0:#D6DEEB;--1:#403F53">(fontSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">14f</span><span style="--0:#D6DEEB;--1:#403F53">))</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">            </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">        </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div></code></pre><div class="copy"><div aria-live="polite"></div><button title="复制到剪贴板" data-copied="复制成功！" data-code="val colors = intArrayOf(0xFF0369A1.toInt(), 0xFF38BDF8.toInt(), 0xFFFBBF24.toInt())val gradients = listOf(    &#x22;LINEAR&#x22; to LinearGradient(colors = colors),    &#x22;RADIAL&#x22; to RadialGradient(colors = colors, radius = 0.5f),    &#x22;SWEEP&#x22; to SweepGradient(colors = colors),)val png = SnapshotPNG {    Padding(padding = EdgeInsets.all(16f)) {        Row(mainAxisSize = MainAxisSize.MIN) {            for ((label, gradient) in gradients) {                Padding(padding = EdgeInsets.all(8f)) {                    Column(mainAxisSize = MainAxisSize.MIN) {                        Container(width = 160f, height = 120f, decoration = BoxDecoration(gradient = gradient))                        SizedBox(height = 8f)                        Text(label, style = TextStyle(fontSize = 14f))                    }                }            }        }    }}"><div></div></button></div></figure></div><p>改变 radius 不是改变 Container 大小；改变 GradientRotation 也不会旋转文字。全部参数见<a href="/reference/gradients/">渐变参考</a>。</p><div class="sl-heading-wrapper level-h2"><h2 id="行内图标对齐" __collectHeading="true">行内图标对齐</h2><a class="sl-anchor-link" href="#行内图标对齐"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “行内图标对齐”</span></a></div><p><img src="/examples/inline-alignment-comparison.png" alt="同一文本行中行内图标使用 TOP、MIDDLE、BOTTOM 对齐的效果"/></p><p>文字及图标 Span 继承同一个 32 号样式，蓝色图标尺寸为 16×16；alignment 作用于行内排版，不是外层 Container。不要只给相邻文字设置字号、却让 WidgetSpan 留在默认字号，否则对比的字体度量不同。字体 ascent / descent 不对称时，MIDDLE 不一定等于人眼感知的字形中心。</p><div class="expressive-code"><figure class="frame not-content"><figcaption class="header"></figcaption><pre data-language="kotlin"><code><div class="ec-line"><div class="code"><span style="--0:#C792EA;--1:#8844AE">val</span><span style="--0:#D6DEEB;--1:#403F53"> png </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">SnapshotPNG</span><span style="--0:#D6DEEB;--1:#403F53"> {</span></div></div><div class="ec-line"><div class="code"><span class="indent">    </span><span style="--0:#82AAFF;--1:#3B61B0">Container</span><span style="--0:#D6DEEB;--1:#403F53">(width </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">480f</span><span style="--0:#D6DEEB;--1:#403F53">, padding </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> EdgeInsets.</span><span style="--0:#82AAFF;--1:#3B61B0">all</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#F78C6C;--1:#AA0982">24f</span><span style="--0:#D6DEEB;--1:#403F53">), color </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">0xFFF1F5F9</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">()) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">        </span><span style="--0:#82AAFF;--1:#3B61B0">Column</span><span style="--0:#D6DEEB;--1:#403F53">(mainAxisSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> MainAxisSize.MIN, crossAxisAlignment </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> CrossAxisAlignment.START) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">            </span><span style="--0:#C792EA;--1:#8844AE">for</span><span style="--0:#D6DEEB;--1:#403F53"> (mode </span><span style="--0:#C792EA;--1:#8844AE">in</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">listOf</span><span style="--0:#D6DEEB;--1:#403F53">(PlaceholderAlignment.TOP, PlaceholderAlignment.MIDDLE, PlaceholderAlignment.BOTTOM)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                </span><span style="--0:#82AAFF;--1:#3B61B0">RichText</span><span style="--0:#D6DEEB;--1:#403F53"> {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                    </span><span style="--0:#82AAFF;--1:#3B61B0">TextSpan</span><span style="--0:#D6DEEB;--1:#403F53">(style </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">TextStyle</span><span style="--0:#D6DEEB;--1:#403F53">(fontSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">32f</span><span style="--0:#D6DEEB;--1:#403F53">)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                        </span><span style="--0:#82AAFF;--1:#3B61B0">TextSpan</span><span style="--0:#D6DEEB;--1:#403F53">(text </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#ECC48D;--1:#984E4D">"Ag 中文 "</span><span style="--0:#D6DEEB;--1:#403F53">)</span></div></div><div class="ec-line"><div class="code"><span class="indent">                        </span><span style="--0:#82AAFF;--1:#3B61B0">WidgetSpan</span><span style="--0:#D6DEEB;--1:#403F53">(alignment </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> mode) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                            </span><span style="--0:#82AAFF;--1:#3B61B0">Container</span><span style="--0:#D6DEEB;--1:#403F53">(width </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">16f</span><span style="--0:#D6DEEB;--1:#403F53">, height </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">16f</span><span style="--0:#D6DEEB;--1:#403F53">, color </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">0xFF0284C7</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">())</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                        </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent">                        </span><span style="--0:#82AAFF;--1:#3B61B0">TextSpan</span><span style="--0:#D6DEEB;--1:#403F53">(text </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#ECC48D;--1:#984E4D">" ${mode.name}"</span><span style="--0:#D6DEEB;--1:#403F53">, style </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">TextStyle</span><span style="--0:#D6DEEB;--1:#403F53">(fontSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">16f</span><span style="--0:#D6DEEB;--1:#403F53">))</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent">                </span><span style="--0:#82AAFF;--1:#3B61B0">SizedBox</span><span style="--0:#D6DEEB;--1:#403F53">(height </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">12f</span><span style="--0:#D6DEEB;--1:#403F53">)</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">            </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">        </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div></code></pre><div class="copy"><div aria-live="polite"></div><button title="复制到剪贴板" data-copied="复制成功！" data-code="val png = SnapshotPNG {    Container(width = 480f, padding = EdgeInsets.all(24f), color = 0xFFF1F5F9.toInt()) {        Column(mainAxisSize = MainAxisSize.MIN, crossAxisAlignment = CrossAxisAlignment.START) {            for (mode in listOf(PlaceholderAlignment.TOP, PlaceholderAlignment.MIDDLE, PlaceholderAlignment.BOTTOM)) {                RichText {                    TextSpan(style = TextStyle(fontSize = 32f)) {                        TextSpan(text = &#x22;Ag 中文 &#x22;)                        WidgetSpan(alignment = mode) {                            Container(width = 16f, height = 16f, color = 0xFF0284C7.toInt())                        }                        TextSpan(text = &#x22; ${mode.name}&#x22;, style = TextStyle(fontSize = 16f))                    }                }                SizedBox(height = 12f)            }        }    }}"><div></div></button></div></figure></div><p>BASELINE / ABOVE_BASELINE / BELOW_BASELINE 使用字体基线，见<a href="/reference/text-layout/#widgetspan-%E4%B8%8E-emoji-%E5%AF%B9%E9%BD%90">行内对齐参考</a>。</p><div class="sl-heading-wrapper level-h2"><h2 id="圆角背景与子树裁剪" __collectHeading="true">圆角背景与子树裁剪</h2><a class="sl-anchor-link" href="#圆角背景与子树裁剪"><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"/></svg></span><span class="sr-only" data-pagefind-ignore="">Section titled “圆角背景与子树裁剪”</span></a></div><p><img src="/examples/clip-comparison.png" alt="只有圆角背景时蓝色子节点仍为矩形，ClipRRect 和 ClipOval 分别裁成圆角与椭圆"/></p><p>三个子节点都是相同的蓝色矩形。第一项仅给外层背景设置圆角，子节点覆盖它后仍是矩形；第二、第三项明确裁剪子树。</p><div class="expressive-code"><figure class="frame not-content"><figcaption class="header"></figcaption><pre data-language="kotlin"><code><div class="ec-line"><div class="code"><span style="--0:#C792EA;--1:#8844AE">val</span><span style="--0:#D6DEEB;--1:#403F53"> png </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">SnapshotPNG</span><span style="--0:#D6DEEB;--1:#403F53"> {</span></div></div><div class="ec-line"><div class="code"><span class="indent">    </span><span style="--0:#82AAFF;--1:#3B61B0">Padding</span><span style="--0:#D6DEEB;--1:#403F53">(padding </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> EdgeInsets.</span><span style="--0:#82AAFF;--1:#3B61B0">all</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#F78C6C;--1:#AA0982">16f</span><span style="--0:#D6DEEB;--1:#403F53">)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">        </span><span style="--0:#82AAFF;--1:#3B61B0">Row</span><span style="--0:#D6DEEB;--1:#403F53">(mainAxisSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> MainAxisSize.MIN) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">            </span><span style="--0:#C792EA;--1:#8844AE">for</span><span style="--0:#D6DEEB;--1:#403F53"> (label </span><span style="--0:#C792EA;--1:#8844AE">in</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">listOf</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#ECC48D;--1:#984E4D">"背景圆角"</span><span style="--0:#D6DEEB;--1:#403F53">, </span><span style="--0:#ECC48D;--1:#984E4D">"ClipRRect"</span><span style="--0:#D6DEEB;--1:#403F53">, </span><span style="--0:#ECC48D;--1:#984E4D">"ClipOval"</span><span style="--0:#D6DEEB;--1:#403F53">)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                </span><span style="--0:#82AAFF;--1:#3B61B0">Padding</span><span style="--0:#D6DEEB;--1:#403F53">(padding </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> EdgeInsets.</span><span style="--0:#82AAFF;--1:#3B61B0">all</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#F78C6C;--1:#AA0982">8f</span><span style="--0:#D6DEEB;--1:#403F53">)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                    </span><span style="--0:#82AAFF;--1:#3B61B0">Column</span><span style="--0:#D6DEEB;--1:#403F53">(mainAxisSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> MainAxisSize.MIN) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                        </span><span style="--0:#82AAFF;--1:#3B61B0">SizedBox</span><span style="--0:#D6DEEB;--1:#403F53">(width </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">160f</span><span style="--0:#D6DEEB;--1:#403F53">, height </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">100f</span><span style="--0:#D6DEEB;--1:#403F53">) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                            </span><span style="--0:#C792EA;--1:#8844AE">when</span><span style="--0:#D6DEEB;--1:#403F53"> (label) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                                </span><span style="--0:#ECC48D;--1:#984E4D">"背景圆角"</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#C792EA;--1:#8844AE">-></span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">Container</span><span style="--0:#D6DEEB;--1:#403F53">(decoration </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">BoxDecoration</span><span style="--0:#D6DEEB;--1:#403F53">(</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                                    </span></span><span style="--0:#D6DEEB;--1:#403F53">color </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">0xFFE2E8F0</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">(), borderRadius </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> BorderRadius.</span><span style="--0:#82AAFF;--1:#3B61B0">circular</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#F78C6C;--1:#AA0982">24f</span><span style="--0:#D6DEEB;--1:#403F53">),</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                                </span></span><span style="--0:#D6DEEB;--1:#403F53">)) { </span><span style="--0:#82AAFF;--1:#3B61B0">ColoredBox</span><span style="--0:#D6DEEB;--1:#403F53">(color </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">0xFF0284C7</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">()) }</span></div></div><div class="ec-line"><div class="code"><span class="indent">                                </span><span style="--0:#ECC48D;--1:#984E4D">"ClipRRect"</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#C792EA;--1:#8844AE">-></span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">ClipRRect</span><span style="--0:#D6DEEB;--1:#403F53">(borderRadius </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> BorderRadius.</span><span style="--0:#82AAFF;--1:#3B61B0">circular</span><span style="--0:#D6DEEB;--1:#403F53">(</span><span style="--0:#F78C6C;--1:#AA0982">24f</span><span style="--0:#D6DEEB;--1:#403F53">)) {</span></div></div><div class="ec-line"><div class="code"><span class="indent">                                    </span><span style="--0:#82AAFF;--1:#3B61B0">ColoredBox</span><span style="--0:#D6DEEB;--1:#403F53">(color </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">0xFF0284C7</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">())</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                                </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent">                                </span><span style="--0:#C792EA;--1:#8844AE">else</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#C792EA;--1:#8844AE">-></span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">ClipOval</span><span style="--0:#D6DEEB;--1:#403F53"> { </span><span style="--0:#82AAFF;--1:#3B61B0">ColoredBox</span><span style="--0:#D6DEEB;--1:#403F53">(color </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">0xFF0284C7</span><span style="--0:#D6DEEB;--1:#403F53">.</span><span style="--0:#82AAFF;--1:#3B61B0">toInt</span><span style="--0:#D6DEEB;--1:#403F53">()) }</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                            </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                        </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent">                        </span><span style="--0:#82AAFF;--1:#3B61B0">SizedBox</span><span style="--0:#D6DEEB;--1:#403F53">(height </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">8f</span><span style="--0:#D6DEEB;--1:#403F53">)</span></div></div><div class="ec-line"><div class="code"><span class="indent">                        </span><span style="--0:#82AAFF;--1:#3B61B0">Text</span><span style="--0:#D6DEEB;--1:#403F53">(label, style </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">TextStyle</span><span style="--0:#D6DEEB;--1:#403F53">(fontSize </span><span style="--0:#C792EA;--1:#8844AE">=</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#F78C6C;--1:#AA0982">14f</span><span style="--0:#D6DEEB;--1:#403F53">))</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">                </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">            </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">        </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span class="indent"><span style="--0:#D6DEEB;--1:#403F53">    </span></span><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div><div class="ec-line"><div class="code"><span style="--0:#D6DEEB;--1:#403F53">}</span></div></div></code></pre><div class="copy"><div aria-live="polite"></div><button title="复制到剪贴板" data-copied="复制成功！" data-code="val png = SnapshotPNG {    Padding(padding = EdgeInsets.all(16f)) {        Row(mainAxisSize = MainAxisSize.MIN) {            for (label in listOf(&#x22;背景圆角&#x22;, &#x22;ClipRRect&#x22;, &#x22;ClipOval&#x22;)) {                Padding(padding = EdgeInsets.all(8f)) {                    Column(mainAxisSize = MainAxisSize.MIN) {                        SizedBox(width = 160f, height = 100f) {                            when (label) {                                &#x22;背景圆角&#x22; -> Container(decoration = BoxDecoration(                                    color = 0xFFE2E8F0.toInt(), borderRadius = BorderRadius.circular(24f),                                )) { ColoredBox(color = 0xFF0284C7.toInt()) }                                &#x22;ClipRRect&#x22; -> ClipRRect(borderRadius = BorderRadius.circular(24f)) {                                    ColoredBox(color = 0xFF0284C7.toInt())                                }                                else -> ClipOval { ColoredBox(color = 0xFF0284C7.toInt()) }                            }                        }                        SizedBox(height = 8f)                        Text(label, style = TextStyle(fontSize = 14f))                    }                }            }        }    }}"><div></div></button></div></figure></div><p>裁剪不会给内容预留空间，也不会扩大输出画布。需要外部阴影时，将阴影装饰留在裁剪组件外侧，详见 <a href="/reference/box-shadow/">BoxShadow</a>。</p></article></div><footer class="sl-flex astro-lyrtiueh"><div class="meta sl-flex astro-lyrtiueh"></div><div class="pagination-links print:hidden astro-6i6fca44" dir="ltr"><a href="/guides/examples/" rel="prev" class="astro-6i6fca44"><svg aria-hidden="true" class="astro-6i6fca44 astro-tynuvajn" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1.5rem;"><path d="M17 11H9.41l3.3-3.29a1.004 1.004 0 1 0-1.42-1.42l-5 5a1 1 0 0 0-.21.33 1 1 0 0 0 0 .76 1 1 0 0 0 .21.33l5 5a1.002 1.002 0 0 0 1.639-.325 1 1 0 0 0-.219-1.095L9.41 13H17a1 1 0 0 0 0-2Z"/></svg><span class="astro-6i6fca44">上一页<br class="astro-6i6fca44"><span class="link-title astro-6i6fca44">完整模板示例</span></span></a><a href="/guides/rendering/" rel="next" class="astro-6i6fca44"><svg aria-hidden="true" class="astro-6i6fca44 astro-tynuvajn" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1.5rem;"><path d="M17.92 11.62a1.001 1.001 0 0 0-.21-.33l-5-5a1.003 1.003 0 1 0-1.42 1.42l3.3 3.29H7a1 1 0 0 0 0 2h7.59l-3.3 3.29a1.002 1.002 0 0 0 .325 1.639 1 1 0 0 0 1.095-.219l5-5a1 1 0 0 0 .21-.33 1 1 0 0 0 0-.76Z"/></svg><span class="astro-6i6fca44">下一页<br class="astro-6i6fca44"><span class="link-title astro-6i6fca44">渲染入口与输出</span></span></a></div></footer></div></div></main></div></div></div></div><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a4b5cdb36d5d9526',t:'MTc5MjE0MDQ5NQ=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v4bc70e2c01a94c73b74392e4234840661791215815920" integrity="sha512-L0ha0OXavK/8okipN9F8BtP84dg9DUhPERbBXzwI6dgTA55d2+yweo3pn5CSFYs45/r8md2+xvUPtTdvTNRfjA==" data-cf-beacon='{"version":"2024.11.0","token":"f66e77da7c9447699a790b7cf33dfde6","r":1,"spa":2}' crossorigin="anonymous"></script>
