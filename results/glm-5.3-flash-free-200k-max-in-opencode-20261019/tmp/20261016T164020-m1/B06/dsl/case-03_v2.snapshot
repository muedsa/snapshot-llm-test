<Positioned left="494" top="352" width="244" height="1"><Container width="244" height="1" color="#DDE7EF" /></Positioned>
<Positioned left="494" top="372"><Text fontSize="17" color="#22374B" fontFamily="Noto Sans CJK SC">一档 60 度 × 0.52</Text></Positioned>
<Positioned left="494" top="400"><Text fontSize="24" color="#22374B" fontFamily="Inter" fontStyle="BOLD">31.20</Text></Positioned>
<Positioned left="600" top="408"><Text fontSize="15" color="#6A7383" fontFamily="Noto Sans CJK SC">元</Text></Positioned>
<Positioned left="494" top="444"><Text fontSize="17" color="#22374B" fontFamily="Noto Sans CJK SC">二档 420 度 × 0.57</Text></Positioned>
<Positioned left="494" top="472"><Text fontSize="24" color="#22374B" fontFamily="Inter" fontStyle="BOLD">239.40</Text></Positioned>
<Positioned left="650" top="480"><Text fontSize="15" color="#6A7383" fontFamily="Noto Sans CJK SC">元</Text></Positioned>
<Positioned left="494" top="515" width="244" height="1"><Container width="244" height="1" color="#DDE7EF" /></Positioned>
<Positioned left="494" top="516" width="244" height="1"><Container width="244" height="1" color="#DDE7EF" /></Positioned>
<Positioned left="494" top="534"><Text fontSize="30" color="#1F5A85" fontFamily="Inter" fontStyle="BOLD">270.60</Text></Positioned>
<Positioned left="640" top="552"><Text fontSize="16" color="#6A7383" fontFamily="Noto Sans CJK SC">元</Text></Positioned>
<Positioned left="494" top="596"><Text fontSize="14" color="#6A7383" fontFamily="Noto Sans CJK SC">直觉 480 × 0.52 = 249.6 元（错）</Text></Positioned>
<Positioned left="494" top="640" width="266" height="29"><Container width="266" height="29" color="#EFE8D8" borderRadius="29" border="1.4 SOLID #D98E2B" /></Positioned>
<Positioned left="494" top="647" width="266"><Text fontSize="15" color="#D98E2B" fontFamily="Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">多付 21.0 元（+8.4%）</Text></Positioned>
<Positioned left="96" top="724" width="666" height="128"><Container width="666" height="128" color="#E7F1F8" borderRadius="12" /></Positioned>
<Positioned left="120" top="740"><Text fontSize="17" color="#22374B" fontFamily="Noto Sans CJK SC">为什么贵了？2,700 已接近一档上限 2,760 度：本月 480 度里只有</Text></Positioned>
<Positioned left="120" top="768"><Text fontSize="17" color="#22374B" fontFamily="Noto Sans CJK SC">60 度仍在一档，其余 420 度全部按二档计；阶梯按年度累计结算，</Text></Positioned>
<Positioned left="120" top="796"><Text fontSize="17" color="#22374B" fontFamily="Noto Sans CJK SC">跨档后年内回不去下层，冬天用电多的月份会继续高位计费。</Text></Positioned>
<Positioned left="96" top="872"><Text fontSize="17" color="#46617A" fontFamily="Noto Sans CJK SC">怎么用：看电费单「年累计」一栏，对照本月抄表数，</Text></Positioned>
<Positioned left="96" top="902"><Text fontSize="17" color="#46617A" fontFamily="Noto Sans CJK SC">即可预判是否跨档、大概补多少钱。</Text></Positioned>
<Positioned left="0" top="1072" width="800"><Text fontSize="15" color="#6A7383" fontFamily="Noto Sans CJK SC" textAlign="CENTER">档位/电价为演示口径；各地阶梯与结算周期不同，分时电价另算，以当地文件为准 · 演示数据</Text></Positioned>
