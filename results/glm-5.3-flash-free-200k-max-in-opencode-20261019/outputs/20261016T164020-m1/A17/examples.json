 "technical_claims": [
  {
   "id": "C1",
   "claim": "POST /snapshot 是 UTF-8 纯文本 XML（Content-Type: text/plain; charset=utf-8），成功响应即图片字节，错误为 JSON（code/message/requestId），429/503 用 Retry-After；请求头 X-Request-Id/Server-Timing 可追踪",
   "source": "https://open-snapshot.muedsa.com/ai-guide.md（本任务以 GET 实取 3718B，缓存 docs/ai-guide.txt）",
   "examples": [
    "page-01",
    "example-01"
   ]
  },
  {
   "id": "C2",
   "claim": "8 位颜色为 #RRGGBBAA——透明度在末两位（不透明红 #FF0000≈#FF0000）",
   "source": "ai-guide.md（颜色一节）",
   "examples": [
    "example-03",
    "page-03"
   ]
  },
  {
   "id": "C3",
   "claim": "解析器不做 HTML 实体解码；<、& 之类须放 CDATA 交给 Text；Raw 保留原文空白；CDATA 在 Text 内按原始文本内容解析",
   "source": "docs/parser.txt / parser-text.txt（run 内缓存，相关页实读）",
   "examples": [
    "example-03",
    "page-03"
   ]
  },
  {
   "id": "C4",
   "claim": "Text 内行内样式 span 标签是 <Raw>（可带 color/fontStyle/decoration 等），不存在 <Span> 标签——首版用 <Span> 得到 400 PARSE_ERROR \"Unknown element tag [Span]\"（requestId caa75f13-568d-4d45-9a4e-75db52df6dee）",
   "source": "parser-text.txt 完整示例（Raw decoration=\"NONE\" 混排）+ 本任务错误响应记录",
   "examples": [
    "example-03"
   ]
  },
  {
   "id": "C5",
   "claim": "Expanded 须是 Row/Column/Flex 直接子节点；默认 flex=1，flex=2:1 时剩余宽按 2/3、1/3 强制分配",
   "source": "https://snapshot.muedsa.com/widgets/layout/expanded/（本任务实际 GET 200，56627B；Kotlin 侧 Expanded(flex=2)/Expanded(flex=1) 示例）",
   "examples": [
    "example-02",
    "page-02"
   ]
  },
  {
   "id": "C6",
   "claim": "画布尺寸由布局决定：Snapshot 不带 width/height，根布局须收敛为有限非零根尺寸（本套以根 Stack 首子 SizedBox 承载）",
   "source": "ai-guide.md（画布尺寸由布局决定）+ docs/layout.txt（根出图约束/无界子项警告）+ overview.raw",
   "examples": [
    "example-02",
    "page-02"
   ]
  },
  {
