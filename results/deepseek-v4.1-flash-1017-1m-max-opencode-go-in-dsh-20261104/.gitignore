# 运行时缓存忽略规则（总任务根唯一一份）
# 参考 templates/gitignore-template.txt；只排除运行时缓存。
# outputs/、tmp/ 内的过程证据（DSL、PNG、请求响应、草稿、日志、检查点）继续保留，不在此忽略。

# ---- Python 运行时缓存 ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# ---- Node / 前端工具缓存 ----
node_modules/
.pnpm-store/
.next/
.turbo/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# ---- 通用编辑器 / 系统缓存（非过程证据） ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/.history/
.idea/workspace.xml

# ---- 渲染/编译临时产物（不承载过程证据的纯缓存） ----
*.tmp
~$*
