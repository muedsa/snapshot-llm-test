<Snapshot background="#FBFAF7" type="png"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1600" color="#FBFAF7"/></Positioned><Positioned left="48" top="44"><Container width="1104" height="4" color="#C2410C"/></Positioned><Positioned left="48" top="56" width="600"><Text fontSize="22" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第一章 · 调用契约</Text></Positioned><Positioned left="48" top="92" width="900"><Text fontSize="42" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">一次请求，一张图</Text></Positioned><Positioned left="1032" top="58" width="120"><Text fontSize="22" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">01 / 04</Text></Positioned><Positioned left="48" top="156"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="176" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">把 DSL 当作纯文本 POST 给服务：请求体是 UTF-8 文本，响应体是 PNG 原始字节。</Text></Positioned><Positioned left="48" top="215" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">成功只有一种形态：状态码 200 且 Content-Type 以 image/ 开头；其余一律按失败处理，先读</Text></Positioned><Positioned left="48" top="248" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">JSON 里的 code 与 diagnostic。</Text></Positioned><Positioned left="48" top="287" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">限流或维护返回 429/503 并带 Retry-After：按它等待再试，每次请求都写进日志。</Text></Positioned><Positioned left="48" top="332" width="400"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">示例代码（节选）</Text></Positioned><Positioned left="692" top="336" width="460"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">完整示例 example-01.snapshot 第 4–9 行</Text></Positioned><Positioned left="48" top="368"><Container width="1104" height="174" color="#121A26" borderRadius="12"/></Positioned><Positioned left="48" top="368"><Container width="5" height="174" color="#C2410C" borderRadius="2"/></Positioned><Positioned left="58" top="380" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="20" top="20"><Container width="360" height="96" color="#16202E"/></Positioned>]]></Text></Positioned><Positioned left="58" top="405" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="40" top="38"><Text fontSize="26">200 image/png</Text></Positioned>]]></Text></Positioned><Positioned left="58" top="430" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="40" top="76"><Text fontSize="18">1812043 bytes 0.94 s</Text></Positioned>]]></Text></Positioned><Positioned left="58" top="455" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="28" top="46"><Container width="10" height="10" color="#34D399"/></Positioned>]]></Text></Positioned><Positioned left="58" top="480" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="20" top="132"><Container width="360" height="56" color="#16202E"/></Positioned>]]></Text></Positioned><Positioned left="58" top="505" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="36" top="148"><Text fontSize="16">requestId 7f3c-9a21</Text></Positioned>]]></Text></Positioned><Positioned left="64" top="546" width="1000"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">…… 第 1–3 行是 Snapshot 根与 400×240 容器，此处省略 ……</Text></Positioned><Positioned left="48" top="582" width="700"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">教学插图（同一份 DSL 的真实渲染，1:1）</Text></Positioned><Positioned left="44" top="618"><Container width="408" height="248" color="#0B1220" borderRadius="8"/></Positioned><Positioned left="68" top="642"><Container width="360" height="96" color="#16202E"/></Positioned><Positioned left="88" top="660"><Text fontSize="26">200 image/png</Text></Positioned><Positioned left="88" top="698"><Text fontSize="18">1812043 bytes 0.94 s</Text></Positioned><Positioned left="76" top="668"><Container width="10" height="10" color="#34D399"/></Positioned><Positioned left="68" top="754"><Container width="360" height="56" color="#16202E"/></Positioned><Positioned left="84" top="770"><Text fontSize="16">requestId 7f3c-9a21</Text></Positioned><Positioned left="492" top="624" width="610"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">同一份 DSL 的真实渲染：400×240、6 个节点</Text></Positioned><Positioned left="492" top="664" width="610"><Text fontSize="20" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">· 响应字节数由服务决定，不要用本地 PNG 长度核对。</Text></Positioned><Positioned left="492" top="726" width="610"><Text fontSize="20" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">· requestId 是唯一能把图片、日志与失败诊断串起来的字段。</Text></Positioned><Positioned left="48" top="894"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="906" width="200"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">要点</Text></Positioned><Positioned left="48" top="940" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">请求</Text></Positioned><Positioned left="232" top="940" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">POST https://open-snapshot.muedsa.com/snapshot，body 为 UTF-8 纯文本</Text></Positioned><Positioned left="48" top="971" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">成功</Text></Positioned><Positioned left="232" top="971" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">200 + image/png 原始字节，直接写文件</Text></Positioned><Positioned left="48" top="1002" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">失败</Text></Positioned><Positioned left="232" top="1002" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">JSON {code, message, requestId, diagnostic}</Text></Positioned><Positioned left="48" top="1033" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">重试</Text></Positioned><Positioned left="232" top="1033" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">429/503 读 Retry-After；网络错误退避重试</Text></Positioned><Positioned left="48" top="1090"><Container width="1104" height="132" color="#F3EEE4" borderRadius="12"/></Positioned><Positioned left="70" top="1104" width="200"><Text fontSize="22" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">试一试</Text></Positioned><Positioned left="70" top="1142" width="1000"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">· 用 curl 发一次请求，把响应字节直接写成 .png</Text></Positioned><Positioned left="70" top="1176" width="1000"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">· 把 requestId 抄进日志，再回头用它找对应的图</Text></Positioned><Positioned left="48" top="1560"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="1570" width="700"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">从文字到图片 · Snapshot 入门手册 · 01</Text></Positioned><Positioned left="852" top="1570" width="300"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">示例均可直接提交运行</Text></Positioned></Stack></Container></Snapshot>