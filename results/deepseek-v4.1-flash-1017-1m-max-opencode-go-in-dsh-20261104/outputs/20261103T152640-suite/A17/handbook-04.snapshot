<Snapshot background="#FBFAF7" type="png"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1600" color="#FBFAF7"/></Positioned><Positioned left="48" top="44"><Container width="1104" height="4" color="#C2410C"/></Positioned><Positioned left="48" top="56" width="600"><Text fontSize="22" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第四章 · 滤镜与可复现交付</Text></Positioned><Positioned left="48" top="92" width="900"><Text fontSize="42" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">效果要能被验证</Text></Positioned><Positioned left="1032" top="58" width="120"><Text fontSize="22" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">04 / 04</Text></Positioned><Positioned left="48" top="156"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="176" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">ImageFiltered 作用于整棵子树，BackdropFilter 在已有内容上叠一层模糊；想“只糊背景”就要把清</Text></Positioned><Positioned left="48" top="209" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">晰内容画在裁剪外。</Text></Positioned><Positioned left="48" top="248" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">本例把蓝色面板放进 ImageFiltered 子树：面板边缘被糊成渐变，条纹仍是硬边；文字另画一层，所以</Text></Positioned><Positioned left="48" top="281" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">保持锐利。</Text></Positioned><Positioned left="48" top="320" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">交付前必须打开最终 PNG 检查尺寸、层次与遮挡；失败响应、重试和每次迭代都留在日志里。</Text></Positioned><Positioned left="48" top="365" width="400"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">示例代码（节选）</Text></Positioned><Positioned left="692" top="369" width="460"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">完整示例 example-04.snapshot 第 4–16 行</Text></Positioned><Positioned left="48" top="401"><Container width="1104" height="349" color="#121A26" borderRadius="12"/></Positioned><Positioned left="48" top="401"><Container width="5" height="349" color="#C2410C" borderRadius="2"/></Positioned><Positioned left="58" top="413" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="20" top="30"><Container width="28" height="180" color="#0EA5E9"/></Positioned>]]></Text></Positioned><Positioned left="58" top="438" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="80" top="30"><Container width="28" height="180" color="#0EA5E9"/></Positioned>]]></Text></Positioned><Positioned left="58" top="463" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="140" top="30"><Container width="28" height="180" color="#0EA5E9"/></Positioned>]]></Text></Positioned><Positioned left="58" top="488" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="200" top="30"><Container width="28" height="180" color="#0EA5E9"/></Positioned>]]></Text></Positioned><Positioned left="58" top="513" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="260" top="30"><Container width="28" height="180" color="#0EA5E9"/></Positioned>]]></Text></Positioned><Positioned left="58" top="538" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="320" top="30"><Container width="28" height="180" color="#0EA5E9"/></Positioned>]]></Text></Positioned><Positioned left="58" top="563" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="90" top="62">]]></Text></Positioned><Positioned left="58" top="588" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[      <SizedBox width="220" height="116"><ImageFiltered sigmaX="6" sigmaY="6">]]></Text></Positioned><Positioned left="58" top="613" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[        <Container width="220" height="116" color="#2563EB" borderRadius="18"/>]]></Text></Positioned><Positioned left="58" top="638" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[      </ImageFiltered></SizedBox></Positioned>]]></Text></Positioned><Positioned left="58" top="663" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="100" top="104"><Text fontSize="20">SHARP</Text></Positioned>]]></Text></Positioned><Positioned left="58" top="688" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    </Stack>]]></Text></Positioned><Positioned left="58" top="713" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[  </Container>]]></Text></Positioned><Positioned left="64" top="754" width="1000"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">…… 第 1–3 行是 Snapshot 根与 400×240 容器，此处省略 ……</Text></Positioned><Positioned left="48" top="790" width="700"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">教学插图（同一份 DSL 的真实渲染，1:1）</Text></Positioned><Positioned left="44" top="826"><Container width="408" height="248" color="#0B1220" borderRadius="8"/></Positioned><Positioned left="68" top="860"><Container width="28" height="180" color="#0EA5E9"/></Positioned><Positioned left="128" top="860"><Container width="28" height="180" color="#0EA5E9"/></Positioned><Positioned left="188" top="860"><Container width="28" height="180" color="#0EA5E9"/></Positioned><Positioned left="248" top="860"><Container width="28" height="180" color="#0EA5E9"/></Positioned><Positioned left="308" top="860"><Container width="28" height="180" color="#0EA5E9"/></Positioned><Positioned left="368" top="860"><Container width="28" height="180" color="#0EA5E9"/></Positioned><Positioned left="138" top="892">  <SizedBox width="220" height="116"><ImageFiltered sigmaX="6" sigmaY="6">    <Container width="220" height="116" color="#2563EB" borderRadius="18"/>  </ImageFiltered></SizedBox></Positioned><Positioned left="148" top="934"><Text fontSize="20">SHARP</Text></Positioned><Positioned left="492" top="832" width="610"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">条纹锐利、蓝色面板被 σ=6 模糊：同一份 DSL 的真实渲染</Text></Positioned><Positioned left="492" top="872" width="610"><Text fontSize="20" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">· 蓝色面板的四边被模糊成渐变，条纹仍是硬边。</Text></Positioned><Positioned left="492" top="934" width="610"><Text fontSize="20" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">· 想只糊背景，就把模糊副本放进裁剪内，文字另画一层。</Text></Positioned><Positioned left="48" top="1102"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="1114" width="200"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">要点</Text></Positioned><Positioned left="48" top="1148" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">ImageFiltered</Text></Positioned><Positioned left="232" top="1148" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">整棵子树一起糊，连文字也糊</Text></Positioned><Positioned left="48" top="1179" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">SizedBox</Text></Positioned><Positioned left="232" top="1179" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">给滤镜子树一个确定尺寸，定位才稳定</Text></Positioned><Positioned left="48" top="1210" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">自检</Text></Positioned><Positioned left="232" top="1210" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">渲染后打开原图，核对遮挡与裁切</Text></Positioned><Positioned left="48" top="1241" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">可复现</Text></Positioned><Positioned left="232" top="1241" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">DSL、PNG、请求日志、迭代记录一并保存</Text></Positioned><Positioned left="48" top="1298"><Container width="1104" height="132" color="#F3EEE4" borderRadius="12"/></Positioned><Positioned left="70" top="1312" width="200"><Text fontSize="22" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">试一试</Text></Positioned><Positioned left="70" top="1350" width="1000"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">· 把 sigma 从 6 改成 0 与 20，比较面板边缘</Text></Positioned><Positioned left="70" top="1384" width="1000"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">· 把 ImageFiltered 提到 Container 外，看文字是否一起糊</Text></Positioned><Positioned left="48" top="1560"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="1570" width="700"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">从文字到图片 · Snapshot 入门手册 · 04</Text></Positioned><Positioned left="852" top="1570" width="300"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">示例均可直接提交运行</Text></Positioned></Stack></Container></Snapshot>