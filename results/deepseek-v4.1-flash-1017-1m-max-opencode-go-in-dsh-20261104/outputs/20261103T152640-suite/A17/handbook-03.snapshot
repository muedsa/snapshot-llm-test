<Snapshot background="#FBFAF7" type="png"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1600" color="#FBFAF7"/></Positioned><Positioned left="48" top="44"><Container width="1104" height="4" color="#C2410C"/></Positioned><Positioned left="48" top="56" width="600"><Text fontSize="22" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第三章 · 文本与透明度</Text></Positioned><Positioned left="48" top="92" width="900"><Text fontSize="42" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">看不见的字符，最容易出错</Text></Positioned><Positioned left="1032" top="58" width="120"><Text fontSize="22" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">03 / 04</Text></Positioned><Positioned left="48" top="156"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="176" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">Text 会裁掉首尾空白；要保留空白就用 Text 内的 Raw，或把整段包进 CDATA。</Text></Positioned><Positioned left="48" top="215" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC"><![CDATA[< 与 & 不是普通字符：必须走 CDATA，否则会被当成标签或实体，渲染出来就是另一段文字。]]></Text></Positioned><Positioned left="48" top="254" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">8 位十六进制是 #RRGGBBAA，末两位是 alpha：20% 白是 #FFFFFF33，#33FFFFFF 却是青白色。</Text></Positioned><Positioned left="48" top="293" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">富文本用同一个 Text 里嵌 Text 实现，各 span 天然共用一条基线（示例为控制行宽未印出，原理见</Text></Positioned><Positioned left="48" top="326" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">下）。</Text></Positioned><Positioned left="48" top="371" width="400"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">示例代码（节选）</Text></Positioned><Positioned left="692" top="375" width="460"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">完整示例 example-03.snapshot 第 4–12 行</Text></Positioned><Positioned left="48" top="407"><Container width="1104" height="249" color="#121A26" borderRadius="12"/></Positioned><Positioned left="48" top="407"><Container width="5" height="249" color="#C2410C" borderRadius="2"/></Positioned><Positioned left="58" top="419" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="20" top="14"><Container width="360" height="56" color="#FFFFFF"/></Positioned>]]></Text></Positioned><Positioned left="58" top="444" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="20" top="14"><Container width="196" height="56" color="#2563EB80"/></Positioned>]]></Text></Positioned><Positioned left="58" top="469" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="232" top="30"><Text fontSize="18">50% blue</Text></Positioned>]]></Text></Positioned><Positioned left="58" top="494" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="20" top="84"><Text fontSize="20"><![CDATA[A < B & C > D]]><![CDATA[</Text></Positioned>]]></Text></Positioned><Positioned left="58" top="519" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="20" top="116"><Text fontSize="20"><Raw>batch   07</Raw></Text></Positioned>]]></Text></Positioned><Positioned left="58" top="544" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="318" top="86"><Container width="54" height="40" color="#FFFFFF33"/></Positioned>]]></Text></Positioned><Positioned left="58" top="569" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    </Stack>]]></Text></Positioned><Positioned left="58" top="594" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[  </Container>]]></Text></Positioned><Positioned left="58" top="619" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[</Snapshot>]]></Text></Positioned><Positioned left="64" top="660" width="1000"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">…… 第 1–3 行是 Snapshot 根与 400×240 容器，此处省略 ……</Text></Positioned><Positioned left="48" top="696" width="700"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">教学插图（同一份 DSL 的真实渲染，1:1）</Text></Positioned><Positioned left="44" top="732"><Container width="408" height="248" color="#0B1220" borderRadius="8"/></Positioned><Positioned left="68" top="750"><Container width="360" height="56" color="#FFFFFF"/></Positioned><Positioned left="68" top="750"><Container width="196" height="56" color="#2563EB80"/></Positioned><Positioned left="280" top="766"><Text fontSize="18">50% blue</Text></Positioned><Positioned left="68" top="820"><Text fontSize="20"><![CDATA[A < B & C > D]]></Text></Positioned><Positioned left="68" top="852"><Text fontSize="20"><Raw>batch   07</Raw></Text></Positioned><Positioned left="366" top="822"><Container width="54" height="40" color="#FFFFFF33"/></Positioned><Positioned left="492" top="738" width="610"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">CDATA、Raw 与两个不同 alpha 的叠色，来自同一份 DSL</Text></Positioned><Positioned left="492" top="778" width="610"><Text fontSize="20" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">· 把半透明当“变淡”容易忽略它仍在和白底混合。</Text></Positioned><Positioned left="492" top="840" width="610"><Text fontSize="20" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">· 每个 span 只能有一个颜色，斜杠要单独一段。</Text></Positioned><Positioned left="48" top="1008"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="1020" width="200"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">要点</Text></Positioned><Positioned left="48" top="1054" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Raw</Text></Positioned><Positioned left="232" top="1054" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">Text 的子节点，保留首尾与连续空格</Text></Positioned><Positioned left="48" top="1085" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">CDATA</Text></Positioned><Positioned left="232" top="1085" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC"><![CDATA[<![CDATA[A < B & C > D]]><![CDATA[ 原样输出]]></Text></Positioned><Positioned left="48" top="1116" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">富文本</Text></Positioned><Positioned left="232" top="1116" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">同一个 Text 内嵌 Text，共用基线</Text></Positioned><Positioned left="48" top="1147" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">alpha</Text></Positioned><Positioned left="232" top="1147" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">#RRGGBBAA：33=20%、80≈50%、FF=100%</Text></Positioned><Positioned left="48" top="1204"><Container width="1104" height="132" color="#F3EEE4" borderRadius="12"/></Positioned><Positioned left="70" top="1218" width="200"><Text fontSize="22" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">试一试</Text></Positioned><Positioned left="70" top="1256" width="1000"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">· 把 #FFFFFF33 改成 #33FFFFFF，对比前后颜色</Text></Positioned><Positioned left="70" top="1290" width="1000"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">· 用 Raw 保住两个连续空格，再删掉它试试</Text></Positioned><Positioned left="48" top="1560"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="1570" width="700"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">从文字到图片 · Snapshot 入门手册 · 03</Text></Positioned><Positioned left="852" top="1570" width="300"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">示例均可直接提交运行</Text></Positioned></Stack></Container></Snapshot>