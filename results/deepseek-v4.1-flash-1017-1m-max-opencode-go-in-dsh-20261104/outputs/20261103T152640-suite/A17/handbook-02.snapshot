<Snapshot background="#FBFAF7" type="png"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1600" color="#FBFAF7"/></Positioned><Positioned left="48" top="44"><Container width="1104" height="4" color="#C2410C"/></Positioned><Positioned left="48" top="56" width="600"><Text fontSize="22" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第二章 · 根尺寸与有界布局</Text></Positioned><Positioned left="48" top="92" width="900"><Text fontSize="42" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">先给边界，再谈排布</Text></Positioned><Positioned left="1032" top="58" width="120"><Text fontSize="22" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">02 / 04</Text></Positioned><Positioned left="48" top="156"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="176" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">Snapshot 根没有 width/height：画布尺寸来自内容，要固定输出就先用 Container 写死宽高。</Text></Positioned><Positioned left="48" top="215" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">Row/Column 在主轴上默认无界；把 Expanded 放进无界主轴会直接报 Layout size is infinite。</Text></Positioned><Positioned left="48" top="254" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">Positioned 只在 Stack/IndexedStack 里生效，放进 Row 会得到 renderBox.parentData must be</Text></Positioned><Positioned left="48" top="287" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">StackParentData。</Text></Positioned><Positioned left="48" top="326" width="1104"><Text fontSize="24" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">注意：给 Container 写 left/top 不会生效——绝对定位属于 Positioned，不属于 Container。</Text></Positioned><Positioned left="48" top="371" width="400"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">示例代码（节选）</Text></Positioned><Positioned left="692" top="375" width="460"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">完整示例 example-02.snapshot 第 4–11 行</Text></Positioned><Positioned left="48" top="407"><Container width="1104" height="224" color="#121A26" borderRadius="12"/></Positioned><Positioned left="48" top="407"><Container width="5" height="224" color="#C2410C" borderRadius="2"/></Positioned><Positioned left="58" top="419" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="20" top="18"><Container width="360" height="76" color="#16202E"/></Positioned>]]></Text></Positioned><Positioned left="58" top="444" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="32" top="30"><Container width="104" height="52" color="#2563EB"/></Positioned>]]></Text></Positioned><Positioned left="58" top="469" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="148" top="30"><Container width="104" height="52" color="#0F766E"/></Positioned>]]></Text></Positioned><Positioned left="58" top="494" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="264" top="30"><Container width="104" height="52" color="#B45309"/></Positioned>]]></Text></Positioned><Positioned left="58" top="519" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="20" top="110"><Container width="360" height="112" color="#16202E"/></Positioned>]]></Text></Positioned><Positioned left="58" top="544" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="44" top="130"><Container width="120" height="72" color="#334155"/></Positioned>]]></Text></Positioned><Positioned left="58" top="569" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="96" top="150"><Container width="120" height="72" color="#475569"/></Positioned>]]></Text></Positioned><Positioned left="58" top="594" width="1090"><Text fontSize="20" color="#DCE6F2" fontFamily="Noto Sans Mono CJK SC"><![CDATA[    <Positioned left="240" top="150"><Text fontSize="18">bounded</Text></Positioned>]]></Text></Positioned><Positioned left="64" top="635" width="1000"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">…… 第 1–3 行是 Snapshot 根与 400×240 容器，此处省略 ……</Text></Positioned><Positioned left="48" top="671" width="700"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">教学插图（同一份 DSL 的真实渲染，1:1）</Text></Positioned><Positioned left="44" top="707"><Container width="408" height="248" color="#0B1220" borderRadius="8"/></Positioned><Positioned left="68" top="729"><Container width="360" height="76" color="#16202E"/></Positioned><Positioned left="80" top="741"><Container width="104" height="52" color="#2563EB"/></Positioned><Positioned left="196" top="741"><Container width="104" height="52" color="#0F766E"/></Positioned><Positioned left="312" top="741"><Container width="104" height="52" color="#B45309"/></Positioned><Positioned left="68" top="821"><Container width="360" height="112" color="#16202E"/></Positioned><Positioned left="92" top="841"><Container width="120" height="72" color="#334155"/></Positioned><Positioned left="144" top="861"><Container width="120" height="72" color="#475569"/></Positioned><Positioned left="288" top="861"><Text fontSize="18">bounded</Text></Positioned><Positioned left="492" top="713" width="610"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">三块等分来自有界 Row；重叠方块来自有界 Stack</Text></Positioned><Positioned left="492" top="753" width="610"><Text fontSize="20" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">· 不要用 HTML 的默认块级流来类比 Snapshot 的布局。</Text></Positioned><Positioned left="492" top="815" width="610"><Text fontSize="20" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">· 方格重叠靠 Positioned 的 left/top 叠加实现。</Text></Positioned><Positioned left="48" top="983"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="995" width="200"><Text fontSize="22" color="#12161C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">要点</Text></Positioned><Positioned left="48" top="1029" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">根尺寸</Text></Positioned><Positioned left="232" top="1029" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC"><![CDATA[由布局决定：<Container width height> 包住全部内容]]></Text></Positioned><Positioned left="48" top="1060" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Expanded</Text></Positioned><Positioned left="232" top="1060" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">只在有界主轴里合法，用来瓜分剩余空间</Text></Positioned><Positioned left="48" top="1091" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Positioned</Text></Positioned><Positioned left="232" top="1091" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">父节点必须是 Stack，坐标相对 Stack 左上角</Text></Positioned><Positioned left="48" top="1122" width="176"><Text fontSize="20" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">排查</Text></Positioned><Positioned left="232" top="1122" width="900"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">先看错误里的 Layout size 与 parentData 关键词</Text></Positioned><Positioned left="48" top="1179"><Container width="1104" height="132" color="#F3EEE4" borderRadius="12"/></Positioned><Positioned left="70" top="1193" width="200"><Text fontSize="22" color="#C2410C" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">试一试</Text></Positioned><Positioned left="70" top="1231" width="1000"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">· 把 Expanded 放进无界 Column，抄下报错原文</Text></Positioned><Positioned left="70" top="1265" width="1000"><Text fontSize="20" color="#39424F" fontFamily="Inter,Noto Sans CJK SC">· 用 Stack + Positioned 复现两个方块的重叠</Text></Positioned><Positioned left="48" top="1560"><Container width="1104" height="1" color="#E2DDD3"/></Positioned><Positioned left="48" top="1570" width="700"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC">从文字到图片 · Snapshot 入门手册 · 02</Text></Positioned><Positioned left="852" top="1570" width="300"><Text fontSize="18" color="#6E7885" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">示例均可直接提交运行</Text></Positioned></Stack></Container></Snapshot>