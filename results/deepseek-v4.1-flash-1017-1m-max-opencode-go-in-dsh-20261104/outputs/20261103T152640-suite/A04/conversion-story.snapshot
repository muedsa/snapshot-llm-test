nter,Noto Sans CJK SC" fontStyle="BOLD">26.00%</Text></Positioned><Positioned left="622" top="754" width="240"><Text fontSize="18" color="#8494AE" fontFamily="Inter,Noto Sans CJK SC">后期结构 × 前期率</Text></Positioned><Positioned left="622" top="776" width="240"><Text fontSize="34" color="#14213D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">14.00%</Text></Positioned><Positioned left="1112" top="754" width="240"><Text fontSize="18" color="#8494AE" fontFamily="Inter,Noto Sans CJK SC">后期总体</Text></Positioned><Positioned left="1112" top="776" width="240"><Text fontSize="34" color="#14213D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">16.60%</Text></Positioned><Positioned left="362" top="788"><Container width="232" height="2" color="#DC2626"/></Positioned><Positioned left="582" top="782"><Container width="12" height="14" color="#DC2626" borderRadius="2"/></Positioned><Positioned left="362" top="758" width="242"><Text fontSize="20" color="#DC2626" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">结构效应 -12.00pp</Text></Positioned><Positioned left="852" top="788"><Container width="232" height="2" color="#15803D"/></Positioned><Positioned left="1072" top="782"><Container width="12" height="14" color="#15803D" borderRadius="2"/></Positioned><Positioned left="852" top="758" width="242"><Text fontSize="20" color="#15803D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">渠道内改善 +2.60pp</Text></Positioned><Positioned left="1362" top="758" width="190"><Text fontSize="24" color="#4338CA" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="RIGHT">合计 -9.40pp</Text></Positioned><Positioned left="1362" top="792" width="190"><Text fontSize="18" color="#8494AE" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">结构效应主导</Text></Positioned><Positioned left="32" top="840"><Container width="1536" height="128" color="#EEF2FF" borderRadius="16" border="1 SOLID #C7D2FE"/></Positioned><Positioned left="32" top="840"><Container width="5" height="128" color="#4338CA" borderRadius="2"/></Positioned><Positioned left="56" top="854"><Text fontSize="18" color="#4338CA" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" letterSpacing="1.2">主结论</Text></Positioned><Positioned left="132" top="848" width="1412"><Text fontSize="22" color="#14213D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">两渠道转化率都在上升（30.00%→35.00%、10.00%→12.00%），总体却从 26.00% 降到 16.60%。</Text></Positioned><Positioned left="132" top="878" width="1412"><Text fontSize="22" color="#14213D" fontFamily="Inter,Noto Sans CJK SC">访问结构由 80/20 翻转为 20/80：结构效应 -12.00pp 压过渠道内改善 +2.60pp，只看平均会误得 +3.50pp。</Text></Positioned><Positioned left="56" top="916"><Container width="1488" height="1" color="#C7D2FE"/></Positioned><Positioned left="56" top="924" width="1488"><Text fontSize="18" color="#4A5875" fontFamily="Inter,Noto Sans CJK SC">限制：仅两期两渠道，无成本、时段、落地页与来源质量数据；只能说明构成变化足以解释总体下降，不能证明因果，也不能推断维持原结构时总体率不变。</Text></Positioned></Stack></Container></Snapshot>