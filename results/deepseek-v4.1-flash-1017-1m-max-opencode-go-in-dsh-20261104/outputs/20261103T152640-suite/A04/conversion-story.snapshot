" fontFamily="Inter,Noto Sans CJK SC">前期 · 总体</Text></Positioned><Positioned left="808" top="242"><Text fontSize="52" color="#14213D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" letterSpacing="-1">26.00%</Text></Positioned><Positioned left="808" top="304"><Text fontSize="18" color="#4A5875" fontFamily="Inter,Noto Sans CJK SC">2,600 ÷ 10,000</Text></Positioned><Positioned left="1160" top="220"><Text fontSize="18" color="#8494AE" fontFamily="Inter,Noto Sans CJK SC">后期 · 总体</Text></Positioned><Positioned left="1160" top="242"><Text fontSize="52" color="#14213D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" letterSpacing="-1">16.60%</Text></Positioned><Positioned left="1160" top="304"><Text fontSize="18" color="#4A5875" fontFamily="Inter,Noto Sans CJK SC">1,660 ÷ 10,000</Text></Positioned><Positioned left="1048" top="250" width="80"><Text fontSize="40" color="#8494AE" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">→</Text></Positioned><Positioned left="1420" top="240"><Container width="120" height="40" color="#FEE2E2" borderRadius="8"/></Positioned><Positioned left="1420" top="247" width="120"><Text fontSize="22" color="#DC2626" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">-9.40pp</Text></Positioned><Positioned left="804" top="340"><Container width="740" height="1" color="#E3E9F2"/></Positioned><Positioned left="808" top="352"><Text fontSize="18" color="#DC2626" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">常见误算：把两个渠道比例平均</Text></Positioned><Positioned left="808" top="378"><Text fontSize="20" color="#4A5875" fontFamily="Inter,Noto Sans CJK SC">（30.00% + 10.00%）÷ 2 = 20.00%</Text></Positioned><Positioned left="808" top="404"><Text fontSize="20" color="#4A5875" fontFamily="Inter,Noto Sans CJK SC">（35.00% + 12.00%）÷ 2 = 23.50%</Text></Positioned><Positioned left="1250" top="378" width="200"><Text fontSize="28" color="#DC2626" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">+3.50pp</Text></Positioned><Positioned left="1250" top="408" width="260"><Text fontSize="18" color="#DC2626" fontFamily="Inter,Noto Sans CJK SC">方向与实际相反</Text></Positioned><Positioned left="804" top="434"><Container width="4" height="22" color="#DC2626" borderRadius="2"/></Positioned><Positioned left="818" top="432" width="718"><Text fontSize="18" color="#4A5875" fontFamily="Inter,Noto Sans CJK SC">平均法把两个不同分母的比例等权，忽略了访问结构；它给出上升，总体却在下降。</Text></Positioned><Positioned left="32" top="486"><Container width="728" height="238" color="#FFFFFF" borderRadius="16" border="1 SOLID #E3E9F2"/></Positioned><Positioned left="56" top="502"><Text fontSize="22" color="#14213D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">访问构成：每期等长，分段按真实占比</Text></Positioned><Positioned left="56" top="562"><Text fontSize="22" color="#14213D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">前期</Text></Positioned><Positioned left="128" top="548"><Container width="452.8" height="54" color="#14B8A6" borderRadius="0" borderRadiusTopLeft="6" borderRadiusBottomLeft="6"/></Positioned><Positioned left="128" top="556" width="452.8"><Text fontSize="20" color="#FFFFFF" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">8,000</Text></Positioned><Positioned left="128" top="580" width="452.8"><Text fontSize="18" color="#FFFFFF" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">80%</Text></Positioned><Positioned left="580.8" top="548"><Container width="113.2" height="54" color="#F59E0B" borderRadius="0" borderRadiusTopRight="6" borderRadiusBottomRight="6"/></Positioned><Positioned left="580.8" top="556" width="113.2"><Text fontSize="20" color="#FFFFFF" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">2,000</Text></Positioned><Positioned left="580.8" top="580" width="113.2"><Text fontSize="18" color="#FFFFFF" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">20%</Text></Positioned><Positioned left="128" top="608" width="566"><Text fontSize="18" color="#8494AE" fontFamily="Inter,Noto Sans CJ