<Snapshot background="#FBF9F4" type="png"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1600" color="#FBF9F4" borderRadius="0"/></Positioned><Positioned left="120" top="120"><Container width="2" height="240" color="#9A3412" borderRadius="0"/></Positioned><Positioned left="160" top="118" width="600"><Text fontSize="26" color="#9A3412" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第三章</Text></Positioned><Positioned left="160" top="168" width="900"><Text fontSize="72" color="#1A1A1A" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">把信息</Text></Positioned><Positioned left="160" top="252" width="900"><Text fontSize="72" color="#1A1A1A" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">排成队列</Text></Positioned><Positioned left="160" top="360" width="860"><Text fontSize="26" color="#6B6558" fontFamily="Inter,Noto Sans CJK SC">关于秩序、留白与阅读节奏的一章</Text></Positioned><Positioned left="160" top="430"><Container width="880" height="2" color="#D9D2C4" borderRadius="0"/></Positioned><Positioned left="160" top="470" width="880"><Text fontSize="26" color="#1A1A1A" fontFamily="Inter,Noto Sans CJK SC">读者在页面上移动视线的方式，决定了信息应该以什么顺序出现。</Text></Positioned><Positioned left="160" top="514" width="880"><Text fontSize="26" color="#1A1A1A" fontFamily="Inter,Noto Sans CJK SC">把标题、日期、正文、注释按同一条基线排好，视线就不需要反复跳跃。</Text></Positioned><Positioned left="160" top="558" width="880"><Text fontSize="26" color="#1A1A1A" fontFamily="Inter,Noto Sans CJK SC">留白不是空的，它是段落之间的呼吸；每一处间距都应当可以被解释。</Text></Positioned><Positioned left="160" top="640"><Container width="880" height="1" color="#E5DFD2" borderRadius="0"/></Positioned><Positioned left="160" top="690" width="120"><Text fontSize="30" color="#9A3412" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">01</Text></Positioned><Positioned left="160" top="736" width="260"><Text fontSize="30" color="#1A1A1A" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">先分组</Text></Positioned><Positioned left="160" top="782" width="280"><Text fontSize="20" color="#6B6558" fontFamily="Inter,Noto Sans CJK SC">同类收进一个单元。</Text></Positioned><Positioned left="460" top="690" width="120"><Text fontSize="30" color="#9A3412" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">02</Text></Positioned><Positioned left="460" top="736" width="260"><Text fontSize="30" color="#1A1A1A" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">再排序</Text></Positioned><Positioned left="460" top="782" width="280"><Text fontSize="20" color="#6B6558" fontFamily="Inter,Noto Sans CJK SC">用字号与位置排序。</Text></Positioned><Positioned left="760" top="690" width="120"><Text fontSize="30" color="#9A3412" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">03</Text></Positioned><Positioned left="760" top="736" width="260"><Text fontSize="30" color="#1A1A1A" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">后对齐</Text></Positioned><Positioned left="760" top="782" width="280"><Text fontSize="20" color="#6B6558" fontFamily="Inter,Noto Sans CJK SC">边缘落在同一线。</Text></Positioned><Positioned left="160" top="900"><Container width="880" height="1" color="#E5DFD2" borderRadius="0"/></Positioned><Positioned left="160" top="940"><Container width="700" height="10" color="#EDE8DC" borderRadius="0"/></Positioned><Positioned left="160" top="986"><Container width="880" height="10" color="#EDE8DC" borderRadius="0"/></Positioned><Positioned left="160" top="1032"><Container width="880" height="10" color="#EDE8DC" borderRadius="0"/></Positioned><Positioned left="160" top="1078"><Container width="880" height="10" color="#EDE8DC" borderRadius="0"/></Positioned><Positioned left="160" top="1124"><Container width="700" height="10" color="#EDE8DC" borderRadius="0"/></Positioned><Positioned left="160" top="1170"><Container width="880" height="10" color="#EDE8DC" borderRadius="0"/></Positioned><Positioned left="160" top="1216"><Container width="880" height="10" color="#EDE8DC" borderRadius="0