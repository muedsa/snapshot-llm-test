<Positioned left="64" top="908"><Container width="1072" height="1" color="#DAD5C8" borderRadius="0"/></Positioned><Positioned left="64" top="946" width="380"><Text fontSize="21" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">其中 32 度落在第三档</Text></Positioned><Positioned left="470" top="946" width="180"><Text fontSize="21" color="#B3352E" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">+26.2 元</Text></Positioned><Positioned left="680" top="946" width="460"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">跨档后单价从 0.57 涨到 0.82</Text></Positioned><Positioned left="64" top="1018"><Container width="1072" height="1" color="#DAD5C8" borderRadius="0"/></Positioned><Positioned left="64" top="1056" width="380"><Text fontSize="21" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">峰时段占比上升 6%</Text></Positioned><Positioned left="470" top="1056" width="180"><Text fontSize="21" color="#B3352E" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">+29.8 元</Text></Positioned><Positioned left="680" top="1056" width="460"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">19:00–21:00 用电集中</Text></Positioned><Positioned left="64" top="1128"><Container width="1072" height="1" color="#DAD5C8" borderRadius="0"/></Positioned><Positioned left="64" top="1200" width="900"><Text fontSize="22" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">想省电，先看第三档的 112 度用在哪里。</Text></Positioned><Positioned left="64" top="1240" width="1000"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">把 19:00–21:00 的洗衣与热水器挪到 22:00 之后，按示例峰谷价差每月约省 26 元。</Text></Positioned><Positioned left="64" top="1300" width="900"><Text fontSize="17" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">说明：电价与用量均为示例，不对应任何真实账单。</Text></Positioned></Stack></Container></Snapshot>