itioned><Positioned left="84" top="706" width="300"><Text fontSize="20" color="#FFFFFF" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">正常范围</Text></Positioned><Positioned left="64" top="754"><Container width="952" height="74" color="#FFFFFF" borderRadius="8" border="1 SOLID #DAD5C8"/></Positioned><Positioned left="88" top="766" width="300"><Text fontSize="20" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">血红蛋白</Text></Positioned><Positioned left="88" top="796" width="300"><Text fontSize="16" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">参考 110–150</Text></Positioned><Positioned left="700" top="774" width="280"><Text fontSize="22" color="#1F7A4D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="RIGHT">132 g/L</Text></Positioned><Positioned left="64" top="838"><Container width="952" height="74" color="#FFFFFF" borderRadius="8" border="1 SOLID #DAD5C8"/></Positioned><Positioned left="88" top="850" width="300"><Text fontSize="20" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">总胆固醇</Text></Positioned><Positioned left="88" top="880" width="300"><Text fontSize="16" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">参考 上限 5.2</Text></Positioned><Positioned left="700" top="858" width="280"><Text fontSize="22" color="#1F7A4D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="RIGHT">4.6 mmol/L</Text></Positioned><Positioned left="64" top="1010" width="950"><Text fontSize="20" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">下一步：两个月后复查血脂与血糖，其余一年后常规体检。</Text></Positioned><Positioned left="64" top="1058" width="950"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">报告上的箭头只是「偏离参考区间」，不等于「有病」。</Text></Positioned><Positioned left="64" top="1150" width="900"><Text fontSize="17" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">说明：数值为示例，不构成医疗建议。</Text></Positioned></Stack></Container></Snapshot>