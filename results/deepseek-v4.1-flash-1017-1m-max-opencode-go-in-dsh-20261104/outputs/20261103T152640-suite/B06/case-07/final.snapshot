<Snapshot background="#FBFAF6" type="png"><Container width="1080" height="1080"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1080" height="8" color="#C8452D" borderRadius="0"/></Positioned><Positioned left="64" top="44" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">问题 07 · 站在桶前不知道扔哪</Text></Positioned><Positioned left="64" top="76" width="952"><Text fontSize="40" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">三个问题，决定它进哪个桶</Text></Positioned><Positioned left="64" top="132" width="952"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">把 64 类细则压成一条判断路径</Text></Positioned><Positioned left="64" top="172"><Container width="952" height="2" color="#161616" borderRadius="0"/></Positioned><Positioned left="64" top="220"><Container width="952" height="150" color="#FFFFFF" borderRadius="10" border="1 SOLID #DAD5C8"/></Positioned><Positioned left="64" top="220"><Container width="8" height="150" color="#1F7A4D" borderRadius="4"/></Positioned><Positioned left="92" top="236" width="80"><Text fontSize="22" color="#1F7A4D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Q1</Text></Positioned><Positioned left="92" top="272" width="500"><Text fontSize="22" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">它含有食物或厨余吗？</Text></Positioned><Positioned left="92" top="312" width="700"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">是 → 湿垃圾（沥干后投放）</Text></Positioned><Positioned left="64" top="400"><Container width="952" height="150" color="#FFFFFF" borderRadius="10" border="1 SOLID #DAD5C8"/></Positioned><Positioned left="64" top="400"><Container width="8" height="150" color="#1D4ED8" borderRadius="4"/></Positioned><Positioned left="92" top="416" width="80"><Text fontSize="22" color="#1D4ED8" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Q2</Text></Positioned><Positioned left="92" top="452" width="500"><Text fontSize="22" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">它能被回收再利用吗？</Text></Positioned><Positioned left="92" top="492" width="700"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">是 → 可回收物（清空、压扁）</Text></Positioned><Positioned left="64" top="580"><Container width="952" height="150" color="#FFFFFF" borderRadius="10" border="1 SOLID #DAD5C8"/></Positioned><Positioned left="64" top="580"><Container width="8" height="150" color="#B3352E" borderRadius="4"/></Positioned><Positioned left="92" top="596" width="80"><Text fontSize="22" color="#B3352E" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Q3</Text></Positioned><Positioned left="92" top="632" width="500"><Text fontSize="22" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">它含药、电池、灯管吗？</Text></Positioned><Positioned left="92" top="672" width="700"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">是 → 有害垃圾（单独密封）</Text></Positioned><Positioned left="64" top="780"><Container width="952" height="120" color="#FFFFFF" borderRadius="10" border="1 SOLID #DAD5C8"/></Positioned><Positioned left="92" top="800" width="500"><Text fontSize="24" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">以上都不是 → 干垃圾</Text></Positioned><Positioned left="92" top="840" width="600"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">例如：陶瓷碎片、用过的纸巾、大骨头</Text></Positioned><Positioned left="64" top="960" width="950"><Text fontSize="19" color="#161616" fontFamily="Inter,Noto Sans CJK SC">不确定的时候，宁可扔干垃圾——湿垃圾里混入塑料会让整桶报废。</Text></Positioned><Positioned left="64" top="1010" width="900"><Text fontSize="17" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">说明：分类口径以本地规定为准，此处为常见四分类的示例。</Text></Positioned></Stack></Container></Snapshot>