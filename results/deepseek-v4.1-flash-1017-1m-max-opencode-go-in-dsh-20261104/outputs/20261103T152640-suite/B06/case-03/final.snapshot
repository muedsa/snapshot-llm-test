<Snapshot background="#FBFAF6" type="png"><Container width="1080" height="1350"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1080" height="8" color="#C8452D" borderRadius="0"/></Positioned><Positioned left="64" top="44" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">问题 03 · 营养成分表看不懂</Text></Positioned><Positioned left="64" top="76" width="952"><Text fontSize="40" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">这碗面的钠，占了你一天的一半</Text></Positioned><Positioned left="64" top="132" width="952"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">把「每 100 克」换算成「这一份」与「每日占比」</Text></Positioned><Positioned left="64" top="172"><Container width="952" height="2" color="#161616" borderRadius="0"/></Positioned><Positioned left="64" top="220" width="200"><Text fontSize="26" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">钠</Text></Positioned><Positioned left="240" top="222" width="300"><Text fontSize="24" color="#161616" fontFamily="Inter,Noto Sans CJK SC">2 140 mg</Text></Positioned><Positioned left="560" top="224" width="160"><Text fontSize="30" color="#B3352E" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="RIGHT">107%</Text></Positioned><Positioned left="64" top="276"><Container width="952" height="22" color="#EDE9DE" borderRadius="11"/></Positioned><Positioned left="64" top="276"><Container width="952" height="22" color="#B3352E" borderRadius="11"/></Positioned><Positioned left="64" top="308" width="600"><Text fontSize="17" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">每日上限 2 000 mg</Text></Positioned><Positioned left="64" top="390" width="200"><Text fontSize="26" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">脂肪</Text></Positioned><Positioned left="240" top="392" width="300"><Text fontSize="24" color="#161616" fontFamily="Inter,Noto Sans CJK SC">18.6 g</Text></Positioned><Positioned left="560" top="394" width="160"><Text fontSize="30" color="#B26A00" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="RIGHT">31%</Text></Positioned><Positioned left="64" top="446"><Container width="952" height="22" color="#EDE9DE" borderRadius="11"/></Positioned><Positioned left="64" top="446"><Container width="295" height="22" color="#B26A00" borderRadius="11"/></Positioned><Positioned left="64" top="478" width="600"><Text fontSize="17" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">每日参考 60 g</Text></Positioned><Positioned left="64" top="560" width="200"><Text fontSize="26" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">糖</Text></Positioned><Positioned left="240" top="562" width="300"><Text fontSize="24" color="#161616" fontFamily="Inter,Noto Sans CJK SC">9.4 g</Text></Positioned><Positioned left="560" top="564" width="160"><Text fontSize="30" color="#B26A00" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="RIGHT">19%</Text></Positioned><Positioned left="64" top="616"><Container width="952" height="22" color="#EDE9DE" borderRadius="11"/></Positioned><Positioned left="64" top="616"><Container width="180" height="22" color="#B26A00" borderRadius="11"/></Positioned><Positioned left="64" top="648" width="600"><Text fontSize="17" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">每日上限 50 g</Text></Positioned><Positioned left="64" top="730" width="200"><Text fontSize="26" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">蛋白质</Text></Positioned><Positioned left="240" top="732" width="300"><Text fontSize="24" color="#161616" fontFamily="Inter,Noto Sans CJK SC">12.1 g</Text></Positioned><Positioned left="560" top="734" width="160"><Text fontSize="30" color="#1F7A4D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="RIGHT">24%</Text></Positioned><Positioned left="64" top="786"><Container width="952" height="22" color="#EDE9DE" borderRadius="11"/></Positioned><Positioned left="64" top="786"><Container width="228" height="22" color="#1F7A4D" borderRadius="11"/></Positioned><Positioned left="64" top="818" width="600"><Text fontSize="17" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">每日参考 50 g</Text></Positioned><Positioned left="64" top="940"><Container width="952" height="2" color="#DAD5C8" borderRadius="0"/></Positioned><Positioned left="64" top="966" width="600"><Text fontSize="22" color="#161616" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">为什么换算很重要</Text></Positioned><Positioned left="64" top="1004" width="950"><Text fontSize="20" color="#161616" fontFamily="Inter,Noto Sans CJK SC">包装标的是「每 100 克」，而这一碗是 105 克。</Text></Positioned><Positioned left="64" top="1038" width="950"><Text fontSize="20" color="#161616" fontFamily="Inter,Noto Sans CJK SC">直接看每 100 克，会把钠低估 5%。</Text></Positioned><Positioned left="64" top="1090" width="950"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">一餐吃掉 107% 的钠上限，意味着当天其余两餐要非常清淡。</Text></Positioned><Positioned left="64" top="1220" width="900"><Text fontSize="17" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">说明：数值为示例配方，每日参考值采用常见成人标准。</Text></Positioned></Stack></Container></Snapshot>