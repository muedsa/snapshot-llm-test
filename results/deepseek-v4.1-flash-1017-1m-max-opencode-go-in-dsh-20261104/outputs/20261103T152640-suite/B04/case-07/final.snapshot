<Snapshot background="#FBFAF6" type="png"><Container width="1200" height="1300"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1300" color="#FBFAF6" borderRadius="0"/></Positioned><Positioned left="0" top="0"><Container width="1200" height="8" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="56" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第 07 讲 · 空格</Text></Positioned><Positioned left="72" top="88" width="1056"><Text fontSize="46" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">两个空格不是同一个空格</Text></Positioned><Positioned left="72" top="156" width="1056"><Text fontSize="21" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">U+3000 与 U+0020 的断行行为不同，混用会出问题。</Text></Positioned><Positioned left="72" top="196"><Container width="1056" height="2" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="240"><Container width="500" height="200" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="72" top="280" width="500"><Text fontSize="60" color="#141414" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">A　B</Text></Positioned><Positioned left="72" top="380" width="500"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">U+3000 IDEOGRAPHIC SPACE</Text></Positioned><Positioned left="628" top="240"><Container width="500" height="200" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="628" top="280" width="500"><Text fontSize="60" color="#141414" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">A B</Text></Positioned><Positioned left="628" top="380" width="500"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">U+0020 SPACE</Text></Positioned><Positioned left="72" top="480" width="1056"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">两者的断行类不同</Text></Positioned><Positioned left="72" top="520" width="1056"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">U+3000 属于 BA（Break After）类，提供断点但不参与间接断行的判定。</Text></Positioned><Positioned left="72" top="556" width="1056"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">U+0020 属于 SP 类，是「间接断行」的判定依据。</Text></Positioned><Positioned left="72" top="620"><Container width="1056" height="2" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="648" width="1056"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">对排版的实际影响：中文里用 U+3000 做段首缩进，不会像空格那样被挤压。</Text></Positioned><Positioned left="72" top="686" width="1056"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">如果用 U+0020 缩进，两端对齐时缩进会被拉宽。</Text></Positioned><Positioned left="72" top="740" width="1056"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">上排两图宽度相同，字距不同——这是两个不同码位，不是同一个空格。</Text></Positioned><Positioned left="72" top="1208"><Container width="1056" height="1" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1224" width="880"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">来源：UAX #14 Table 1（BA/SP 类）、§5.1 BA 小节的 U+3000 条目</Text></Positioned><Positioned left="940" top="1224" width="188"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">混排十讲 · 07</Text></Positioned></Stack></Container></Snapshot>