"940"><Text fontSize="23" color="#141414" fontFamily="Inter,Noto Sans CJK SC">拉丁词内部不断行</Text></Positioned><Positioned left="72" top="620"><Container width="44" height="44" color="#FFFFFF" borderRadius="6" border="2 SOLID #141414"/></Positioned><Positioned left="136" top="618" width="940"><Text fontSize="23" color="#141414" fontFamily="Inter,Noto Sans CJK SC">数字与单位不拆行</Text></Positioned><Positioned left="72" top="716"><Container width="44" height="44" color="#FFFFFF" borderRadius="6" border="2 SOLID #141414"/></Positioned><Positioned left="136" top="714" width="940"><Text fontSize="23" color="#141414" fontFamily="Inter,Noto Sans CJK SC">千分位与百分号跟随数字</Text></Positioned><Positioned left="72" top="812"><Container width="44" height="44" color="#FFFFFF" borderRadius="6" border="2 SOLID #141414"/></Positioned><Positioned left="136" top="810" width="940"><Text fontSize="23" color="#141414" fontFamily="Inter,Noto Sans CJK SC">中文与拉丁之间留 1/4 Em 空隙</Text></Positioned><Positioned left="72" top="908"><Container width="44" height="44" color="#FFFFFF" borderRadius="6" border="2 SOLID #141414"/></Positioned><Positioned left="136" top="906" width="940"><Text fontSize="23" color="#141414" fontFamily="Inter,Noto Sans CJK SC">竖排时拉丁串整体旋转</Text></Positioned><Positioned left="72" top="1004"><Container width="44" height="44" color="#FFFFFF" borderRadius="6" border="2 SOLID #141414"/></Positioned><Positioned left="136" top="1002" width="940"><Text fontSize="23" color="#141414" fontFamily="Inter,Noto Sans CJK SC">全角标点不做字距拉伸</Text></Positioned><Positioned left="72" top="1100"><Container width="44" height="44" color="#FFFFFF" borderRadius="6" border="2 SOLID #141414"/></Positioned><Positioned left="136" top="1098" width="940"><Text fontSize="23" color="#141414" fontFamily="Inter,Noto Sans CJK SC">导出前逐行检查行首行尾</Text></Positioned><Positioned left="72" top="1220"><Container width="1056" height="2" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1248" width="1056"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">前六条来自 UAX #11/#14 的类别定义；后四条是排印实践，规范未强制。</Text></Positioned><Positioned left="72" top="1290" width="1056"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">把它们分开标注，是为了不把编辑经验说成标准。</Text></Positioned><Positioned left="72" top="1408"><Container width="1056" height="1" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1424" width="880"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">来源：UAX #11、UAX #14 各节；经验条目已标注</Text></Positioned><Positioned left="940" top="1424" width="188"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">混排十讲 · 10</Text></Positioned></Stack></Container></Snapshot>