<Snapshot background="#FBFAF6" type="png"><Container width="1200" height="1500"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1500" color="#FBFAF6" borderRadius="0"/></Positioned><Positioned left="0" top="0"><Container width="1200" height="8" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="56" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第 02 讲 · 宽度</Text></Positioned><Positioned left="72" top="88" width="1056"><Text fontSize="46" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">六种默认宽度，两种运行结果</Text></Positioned><Positioned left="72" top="156" width="1056"><Text fontSize="21" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">UAX #11 定义了六个取值；实现只关心最终是窄还是宽。</Text></Positioned><Positioned left="72" top="196"><Container width="1056" height="2" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="236"><Container width="1056" height="130" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="258" width="140"><Text fontSize="40" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">W</Text></Positioned><Positioned left="250" top="260" width="300"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Wide</Text></Positioned><Positioned left="250" top="298" width="600"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">汉字、假名、全角标点</Text></Positioned><Positioned left="780" top="280" width="300"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">1 Em，竖排直立</Text></Positioned><Positioned left="72" top="386"><Container width="1056" height="130" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="408" width="140"><Text fontSize="40" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">F</Text></Positioned><Positioned left="250" top="410" width="300"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Fullwidth</Text></Positioned><Positioned left="250" top="448" width="600"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">全角 ASCII 兼容形（如 ！）</Text></Positioned><Positioned left="780" top="430" width="300"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">1 Em</Text></Positioned><Positioned left="72" top="536"><Container width="1056" height="130" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="558" width="140"><Text fontSize="40" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">H</Text></Positioned><Positioned left="250" top="560" width="300"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Halfwidth</Text></Positioned><Positioned left="250" top="598" width="600"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">半角片假名等兼容形</Text></Positioned><Positioned left="780" top="580" width="300"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">1/2 Em，竖排旋转</Text></Positioned><Positioned left="72" top="686"><Container width="1056" height="130" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="708" width="140"><Text fontSize="40" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Na</Text></Positioned><Positioned left="250" top="710" width="300"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Narrow</Text></Positioned><Positioned left="250" top="748" width="600"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">ASCII 全部</Text></Positioned><Positioned left="780" top="730" width="300"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">1/2 Em</Text></Positioned><Positioned left="72" top="836"><Container width="1056" height="130" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="858" width="140"><Text fontSize="40" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">A</Text></Positioned><Positioned left="250" top="860" width="300"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Ambiguous</Text></Positioned><Positioned left="250" top="898" width="600"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">希腊/西里尔、部分符号</Text></Positioned><Positioned left="780" top="880" width="300"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">上下文决定，默认窄</Text></Positioned><Positioned left="72" top="986"><Container width="1056" height="130" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="1008" width="140"><Text fontSize="40" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">N</Text></Positioned><Positioned left="250" top="1010" width="300"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Neutral</Text></Positioned><Positioned left="250" top="1048" width="600"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">其它（如天城文）</Text></Positioned><Positioned left="780" top="1030" width="300"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">按窄处理</Text></Positioned><Positioned left="72" top="1160" width="1056"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC">六种默认值在具体操作时只解析成「窄」与「宽」两种结果。</Text></Positioned><Positioned left="72" top="1200" width="1056"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">Ambiguous 在东亚上下文里可为宽，其余场景按窄处理。</Text></Positioned><Positioned left="72" top="1408"><Container width="1056" height="1" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1424" width="880"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">来源：UAX #11 §3、§4（ED2–ED7）</Text></Positioned><Positioned left="940" top="1424" width="188"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">混排十讲 · 02</Text></Positioned></Stack></Container></Snapshot>