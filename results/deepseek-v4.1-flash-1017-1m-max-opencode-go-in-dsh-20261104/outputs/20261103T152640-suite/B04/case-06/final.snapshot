<Snapshot background="#FBFAF6" type="png"><Container width="1200" height="1350"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1350" color="#FBFAF6" borderRadius="0"/></Positioned><Positioned left="0" top="0"><Container width="1200" height="8" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="56" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第 06 讲 · 小假名</Text></Positioned><Positioned left="72" top="88" width="1056"><Text fontSize="46" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">同一类字，三种禁则</Text></Positioned><Positioned left="72" top="156" width="1056"><Text fontSize="21" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">CJ 是可裁定的类别，取决于你选 strict、normal 还是 loose。</Text></Positioned><Positioned left="72" top="196"><Container width="1056" height="2" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="236" width="1056"><Text fontSize="23" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">CJ 类：小假名与长音符。它们既可能被禁止行首，也可能允许。</Text></Positioned><Positioned left="72" top="300"><Container width="1056" height="180" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="330" width="900"><Text fontSize="46" color="#141414" fontFamily="Inter,Noto Sans CJK SC">ぁ ぃ ぅ ぇ ぉ ゃ ゅ ょ っ ー</Text></Positioned><Positioned left="100" top="400" width="900"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">U+3041 起 · 小写平假名 · 片假名同理（U+30A1 起）</Text></Positioned><Positioned left="72" top="520"><Container width="1056" height="130" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="540" width="220"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">strict</Text></Positioned><Positioned left="320" top="542" width="500"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">把 CJ 当作 NS 处理</Text></Positioned><Positioned left="320" top="580" width="500"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">行首禁止，最严格</Text></Positioned><Positioned left="72" top="670"><Container width="1056" height="130" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="690" width="220"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">normal</Text></Positioned><Positioned left="320" top="692" width="500"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">把 CJ 当作 ID 处理</Text></Positioned><Positioned left="320" top="730" width="500"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">允许行首，书刊常用</Text></Positioned><Positioned left="72" top="820"><Container width="1056" height="130" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="840" width="220"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">loose</Text></Positioned><Positioned left="320" top="842" width="500"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">更少的禁则字符</Text></Positioned><Positioned left="320" top="880" width="500"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">报纸短栏常用</Text></Positioned><Positioned left="72" top="1020" width="1056"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC">三档禁则集合大小不同：strict 最大、loose 最小。</Text></Positioned><Positioned left="72" top="1060" width="1056"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">原因之一是：禁则字符越多，越容易触发整行挤压对齐。</Text></Positioned><Positioned left="72" top="1258"><Container width="1056" height="1" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1274" width="880"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">来源：UAX #14 §5.1 CJ 小节（CSS Text Level 3 的 strict/normal/loose）</Text></Positioned><Positioned left="940" top="1274" width="188"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">混排十讲 · 06</Text></Positioned></Stack></Container></Snapshot>