<Snapshot background="#FBFAF6" type="png"><Container width="1200" height="1400"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1400" color="#FBFAF6" borderRadius="0"/></Positioned><Positioned left="0" top="0"><Container width="1200" height="8" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="56" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第 03 讲 · Em</Text></Positioned><Positioned left="72" top="88" width="1056"><Text fontSize="46" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">一个汉字，一个方格</Text></Positioned><Positioned left="72" top="156" width="1056"><Text fontSize="21" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">宽窄的基准单位是 Em；它不是字体的实际墨迹宽度。</Text></Positioned><Positioned left="72" top="196"><Container width="1056" height="2" color="#141414" borderRadius="0"/></Positioned><Positioned left="300" top="260"><Container width="300" height="300" color="#FFFFFF" borderRadius="0" border="1 SOLID #141414"/></Positioned><Positioned left="360" top="320"><Container width="180" height="180" color="#F3E6D9" borderRadius="0" border="1 SOLID #C8452D"/></Positioned><Positioned left="360" top="380" width="180"><Text fontSize="90" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">永</Text></Positioned><Positioned left="620" top="300" width="400"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">宽字符：占 1 Em</Text></Positioned><Positioned left="620" top="336" width="460"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">等宽字体里就是一个方格</Text></Positioned><Positioned left="300" top="640"><Container width="300" height="160" color="#FFFFFF" borderRadius="0" border="1 SOLID #141414"/></Positioned><Positioned left="300" top="720"><Container width="160" height="80" color="#DDE7F5" borderRadius="0" border="1 SOLID #1D4ED8"/></Positioned><Positioned left="300" top="736" width="160"><Text fontSize="40" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">Ab</Text></Positioned><Positioned left="620" top="660" width="400"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">窄字符：占 1/2 Em</Text></Positioned><Positioned left="620" top="696" width="460"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">ASCII 属于 Narrow（Na）</Text></Positioned><Positioned left="72" top="900"><Container width="1056" height="2" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="928" width="1056"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC">UAX #11 把「Em」定义为东亚字体的单位宽度：标准字身是正方形。</Text></Positioned><Positioned left="72" top="966" width="1056"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC">因此汉字的字身是 1 Em，拉丁字母在等宽字体里占 1/2 Em。</Text></Positioned><Positioned left="72" top="1016" width="1056"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">注意：这只是「默认宽度」，字体实际字面可能更小。</Text></Positioned><Positioned left="72" top="1052" width="1056"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">左图为示意，不表示某个具体字体的字面率。</Text></Positioned><Positioned left="72" top="1308"><Container width="1056" height="1" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1324" width="880"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">来源：UAX #11 §1（Overview）、§5（Recommendations）</Text></Positioned><Positioned left="940" top="1324" width="188"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">混排十讲 · 03</Text></Positioned></Stack></Container></Snapshot>