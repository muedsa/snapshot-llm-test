<Snapshot background="#FBFAF6" type="png"><Container width="1200" height="1400"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1400" color="#FBFAF6" borderRadius="0"/></Positioned><Positioned left="0" top="0"><Container width="1200" height="8" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="56" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第 05 讲 · 禁则</Text></Positioned><Positioned left="72" top="88" width="1056"><Text fontSize="46" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">行首不能出现的字</Text></Positioned><Positioned left="72" top="156" width="1056"><Text fontSize="21" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">标点被单独分到另一行开头，是最容易被看见的排版错误。</Text></Positioned><Positioned left="72" top="196"><Container width="1056" height="2" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="236" width="1056"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">行首禁则：这些字符不能出现在一行的开头。</Text></Positioned><Positioned left="72" top="300"><Container width="300" height="110" color="#FFFFFF" borderRadius="8" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="72" top="324" width="300"><Text fontSize="52" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">、</Text></Positioned><Positioned left="400" top="320" width="160"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">CL</Text></Positioned><Positioned left="560" top="326" width="560"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">U+3001 IDEOGRAPHIC COMMA</Text></Positioned><Positioned left="72" top="430"><Container width="300" height="110" color="#FFFFFF" borderRadius="8" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="72" top="454" width="300"><Text fontSize="52" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">。</Text></Positioned><Positioned left="400" top="450" width="160"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">CL</Text></Positioned><Positioned left="560" top="456" width="560"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">U+3002 IDEOGRAPHIC FULL STOP</Text></Positioned><Positioned left="72" top="560"><Container width="300" height="110" color="#FFFFFF" borderRadius="8" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="72" top="584" width="300"><Text fontSize="52" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">，</Text></Positioned><Positioned left="400" top="580" width="160"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">CL</Text></Positioned><Positioned left="560" top="586" width="560"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">U+FF0C FULLWIDTH COMMA</Text></Positioned><Positioned left="72" top="690"><Container width="300" height="110" color="#FFFFFF" borderRadius="8" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="72" top="714" width="300"><Text fontSize="52" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">）</Text></Positioned><Positioned left="400" top="710" width="160"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">CP</Text></Positioned><Positioned left="560" top="716" width="560"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">U+FF09 FULLWIDTH RIGHT PARENTHESIS</Text></Positioned><Positioned left="72" top="820"><Container width="300" height="110" color="#FFFFFF" borderRadius="8" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="72" top="844" width="300"><Text fontSize="52" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">！</Text></Positioned><Positioned left="400" top="840" width="160"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">EX</Text></Positioned><Positioned left="560" top="846" width="560"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">U+FF01 FULLWIDTH EXCLAMATION MARK</Text></Positioned><Positioned left="72" top="1000"><Container width="1056" height="2" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1028" width="1056"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC">反向的一半：开引号与左括号不能落在行尾（OP 类）。</Text></Positioned><Positioned left="72" top="1066" width="1056"><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">「（ 等开标点之后禁止断行，闭合标点之前禁止断行。</Text></Positioned><Positioned left="72" top="1120" width="1056"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">实际排版软件还会对连续标点做挤压，这部分不在 UAX 规范内。</Text></Positioned><Positioned left="72" top="1308"><Container width="1056" height="1" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1324" width="880"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">来源：UAX #14 Table 1（CL/CP/EX/OP 类）、§5.1 CL 小节</Text></Positioned><Positioned left="940" top="1324" width="188"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">混排十讲 · 05</Text></Positioned></Stack></Container></Snapshot>