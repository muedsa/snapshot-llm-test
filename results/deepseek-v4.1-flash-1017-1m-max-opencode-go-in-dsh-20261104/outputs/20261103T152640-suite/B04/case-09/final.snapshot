<Snapshot background="#FBFAF6" type="png"><Container width="1200" height="1300"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1300" color="#FBFAF6" borderRadius="0"/></Positioned><Positioned left="0" top="0"><Container width="1200" height="8" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="56" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第 09 讲 · 数字</Text></Positioned><Positioned left="72" top="88" width="1056"><Text fontSize="46" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">别把千分位拆到两行</Text></Positioned><Positioned left="72" top="156" width="1056"><Text fontSize="21" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">NU/IS/PR/PO 四类共同保护数字表达式。</Text></Positioned><Positioned left="72" top="196"><Container width="1056" height="2" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="236" width="1056"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">数字有自己的一套类：不要让它被拆开。</Text></Positioned><Positioned left="72" top="300"><Container width="1056" height="120" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="322" width="140"><Text fontSize="30" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">NU</Text></Positioned><Positioned left="260" top="324" width="260"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">数字</Text></Positioned><Positioned left="540" top="326" width="200"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC">0–9</Text></Positioned><Positioned left="100" top="372" width="900"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">构成数字表达式，内部不当断</Text></Positioned><Positioned left="72" top="440"><Container width="1056" height="120" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="462" width="140"><Text fontSize="30" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">IS</Text></Positioned><Positioned left="260" top="464" width="260"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">中缀分隔</Text></Positioned><Positioned left="540" top="466" width="200"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC">. ,</Text></Positioned><Positioned left="100" top="512" width="900"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">数字前后的断点被抑制</Text></Positioned><Positioned left="72" top="580"><Container width="1056" height="120" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="602" width="140"><Text fontSize="30" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">PR</Text></Positioned><Positioned left="260" top="604" width="260"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">前缀</Text></Positioned><Positioned left="540" top="606" width="200"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC">$ £ ¥</Text></Positioned><Positioned left="100" top="652" width="900"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">不得在其后断开</Text></Positioned><Positioned left="72" top="720"><Container width="1056" height="120" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="742" width="140"><Text fontSize="30" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">PO</Text></Positioned><Positioned left="260" top="744" width="260"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">后缀</Text></Positioned><Positioned left="540" top="746" width="200"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC">% ¢</Text></Positioned><Positioned left="100" top="792" width="900"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">不得在其前断开</Text></Positioned><Positioned left="72" top="900"><Container width="1056" height="2" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="928" width="1056"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">正确：1,280 元　12.5%　¥399</Text></Positioned><Positioned left="72" top="980" width="1056"><Text fontSize="21" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">错误：把「1,280 元」断成「1,280」与「元」分处两行</Text></Positioned><Positioned left="72" top="1030" width="1056"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">数字后紧跟单位时，单位应与数字同处一行；这不属于 UAX 的强制规则，属于编辑规则。</Text></Positioned><Positioned left="72" top="1208"><Container width="1056" height="1" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1224" width="880"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">来源：UAX #14 Table 1（Numeric Context 四类）</Text></Positioned><Positioned left="940" top="1224" width="188"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">混排十讲 · 09</Text></Positioned></Stack></Container></Snapshot>