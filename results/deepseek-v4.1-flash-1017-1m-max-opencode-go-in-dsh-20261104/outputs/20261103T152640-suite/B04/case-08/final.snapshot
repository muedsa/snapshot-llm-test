<Snapshot background="#FBFAF6" type="png"><Container width="1200" height="1350"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1350" color="#FBFAF6" borderRadius="0"/></Positioned><Positioned left="0" top="0"><Container width="1200" height="8" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="56" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第 08 讲 · 混排</Text></Positioned><Positioned left="72" top="88" width="1056"><Text fontSize="46" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">一个空格，改变断点分布</Text></Positioned><Positioned left="72" top="156" width="1056"><Text fontSize="21" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">拉丁词是不可分的整体，汉字几乎处处可断。</Text></Positioned><Positioned left="72" top="196"><Container width="1056" height="2" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="236" width="1056"><Text fontSize="24" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">同一段话，两种处理：</Text></Positioned><Positioned left="72" top="280"><Container width="1056" height="170" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="306" width="900"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC">本刊使用 Snapshot DSL 排版，</Text></Positioned><Positioned left="100" top="348" width="900"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC">每行 24 字，字号 16。</Text></Positioned><Positioned left="100" top="396" width="900"><Text fontSize="19" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC">↑ 空格处可断，汉字之间也可断</Text></Positioned><Positioned left="72" top="480"><Container width="1056" height="170" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="506" width="900"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC">本刊使用Snapshot DSL排版，</Text></Positioned><Positioned left="100" top="548" width="900"><Text fontSize="26" color="#141414" fontFamily="Inter,Noto Sans CJK SC">每行24字，字号16。</Text></Positioned><Positioned left="100" top="596" width="900"><Text fontSize="19" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC">↑ 没有空格，断点只由汉字决定</Text></Positioned><Positioned left="72" top="700"><Container width="1056" height="2" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="728" width="1056"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">拉丁词内部不可断（AL 类），汉字之间几乎处处可断（ID 类）。</Text></Positioned><Positioned left="72" top="766" width="1056"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">混排时，行尾会出现「拉丁词被整体推到下一行」的空隙。</Text></Positioned><Positioned left="72" top="804" width="1056"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">这就是为什么中英混排的字距常常看起来不匀。</Text></Positioned><Positioned left="72" top="858" width="1056"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">两段文字内容相同，第二段靠汉字断行，第一段多了一个可断的空格。</Text></Positioned><Positioned left="72" top="1258"><Container width="1056" height="1" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1274" width="880"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">来源：UAX #14 Table 1（AL/ID 类）、§5.1 AL 小节</Text></Positioned><Positioned left="940" top="1274" width="188"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">混排十讲 · 08</Text></Positioned></Stack></Container></Snapshot>