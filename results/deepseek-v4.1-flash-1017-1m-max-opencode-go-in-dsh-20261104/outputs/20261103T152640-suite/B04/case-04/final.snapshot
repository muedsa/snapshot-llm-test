<Snapshot background="#FBFAF6" type="png"><Container width="1200" height="1450"><Stack alignment="TOP_LEFT" clipBehavior="HARD_EDGE"><Positioned left="0" top="0"><Container width="1200" height="1450" color="#FBFAF6" borderRadius="0"/></Positioned><Positioned left="0" top="0"><Container width="1200" height="8" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="56" width="700"><Text fontSize="20" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">第 04 讲 · 断行</Text></Positioned><Positioned left="72" top="88" width="1056"><Text fontSize="46" color="#141414" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">四种断行风格</Text></Positioned><Positioned left="72" top="156" width="1056"><Text fontSize="21" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">混排之所以难，是因为同一行里可能同时出现两种风格。</Text></Positioned><Positioned left="72" top="196"><Container width="1056" height="2" color="#141414" borderRadius="0"/></Positioned><Positioned left="72" top="236"><Container width="1056" height="240" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="256" width="500"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Western</Text></Positioned><Positioned left="100" top="294" width="900"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">空格与连字符决定断点</Text></Positioned><Positioned left="100" top="332" width="900"><Text fontSize="20" color="#141414" fontFamily="Inter,Noto Sans CJK SC">The quick brown fox jumps over the lazy dog.</Text></Positioned><Positioned left="100" top="372" width="900"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">只在这两处可断：词间空格、连字符</Text></Positioned><Positioned left="72" top="506"><Container width="1056" height="240" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="526" width="500"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">East Asian</Text></Positioned><Positioned left="100" top="564" width="900"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">任何位置都能断，除非被禁止</Text></Positioned><Positioned left="100" top="602" width="900"><Text fontSize="20" color="#141414" fontFamily="Inter,Noto Sans CJK SC">这是一段中文，几乎每个字之间都可以断开。</Text></Positioned><Positioned left="100" top="642" width="900"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">断点密到几乎每字一处</Text></Positioned><Positioned left="72" top="776"><Container width="1056" height="240" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="796" width="500"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">South East Asian</Text></Positioned><Positioned left="100" top="834" width="900"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">需要词法分析</Text></Positioned><Positioned left="100" top="872" width="900"><Text fontSize="20" color="#141414" fontFamily="Inter,Noto Sans CJK SC">ภาษาไทยไม่ใช้ช่องว่าง</Text></Positioned><Positioned left="100" top="912" width="900"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">没有空格，必须查词</Text></Positioned><Positioned left="72" top="1046"><Container width="1056" height="240" color="#FFFFFF" borderRadius="10" border="1 SOLID #D9D3C6"/></Positioned><Positioned left="100" top="1066" width="500"><Text fontSize="26" color="#C8452D" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">Brahmic</Text></Positioned><Positioned left="100" top="1104" width="900"><Text fontSize="21" color="#141414" fontFamily="Inter,Noto Sans CJK SC">按正字音节边界</Text></Positioned><Positioned left="100" top="1142" width="900"><Text fontSize="20" color="#141414" fontFamily="Inter,Noto Sans CJK SC">示例文字不在此展示</Text></Positioned><Positioned left="100" top="1182" width="900"><Text fontSize="19" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">需要字形簇知识</Text></Positioned><Positioned left="72" top="1340" width="1056"><Text fontSize="22" color="#141414" fontFamily="Inter,Noto Sans CJK SC">四种风格可以统一到同一套规则里，只是断点密度不同。</Text></Positioned><Positioned left="72" top="1358"><Container width="1056" height="1" color="#D9D3C6" borderRadius="0"/></Positioned><Positioned left="72" top="1374" width="880"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">来源：UAX #14 §3.1（Determining Line Break Opportunities）</Text></Positioned><Positioned left="940" top="1374" width="188"><Text fontSize="18" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC" textAlign="RIGHT">混排十讲 · 04</Text></Positioned></Stack></Container></Snapshot>