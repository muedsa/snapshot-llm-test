      <!-- N02 下属：蓝色x1, 橙色x2, 灰色x2 -->
      <Positioned left="1180" top="340" width="36" height="36"><Container color="#2563EB" borderRadius="18"/></Positioned>
      <Positioned left="1220" top="320" width="36" height="36"><Container color="#F59E0B" borderRadius="18"/></Positioned>
      <Positioned left="1260" top="340" width="36" height="36"><Container color="#F59E0B" borderRadius="18"/></Positioned>
