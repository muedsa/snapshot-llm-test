      <Positioned left="1280" top="380" width="36" height="36"><Container color="#9CA3AF" borderRadius="18"/></Positioned>

      <!-- N03 下属：橙色x1, 灰色x2, 蓝色x2 -->
      <Positioned left="1420" top="440" width="36" height="36"><Container color="#F59E0B" borderRadius="18"/></Positioned>
      <Positioned left="1460" top="420" width="36" height="36"><Container color="#9CA3AF" borderRadius="18"/></Positioned>
