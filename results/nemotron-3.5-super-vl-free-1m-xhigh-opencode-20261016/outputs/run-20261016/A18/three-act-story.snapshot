      <Positioned left="260" top="540" width="36" height="36"><Container color="#F59E0B" borderRadius="18"/></Positioned>
      <Positioned left="290" top="520" width="36" height="36"><Container color="#F59E0B" borderRadius="18"/></Positioned>
      <Positioned left="320" top="500" width="36" height="36"><Container color="#F59E0B" borderRadius="18"/></Positioned>

      <!-- 灰色节点 -->
      <Positioned left="350" top="280" width="36" height="36"><Container color="#9CA3AF" borderRadius="18"/></Positioned>
      <Positioned left="380" top="260" width="36" height="36"><Container color="#9CA3AF" borderRadius="18"/></Positioned>
      <Positioned left="410" top="280" width="36" height="36"><Container color="#9CA3AF" borderRadius="18"/></Positioned>
      <Positioned left="440" top="320" width="36" height="36"><Container color="#9CA3AF" borderRadius="18"/></Positioned>
      <Positioned left="420" top="360" width="36" height="36"><Container color="#9CA3AF" borderRadius="18"/></Positioned>

      <!-- 第二幕：过载 -->
      <!-- 中间节点 N02 -->
      <Positioned left="740" top="400" width="44" height="44">
        <Container color="#1E293B" borderRadius="22"/>
      </Positioned>
      <Positioned left="718" top="378" width="88" height="88">
        <Container color="#2563EB" borderRadius="44"/>
      </Positioned>

      <!-- 15个单元紧密聚集在中心，形成拥挤状态 -->
      <!-- 第一行 -->
      <Positioned left="700" top="360" width="36" height="36"><Container color="#2563EB" borderRadius="18"/></Positioned>
      <Positioned left="740" top="360" width="36" height="36"><Container color="#F59E0B" borderRadius="18"/></Positioned>
      <Positioned left="780" top="360" width="36" height="36"><Container color="#9CA3AF" borderRadius="18"/></Positioned>
      <!-- 第二行 -->
