<Snapshot background="#FFFFFF" type="png">
  <SizedBox width="1600" height="1000">
    <Stack alignment="TOP_LEFT" clipBehavior="NONE">
      <!-- 标题 -->
      <Positioned left="0" top="10" width="1600" height="40">
        <Text color="#1F2937" fontSize="24" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter" textAlign="CENTER">守恒对象的三幕视觉叙事</Text>
      </Positioned>

      <!-- 第一个幕：集中 -->
      <!-- 左侧幕标题 -->
      <Positioned left="50" top="60" width="300" height="30">
        <Text color="#14233C" fontSize="20" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter" textAlign="CENTER">第一幕：集中</Text>
      </Positioned>

      <!-- 中心节点 N02 -->
      <Positioned left="380" top="400" width="44" height="44">
        <Container color="#1E293B" borderRadius="22"/>
      </Positioned>
      <Positioned left="358" top="378" width="88" height="88">
        <Container color="#2563EB" borderRadius="44"/>
      </Positioned>

      <!-- 15个单元围绕中心分布，形成聚合态 -->
      <!-- 蓝色节点 -->
      <Positioned left="195" top="320" width="36" height="36"><Container color="#2563EB" borderRadius="18"/></Positioned>
      <Positioned left="220" top="290" width="36" height="36"><Container color="#2563EB" borderRadius="18"/></Positioned>
      <Positioned left="250" top="270" width="36" height="36"><Container color="#2563EB" borderRadius="18"/></Positioned>
