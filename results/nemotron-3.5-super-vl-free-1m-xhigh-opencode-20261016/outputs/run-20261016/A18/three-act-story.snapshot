      <Positioned left="720" top="480" width="36" height="36"><Container color="#F59E0B" borderRadius="18"/></Positioned>
      <Positioned left="760" top="480" width="36" height="36"><Container color="#9CA3AF" borderRadius="18"/></Positioned>
      <Positioned left="800" top="480" width="36" height="36"><Container color="#2563EB" borderRadius="18"/></Positioned>

      <!-- 第三幕：重新分配 -->
