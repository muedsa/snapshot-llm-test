            <Row crossAxisAlignment="CENTER">
              <Container width="16" height="3" color="#DC2626" />
              <Container width="6" />
              <Text color="#DC2626" fontSize="18" fontStyle="BOLD" fontFamily="Inter">R</Text>
            </Row>
            <Row crossAxisAlignment="CENTER">
              <Text color="#111827" fontSize="20" fontFamily="Noto Sans CJK SC,Inter">S06 江湾</Text>
