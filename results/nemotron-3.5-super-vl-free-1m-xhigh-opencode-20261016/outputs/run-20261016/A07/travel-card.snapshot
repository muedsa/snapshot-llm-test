<Snapshot background="#FFFFFF" type="png">
  <SizedBox width="720" height="1280">
    <Stack alignment="TOP_LEFT" clipBehavior="NONE">
      <Positioned left="24" top="22">
        <Text color="#0F172A" fontSize="24" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">三条路线旅行卡</Text>
      </Positioned>
      <Positioned left="24" top="54" width="672">
        <Text color="#475569" fontSize="18" fontFamily="Noto Sans CJK SC,Inter" softWrap="true">最少站间边数优先，边数相同则换乘最少；换乘＝改变乘坐线路，第一次上车不算。白底色环站点无无障碍设施，不可作起点、终点或换乘站。</Text>
      </Positioned>

      <!-- Card 1 -->
      <Positioned left="24" top="96" width="672" height="330">
