<Snapshot background="#FFFFFF" type="png">
  <SizedBox width="1200" height="1600">
    <Stack alignment="TOP_LEFT" clipBehavior="NONE">
      <Positioned left="48" top="48" width="1104" height="56">
        <Text color="#14233C" fontSize="34" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">示例 1：提交 DSL 并获取图片</Text>
      </Positioned>
      <Positioned left="48" top="112" width="1104" height="30">
        <Text color="#64748B" fontSize="20" fontFamily="Noto Sans CJK SC,Inter">POST /snapshot 发送纯文本 DSL，服务返回图片二进制</Text>
      </Positioned>
      <Positioned left="1052" top="1552" width="100">
        <Text color="#94A3B8" fontSize="18" fontFamily="Noto Sans CJK SC,Inter" textAlign="RIGHT">第1页</Text>
      </Positioned>
      <Positioned left="48" top="158" width="784" height="320">
        <Container color="#F8F9FC" border="1 SOLID #E2E8F0" borderRadius="10"/>
      </Positioned>
        <Positioned left="64" top="174" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">&lt;Snapshot background="#FFFFFF" type="png"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="192" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">  &lt;Container width="400" height="240" color="#F3F6FB" borderRadius="16" alignment="CENTER"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="210" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">    &lt;Stack alignment="CENTER"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="228" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;Text color="#1E3A8A" fontSize="32" fontStyle="BOLD"&gt;Hello&lt;/Text&gt;</Text>
        </Positioned>
        <Positioned left="64" top="246" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;Text color="#475569" fontSize="18"&gt;Snapshot PNG&lt;/Text&gt;</Text>
        </Positioned>
        <Positioned left="64" top="264" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">    &lt;/Stack&gt;</Text>
        </Positioned>
        <Positioned left="64" top="282" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">  &lt;/Container&gt;</Text>
        </Positioned>
        <Positioned left="64" top="300" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">&lt;/Snapshot&gt;</Text>
        </Positioned>
      <Positioned left="842" top="158" width="400" height="240">
        <Container color="#FFFFFF" border="1 SOLID #CBD5E1" borderRadius="10"/>
      </Positioned>
      <Positioned left="852" top="178" width="380" height="220">
        <Container color="#FFFFFF" borderRadius="8">
          <Stack alignment="TOP_LEFT">
<Container width="400" height="240" color="#F3F6FB" borderRadius="16" alignment="CENTER">
    <Stack alignment="CENTER">
      <Text color="#1E3A8A" fontSize="32" fontStyle="BOLD">Hello</Text>
      <Text color="#475569" fontSize="18">Snapshot PNG</Text>
    </Stack>
  </Container>
          </Stack>
        </Container>
      </Positioned>
      <Positioned left="48" top="518" width="1104" height="26">
        <Text color="#14233C" fontSize="22" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">关键点</Text>
      </Positioned>
      <Positioned left="48" top="552" width="1104" height="130">
        <Text color="#334155" fontSize="20" fontFamily="Noto Sans CJK SC,Inter" softWrap="true">把类 DOM 文本作为 UTF-8 纯文本 POST 到 /snapshot，服务返回图片二进制（PNG）。Content-Type 为 text/plain; charset=utf-8，不要发送 JSON。</Text>
      </Positioned>
    </Stack>
  </SizedBox>
</Snapshot>