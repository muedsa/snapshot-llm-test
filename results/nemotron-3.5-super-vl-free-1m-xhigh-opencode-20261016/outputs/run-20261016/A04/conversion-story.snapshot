<Snapshot background="#FFFFFF" type="png">
  <Container width="1600" height="1000">
    <Stack alignment="TOP_LEFT" clipBehavior="NONE">
      <!-- 标题 -->
      <Positioned left="40" top="30">
        <Text color="#0F172A" fontSize="24" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">转化变化，为什么不能只看平均？</Text>
      </Positioned>
      <Positioned left="40" top="64">
        <Text color="#64748B" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">两渠道两期转化率与访问构成 · 总体 = 总成交 ÷ 总访问 · 数据来源：inputs/conversion.csv</Text>
      </Positioned>

      <!-- 左上：渠道分组率图（0-100% 同一尺度，两期×两渠道） -->
      <Positioned left="40" top="110">
        <Text color="#0F172A" fontSize="18" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">渠道分组转化率（同一 0–100% 尺度）</Text>
      </Positioned>
      <Positioned left="40" top="440" width="660">
        <Container height="1" color="#E2E8F0" />
      </Positioned>
      <!-- Y轴刻度标签（图标注≥18） -->
      <Positioned left="20" top="348" width="64"><Text textAlign="END" color="#64748B" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">100%</Text></Positioned>
      <Positioned left="20" top="296" width="64"><Text textAlign="END" color="#64748B" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">80%</Text></Positioned>
      <Positioned left="20" top="244" width="64"><Text textAlign="END" color="#64748B" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">60%</Text></Positioned>
      <Positioned left="20" top="192" width="64"><Text textAlign="END" color="#64748B" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">40%</Text></Positioned>
      <Positioned left="20" top="140" width="64"><Text textAlign="END" color="#64748B" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">20%</Text></Positioned>
      <Positioned left="20" top="432" width="64"><Text textAlign="END" color="#64748B" fontSize="18" fontFamily="Noto Sans CJK SC,Inter">0%</Text></Positioned>
      <!-- 网格线 -->
      <Positioned left="90" top="433"><Container width="550" height="1" color="#E2E8F0" /></Positioned>
      <Positioned left="90" top="381"><Container width="550" height="1" color="#E2E8F0" /></Positioned>
      <Positioned left="90" top="329"><Container width="550" height="1" color="#E2E8F0" /></Positioned>
      <Positioned left="90" top="277"><Container width="550" height="1" color="#E2E8F0" /></Positioned>
      <Positioned left="90" top="225"><Container width="550" height="1" color="#E2E8F0" /></Positioned>
      <Positioned left="90" top="173"><Container width="550" height="1" color="#E2E8F0" /></Positioned>
      <!-- 前期组：直接 30%（高69），推广 10%（高23），基准 y=433，比例 2.3px/1% -->
      <Positioned left="110" top="364" width="52" height="69">
        <Container color="#2563EB" borderRadiusTopLeft="5" borderRadiusTopRight="5">
          <Text color="#FFFFFF" fontSize="15" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">30.0%</Text>
        </Container>
      </Positioned>
      <Positioned left="172" top="410" width="52" height="23">
        <Container color="#F59E0B" borderRadiusTopLeft="5" borderRadiusTopRight="5">
          <Text color="#FFFFFF" fontSize="15" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">10.0%</Text>
        </Container>
      </Positioned>
      <!-- 后期组：直接 35%（高80.5→80），推广 12%（高27.6→27） -->
      <Positioned left="390" top="353" width="52" height="80">
        <Container color="#2563EB" borderRadiusTopLeft="5" borderRadiusTopRight="5">
          <Text color="#FFFFFF" fontSize="15" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">35.0%</Text>
        </Container>
      </Positioned>
      <Positioned left="452" top="406" width="52" height="27">
        <Container color="#F59E0B" borderRadiusTopLeft="5" borderRadiusTopRight="5">
          <Text color="#FFFFFF" fontSize="15" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">12.0%</Text>
        </Container>
      </Positioned>
      <!-- 组标签 -->
      <Positioned left="110" top="440" width="114"><Text textAlign="CENTER" color="#374151" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">前期</Text></Positioned>
      <Positioned left="390" top="440" width="114"><Text textAlign="CENTER" color="#374151" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">后期</Text></Positioned>
      <!-- 图例 -->
      <Positioned left="90" top="466">
        <Row mainAxisAlignment="START" crossAxisAlignment="CENTER">
          <Container width="16" height="16" color="#2563EB" borderRadius="4" />
          <Container width="8" />
          <Text color="#374151" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">直接访问</Text>
          <Container width="28" />
          <Container width="16" height="16" color="#F59E0B" borderRadius="4" />
          <Container width="8" />
          <Text color="#374151" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">推广访问</Text>
        </Row>
      </Positioned>

      <!-- 右上：访问构成堆叠图（每期等长，分段按真实占比） -->
      <Positioned left="840" top="110">
        <Text color="#0F172A" fontSize="18" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">两期访问构成（等长堆叠，分段＝真实占比）</Text>
      </Positioned>
      <Positioned left="840" top="440" width="720">
        <Container height="1" color="#E2E8F0" />
      </Positioned>
      <!-- 前期条 y=150~260，x=920~1520，直接 80%（512px），推广 20%（128px） -->
      <Positioned left="920" top="150" width="512" height="56">
        <Container color="#2563EB" borderRadiusTopLeft="8" borderRadiusTopRight="8">
          <Text color="#FFFFFF" fontSize="17" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">直接访问 80%（8,000/10,000）</Text>
        </Container>
      </Positioned>
      <Positioned left="1432" top="206" width="128" height="44">
        <Container color="#F59E0B" borderRadiusBottomLeft="8" borderRadiusBottomRight="8" alignment="CENTER">
          <Text color="#FFFFFF" fontSize="15" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">推广访问 20%（2,000/10,000）</Text>
        </Container>
      </Positioned>
      <!-- 后期条 y=290~400，直接 20%（128px），推广 80%（512px） -->
      <Positioned left="920" top="290" width="128" height="56">
        <Container color="#2563EB" borderRadiusTopLeft="8" borderRadiusTopRight="8">
          <Text color="#FFFFFF" fontSize="17" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">直接访问 20%（2,000/10,000）</Text>
        </Container>
      </Positioned>
      <Positioned left="1048" top="346" width="512" height="44">
        <Container color="#F59E0B" alignment="CENTER">
          <Text color="#FFFFFF" fontSize="17" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">推广访问 80%（8,000/10,000）</Text>
        </Container>
      </Positioned>
      <!-- 期标签 -->
      <Positioned left="920" top="266" width="512"><Text textAlign="CENTER" color="#374151" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">前期 · 总访问 10,000</Text></Positioned>
      <Positioned left="920" top="406" width="512"><Text textAlign="CENTER" color="#374151" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">后期 · 总访问 10,000</Text></Positioned>

      <!-- 左下：总体对照（总体 = 总成交 ÷ 总访问） -->
      <Positioned left="40" top="480">
        <Text color="#0F172A" fontSize="18" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">总体转化率对照（总成交 ÷ 总访问）</Text>
      </Positioned>
      <Positioned left="40" top="700" width="660">
        <Container height="1" color="#E2E8F0" />
      </Positioned>
      <!-- 前期 26.0%，后期 16.6%，尺度 0–40%，基准 y=666，高比例 4.15px/1% -->
      <Positioned left="120" top="560" width="80" height="106">
        <Container color="#2563EB" borderRadiusTopLeft="6" borderRadiusTopRight="6">
          <Text color="#FFFFFF" fontSize="16" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">26.0%</Text>
        </Container>
      </Positioned>
      <Positioned left="240" top="596" width="80" height="70">
        <Container color="#F59E0B" borderRadiusTopLeft="6" borderRadiusTopRight="6">
          <Text color="#FFFFFF" fontSize="16" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC" textAlign="CENTER">16.6%</Text>
        </Container>
      </Positioned>
      <Positioned left="120" top="672" width="80"><Text textAlign="CENTER" color="#374151" fontSize="16" fontFamily="Noto Sans CJK SC,Inter">前期</Text></Positioned>
      <Positioned left="240" top="672" width="80"><Text textAlign="CENTER" color="#374151" fontSize="16" fontFamily="Noto Sans CJK SC,Inter">后期</Text></Positioned>
      <Positioned left="40" top="632" width="64"><Text textAlign="END" color="#64748B" fontSize="16" fontFamily="Noto Sans CJK SC,Inter">30%</Text></Positioned>
      <Positioned left="40" top="572" width="64"><Text textAlign="END" color="#64748B" fontSize="16" fontFamily="Noto Sans CJK SC,Inter">20%</Text></Positioned>
      <Positioned left="40" top="666" width="64"><Text textAlign="END" color="#64748B" fontSize="16" fontFamily="Noto Sans CJK SC,Inter">0%</Text></Positioned>

      <!-- 右下：原始数据小表（分母/分子可核对） -->
      <Positioned left="840" top="480">
        <Text color="#0F172A" fontSize="18" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">原始数据（访问/成交，来自 conversion.csv）</Text>
      </Positioned>
      <Positioned left="840" top="516" width="720" height="184">
        <Container color="#F8FAFC" border="1 SOLID #E2E8F0" borderRadius="8">
          <Column>
            <!-- 表头 -->
            <Container height="34" borderBottom="1 SOLID #E2E8F0">
              <Row crossAxisAlignment="CENTER">
                <SizedBox width="170"><Text color="#374151" fontSize="17" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">期别 · 渠道</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#374151" fontSize="17" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">访问</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#374151" fontSize="17" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">成交</Text></SizedBox>
                <SizedBox width="210"><Text textAlign="RIGHT" color="#374151" fontSize="17" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">转化率</Text></SizedBox>
              </Row>
            </Container>
            <Container height="30" borderBottom="1 SOLID #F1F5F9">
              <Row crossAxisAlignment="CENTER">
                <SizedBox width="170"><Text color="#0F172A" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">前期 · 直接访问</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontFamily="Inter,Noto Sans CJK SC">8,000</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontFamily="Inter,Noto Sans CJK SC">2,400</Text></SizedBox>
                <SizedBox width="210"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">30.0%</Text></SizedBox>
              </Row>
            </Container>
            <Container height="30" borderBottom="1 SOLID #F1F5F9">
              <Row crossAxisAlignment="CENTER">
                <SizedBox width="170"><Text color="#0F172A" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">前期 · 推广访问</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontFamily="Inter,Noto Sans CJK SC">2,000</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontFamily="Inter,Noto Sans CJK SC">200</Text></SizedBox>
                <SizedBox width="210"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">10.0%</Text></SizedBox>
              </Row>
            </Container>
            <Container height="30" borderBottom="1 SOLID #F1F5F9">
              <Row crossAxisAlignment="CENTER">
                <SizedBox width="170"><Text color="#0F172A" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">后期 · 直接访问</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontFamily="Inter,Noto Sans CJK SC">2,000</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontFamily="Inter,Noto Sans CJK SC">700</Text></SizedBox>
                <SizedBox width="210"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">35.0%</Text></SizedBox>
              </Row>
            </Container>
            <Container height="30" borderBottom="1 SOLID #F1F5F9">
              <Row crossAxisAlignment="CENTER">
                <SizedBox width="170"><Text color="#0F172A" fontSize="17" fontFamily="Noto Sans CJK SC,Inter">后期 · 推广访问</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontFamily="Inter,Noto Sans CJK SC">8,000</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontFamily="Inter,Noto Sans CJK SC">960</Text></SizedBox>
                <SizedBox width="210"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">12.0%</Text></SizedBox>
              </Row>
            </Container>
            <Container height="34" color="#FFFFFF" borderTop="1 SOLID #E2E8F0">
              <Row crossAxisAlignment="CENTER">
                <SizedBox width="170"><Text color="#0F172A" fontSize="17" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">总体（全部汇总）</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">20,000</Text></SizedBox>
                <SizedBox width="170"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">4,260</Text></SizedBox>
                <SizedBox width="210"><Text textAlign="RIGHT" color="#0F172A" fontSize="17" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">21.3%</Text></SizedBox>
              </Row>
            </Container>
          </Column>
        </Container>
      </Positioned>

      <!-- 底部主结论与限制说明 -->
      <Positioned left="40" top="740" width="1520">
        <Container>
          <Column crossAxisAlignment="START">
            <Text color="#0F172A" fontSize="22" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">主结论：两渠道转化率均在提升（直接访问 30.0%→35.0%，推广访问 10.0%→12.0%），但总体转化率却从 26.0% 下降至 21.3%（前期 2600÷10000，后期 1660÷10000）。原因是访问构成发生了偏移：前期直接访问占 80%，后期推广访问占 80% 且推广基数大、低转化率，拉低了总体。分组与总体不同向，不能只看平均，也不能把绝对成交量当成转化率。</Text>
            <SizedBox height="10" />
            <Text color="#DC2626" fontSize="20" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">限制说明：本数据为观察性聚合，只能说明转化率与访问构成的关联，不能由该数据证明渠道变更导致转化率上升或下降的因果关系。</Text>
          </Column>
        </Container>
      </Positioned>
    </Stack>
  </Container>
</Snapshot>
