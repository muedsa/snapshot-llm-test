<Snapshot background="#FFFFFF" type="png">
  <SizedBox width="1200" height="1600">
    <Stack alignment="TOP_LEFT" clipBehavior="NONE">
      <Positioned left="48" top="48" width="1104" height="56">
        <Text color="#14233C" fontSize="34" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">示例 2：Stack 与 Positioned 定位</Text>
      </Positioned>
      <Positioned left="48" top="112" width="1104" height="30">
        <Text color="#64748B" fontSize="20" fontFamily="Noto Sans CJK SC,Inter">Stack 层叠，Positioned 用 left/top 绝对定位子节点</Text>
      </Positioned>
      <Positioned left="1052" top="1552" width="100">
        <Text color="#94A3B8" fontSize="18" fontFamily="Noto Sans CJK SC,Inter" textAlign="RIGHT">第2页</Text>
      </Positioned>
      <Positioned left="48" top="158" width="784" height="320">
        <Container color="#F8F9FC" border="1 SOLID #E2E8F0" borderRadius="10"/>
      </Positioned>
        <Positioned left="64" top="174" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">&lt;Snapshot background="#FFFFFF" type="png"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="192" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">  &lt;Container width="400" height="240" color="#FFFFFF"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="210" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">    &lt;Stack alignment="TOP_LEFT"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="228" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;Positioned left="20" top="20" width="80" height="60"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="246" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">        &lt;Container color="#2563EB" borderRadius="8"/&gt;</Text>
        </Positioned>
        <Positioned left="64" top="264" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;/Positioned&gt;</Text>
        </Positioned>
        <Positioned left="64" top="282" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;Positioned left="120" top="40" width="80" height="60"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="300" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">        &lt;Container color="#3B82F6" borderRadius="8"/&gt;</Text>
        </Positioned>
        <Positioned left="64" top="318" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;/Positioned&gt;</Text>
        </Positioned>
        <Positioned left="64" top="336" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;Positioned left="220" top="60" width="80" height="60"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="354" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">        &lt;Container color="#60A5FA" borderRadius="8"/&gt;</Text>
        </Positioned>
        <Positioned left="64" top="372" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;/Positioned&gt;</Text>
        </Positioned>
        <Positioned left="64" top="390" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;Positioned left="280" top="100" width="80" height="60"&gt;</Text>
        </Positioned>
        <Positioned left="64" top="408" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">        &lt;Container color="#93C5FD" borderRadius="8"/&gt;</Text>
        </Positioned>
        <Positioned left="64" top="426" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">      &lt;/Positioned&gt;</Text>
        </Positioned>
        <Positioned left="64" top="444" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">    &lt;/Stack&gt;</Text>
        </Positioned>
        <Positioned left="64" top="462" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">  &lt;/Container&gt;</Text>
        </Positioned>
        <Positioned left="64" top="480" width="752" height="18">
          <Text color="#1E293B" fontSize="15" fontFamily="Inter">&lt;/Snapshot&gt;</Text>
        </Positioned>
      <Positioned left="842" top="158" width="400" height="240">
        <Container color="#FFFFFF" border="1 SOLID #CBD5E1" borderRadius="10"/>
      </Positioned>
      <Positioned left="852" top="178" width="380" height="220">
        <Container color="#FFFFFF" borderRadius="8">
          <Stack alignment="TOP_LEFT">
<Container width="400" height="240" color="#FFFFFF">
    <Stack alignment="TOP_LEFT">
      <Positioned left="20" top="20" width="80" height="60">
        <Container color="#2563EB" borderRadius="8"/>
      </Positioned>
      <Positioned left="120" top="40" width="80" height="60">
        <Container color="#3B82F6" borderRadius="8"/>
      </Positioned>
      <Positioned left="220" top="60" width="80" height="60">
        <Container color="#60A5FA" borderRadius="8"/>
