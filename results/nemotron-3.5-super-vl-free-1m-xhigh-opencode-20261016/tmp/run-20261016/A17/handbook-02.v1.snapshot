      <Positioned left="280" top="100" width="80" height="60">
        <Container color="#93C5FD" borderRadius="8"/>
      </Positioned>
    </Stack>
  </Container>
          </Stack>
        </Container>
      </Positioned>
      <Positioned left="48" top="518" width="1104" height="26">
        <Text color="#14233C" fontSize="22" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">关键点</Text>
      </Positioned>
      <Positioned left="48" top="552" width="1104" height="130">
        <Text color="#334155" fontSize="20" fontFamily="Noto Sans CJK SC,Inter" softWrap="true">Stack 按层叠顺序绘制子节点，Positioned 用 left/top 精确放置。适合仪表盘、驾驶舱等固定位置布局。</Text>
      </Positioned>
    </Stack>
  </SizedBox>
</Snapshot>