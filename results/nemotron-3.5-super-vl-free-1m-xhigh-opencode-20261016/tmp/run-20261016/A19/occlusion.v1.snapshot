<Snapshot background="#FFFFFF" type="png">
  <SizedBox width="800" height="800">
    <Stack alignment="TOP_LEFT" clipBehavior="NONE">
      <!-- Hidden object behind occluder: blue circle -->
      <Positioned left="360" top="60" width="280" height="280">
        <Container color="#2563EB" borderRadius="140"/>
      </Positioned>
      <!-- Occluder: large gray rectangle covering the hidden object -->
      <Positioned left="200" top="40" width="280" height="280">
        <Container color="#F59E0B" borderRadius="20"/>
      </Positioned>
    </Stack>
  </SizedBox>
</Snapshot>