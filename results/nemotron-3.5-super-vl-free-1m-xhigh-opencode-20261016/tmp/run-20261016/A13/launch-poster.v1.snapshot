<Snapshot background="#0F172A" type="png">
  <Container width="1080" height="1350">
    <Stack alignment="TOP_LEFT" clipBehavior="NONE">
      <!-- 顶部主标题 -->
      <Positioned left="0" top="130" width="1080" height="64">
        <Stack alignment="CENTER">
          <Positioned left="0" top="0" width="1080" height="64">
            <Text color="#FFFFFF" fontSize="60" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter" textAlign="CENTER">叠光 Layerlight</Text>
          </Positioned>
        </Stack>
      </Positioned>
      <!-- 副标题 -->
      <Positioned left="0" top="200" width="1080" height="34">
        <Stack alignment="CENTER">
          <Positioned left="0" top="0" width="1080" height="34">
            <Text color="#94A3B8" fontSize="24" fontFamily="Noto Sans CJK SC,Inter" textAlign="CENTER">把复杂信息，组织成清晰画面</Text>
          </Positioned>
        </Stack>
      </Positioned>
      <!-- 日期与状态 -->
      <Positioned left="0" top="250" width="1080" height="28">
        <Stack alignment="CENTER">
          <Positioned left="0" top="0" width="1080" height="28">
            <Text color="#64748B" fontSize="20" fontFamily="Noto Sans CJK SC,Inter" textAlign="CENTER">2026.11.07 &middot; ONLINE</Text>
          </Positioned>
        </Stack>
      </Positioned>
      <!-- OPEN BETA -->
      <Positioned left="0" top="300" width="1080" height="40">
        <Stack alignment="CENTER">
          <Positioned left="0" top="0" width="1080" height="40">
            <Text color="#2563EB" fontSize="34" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC" letterSpacing="6" textAlign="CENTER">OPEN BETA</Text>
          </Positioned>
        </Stack>
      </Positioned>
      <!-- 中央图标（460x460，按同一几何规则重绘） -->
      <Positioned left="310" top="520" width="460" height="460">
        <Stack alignment="TOP_LEFT">
          <Positioned left="20" top="20" width="420" height="420">
            <Container color="#1E3A8A" borderRadius="36"/>
          </Positioned>
          <Positioned left="33" top="33" width="260" height="260">
            <Container color="#3B82F6" borderRadius="24"/>
          </Positioned>
          <Positioned left="183" top="183" width="260" height="260">
            <Container color="#FFFFFF" borderRadius="24"/>
          </Positioned>
          <Positioned left="230" top="230" width="40" height="40">
            <Container color="#F59E0B" borderRadius="20"/>
          </Positioned>
        </Stack>
      </Positioned>
      <!-- 底部网址 -->
      <Positioned left="0" top="1240" width="1080" height="28">
        <Stack alignment="CENTER">
          <Positioned left="0" top="0" width="1080" height="28">
            <Text color="#94A3B8" fontSize="20" fontFamily="Noto Sans CJK SC,Inter" textAlign="CENTER">layerlight.example.org</Text>
          </Positioned>
        </Stack>
      </Positioned>
    </Stack>
  </Container>
</Snapshot>
