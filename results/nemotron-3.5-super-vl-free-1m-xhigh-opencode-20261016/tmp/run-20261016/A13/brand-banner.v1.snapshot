<Snapshot background="#FFFFFF" type="png">
  <Container width="1200" height="400">
    <Stack alignment="TOP_LEFT" clipBehavior="NONE">
      <!-- 左侧图标（300x300，按同一几何规则重绘，不嵌入PNG） -->
      <Positioned left="40" top="50" width="300" height="300">
        <Stack alignment="TOP_LEFT">
          <Positioned left="27" top="27" width="246" height="246">
            <Container color="#1E3A8A" borderRadius="21"/>
          </Positioned>
          <Positioned left="35" top="35" width="152" height="152">
            <Container color="#3B82F6" borderRadius="14"/>
          </Positioned>
          <Positioned left="109" top="109" width="152" height="152">
            <Container color="#FFFFFF" borderRadius="14"/>
          </Positioned>
          <Positioned left="138" top="138" width="24" height="24">
            <Container color="#F59E0B" borderRadius="12"/>
          </Positioned>
        </Stack>
      </Positioned>
      <!-- 右侧文字 -->
      <Positioned left="380" top="80" width="780" height="100">
        <Stack alignment="TOP_LEFT">
          <Positioned left="0" top="0" width="780" height="56">
            <Text color="#1E3A8A" fontSize="56" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">叠光 Layerlight</Text>
          </Positioned>
          <Positioned left="0" top="62" width="780" height="34">
            <Text color="#64748B" fontSize="24" fontFamily="Noto Sans CJK SC,Inter">把复杂信息，组织成清晰画面</Text>
          </Positioned>
        </Stack>
      </Positioned>
      <!-- 底部点缀线 -->
      <Positioned left="40" top="388" width="1120" height="2">
        <Container color="#2563EB"/>
      </Positioned>
    </Stack>
  </Container>
</Snapshot>
