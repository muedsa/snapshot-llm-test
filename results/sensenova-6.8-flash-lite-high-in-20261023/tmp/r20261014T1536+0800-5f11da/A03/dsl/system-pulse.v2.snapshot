<Snapshot background="#0B1220" type="png">
  <!-- 根容器给出画布尺寸（<Snapshot> 没有 width/height）+ 32px 安全边距 -->
  <Container width="1280" height="800" color="#0B1220" padding="(32,32)">
    <Stack fit="EXPAND" clipBehavior="NONE">

      <!-- 标题：44 号粗体，绝对 x 32 -->
      <Positioned left="0" top="2">
        <Text fontFamily="Inter" fontSize="44" fontStyle="BOLD"
              color="#FFFFFF">System Pulse</Text>
      </Positioned>

      <!-- 右上 LIVE 96×36，绝对 x 1152..1248 -->
      <Positioned left="1120" top="10">
        <Container width="96" height="36" borderRadius="18"
                   color="#052E16" border="1 SOLID #16A34A">
          <Stack fit="EXPAND" clipBehavior="NONE">
            <Positioned left="16" top="14">
              <Container width="8" height="8" borderRadius="4" color="#22C55E"/>
            </Positioned>
            <Positioned left="32" top="0">
              <Container width="56" height="36" alignment="CENTER_LEFT">
                <Text fontFamily="Inter" fontSize="18" fontStyle="BOLD"
                      color="#4ADE80" letterSpacing="2">LIVE</Text>
              </Container>
            </Positioned>
          </Stack>
        </Container>
      </Positioned>

      <!-- 第一行：三个等宽指标卡（宽 384，间距 32） -->
      <Positioned left="0" top="92">
        <Container width="384" height="150" borderRadius="20"
                   color="#101B2E" border="1 SOLID #233049"
                   boxShadow="0 8 20 0 #00000040 NORMAL">
          <Column mainAxisAlignment="CENTER" crossAxisAlignment="CENTER">
            <Text fontFamily="Inter" fontSize="28" color="#FFFFFF">USAGE 72%</Text>
            <Container width="72" height="22" color="transparent">
              <Container width="72" height="4" borderRadius="2" color="#38BDF8"/>
            </Container>
          </Column>
        </Container>
      </Positioned>
      <Positioned left="416" top="92">
        <Container width="384" height="150" borderRadius="20"
                   color="#101B2E" border="1 SOLID #233049"
                   boxShadow="0 8 20 0 #00000040 NORMAL">
          <Column mainAxisAlignment="CENTER" crossAxisAlignment="CENTER">
            <Text fontFamily="Inter" fontSize="28" color="#FFFFFF">LATENCY 148 ms</Text>
            <Container width="72" height="22" color="transparent">
              <Container width="72" height="4" borderRadius="2" color="#FBBF24"/>
            </Container>
          </Column>
        </Container>
      </Positioned>
      <Positioned left="832" top="92">
        <Container width="384" height="150" borderRadius="20"
                   color="#101B2E" border="1 SOLID #233049"
                   boxShadow="0 8 20 0 #00000040 NORMAL">
          <Column mainAxisAlignment="CENTER" crossAxisAlignment="CENTER">
            <Text fontFamily="Inter" fontSize="28" color="#FFFFFF">SUCCESS 99.2%</Text>
            <Container width="72" height="22" color="transparent">
              <Container width="72" height="4" borderRadius="2" color="#34D399"/>
            </Container>
          </Column>
        </Container>
      </Positioned>

      <!-- 分隔线 -->
      <Positioned left="0" top="328">
        <Container width="1216" height="1" color="#1B2740"/>
      </Positioned>

      <!-- 背景彩色细条：x 250..1030，
           越过说明卡左右两侧边界（390 / 890） -->
      <Positioned left="218" top="414">
        <Container width="780" height="150" color="transparent">
          <Column mainAxisAlignment="SPACE_AROUND">
            <Container width="780" height="10" color="#F472B6"/>
            <Container width="780" height="10" color="#38BDF8"/>
            <Container width="780" height="10" color="#A78BFA"/>
            <Container width="780" height="10" color="#34D399"/>
            <Container width="780" height="10" color="#FBBF24"/>
          </Column>
        </Container>
      </Positioned>

      <!-- 只模糊卡内背景：ClipRRect 限定圆角区域 + BackdropFilter，子节点透明占位 -->
      <Positioned left="358" top="414">
        <ClipRRect borderRadius="24">
          <BackdropFilter sigmaX="10" sigmaY="10" tileMode="CLAMP">
            <Container width="500" height="150" color="transparent"/>
          </BackdropFilter>
        </ClipRRect>
      </Positioned>

      <!-- 说明卡卡体：半透明填充，让模糊出来的色彩可见 -->
      <Positioned left="358" top="414">
        <Container width="500" height="150" borderRadius="24"
                   color="#FFFFFF1A" border="1 SOLID #38BDF8"/>
      </Positioned>

      <!-- 文字在滤镜之外：保持清晰 -->
      <Positioned left="358" top="414">
        <Container width="500" height="150" alignment="CENTER">
          <Text fontFamily="Inter" fontSize="28" color="#FFFFFF"
                letterSpacing="0.5">Background-only blur</Text>
        </Container>
      </Positioned>

      <!-- 右下 REVIEW 160×56，视觉逆时针 8°，绕自身中心 -->
      <Positioned left="1046" top="638">
        <Transform matrix="(0.9902681,-0.1391731,0.0000000,0.0000000,0.1391731,0.9902681,0.0000000,0.0000000,0.0000000,0.0000000,1.0000000,0.0000000,0.0000000,0.0000000,0.0000000,1.0000000)" alignment="CENTER">
          <Container width="160" height="56" borderRadius="12"
                     color="#FFFFFF33" border="1 SOLID #FFFFFF66">
            <Text fontFamily="Inter" fontSize="24" fontStyle="BOLD"
                  color="#FFFFFF" letterSpacing="2">REVIEW</Text>
          </Container>
        </Transform>
      </Positioned>

    </Stack>
  </Container>
</Snapshot>