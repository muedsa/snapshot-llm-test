<Positioned left="1132" top="185" width="52"><Container alignment="CENTER_RIGHT"><Text fontSize="21" color="#5B6B7FFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">40%</Text></Container></Positioned>
