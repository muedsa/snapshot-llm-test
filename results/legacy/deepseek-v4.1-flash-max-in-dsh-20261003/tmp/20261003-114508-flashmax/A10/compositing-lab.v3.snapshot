<Snapshot background="#EEF2F7FF" type="png">
<Container width="1440" height="1100">
<Stack alignment="TOP_LEFT" fit="EXPAND">
<Positioned left="0" top="0"><Container width="1440" height="118" color="#0F172AFF"/></Positioned>
<Positioned left="192" top="26"><Text fontSize="40" color="#F8FAFCFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">看到差异，才能说用对了</Text></Positioned>
<Positioned left="192" top="80"><Text fontSize="20" color="#94A3B8FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">六格对照：alpha / 组透明度 / 仅背景模糊 / 子树模糊 / 滤色×模糊 / 圆形裁剪　·　σx=σy=6　·　实验区 320×240 白底</Text></Positioned>
<Positioned left="192" top="132" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">① 两个矩形各自 50% alpha</Text></Container></Positioned>
<Positioned left="192" top="162" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">红下蓝上，各带 50% alpha</Text></Container></Positioned>
<Positioned left="192" top="190" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#0E9F8FFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">重叠处两层互相混合 → 偏紫</Text></Container></Positioned>
<Positioned left="560" top="132" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">② 不透明矩形 + Opacity(0.5)</Text></Container></Positioned>
<Positioned left="560" top="162" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">组内先压平，再整体 50%</Text></Container></Positioned>
<Positioned left="560" top="190" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#0E9F8FFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">重叠处 = 蓝白各半 → 淡蓝</Text></Container></Positioned>
<Positioned left="928" top="132" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">③ 仅背景模糊</Text></Container></Positioned>
<Positioned left="928" top="162" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">ClipRRect + BackdropFilter</Text></Container></Positioned>
<Positioned left="928" top="190" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#0E9F8FFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">字清晰 · 背景糊 · 不外溢</Text></Container></Positioned>
<Positioned left="192" top="492" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">④ 卡内子树模糊</Text></Container></Positioned>
<Positioned left="192" top="522" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">ImageFiltered σ=6 只糊内容</Text></Container></Positioned>
<Positioned left="192" top="550" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#0E9F8FFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">字糊 · 条纹清晰 · 模糊外溢卡外</Text></Container></Positioned>
<Positioned left="560" top="492" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">⑤ 滤色 → 子树模糊</Text></Container></Positioned>
<Positioned left="560" top="522" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">MULTIPLY #F6B94A 之后 σ=6</Text></Container></Positioned>
<Positioned left="560" top="550" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#0E9F8FFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">滤色限框内 · 模糊外溢约 18px</Text></Container></Positioned>
<Positioned left="928" top="492" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">⑥ ⑤ 再限定圆形裁剪</Text></Container></Positioned>
<Positioned left="928" top="522" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">ClipOval 直径 200 限定区域</Text></Container></Positioned>
<Positioned left="928" top="550" width="320"><Container alignment="CENTER_LEFT"><Text fontSize="20" color="#0E9F8FFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">圆外无滤色 · 边界清晰</Text></Container></Positioned>
