<Positioned left="800" top="1300" width="384"><Container alignment="TOP_LEFT"><Text fontSize="16" color="#44506AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">distress and urgency; DSC alert from the set</Text></Container></Positioned>
<Positioned left="630" top="1336"><Container width="562" height="36" color="#FFFFFFFF" borderRadius="6" border="1 SOLID #CBD5E1FF"/></Positioned>
<Positioned left="642" top="1344"><Text fontSize="17" color="#0B1B2BFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">VHF 72</Text></Positioned>
<Positioned left="800" top="1344" width="384"><Container alignment="TOP_LEFT"><Text fontSize="16" color="#44506AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Brindlemouth Harbour Office, 07:00–19:00</Text></Container></Positioned>
<Positioned left="630" top="1380"><Container width="562" height="36" color="#FFFFFFFF" borderRadius="6" border="1 SOLID #CBD5E1FF"/></Positioned>
<Positioned left="642" top="1388"><Text fontSize="17" color="#0B1B2BFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">0131 555 0142</Text></Positioned>
<Positioned left="800" top="1388" width="384"><Container alignment="TOP_LEFT"><Text fontSize="16" color="#44506AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Brindlemouth Coastguard ops room (fictional)</Text></Container></Positioned>
<Positioned left="630" top="1424"><Container width="562" height="36" color="#FFFFFFFF" borderRadius="6" border="1 SOLID #CBD5E1FF"/></Positioned>
<Positioned left="642" top="1432"><Text fontSize="17" color="#0B1B2BFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">PLB hex 1D0-2E44-91</Text></Positioned>
<Positioned left="800" top="1432" width="384"><Container alignment="TOP_LEFT"><Text fontSize="16" color="#44506AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">registered to Petrel; float-free on the skipper's vest</Text></Container></Positioned>
<Positioned left="630" top="1468"><Container width="562" height="36" color="#FFFFFFFF" borderRadius="6" border="1 SOLID #CBD5E1FF"/></Positioned>
<Positioned left="642" top="1476"><Text fontSize="17" color="#0B1B2BFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">Tom Ellery</Text></Positioned>
<Positioned left="800" top="1476" width="384"><Container alignment="TOP_LEFT"><Text fontSize="16" color="#44506AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">shore contact — has the float plan and the check-in ladder</Text></Container></Positioned>
<Positioned left="48" top="1486"><Text fontSize="20" color="#14203AFF" fontFamily="Inter" fontStyle="BOLD">E · CREW, KIT AND CHECKS</Text></Positioned>
<Positioned left="48" top="1514"><Container width="540" height="2" color="#14203AFF"/></Positioned>
<Positioned left="52" top="1532"><Container width="14" height="14" color="#00000000" borderRadius="3" border="2 SOLID #0B7A6EFF"/></Positioned>
<Positioned left="76" top="1529"><Text fontSize="16" color="#33405AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">2 lifejackets, 2 kill cords, 1 throw line, 2 flares in date</Text></Positioned>
<Positioned left="52" top="1558"><Container width="14" height="14" color="#00000000" borderRadius="3" border="2 SOLID #0B7A6EFF"/></Positioned>
<Positioned left="76" top="1555"><Text fontSize="16" color="#33405AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">VHF handheld + fixed set, phone in a dry bag, PLB on the skipper</Text></Positioned>
<Positioned left="52" top="1584"><Container width="14" height="14" color="#00000000" borderRadius="3" border="2 SOLID #0B7A6EFF"/></Positioned>
<Positioned left="76" top="1581"><Text fontSize="16" color="#33405AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">First aid kit, 2 L water, sun cover, anchor and 30 m warp</Text></Positioned>
<Positioned left="52" top="1610"><Container width="14" height="14" color="#00000000" borderRadius="3" border="2 SOLID #0B7A6EFF"/></Positioned>
<Positioned left="76" top="1607"><Text fontSize="16" color="#33405AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Tide table for the day, this plan laminated, pencil and grease board</Text></Positioned>
<Positioned left="630" top="1486"><Text fontSize="20" color="#14203AFF" fontFamily="Inter" fontStyle="BOLD">F · DAY PLAN</Text></Positioned>
<Positioned left="630" top="1514"><Container width="562" height="2" color="#14203AFF"/></Positioned>
