<Snapshot background="#0B1220FF" type="png">
  <Container width="900" height="420" padding="(24,32)">
    <Column crossAxisAlignment="START">
      <Text fontSize="30" color="#FFFFFFFF" fontFamily="Noto Sans CJK SC">A: padding="(24,32)" 通过；根 Snapshot 不带 width/height</Text>
      <Container height="12" />
      <Text fontSize="24" color="#5EEAD4FF" fontFamily="Noto Sans CJK SC">B: fontSize 驼峰通过（font-size 未测，已知属性名区分大小写）</Text>
      <Container height="20" />
      <Stack alignment="TOP_LEFT">
        <Container width="400" height="120" color="#334155FF" />
        <Positioned left="20" top="20"><Text fontSize="24" color="#FFFFFFFF" fontFamily="Noto Sans CJK SC">C: Positioned 在 Stack 内可用</Text></Positioned>
      </Stack>
      <Container height="20" />
      <ImageFiltered sigmaX="8" sigmaY="8"><Container width="300" height="60" color="#FFFFFF44"><Text fontSize="22" color="#FFFFFFFF">D: ImageFiltered sigmaX/sigmaY</Text></Container></ImageFiltered>
      <Container height="12" />
      <BackdropFilter sigmaX="8" sigmaY="8"><Container width="300" height="60" color="#FFFFFF44"><Text fontSize="22" color="#FFFFFFFF">E: BackdropFilter sigmaX/sigmaY</Text></Container></BackdropFilter>
    </Column>
  </Container>
</Snapshot>
