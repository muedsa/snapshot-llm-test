<Positioned left="48" top="20"><Text fontSize="20" color="#5EEAD4FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">A17 · 03 · 文本与颜色</Text></Positioned>
<Positioned left="48" top="92"><Text fontSize="34" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">原样文本、CDATA 与尾部 alpha</Text></Positioned>
<Positioned left="48" top="140"><Text fontSize="24" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Text 会 trim，Raw 不会；解析器不做 HTML 实体解码；8 位颜色的最后两位是透明度。</Text></Positioned>
<Positioned left="1020" top="20"><Container width="132" height="32" color="#1E293BFF" borderRadius="16"/></Positioned>
<Positioned left="1020" top="27" width="132"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#CBD5E1FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">PAGE 3 / 4</Text></Container></Positioned>
<Positioned left="48" top="1546"><Container width="1104" height="1" color="#E2E8F0FF"/></Positioned>
<Positioned left="48" top="1560"><Text fontSize="18" color="#94A3B8FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Snapshot DSL 入门手册 · run 20261003-114508-flashmax</Text></Positioned>
<Positioned left="852" top="1560" width="300"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#94A3B8FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">第 3 页 · 共 4 页</Text></Container></Positioned>
<Positioned left="48" top="192"><Container width="1104" height="356" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="210"><Container width="5" height="26" color="#1D4ED8FF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="208"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">1 · Text / Raw / CDATA 的实际行为</Text></Positioned>
<Positioned left="70" top="259"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="250" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Text 会 trim</Text></Container></Positioned>
<Positioned left="242" top="250"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">首尾空白丢失；要保留缩进和换行就用 Raw。</Text></Positioned>
<Positioned left="70" top="309"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="300" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">不解实体</Text></Container></Positioned>
<Positioned left="242" top="300"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">解析器不做 HTML 实体解码：&amp;larr; &amp;amp; 会原样显示，而不是变成 &amp; 。</Text></Positioned>
<Positioned left="70" top="359"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="350" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">CDATA 才是正解</Text></Container></Positioned>
<Positioned left="242" top="350"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">文本里要出现 &lt; 或 &gt; 必须用 CDATA 包住。</Text></Positioned>
<Positioned left="70" top="409"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="400" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">常见误解</Text></Container></Positioned>
<Positioned left="242" top="400"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">把 DSL 代码当普通文本写，&amp;lt; 不会变回 &lt;，而是原样印出来。</Text></Positioned>
<Positioned left="70" top="459"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="450" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">非文本标签</Text></Container></Positioned>
<Positioned left="242" top="450"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">容器里出现非空白原始文本会报 Not Support RAWTEXT。</Text></Positioned>
<Positioned left="64" top="454"><Container width="1072" height="74" color="#FEF2F2FF" borderRadius="10" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="80" top="466"><Text fontSize="20" color="#D92D20FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">真实 400 响应（本项目实测）</Text></Positioned>
<Positioned left="80" top="494"><Text fontSize="18" color="#0F172AFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">PARSE_ERROR Pos[3:18]~72: Attr [color] unsupported CSS color [not-a-color]</Text></Positioned>
<Positioned left="48" top="562"><Container width="1104" height="332" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="580"><Container width="5" height="26" color="#D97706FF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="578"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">2 · 尾部 alpha：8 位十六进制的最后两位</Text></Positioned>
<Positioned left="70" top="629"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="620" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">#RRGGBBAA</Text></Container></Positioned>
<Positioned left="242" top="620"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">前六位是色相，后两位是 alpha</Text></Positioned>
<Positioned left="242" top="649"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">：FF 不透明、 80 约 50% 、 </Text></Positioned>
<Positioned left="242" top="678"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">00 完全透明。</Text></Positioned>
<Positioned left="70" top="732"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="723" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">旧写法不再成立</Text></Container></Positioned>
<Positioned left="242" top="723"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Kotlin 侧仍是 0xAARRGGBB，</Text></Positioned>
<Positioned left="242" top="752"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">但 DSL 文本已按 CSS 的 #RRG</Text></Positioned>
<Positioned left="242" top="781"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">GBBAA 解析。</Text></Positioned>
<Positioned left="70" top="835"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="826" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">透明度合成</Text></Container></Positioned>
<Positioned left="242" top="826"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">半透明色块叠在白底与深底上结</Text></Positioned>
<Positioned left="242" top="855"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">果不同，见右图。</Text></Positioned>
<Positioned left="600" top="624"><Container width="536" height="250" color="#F8FAFCFF" borderRadius="10" border="1 SOLID #E2E8F0FF"/></Positioned>
