<Positioned left="70" top="259"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="250" width="184"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">方法与路径</Text></Container></Positioned>
<Positioned left="278" top="250"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">POST /snapshot，没有 JSON 包装。</Text></Positioned>
<Positioned left="70" top="296"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="287" width="184"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">请求头</Text></Container></Positioned>
<Positioned left="278" top="287"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Content-Type: text/plain; charset=utf-8</Text></Positioned>
<Positioned left="70" top="333"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="324" width="184"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">UTF-8</Text></Container></Positioned>
<Positioned left="278" top="324"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">带 BOM 会在位置 0 报错 Not Support RAWTEXT。</Text></Positioned>
<Positioned left="70" top="370"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="361" width="184"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">请求体</Text></Container></Positioned>
<Positioned left="278" top="361"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">就是 .snapshot 原文，以 Snapshot 为根。</Text></Positioned>
<Positioned left="70" top="407"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="398" width="184"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">根节点</Text></Container></Positioned>
<Positioned left="278" top="398"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">多一个根子节点就是 400 PARSE_ERROR。</Text></Positioned>
