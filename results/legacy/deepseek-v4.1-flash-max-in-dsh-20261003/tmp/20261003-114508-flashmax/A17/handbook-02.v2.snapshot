<Positioned left="48" top="20"><Text fontSize="20" color="#5EEAD4FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">A17 · 02 · 根尺寸与布局</Text></Positioned>
<Positioned left="48" top="92"><Text fontSize="34" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">根尺寸来自布局，不是 HTML 画布</Text></Positioned>
<Positioned left="48" top="140"><Text fontSize="24" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Snapshot 是约束布局：父节点给约束，子节点报尺寸，最后用根 RenderBox 的尺寸出图。</Text></Positioned>
<Positioned left="1020" top="20"><Container width="132" height="32" color="#1E293BFF" borderRadius="16"/></Positioned>
<Positioned left="1020" top="27" width="132"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#CBD5E1FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">PAGE 2 / 4</Text></Container></Positioned>
<Positioned left="48" top="1546"><Container width="1104" height="1" color="#E2E8F0FF"/></Positioned>
<Positioned left="48" top="1560"><Text fontSize="18" color="#94A3B8FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Snapshot DSL 入门手册 · run 20261003-114508-flashmax</Text></Positioned>
<Positioned left="852" top="1560" width="300"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#94A3B8FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">第 2 页 · 共 4 页</Text></Container></Positioned>
<Positioned left="48" top="192"><Container width="1104" height="300" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="210"><Container width="5" height="26" color="#1D4ED8FF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="208"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">1 · 定义根尺寸的三种写法</Text></Positioned>
<Positioned left="64" top="250"><Container width="700" height="64" color="#F8FAFCFF" borderRadius="8" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="80" top="269"><Text fontSize="22" color="#1D4ED8FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">width / height</Text></Positioned>
<Positioned left="300" top="269"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">固定画布：&lt;Container width="400" height="240"&gt; 根节点直接定尺。</Text></Positioned>
<Positioned left="64" top="324"><Container width="700" height="64" color="#F8FAFCFF" borderRadius="8" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="80" top="343"><Text fontSize="22" color="#1D4ED8FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">子节点决定</Text></Positioned>
<Positioned left="300" top="343"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">无尺寸容器会收缩到内容；空容器在无界约束下变成 0×0。</Text></Positioned>
<Positioned left="64" top="398"><Container width="700" height="64" color="#F8FAFCFF" borderRadius="8" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="80" top="417"><Text fontSize="22" color="#1D4ED8FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">边界情况</Text></Positioned>
<Positioned left="300" top="417"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">根尺寸为 0 或无限都会报错：先把根尺寸写死。</Text></Positioned>
<Positioned left="800" top="250"><Container width="336" height="216" color="#F8FAFCFF" borderRadius="10" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="820" top="294"><Container width="230" height="140" color="#FFFFFFFF" borderRadius="6" border="2 SOLID #0E9F8FFF"/></Positioned>
<Positioned left="820" top="266" width="300"><Container alignment="CENTER_LEFT"><Text fontSize="18" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">根 RenderBox 布局尺寸 = 输出像素</Text></Container></Positioned>
<Positioned left="830" top="346"><Text fontSize="18" color="#1D4ED8FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">width 400</Text></Positioned>
<Positioned left="830" top="370"><Text fontSize="18" color="#1D4ED8FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">height 240</Text></Positioned>
<Positioned left="830" top="400"><Text fontSize="18" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">向上取整为像素</Text></Positioned>
<Positioned left="48" top="506"><Container width="1104" height="274" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="524"><Container width="5" height="26" color="#0E9F8FFF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="522"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">2 · 有界 Row / Column / Expanded</Text></Positioned>
<Positioned left="70" top="573"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="564" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">有界主轴</Text></Container></Positioned>
<Positioned left="242" top="564"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Flex 主轴无限时无法分配剩余空间：先用 SizedBox / Container 给定尺寸。</Text></Positioned>
<Positioned left="70" top="623"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="614" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Expanded</Text></Container></Positioned>
<Positioned left="242" top="614"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">相当于 Flexible(fit=TIGHT)，强制占满分到的份额；只能是 Flex/Row/Column</Text></Positioned>
<Positioned left="242" top="646"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL"> 的直属子节点。</Text></Positioned>
<Positioned left="70" top="705"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="696" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Flexible / Spacer</Text></Container></Positioned>
<Positioned left="242" top="696"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">fit="LOOSE" 允许子节点更小；Spacer 只占位不绘制。</Text></Positioned>
<Positioned left="70" top="755"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="746" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">mainAxisSize</Text></Container></Positioned>
<Positioned left="242" top="746"><Text fontSize="24" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">MIN 时 Flex 自身收紧到内容，MAX 时撑满父约束。</Text></Positioned>
<Positioned left="48" top="794"><Container width="1104" height="236" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="812"><Container width="5" height="26" color="#D97706FF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="810"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">3 · Stack + Positioned：绝对坐标层</Text></Positioned>
<Positioned left="70" top="861"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="852" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">直属关系</Text></Container></Positioned>
<Positioned left="242" top="852"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Positioned 只能是 Stack / IndexedSta</Text></Positioned>
<Positioned left="242" top="881"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">ck 的直属子节点；放进 Column 报 parent</Text></Positioned>
<Positioned left="242" top="910"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Data 错误。</Text></Positioned>
<Positioned left="70" top="964"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="955" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">每轴两个</Text></Container></Positioned>
<Positioned left="242" top="955"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">left / right / width 中最多给两个，纵</Text></Positioned>
<Positioned left="242" top="984"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">轴同理。</Text></Positioned>
<Positioned left="70" top="1038"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="1029" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">fit="EXPAND"</Text></Container></Positioned>
<Positioned left="242" top="1029"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">让 Stack 自身撑满父约束，定位坐标才稳定</Text></Positioned>
<Positioned left="242" top="1058"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">。</Text></Positioned>
<Positioned left="700" top="852"><Container width="436" height="150" color="#F8FAFCFF" borderRadius="10" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="716" top="864"><Text fontSize="18" color="#475569FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">Stack (0,0) → 右下增长</Text></Positioned>
<Positioned left="760" top="890"><Container width="70" height="60" color="#0E9F8FFF" borderRadius="8"/></Positioned>
<Positioned left="760" top="952" width="70"><Container alignment="CENTER_RIGHT"><Text fontSize="16" color="#0F172AFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">(40,60)</Text></Container></Positioned>
