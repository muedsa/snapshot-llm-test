<Snapshot background="#FFFFFFFF" type="png">
  <Container width="400" height="240"
             gradientType="LINEAR" gradientColors="#0F172A,#1D4ED8"
             gradientBegin="TOP_LEFT" gradientEnd="BOTTOM_RIGHT">
    <Stack alignment="CENTER" fit="EXPAND">
      <Text fontSize="30" fontStyle="BOLD" color="#F8FAFC"
            fontFamily="Noto Sans CJK SC">Hello Snapshot</Text>
      <Positioned left="20" bottom="18">
        <Text fontSize="18" color="#BFDBFE"
              fontFamily="Noto Sans Mono CJK SC">POST /snapshot</Text>
      </Positioned>
    </Stack>
  </Container>
</Snapshot>
