<Positioned left="48" top="20"><Text fontSize="20" color="#5EEAD4FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">A17 · 04 · 滤镜与交付</Text></Positioned>
<Positioned left="48" top="92"><Text fontSize="34" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">背景滤镜、子树滤镜与可复现交付</Text></Positioned>
<Positioned left="48" top="140"><Text fontSize="24" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">BackdropFilter 糊已经画在背后的内容；ImageFiltered 只糊自己的子树。</Text></Positioned>
<Positioned left="1020" top="20"><Container width="132" height="32" color="#1E293BFF" borderRadius="16"/></Positioned>
<Positioned left="1020" top="27" width="132"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#CBD5E1FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">PAGE 4 / 4</Text></Container></Positioned>
<Positioned left="48" top="1546"><Container width="1104" height="1" color="#E2E8F0FF"/></Positioned>
<Positioned left="48" top="1560"><Text fontSize="18" color="#94A3B8FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Snapshot DSL 入门手册 · run 20261003-114508-flashmax</Text></Positioned>
<Positioned left="852" top="1560" width="300"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#94A3B8FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">第 4 页 · 共 4 页</Text></Container></Positioned>
<Positioned left="48" top="192"><Container width="1104" height="286" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="210"><Container width="5" height="26" color="#1D4ED8FF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="208"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">1 · 两种模糊：背景 vs 子树</Text></Positioned>
<Positioned left="70" top="259"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="250" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">BackdropFilter</Text></Container></Positioned>
<Positioned left="242" top="250"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">读取背后已经绘制的像素做高斯模糊，自己的子节</Text></Positioned>
<Positioned left="242" top="279"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">点不被模糊。</Text></Positioned>
<Positioned left="70" top="335"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="326" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">配合裁剪</Text></Container></Positioned>
<Positioned left="242" top="326"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">通常用 ClipRect / ClipRRect 限定滤镜区域，</Text></Positioned>
<Positioned left="242" top="355"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">否则笔触及全屏。</Text></Positioned>
<Positioned left="70" top="411"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="402" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">ImageFiltered</Text></Container></Positioned>
<Positioned left="242" top="402"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">只模糊自己的子树，里面的文字会一起变糊。</Text></Positioned>
<Positioned left="70" top="458"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="449" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">sigma 取值</Text></Container></Positioned>
<Positioned left="242" top="449"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">sigma 越大越糊；要保持文字锐利就把文字放在滤</Text></Positioned>
<Positioned left="242" top="478"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">镜外层。</Text></Positioned>
<Positioned left="780" top="250"><Container width="356" height="208" color="#F8FAFCFF" borderRadius="10" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="796" top="260"><Text fontSize="18" color="#475569FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">背景已有内容才有效果</Text></Positioned>
<Positioned left="796" top="298"><Container width="66" height="66" color="#1D4ED8FF" borderRadius="8"/></Positioned>
<Positioned left="870" top="298"><Container width="66" height="66" color="#0E9F8FFF" borderRadius="8"/></Positioned>
<Positioned left="944" top="298"><Container width="66" height="66" color="#D97706FF" borderRadius="8"/></Positioned>
<Positioned left="796" top="378"><Container width="320" height="60" color="#FFFFFFCC" borderRadius="8" border="2 SOLID #0E9F8FFF"/></Positioned>
<Positioned left="808" top="396"><Text fontSize="18" color="#0F172AFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">BackdropFilter sigma=8</Text></Positioned>
<Positioned left="48" top="492"><Container width="1104" height="300" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="510"><Container width="5" height="26" color="#0E9F8FFF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="508"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">2 · 视觉自检：先看图，再算数</Text></Positioned>
<Positioned left="64" top="554"><Container width="22" height="22" color="#DCFCE7FF" borderRadius="6" border="1 SOLID #16A34AFF"/></Positioned>
<Positioned left="64" top="557" width="22"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#15803DFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">✓</Text></Container></Positioned>
<Positioned left="102" top="550"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">每张最终图都用图像工具实际打开，不靠 XML、HTTP 200 或像素统计代替。</Text></Positioned>
<Positioned left="64" top="594"><Container width="22" height="22" color="#DCFCE7FF" borderRadius="6" border="1 SOLID #16A34AFF"/></Positioned>
<Positioned left="64" top="597" width="22"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#15803DFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">✓</Text></Container></Positioned>
<Positioned left="102" top="590"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">对照 TASK.md 逐项核对：尺寸、元素个数、文字是否被裁切或互相压字。</Text></Positioned>
<Positioned left="64" top="634"><Container width="22" height="22" color="#DCFCE7FF" borderRadius="6" border="1 SOLID #16A34AFF"/></Positioned>
<Positioned left="64" top="637" width="22"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#15803DFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">✓</Text></Container></Positioned>
<Positioned left="102" top="630"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">必要时放大看局部（密集区域、引导线、小字号），再回到整体看构图。</Text></Positioned>
<Positioned left="64" top="674"><Container width="22" height="22" color="#DCFCE7FF" borderRadius="6" border="1 SOLID #16A34AFF"/></Positioned>
<Positioned left="64" top="677" width="22"><Container alignment="CENTER_RIGHT"><Text fontSize="18" color="#15803DFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">✓</Text></Container></Positioned>
<Positioned left="102" top="670"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">发现问题就改 DSL 重渲染并重新打开比较，直到每项需求都成立。</Text></Positioned>
<Positioned left="48" top="806"><Container width="1104" height="210" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="824"><Container width="5" height="26" color="#D97706FF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="822"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">3 · 可复现交付</Text></Positioned>
<Positioned left="70" top="873"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="864" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">原始字节</Text></Container></Positioned>
<Positioned left="242" top="864"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">最终 PNG 直接用服务返回的原始字节，不做后处理。</Text></Positioned>
<Positioned left="70" top="920"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="911" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">同名 DSL</Text></Container></Positioned>
<Positioned left="242" top="911"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">每张图都保留同名 .snapshot，字节数与 SHA-256 一起记录。</Text></Positioned>
<Positioned left="70" top="967"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="958" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">可重现性</Text></Container></Positioned>
<Positioned left="242" top="958"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">相同 DSL 返回相同字节；用 X-Request-Id 把每次请求与输出对账。</Text></Positioned>
<Positioned left="48" top="1030"><Container width="1104" height="506" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="1048"><Container width="5" height="26" color="#1D4ED8FF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="1046"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">4 · 完整可运行示例（example-04）</Text></Positioned>
