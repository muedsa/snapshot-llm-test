<Positioned left="980" top="552"><Text fontSize="13" color="#7A6A52FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">STITCH LEDGER</Text></Positioned>
<Positioned left="980" top="582"><Text fontSize="13" color="#7A6A52FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">CLOTH</Text></Positioned>
<Positioned left="1112" top="582"><Text fontSize="14" color="#33302AFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">60 × 46 stitches</Text></Positioned>
<Positioned left="980" top="612"><Text fontSize="13" color="#7A6A52FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">BORDER</Text></Positioned>
<Positioned left="1112" top="612"><Text fontSize="14" color="#33302AFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">2 rows, A/C</Text></Positioned>
<Positioned left="980" top="642"><Text fontSize="13" color="#7A6A52FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">MOTIFS</Text></Positioned>
<Positioned left="1112" top="642"><Text fontSize="14" color="#33302AFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">4 corner flowers</Text></Positioned>
<Positioned left="980" top="672"><Text fontSize="13" color="#7A6A52FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">CENTRE</Text></Positioned>
<Positioned left="1112" top="672"><Text fontSize="14" color="#33302AFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">kestrel, 19 rows</Text></Positioned>
<Positioned left="980" top="702"><Text fontSize="13" color="#7A6A52FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">LETTERING</Text></Positioned>
<Positioned left="1112" top="702"><Text fontSize="14" color="#33302AFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">backstitch H</Text></Positioned>
<Positioned left="980" top="732"><Text fontSize="13" color="#7A6A52FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">THREAD</Text></Positioned>
<Positioned left="1112" top="732"><Text fontSize="14" color="#33302AFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">8 shades (invented)</Text></Positioned>
<Positioned left="980" top="768"><Container width="460" height="1" color="#7A6A52FF"/></Positioned>
<Positioned left="980" top="786"><Text fontSize="13" color="#7A6A52FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">HOW TO WORK IT</Text></Positioned>
<Positioned left="980" top="816"><Text fontSize="15" color="#7A6A52FF" fontFamily="Noto Serif CJK SC" fontStyle="NORMAL">Start at the centre cross and work outwards so any counting </Text></Positioned>
<Positioned left="980" top="838"><Text fontSize="15" color="#7A6A52FF" fontFamily="Noto Serif CJK SC" fontStyle="NORMAL">error stops at the border. The kestrel is the only motif that </Text></Positioned>
<Positioned left="980" top="859"><Text fontSize="15" color="#7A6A52FF" fontFamily="Noto Serif CJK SC" fontStyle="NORMAL">uses the shaded range; every other motif stays inside three sh</Text></Positioned>
<Positioned left="980" top="880"><Text fontSize="15" color="#7A6A52FF" fontFamily="Noto Serif CJK SC" fontStyle="NORMAL">ades, so the whole sampler can be stitched from one thread </Text></Positioned>
<Positioned left="980" top="902"><Text fontSize="15" color="#7A6A52FF" fontFamily="Noto Serif CJK SC" fontStyle="NORMAL">card.</Text></Positioned>
<Positioned left="980" top="1520" width="460"><Container alignment="CENTER_LEFT"><Text fontSize="12" color="#8A7A62FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">FICTIONAL SAMPLER · pattern, place name and floss numbers invented for a DSL study; not a commercial chart.</Text></Container></Positioned>
