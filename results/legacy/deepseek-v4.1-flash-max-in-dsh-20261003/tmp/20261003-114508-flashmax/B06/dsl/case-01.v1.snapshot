<Positioned left="48" top="618"><Text fontSize="15" color="#5B6B7FFF" fontFamily="Inter" fontStyle="BOLD" letterSpacing="1">WHAT EACH ONE NEEDS</Text></Positioned>
<Positioned left="48" top="644"><Container width="1504" height="34" color="#E9EDF3FF" borderRadiusTopLeft="10" borderRadiusTopRight="10"/></Positioned>
<Positioned left="60" top="652"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Inter" fontStyle="BOLD">MEDICINE</Text></Positioned>
<Positioned left="324" top="652"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Inter" fontStyle="BOLD">WHEN</Text></Positioned>
<Positioned left="528" top="652"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Inter" fontStyle="BOLD">WITH FOOD</Text></Positioned>
<Positioned left="842" top="652"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Inter" fontStyle="BOLD">KEEP IT APART FROM</Text></Positioned>
<Positioned left="1176" top="652"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Inter" fontStyle="BOLD">IF YOU MISS ONE</Text></Positioned>
<Positioned left="48" top="682"><Container width="1504" height="74" color="#FFFFFFFF"/></Positioned>
<Positioned left="48" top="682"><Container width="6" height="74" color="#7C3AEDFF"/></Positioned>
<Positioned left="70" top="692"><Text fontSize="19" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Levothyroxine</Text></Positioned>
<Positioned left="70" top="718"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">75 micrograms · thyroid replacement</Text></Positioned>
<Positioned left="324" top="700"><Text fontSize="18" color="#7C3AEDFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">07:00</Text></Positioned>
<Positioned left="528" top="694" width="288"><Container alignment="TOP_LEFT"><Text fontSize="15" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">empty stomach, 30 min before breakfast</Text></Container></Positioned>
<Positioned left="842" top="694" width="306"><Container alignment="TOP_LEFT"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">30 min before food; 4 h away from iron</Text></Container></Positioned>
<Positioned left="1176" top="694" width="364"><Container alignment="TOP_LEFT"><Text fontSize="14" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Take it as soon as you remember if it is more than 4 hours before your next iron or calcium dose; otherwise skip that day and carry on. Never double up.</Text></Container></Positioned>
<Positioned left="48" top="756"><Container width="6" height="74" color="#1D4ED8FF"/></Positioned>
<Positioned left="70" top="766"><Text fontSize="19" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Ramipril</Text></Positioned>
<Positioned left="70" top="792"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">5 mg · blood pressure</Text></Positioned>
<Positioned left="324" top="774"><Text fontSize="18" color="#1D4ED8FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">08:00</Text></Positioned>
<Positioned left="528" top="768" width="288"><Container alignment="TOP_LEFT"><Text fontSize="15" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">with or without food</Text></Container></Positioned>
<Positioned left="842" top="768" width="306"><Container alignment="TOP_LEFT"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">avoid potassium supplements; stand up slowly for the first week</Text></Container></Positioned>
<Positioned left="1176" top="768" width="364"><Container alignment="TOP_LEFT"><Text fontSize="14" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Take it when you remember on the same day. If it is nearly time for the next dose, skip the missed one.</Text></Container></Positioned>
<Positioned left="48" top="830"><Container width="1504" height="74" color="#FFFFFFFF"/></Positioned>
<Positioned left="48" top="830"><Container width="6" height="74" color="#B45309FF"/></Positioned>
<Positioned left="70" top="840"><Text fontSize="19" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Ferrous fumarate</Text></Positioned>
<Positioned left="70" top="866"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">210 mg · iron - low ferritin</Text></Positioned>
<Positioned left="324" top="848"><Text fontSize="18" color="#B45309FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">12:00 + 20:00</Text></Positioned>
<Positioned left="528" top="842" width="288"><Container alignment="TOP_LEFT"><Text fontSize="15" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">1 hour before food, with water or juice</Text></Container></Positioned>
<Positioned left="842" top="842" width="306"><Container alignment="TOP_LEFT"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">2 h away from calcium; 4 h away from levothyroxine</Text></Container></Positioned>
<Positioned left="1176" top="842" width="364"><Container alignment="TOP_LEFT"><Text fontSize="14" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">If you miss a dose, take it at least 2 hours away from your calcium tablets. Do not take two doses closer together than 6 hours.</Text></Container></Positioned>
<Positioned left="48" top="904"><Container width="6" height="74" color="#0E9F8FFF"/></Positioned>
<Positioned left="70" top="914"><Text fontSize="19" color="#101820FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Calcium carbonate</Text></Positioned>
<Positioned left="70" top="940"><Text fontSize="14" color="#5B6B7FFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">1.25 g · bone protection</Text></Positioned>
<Positioned left="324" top="922"><Text fontSize="18" color="#0E9F8FFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">13:00 + 21:00</Text></Positioned>
