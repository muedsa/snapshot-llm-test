<Snapshot background="#0F172A" type="png">
  <Container width="1600" height="1000" padding="(24,28)">
    <Column crossAxisAlignment="START">

      <!-- 标题 -->
      <Container width="1544" height="50" color="#1E293B" borderRadius="8" border="1 SOLID #334155" padding="(12,16)">
        <Text color="#F1F5F9" fontSize="24" fontStyle="BOLD">转化变化，为什么不能只看平均？</Text>
      </Container>

      <SizedBox height="12"/>

      <!-- 三图区域 -->
      <Row mainAxisAlignment="SPACE_BETWEEN">

        <!-- 图1：渠道分组率图 -->
        <Container width="480" height="400" color="#1E293B" borderRadius="8" border="1 SOLID #334155" padding="(12,14)">
          <Column crossAxisAlignment="START">
            <Text color="#F1F5F9" fontSize="16" fontStyle="BOLD">渠道分组转化率</Text>
            <SizedBox height="8"/>
            <Text color="#94A3B8" fontSize="12">同一0-100%尺度</Text>
            <SizedBox height="12"/>
            <!-- 直接访问 -->
            <Text color="#F1F5F9" fontSize="14" fontStyle="BOLD">直接访问</Text>
            <SizedBox height="6"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#94A3B8" fontSize="12">前期</Text>
              <SizedBox width="8"/>
              <Container width="200" height="24" color="#10B981" borderRadius="4"/>
              <SizedBox width="8"/>
              <Text color="#F1F5F9" fontSize="14">30.0%</Text>
            </Row>
            <SizedBox height="6"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#94A3B8" fontSize="12">后期</Text>
              <SizedBox width="8"/>
              <Container width="210" height="24" color="#EF4444" borderRadius="4"/>
              <SizedBox width="8"/>
              <Text color="#F1F5F9" fontSize="14">35.0%</Text>
            </Row>
            <SizedBox height="16"/>
            <!-- 推广访问 -->
            <Text color="#F1F5F9" fontSize="14" fontStyle="BOLD">推广访问</Text>
            <SizedBox height="6"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#94A3B8" fontSize="12">前期</Text>
              <SizedBox width="8"/>
              <Container width="60" height="24" color="#10B981" borderRadius="4"/>
              <SizedBox width="8"/>
              <Text color="#F1F5F9" fontSize="14">10.0%</Text>
            </Row>
            <SizedBox height="6"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#94A3B8" fontSize="12">后期</Text>
              <SizedBox width="8"/>
              <Container width="72" height="24" color="#EF4444" borderRadius="4"/>
              <SizedBox width="8"/>
              <Text color="#F1F5F9" fontSize="14">12.0%</Text>
            </Row>
          </Column>
        </Container>

        <!-- 图2：访问构成堆叠图 -->
        <Container width="480" height="400" color="#1E293B" borderRadius="8" border="1 SOLID #334155" padding="(12,14)">
          <Column crossAxisAlignment="START">
            <Text color="#F1F5F9" fontSize="16" fontStyle="BOLD">访问构成</Text>
            <SizedBox height="8"/>
            <Text color="#94A3B8" fontSize="12">每期等长，分段按真实占比</Text>
            <SizedBox height="12"/>
            <!-- 前期 -->
            <Text color="#F1F5F9" fontSize="14" fontStyle="BOLD">前期</Text>
            <SizedBox height="6"/>
            <Row crossAxisAlignment="CENTER">
              <Container width="320" height="32" color="#3B82F6" borderRadius="4"/>
              <Container width="80" height="32" color="#F59E0B" borderRadius="4"/>
            </Row>
            <SizedBox height="4"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#3B82F6" fontSize="12">直接访问 80%</Text>
              <SizedBox width="16"/>
              <Text color="#F59E0B" fontSize="12">推广访问 20%</Text>
            </Row>
            <SizedBox height="16"/>
            <!-- 后期 -->
            <Text color="#F1F5F9" fontSize="14" fontStyle="BOLD">后期</Text>
            <SizedBox height="6"/>
            <Row crossAxisAlignment="CENTER">
              <Container width="80" height="32" color="#3B82F6" borderRadius="4"/>
              <Container width="320" height="32" color="#F59E0B" borderRadius="4"/>
            </Row>
            <SizedBox height="4"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#3B82F6" fontSize="12">直接访问 20%</Text>
              <SizedBox width="16"/>
              <Text color="#F59E0B" fontSize="12">推广访问 80%</Text>
            </Row>
          </Column>
        </Container>

        <!-- 图3：总体对照 -->
        <Container width="480" height="400" color="#1E293B" borderRadius="8" border="1 SOLID #334155" padding="(12,14)">
          <Column crossAxisAlignment="START">
            <Text color="#F1F5F9" fontSize="16" fontStyle="BOLD">总体转化率对照</Text>
            <SizedBox height="8"/>
            <Text color="#94A3B8" fontSize="12">总体 = 总成交数 / 总访问数</Text>
            <SizedBox height="12"/>
            <!-- 前期 -->
            <Text color="#F1F5F9" fontSize="14" fontStyle="BOLD">前期</Text>
            <SizedBox height="6"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#94A3B8" fontSize="12">成交</Text>
              <SizedBox width="8"/>
              <Container width="156" height="28" color="#10B981" borderRadius="4"/>
              <SizedBox width="8"/>
              <Text color="#F1F5F9" fontSize="14">2600</Text>
            </Row>
            <SizedBox height="4"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#94A3B8" fontSize="12">访问</Text>
              <SizedBox width="8"/>
              <Container width="300" height="28" color="#10B981" borderRadius="4"/>
              <SizedBox width="8"/>
              <Text color="#F1F5F9" fontSize="14">10000</Text>
            </Row>
            <SizedBox height="4"/>
            <Text color="#F1F5F9" fontSize="16" fontStyle="BOLD">总体转化率：26.0%</Text>
            <SizedBox height="16"/>
            <!-- 后期 -->
            <Text color="#F1F5F9" fontSize="14" fontStyle="BOLD">后期</Text>
            <SizedBox height="6"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#94A3B8" fontSize="12">成交</Text>
              <SizedBox width="8"/>
              <Container width="100" height="28" color="#EF4444" borderRadius="4"/>
              <SizedBox width="8"/>
              <Text color="#F1F5F9" fontSize="14">1660</Text>
            </Row>
            <SizedBox height="4"/>
            <Row crossAxisAlignment="CENTER">
              <Text color="#94A3B8" fontSize="12">访问</Text>
              <SizedBox width="8"/>
              <Container width="300" height="28" color="#EF4444" borderRadius="4"/>
              <SizedBox width="8"/>
              <Text color="#F1F5F9" fontSize="14">10000</Text>
            </Row>
            <SizedBox height="4"/>
            <Text color="#F1F5F9" fontSize="16" fontStyle="BOLD">总体转化率：16.6%</Text>
          </Column>
        </Container>

      </Row>

      <SizedBox height="12"/>

      <!-- 结论 -->
      <Container width="1544" height="120" color="#1E293B" borderRadius="8" border="1 SOLID #334155" padding="(12,16)">
        <Column crossAxisAlignment="START">
          <Text color="#F1F5F9" fontSize="16" fontStyle="BOLD">结论</Text>
          <SizedBox height="6"/>
          <Text color="#94A3B8" fontSize="14">分组转化率均提升（直接访问30%→35%，推广访问10%→12%），但总体转化率下降（26%→16.6%）。</Text>
          <SizedBox height="4"/>
          <Text color="#94A3B8" fontSize="14">原因是访问构成从直接访问为主（80%）转变为推广访问为主（80%）。</Text>
          <SizedBox height="4"/>
          <Text color="#94A3B8" fontSize="14">限制：不能由该数据证明因果，只能说明相关性。</Text>
        </Column>
      </Container>

      <!-- 数据表 -->
      <Container width="1544" height="120" color="#1E293B" borderRadius="8" border="1 SOLID #334155" padding="(12,14)">
        <Column crossAxisAlignment="START">
          <Text color="#F1F5F9" fontSize="14" fontStyle="BOLD">原始数据</Text>
          <SizedBox height="6"/>
          <Row mainAxisAlignment="SPACE_BETWEEN">
            <Text color="#94A3B8" fontSize="12">期间</Text>
            <Text color="#94A3B8" fontSize="12">渠道</Text>
            <Text color="#94A3B8" fontSize="12">访问数</Text>
            <Text color="#94A3B8" fontSize="12">成交数</Text>
            <Text color="#94A3B8" fontSize="12">转化率</Text>
          </Row>
          <Row mainAxisAlignment="SPACE_BETWEEN">
            <Text color="#F1F5F9" fontSize="12">前期</Text>
            <Text color="#F1F5F9" fontSize="12">直接访问</Text>
            <Text color="#F1F5F9" fontSize="12">8000</Text>
            <Text color="#F1F5F9" fontSize="12">2400</Text>
            <Text color="#F1F5F9" fontSize="12">30.0%</Text>
          </Row>
          <Row mainAxisAlignment="SPACE_BETWEEN">
            <Text color="#F1F5F9" fontSize="12">前期</Text>
            <Text color="#F1F5F9" fontSize="12">推广访问</Text>
            <Text color="#F1F5F9" fontSize="12">2000</Text>
            <Text color="#F1F5F9" fontSize="12">200</Text>
            <Text color="#F1F5F9" fontSize="12">10.0%</Text>
          </Row>
          <Row mainAxisAlignment="SPACE_BETWEEN">
            <Text color="#F1F5F9" fontSize="12">后期</Text>
            <Text color="#F1F5F9" fontSize="12">直接访问</Text>
            <Text color="#F1F5F9" fontSize="12">2000</Text>
            <Text color="#F1F5F9" fontSize="12">700</Text>
            <Text color="#F1F5F9" fontSize="12">35.0%</Text>
          </Row>
          <Row mainAxisAlignment="SPACE_BETWEEN">
            <Text color="#F1F5F9" fontSize="12">后期</Text>
            <Text color="#F1F5F9" fontSize="12">推广访问</Text>
            <Text color="#F1F5F9" fontSize="12">8000</Text>
            <Text color="#F1F5F9" fontSize="12">960</Text>
            <Text color="#F1F5F9" fontSize="12">12.0%</Text>
          </Row>
        </Column>
      </Container>

    </Column>
  </Container>
</Snapshot>