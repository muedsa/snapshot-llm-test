ioned left="1066" top="710" width="474" height="22"><Container width="474" height="22" alignment="CENTER_LEFT"><Text fontSize="14" color="#8A8172" fontFamily="Inter,Noto Sans CJK SC">口径尺寸需与压圈 CNC 程序一并复核，否则冬夏两地装配力差异会显现</Text></Container></Positioned><Positioned left="1040" top="739" width="18" height="18"><Container width="18" height="18" color="#C8552B" borderRadius="9.0"/></Positioned><Positioned left="1041" top="740" width="18" height="18"><Container width="18" height="18" alignment="CENTER"><Text fontSize="13" color="#F2EFE9" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">2</Text></Container></Positioned><Positioned left="1066" top="738" width="474" height="24"><Container width="474" height="24" alignment="CENTER_LEFT"><Text fontSize="15" color="#3A3A38" fontFamily="Inter,Noto Sans CJK SC">密封圈实际装于筒身退刀槽，爆炸图置于尾盖之后</Text></Container></Positioned><Positioned left="1066" top="762" width="474" height="22"><Container width="474" height="22" alignment="CENTER_LEFT"><Text fontSize="14" color="#8A8172" fontFamily="Inter,Noto Sans CJK SC">评审按装配顺序讲，不把序号当安装位置；顺序表已按实物排列</Text></Container></Positioned><Positioned left="1040" top="791" width="18" height="18"><Container width="18" height="18" color="#C8552B" borderRadius="9.0"/></Positioned><Positioned left="1041" top="792" width="18" height="18"><Container width="18" height="18" alignment="CENTER"><Text fontSize="13" color="#F2EFE9" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD">3</Text></Container></Positioned><Positioned left="1066" top="790" width="474" height="24"><Container width="474" height="24" alignment="CENTER_LEFT"><Text fontSize="15" color="#3A3A38" fontFamily="Inter,Noto Sans CJK SC">驱动板未画限流电阻位，需确认与 Ø28 内壁净空</Text></Container></Positioned><Positioned left="1066" top="814" width="474" height="22"><Container width="474" height="22" alignment="CENTER_LEFT"><Text fontSize="14" color="#8A8172" fontFamily="Inter,Noto Sans CJK SC">如补件，Ø28 内径与板边间隙小于 1.5 mm，需改筒身或改板框</Text></Container></Positioned><Positioned left