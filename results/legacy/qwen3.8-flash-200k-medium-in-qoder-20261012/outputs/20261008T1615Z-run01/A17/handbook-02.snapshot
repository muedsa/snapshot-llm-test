<Snapshot background="#F4F6FB" type="png"><Container width="1200" height="1600"><Stack alignment="TOP_LEFT" clipBehavior="NONE"><Positioned left="48" top="48" width="6" height="78"><Container width="6" height="78" color="#1F4FD8"/></Positioned><Positioned left="70" top="46" width="1082" height="35"><Container width="1082" height="35" alignment="TOP_LEFT"><Text color="#6B7C97" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">第 2 页 / 共 4 页 · 布局</Text></Container></Positioned><Positioned left="70" top="74" width="1082" height="55"><Container width="1082" height="55" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="38" fontFamily="Inter Semi Bold,Noto Sans CJK SC" fontStyle="BOLD">尺寸来自布局，不是 CSS</Text></Container></Positioned><Positioned left="70" top="130" width="1082" height="35"><Container width="1082" height="35" alignment="TOP_LEFT"><Text color="#48587A" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">BoxConstraints、有界主轴与 Stack 定位规则</Text></Container></Positioned><Positioned left="48" top="174" width="1104" height="1"><Container width="1104" height="1" color="#DDE4EF"/></Positioned><Positioned left="48" top="198" width="1104" height="38"><Container width="1104" height="38" alignment="TOP_LEFT"><Text color="#1F4FD8" fontSize="26" fontFamily="Inter Semi Bold,Noto Sans CJK SC" fontStyle="BOLD">Box 布局协议</Text></Container></Positioned><Positioned left="53.5" top="247.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="236" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">父传 BoxConstraints（默认 0 到无穷），子在其中选定尺寸，父再决定位置。</Text></Container></Positioned><Positioned left="53.5" top="279.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="268" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">Container 的 width/height 是收紧约束，父级更严格的约束仍然生效。</Text></Container></Positioned><Positioned left="48" top="312" width="1104" height="38"><Container width="1104" height="38" alignment="TOP_LEFT"><Text color="#1F4FD8" fontSize="26" fontFamily="Inter Semi Bold,Noto Sans CJK SC" fontStyle="BOLD">根尺寸从哪里来</Text></Container></Positioned><Positioned left="53.5" top="361.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="350" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">Snapshot 不接受单独的画布宽高，固定画布要用根 Container 或 SizedBox 表达。</Text></Container></Positioned><Positioned left="53.5" top="393.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="382" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">Surface 取根 RenderBox 的布局尺寸并向上取整为像素。</Text></Container></Positioned><Positioned left="53.5" top="425.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="414" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">根尺寸为 0 → layout size is empty；无限 → layout size is infinite。</Text></Container></Positioned><Positioned left="53.5" top="457.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="446" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">更大的 Surface 不会放大内容，只会多出右侧与底部的背景。</Text></Container></Positioned><Positioned left="48" top="490" width="1104" height="38"><Container width="1104" height="38" alignment="TOP_LEFT"><Text color="#1F4FD8" fontSize="26" fontFamily="Inter Semi Bold,Noto Sans CJK SC" fontStyle="BOLD">Row / Column / Expanded</Text></Container></Positioned><Positioned left="53.5" top="539.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="528" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">Row、Column 都是 Flex 的特化；Expanded 等价于 Flexible(fit = TIGHT)。</Text></Container></Positioned><Positioned left="53.5" top="571.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="560" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">三者只能是 Flex、Row 或 Column 的直接子节点，否则 parentData 类型不匹配。</Text></Container></Positioned><Positioned left="53.5" top="603.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="592" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">主轴无限就没有剩余空间可分配，先用外层容器给出有限主轴。</Text></Container></Positioned><Positioned left="53.5" top="635.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="624" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">flex 是正整数权重；允许子节点小于份额时改用 Flexible 或 Spacer。</Text></Container></Positioned><Positioned left="48" top="668" width="1104" height="38"><Container width="1104" height="38" alignment="TOP_LEFT"><Text color="#1F4FD8" fontSize="26" fontFamily="Inter Semi Bold,Noto Sans CJK SC" fontStyle="BOLD">Stack 与 Positioned</Text></Container></Positioned><Positioned left="53.5" top="717.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="706" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">Stack 先布局非 Positioned 子节点，由它们决定 Stack 尺寸。</Text></Container></Positioned><Positioned left="53.5" top="749.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="738" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">同一轴 left、right、width 最多给两项：两边推尺寸，一边加尺寸推另一侧。</Text></Container></Positioned><Positioned left="53.5" top="781.5" width="7" height="7"><Container width="7" height="7" color="#1F4FD8" borderRadius="3.5"/></Positioned><Positioned left="78" top="770" width="1074" height="35"><Container width="1074" height="35" alignment="TOP_LEFT"><Text color="#101A2E" fontSize="24" fontFamily="Inter,Noto Sans CJK SC">Stack 的 clipBehavior 默认 HARD_EDGE，要显示溢出或阴影需显式写 NONE。</Text></Container></Positioned><Positioned left="48" top="814" width="1104" height="381"><Container width="1104" height="381" color="#0E1729" borderRadius="16"/></Positioned><Positioned left="74" top="826" width="784" height="32"><Container width="784" height="32" alignment="TOP_LEFT"><Text color="#9FB4D4" fontSize="22" fontFamily="Inter Semi Bold,Noto Sans CJK SC">example-02.snapshot · 与独立渲染结果同一份 DSL</Text></Container></Positioned><Positioned left="852" top="826" width="274" height="64"><Container width="274" height="64" alignment="TOP_RIGHT"><Text color="#FBBF24" fontSize="22" fontFamily="Inter,Noto Sans CJK SC">印刷第 4–13 行 / 全 24 行</Text></Container></Positioned><Positioned left="74" top="860" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88">  4</Raw></Text></Positioned><Positioned left="126" top="860" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[      <Text color="#94A3B8" fontSize="13">Row：主轴有界，Expanded 才有剩余空间可分]]></Raw></Text></Positioned><Positioned left="126" top="889" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#A9BAD6"><![CDATA[↳ </Text>]]></Raw></Text></Positioned><Positioned left="74" top="918" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88">  5</Raw></Text></Positioned><Positioned left="126" top="918" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[      <Row crossAxisAlignment="START">]]></Raw></Text></Positioned><Positioned left="74" top="947" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88">  6</Raw></Text></Positioned><Positioned left="126" top="947" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[        <Expanded flex="2"><Container height="46" color="#38BDF8" /></Expanded>]]></Raw></Text></Positioned><Positioned left="74" top="976" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88">  7</Raw></Text></Positioned><Positioned left="126" top="976" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[        <Expanded flex="1"><Container height="46" color="#A78BFA" /></Expanded>]]></Raw></Text></Positioned><Positioned left="74" top="1005" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88">  8</Raw></Text></Positioned><Positioned left="126" top="1005" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[        <Expanded flex="1"><Container height="46" color="#34D399" /></Expanded>]]></Raw></Text></Positioned><Positioned left="74" top="1034" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88">  9</Raw></Text></Positioned><Positioned left="126" top="1034" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[      </Row>]]></Raw></Text></Positioned><Positioned left="74" top="1063" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88"> 10</Raw></Text></Positioned><Positioned left="126" top="1063" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[      <Container height="12" />]]></Raw></Text></Positioned><Positioned left="74" top="1092" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88"> 11</Raw></Text></Positioned><Positioned left="126" top="1092" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[      <Text color="#94A3B8" fontSize="13">Stack：Positioned 每轴最多给两项</Text>]]></Raw></Text></Positioned><Positioned left="74" top="1121" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88"> 12</Raw></Text></Positioned><Positioned left="126" top="1121" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[      <Container width="360" height="76" color="#132038">]]></Raw></Text></Positioned><Positioned left="74" top="1150" width="46" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#5B6C88"> 13</Raw></Text></Positioned><Positioned left="126" top="1150" width="1000" height="29"><Text fontSize="20" fontFamily="DejaVu Sans Mono,Noto Sans Mono CJK SC"><Raw color="#DCE6F5"><![CDATA[        <Stack alignment="TOP_LEFT" clipBehavior="NONE">]]></Raw></Text></Positioned><Positioned left="48" top="1205" width="1104" height="32"><Container width="1104" height="32" alignment="TOP_LEFT"><Text color="#6B7C97" fontSize="22" fontFamily="Inter,Noto Sans CJK SC">⋮ 省略的行 · ↳ 续行 · 第 1–3 行根标签与内边距，第 14–24 行 Stack 块与收尾。</Text></Container></Positioned><Positioned left="48" top="1243" width="1104" height="218"><Container width="1104" height="218" color="#FFFFFF" borderRadius="16" border="1 SOLID #DDE4EF"/></Positioned><Positioned left="74" top="1257" width="1052" height="32"><Container width="1052" height="32" alignment="TOP_LEFT"><Text color="#6B7C97" fontSize="22" fontFamily="Inter,Noto Sans CJK SC">本页构件直接绘制：flex 份额与 Positioned 两种写法</Text></Container></Positioned><Positioned left="74" top="1291" width="1052" height="44"><Row crossAxisAlignment="START" mainAxisAlignment="START"><Expanded flex="3"><Container width="200" height="44" color="#1F4FD8" borderRadius="8"/></Expanded><Expanded flex="2"><Container width="200" height="44" color="#7C3AED" borderRadius="8"/></Expanded><Expanded flex="1"><Container width="200" height="44" color="#0F766E" borderRadius="8"/></Expanded></Row></Positioned><Positioned left="86" top="1341" width="506" height="29"><Container width="506" height="29" alignment="TOP_LEFT"><Text color="#1F4FD8" fontSize="20" fontFamily="Inter Semi Bold,Noto Sans CJK SC">flex 3 ≈ 50%</Text></Container></Positioned><Positioned left="612" top="1341" width="330.67" height="29"><Container width="330.67" height="29" alignment="TOP_LEFT"><Text color="#7C3AED" fontSize="20" fontFamily="Inter Semi Bold,Noto Sans CJK SC">flex 2 ≈ 33%</Text></Container></Positioned><Positioned left="962.67" top="1341" width="155.33" height="29"><Container width="155.33" height="29" alignment="TOP_LEFT"><Text color="#0F766E" fontSize="20" fontFamily="Inter Semi Bold,Noto Sans CJK SC">flex 1 ≈ 17%</Text></Container></Positioned><Positioned left="74" top="1371" width="1052" height="78"><Container width="1052" height="78" color="#EEF2FA" borderRadius="12"/></Positioned><Positioned left="88" top="1381" width="1024" height="22"><Container width="1024" height="22" color="#FBBF24" borderRadius="6"/></Positioned><Positioned left="88" top="1409" width="400" height="29"><Container width="400" height="29" alignment="TOP_LEFT"><Text color="#8A5A00" fontSize="20" fontFamily="Inter,Noto Sans CJK SC">left + right ⇒ 宽度由两边推导</Text></Container></Positioned><Positioned left="500" top="1409" width="190" height="22"><Container width="190" height="22" color="#1F4FD8" borderRadius="6"/></Positioned><Positioned left="704" top="1409" width="400" height="29"><Container width="400" height="29" alignment="TOP_LEFT"><Text color="#48587A" fontSize="20" fontFamily="Inter,Noto Sans CJK SC">left + width ⇒ 另一侧被推出</Text></Container></Positioned><Positioned left="48" top="1520" width="1104" height="1"><Container width="1104" height="1" color="#DDE4EF"/></Positioned><Positioned left="48" top="1526" width="844" height="32"><Container width="844" height="32" alignment="TOP_LEFT"><Text color="#6B7C97" fontSize="22" fontFamily="Inter,Noto Sans CJK SC">Snapshot DSL 入门手册 · 从文字到图片</Text></Container></Positioned><Positioned left="892" top="1526" width="260" height="32"><Container width="260" height="32" alignment="TOP_RIGHT"><Text color="#1F4FD8" fontSize="22" fontFamily="Inter Semi Bold,Noto Sans CJK SC">主题：布局与定位</Text></Container></Positioned></Stack></Container></Snapshot>
