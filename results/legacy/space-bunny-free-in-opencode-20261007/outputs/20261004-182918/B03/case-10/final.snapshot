<Positioned left="84.0" top="1015" width="458.0" height="14">
<Text color="#9DB4CCFF" fontSize="10.0" fontFamily="Inter,Noto Sans CJK SC" text="非定位子节点会被拉满 Stack，width/height 失效；矩形必须包在 Positioned 里。" />
</Positioned>
<Positioned left="556.0" top="1002" width="8" height="8">
<Container color="#67E8F9FF" borderRadius="2.0" width="8" height="8" />
</Positioned>
<Positioned left="572.0" top="998" width="458.0" height="16">
