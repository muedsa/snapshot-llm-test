<Snapshot type="png" background="#F1F4F8" debug="false"><Container width="1200" height="1600"><Stack fit="EXPAND" clipBehavior="HARD_EDGE"><Positioned left="64" top="52" width="780" height="38"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#2964D8" fontStyle="BOLD"><Raw><![CDATA[SNAPSHOT / 从文字到图片]]></Raw></Text></Positioned>
<Positioned left="944" top="52" width="208" height="38"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#536780" textAlign="RIGHT"><Raw><![CDATA[入门手册 01 / 04]]></Raw></Text></Positioned>
<Positioned left="64" top="112" width="1088" height="74"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="46" color="#172D48" fontStyle="BOLD"><Raw><![CDATA[01 / 先调用，再核对响应]]></Raw></Text></Positioned>
<Positioned left="64" top="205" width="1088" height="92"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="28" color="#536780" height="1.35"><Raw><![CDATA[把类 DOM 文本提交给 Snapshot 服务。它将 Widget 树布局、绘制并编码为图片；先识别响应类型，再保存可复现结果。]]></Raw></Text></Positioned>
<Positioned left="64" top="315" width="1088" height="2"><Container width="1088" height="2" color="#D8E3EE"/></Positioned>
<Positioned left="64" top="341" width="1088" height="44"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="28" color="#172D48" fontStyle="BOLD"><Raw><![CDATA[先记住这些规则]]></Raw></Text></Positioned>
<Positioned left="69" top="402" width="8" height="8"><Container width="8" height="8" color="#2964D8" shape="CIRCLE"/></Positioned>
<Positioned left="92" top="386" width="1060" height="43"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#172D48"><Raw><![CDATA[POST /snapshot；请求体是 UTF-8 纯文本，Content-Type 为 text/plain。]]></Raw></Text></Positioned>
<Positioned left="69" top="445" width="8" height="8"><Container width="8" height="8" color="#2964D8" shape="CIRCLE"/></Positioned>
<Positioned left="92" top="429" width="1060" height="43"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#172D48"><Raw><![CDATA[type="png" / "jpg" / "webp"；成功 200 返回对应格式的图片字节。]]></Raw></Text></Positioned>
<Positioned left="69" top="488" width="8" height="8"><Container width="8" height="8" color="#2964D8" shape="CIRCLE"/></Positioned>
<Positioned left="92" top="472" width="1060" height="43"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#172D48"><Raw><![CDATA[检查 HTTP 状态与 Content-Type，再把原字节保存为匹配的后缀。]]></Raw></Text></Positioned>
<Positioned left="64" top="544" width="650" height="38"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="26" color="#172D48" fontStyle="BOLD"><Raw><![CDATA[可运行 DSL / 印刷片段]]></Raw></Text></Positioned>
<Positioned left="64" top="594" width="650" height="554"><Container width="650" height="554" color="#172D48" borderRadius="14"/></Positioned>
<Positioned left="86" top="610" width="606" height="526"><Text fontFamily="DejaVu Sans Mono" fontSize="20" color="#F4F8FC" height="1.35"><Raw><![CDATA[<Snapshot type="png">
<Container width="400" height="240"
  color="#DDF6EF" padding="24">
<Column mainAxisAlignment="CENTER"
  crossAxisAlignment="START">
<Text fontFamily="Inter" fontSize="32"
  color="#172D48" fontStyle="BOLD">
<Raw>Hello Snapshot</Raw>
</Text>
<Container height="12"/>
<Text fontFamily="Inter" fontSize="24"
  color="#2964D8">
<Raw>DSL to PNG / 400 x 240</Raw>
</Text>
</Column>
</Container>
</Snapshot>]]></Raw></Text></Positioned>
<Positioned left="64" top="1155" width="1088" height="32"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#536780"><Raw><![CDATA[完整示例：第 1–17 行，无省略。400×240 根尺寸由 Container 布局给出。]]></Raw></Text></Positioned>
<Positioned left="748" top="606" width="400" height="240"><Container width="400" height="240"
  color="#DDF6EF" padding="24">
<Column mainAxisAlignment="CENTER"
  crossAxisAlignment="START">
<Text fontFamily="Inter" fontSize="32"
  color="#172D48" fontStyle="BOLD">
<Raw>Hello Snapshot</Raw>
</Text>
<Container height="12"/>
<Text fontFamily="Inter" fontSize="24"
  color="#2964D8">
<Raw>DSL to PNG / 400 x 240</Raw>
</Text>
</Column>
</Container></Positioned>
<Positioned left="748" top="873" width="400" height="41"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="26" color="#172D48" fontStyle="BOLD"><Raw><![CDATA[真实 DSL 构件 / 400×240]]></Raw></Text></Positioned>
<Positioned left="748" top="926" width="400" height="192"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#536780" height="1.4"><Raw><![CDATA[右侧由同一示例的根 Widget 直接绘制。

另存 example-01.snapshot，独立请求可复现此图。]]></Raw></Text></Positioned>
<Positioned left="64" top="1212" width="520" height="242"><Container width="520" height="242" color="#FFFFFF" border="1 SOLID #D8E3EE" borderRadius="14"/></Positioned>
<Positioned left="86" top="1233" width="476" height="38"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="26" color="#172D48" fontStyle="BOLD"><Raw><![CDATA[遇到错误：先读消息]]></Raw></Text></Positioned>
<Positioned left="86" top="1283" width="476" height="148"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#536780" height="1.35"><Raw><![CDATA[常规错误 JSON 含 code、message、requestId。400 修 DSL；413 缩小请求体；401 检查凭据。错误体不能当 PNG。]]></Raw></Text></Positioned>
<Positioned left="608" top="1212" width="544" height="242"><Container width="544" height="242" color="#FFFFFF" border="1 SOLID #D8E3EE" borderRadius="14"/></Positioned>
<Positioned left="630" top="1233" width="500" height="38"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="26" color="#172D48" fontStyle="BOLD"><Raw><![CDATA[重试与关联记录]]></Raw></Text></Positioned>
<Positioned left="630" top="1283" width="500" height="148"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#536780" height="1.35"><Raw><![CDATA[429 / 部分 503 参考 Retry-After。保留 X-Request-Id。默认不加 errorImage=png；错误图仍为 400。]]></Raw></Text></Positioned>
<Positioned left="64" top="1496" width="1088" height="1"><Container width="1088" height="1" color="#D8E3EE"/></Positioned>
<Positioned left="64" top="1513" width="820" height="38"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#536780"><Raw><![CDATA[真实请求 → 实际看图 → 保存原图与完整 .snapshot]]></Raw></Text></Positioned>
<Positioned left="1044" top="1513" width="108" height="38"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#2964D8" fontStyle="BOLD" textAlign="RIGHT"><Raw><![CDATA[01]]></Raw></Text></Positioned></Stack></Container></Snapshot>
