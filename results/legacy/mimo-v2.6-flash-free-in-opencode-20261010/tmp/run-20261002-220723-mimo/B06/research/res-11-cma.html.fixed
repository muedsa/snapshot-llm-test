		<script>
		$(function(){
    $.getJSON('https://weather.cma.cn/api/alarm/newIndexalarm?callback=?', function(res){
        // 国家级预警列表
        var gjAlarmHtml = [];
        for(var i = 0; i < res.data.gj.length; i++){
            var alarm = res.data.gj[i];
            gjAlarmHtml.push('<a href="https://weather.cma.cn' + alarm.link + '" target="_blank">' + alarm.description + '</a>');
        }
        //把a标签渲染进#gjAlarmList
        $('#gjAlarmList').html(gjAlarmHtml.join(''));

        // =========【新增】渲染完成后，执行liMarquee无缝左滚动 =========
        // direction:'left' 从右向左滚动；direction:'right' 从左向右滚动
        $('#gjAlarmList').liMarquee({
            direction:'left',    /*从左到右滚动，和你的需求匹配*/
            scrollamount:40,       /*滚动速度，数值越大越快，可自行调*/
            circular:true,        /*无缝循环*/
            hoverstop:true        /*鼠标悬浮停止滚动*/
        });

        alarmflip();
    });		
});

//====下面原有alarmflip全部保持原样不动====
function alarmflip(){
    try {
        clearTimeout($vv);
    }catch(e){}

    $v=$(".list_hp_qxyj:visible");
    $vi=$(".list_hp_qxyj").index($v);
    	if ($vi == $(".list_hp_qxyj").length-1)
    {
        $vi=0;
    }else
    {
        $vi=$vi+1;	
    }
    $nextv=$(".list_hp_qxyj").eq($vi);


    $(".con_list_hp_qxyj").flip({
            color:'transparent',				   
            direction:'tb',
            speed:150,
            onAnimation:function(){
                color:'#333',
                $v.hide();
                $nextv.show();
            }
    });
    $vv=setTimeout ("alarmflip()",4000);
}

$(".con_list_hp_qxyj").find(".list_hp_qxyj").on("mouseover",function(){
    try {
        clearTimeout($vv);
    }catch(e){}  
    });
$(".con_list_hp_qxyj").find(".list_hp_qxyj").on("mouseout",function(){
    try {
        clearTimeout($vv);
    }catch(e){}
    $vv=setTimeout ("alarmflip()",4000);
});	
		</script>

		<!-- 预警滚动 -->
		
		<!-- 天气提示滚动 -->
		<script>
// 1.路径拼接函数（已验证拼接正常）
function buildXmlUrl(date) {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    const ymd = String(y) + m + d;
    const finalUrl = "https://weather.cma.cn/file/" + y + "/" + m + "/" + d + "/SEVP_NMC_CDWP_SFER_EME_ACHN_LNO_P9_" + ymd + "000000000.xml";
    console.log("拼接生成XML地址：", finalUrl);
    return finalUrl;
}

const MY_NS = "http://schemas.microsoft.com/office/infopath/2003/myXSD/2009-02-20T10:21:28";

//跑马灯全局变量
let timer = null;
let pauseTimer = null;
const startScroll = 0;
let isPaused = false;

function initMarquee() {
    const $box = $('#tqts');
    const dom = $box[0];
    clearInterval(timer);
    clearTimeout(pauseTimer);
    isPaused = false;
    dom.scrollLeft = startScroll;

    const isOverflow = dom.scrollWidth > dom.clientWidth;
    if (!isOverflow) {
        dom.scrollLeft = 0;
        return;
    }
    const maxScroll = dom.scrollWidth - dom.clientWidth;

    timer = setInterval(function () {
        if(isPaused){
            return;
        }
        dom.scrollLeft += 1;

        // 滚到末尾，停顿1.5秒
        if (dom.scrollLeft >= maxScroll) {
            isPaused = true;
            pauseTimer = setTimeout(function () {
                dom.scrollLeft = startScroll;
                // 回到初始位置，停顿1.5秒再继续滚动
                pauseTimer = setTimeout(function(){
                    isPaused = false;
                }, 1500);
            }, 1500);
        }
    }, 30);
}

function loadAlarmXml() {
    const today = new Date();
    const todayUrl = buildXmlUrl(today);

    $.ajax({
        url: todayUrl,
        type: "GET",
        dataType: "text",
        success: function (xmlText) {
            parseXml(xmlText);
        },
        error: function () {
            console.log("当日文件403/不存在，自动切换前一天");
            const yesterday = new Date();
            yesterday.setDate(yesterday.getDate() - 1);
            const yesterdayUrl = buildXmlUrl(yesterday);
            $.ajax({
                url: yesterdayUrl,
                type: "GET",
                dataType: "text",
                success: function (xmlText) {
                    parseXml(xmlText);
                },
                error: function () {
                    console.error("当日、前一日xml均访问失败");
                    // 失败清空a标签文本
                    $('#tqts > a').text("");
                    initMarquee();
                }
            })
        }
    })
}

function parseXml(xmlText) {
    const parser = new DOMParser();
    const xmlDoc = parser.parseFromString(xmlText, "text/xml");
    const absNode = xmlDoc.getElementsByTagNameNS(MY_NS, "ReportAbstract")[0];
    let txt = "";
    if (absNode) {
        txt = absNode.textContent.trim();
    } else {
        console.warn("未找到 <my:ReportAbstract> 节点");
    }
    //  赋值到内部a标签
    $('#tqts > a').text(txt);
    // 赋值完再初始化跑马灯
    initMarquee();
}


$(function () {
    loadAlarmXml();

    $(window).on('resize', function () {
        clearInterval(timer);
        clearTimeout(pauseTimer);
        isPaused = false;
        initMarquee();
    });
});
</script>


