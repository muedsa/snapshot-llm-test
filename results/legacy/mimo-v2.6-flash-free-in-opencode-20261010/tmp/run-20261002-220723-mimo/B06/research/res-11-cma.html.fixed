		<p style="background: #f5f5f5; text-align: center; padding-bottom: 30px; margin: 0px;"><script id="_jiucuo_" sitecode='bm54000001' src='https://zfwzgl.www.gov.cn/exposure/jiucuo.js'></script><a href="http://wza.isc.org.cn/rzpt/bsgl/dt/20231008/2291.html" target="_blank"><img src="./images/wzabs.png" height="55" style="margin-left: 15px;" border="0" /></a></p>

		<script>
function loadScript(src, timeout) {

    return new Promise((resolve, reject) => {


        const script = document.createElement('script');


        script.src = src;


        const timer = setTimeout(() => {


            script.onerror = null;


            script.onload = null;


            reject(new Error(`Script load timed out: `));


        }, timeout);


        script.onload = () => {


            clearTimeout(timer);


            resolve();


        };


        script.onerror = () => {


            clearTimeout(timer);


            reject(new Error(`Script load error: `));


        };


        document.head.appendChild(script);


    });


}


loadScript('//gov.govwza.cn/dist/aria.js?appid=36c3046abdea26b42920efa4387c3d53', 3000)


    .then(() => {


        console.log('Script loaded successfully');


    })


    .catch((error) => {


        console.error(error.message);


    });
loadScript('//ta.trs.cn/c/js/ta.js?mpid=6224', 3000)


    .then(() => {


        console.log('Script loaded successfully');


    })



    .catch((error) => {


        console.error(error.message);



    });
</script>
