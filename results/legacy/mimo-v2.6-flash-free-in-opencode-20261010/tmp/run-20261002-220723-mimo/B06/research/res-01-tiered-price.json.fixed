false,"gname":"","subjectword":"","url":"https://www.gov.cn/zhengce/zhengceku/202605/content_7070540.htm","childtype":"城乡建设、环境保护\\城市规划","pubtime":1779966000000,"shixiao":"","puborg":"国务院","syqt":""},{"piclinksurl":"","code":"","pcode":"国发〔2026〕7号","source":"","title":"国务院关于推进服务业扩能提质的意见","totalCount":0,"pubtimeStr":"2026.04.21","fwzh":"","imgurl":"","dateType":true,"fwdw":"","theme":false,"currentNum":0,"id":"26016856","themeLinks":[],"ptime":1776157200000,"fcode":"","summary":"实施专业技术人才知识更新工程。完善中国特色职业技能竞赛体系。发展求职招聘大模型、虚拟现实培训等服务产品。深入开展“一带一路”人力资源服务行动。 三、提升生活性服务业重点领域发展能级 （七）增加<em>居民</em>服务","wenhao":"","wjlx":"","index":"000014349/2026-00026","zhengtype":"","personal":false,"gname":"","subjectword":"","url":"https://www.gov.cn/zhengce/zhengceku/202604/content_7066484.htm","childtype":"商贸、海关、旅游\\其他","pubtime":1776762000000,"shixiao":"","puborg":"国务院","syqt":""},{"piclinksurl":"","code":"","pcode":"国令第823号","source":"","title":"全民阅读促进条例","totalCount":0,"pubtimeStr":"2025.12.16","fwzh":"","imgurl":"","dateType":true,"fwdw":"","theme":false,"currentNum":0,"id":"25354064","themeLinks":[],"ptime":1765270800000,"fcode":"","summary":"建立健全安全管理制度，依法配备安全保护设备和人员，保障全民阅读设施和公众活动安全。 第二十一条　新建、改建和扩建<em>居民</em>住宅区配套建设的公共文化设施应当包括全民阅读设施，为<em>居民</em>提供阅读服务。 第二十二条　任何","wenhao":"","wjlx":"","index":"000014349/2025-00097","zhengtype":"","personal":false,"gname":"","subjectword":"","url":"https://www.gov.cn/zhengce/zhengceku/202512/content_7051859.htm","childtype":"文化、广电、新闻出版\\文化","pubtime":1765875600000,"shixiao":"","puborg":"国务院","syqt":""},{"piclinksurl":"","code":"","pcode":"国发〔2024〕12号","source":"","title":"国务院关于印发《2024—2025年节能降碳行动方案》的通知","totalCount":0,"pubtimeStr":"2024.05.29","fwzh":"","imgurl":"","dateType":true,"fwdw":"","theme":false,"currentNum":0,"id":"22089688","themeLinks":[],"ptime":1716452492000,"fcode":"","summary":"与产业政策、环保政策的协同，综合考虑能耗、环保绩效水平，完善高耗能行业<em>阶梯</em><em>电价</em>制度。深化供热计量收费改革，有序推行两部制热价。 （三）加强资金支持。发挥政府投资带动放大效应，积极支持节能降碳改造和用能","wenhao":"","wjlx":"","index":"000014349/2024-00046","zhengtype":"","personal":false,"gname":"","subjectword":"","url":"https://www.gov.cn/zhengce/zhengceku/202405/content_6954323.htm","childtype":"城乡建设、环境保护\\节能与资源综合利用","pubtime":1716980220000,"shixiao":"","puborg":"国务院","syqt":""},{"piclinksurl":"","code":"","pcode":"国办函〔2024〕20号","source":"","title":"国务院办公厅关于转发国家发展改革委、住房城乡建设部《加快推动建筑领域节能降碳工作方案》的通知","totalCount":0,"pubtimeStr":"2024.03.15","fwzh":"","imgurl":"","dateType":true,"fwdw":"","theme":false,"currentNum":0,"id":"21648452","themeLinks":[],"ptime":1710235499000,"fcode":"","summary":"节能降碳管理。加大高效节能家电等设备推广力度，鼓励<em>居民</em>加快淘汰低效落后用能设备。建立公共建筑节能监管体系，科学制定能耗限额基准，明确高耗能高排放建筑改造要求，公示改造信息，加强社会监督。各地区要加快建立","wenhao":"","wjlx":"","index":"000014349/2024-00027","zhengtype":"","personal":false,"gname":"","subjectword":"","url":"https://www.gov.cn/zhengce/zhengceku/202403/content_6939607.htm","childtype":"城乡建设、环境保护\\其他","pubtime":1710503820000,"shixiao":"","puborg":"国务院办公厅","syqt":""},{"piclinksurl":"","code":"","pcode":"国发〔2024〕7号","source":"","title":"国务院关于印发《推动大规模设备更新和消费品以旧换新行动方案》的通知","totalCount":0,"pubtimeStr":"2024.03.13","fwzh":"","imgurl":"","dateType":true,"fwdw":"","theme":false,"currentNum":0,"id":"21645865","themeLinks":[],"ptime":1709801095000,"fcode":"","summary":"以旧换新、回收循环利用、标准提升四大行动，大力促进先进设备生产应用，推动先进产能比重持续提升，推动高质量耐用消费品更多进入<em>居民</em>生活，畅通资源循环利用链条，大幅提高国民经济循环质量和水平。 ——坚持市场为主、","wenhao":"","wjlx":"","index":"000014349/2024-00025","zhengtype":"","personal":false,"gname":"","subjectword":"","url":"https://www.gov.cn/zhengce/zhengceku/202403/content_6939233.htm","childtype":"工业、交通\\机械制造与重工业","pubtime":1710327420000,"shixiao":"","puborg":"国务院","syqt":""},{"piclinksurl":"","code":"","pcode":"国令第776号","source":"","title":"节约用水条例","totalCount":0,"pubtimeStr":"2024.03.20","fwzh":"","imgurl":"","dateType":true,"fwdw":"","theme":false,"currentNum":0,"id":"21683977","themeLinks":[],"ptime":1709964600000,"fcode":"","summary":"用水和具备条件的农村<em>居民</em>生活用水实行<em>阶梯</em>水价，非<em>居民</em>用水实行超定额（超计划）累进加价。 农业水价应当依法统筹供水成本、水资源稀缺程度和农业用