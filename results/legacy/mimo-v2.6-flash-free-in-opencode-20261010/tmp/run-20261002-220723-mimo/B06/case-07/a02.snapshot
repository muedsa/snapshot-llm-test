ioned left="430" top="684" width="98" height="28"><Text fontSize="18" fontFamily="Noto Sans Mono CJK SC" color="#0E1317" textAlign="RIGHT" maxLines="1">4,640</Text></Positioned><Positioned left="40" top="710" width="300" height="22"><Text fontSize="14" fontFamily="Noto Sans CJK SC" color="#5C6674" textAlign="LEFT" maxLines="1">是否已含在月租里，看合同措辞</Text></Positioned><Positioned left="40" top="732" width="371.2" height="5"><Container width="371.2" height="5" color="#4C5FD5" borderRadius="3"/></Positioned><Positioned left="32" top="764" width="496" height="1"><Container width="496" height="1" color="#B6AE9E"/></Positioned><Positioned left="32" top="778" width="300" height="28"><Text fontSize="21" fontFamily="Noto Sans CJK SC" color="#0E1317" textAlign="LEFT" maxLines="1">两种结局</Text></Positioned><Positioned left="32" top="812" width="241" height="150"><Container width="241" height="150" color="#FFFFFF" borderRadius="10" border="1 SOLID #D8D2C6"/></Positioned><Positioned left="52" top="834" width="201" height="26"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#5C6674" textAlign="LEFT" maxLines="1">全部扣掉</Text></Positioned><Positioned left="52" top="864" width="201" height="52"><Text fontSize="34" fontFamily="Inter Black" color="#0E1317" textAlign="LEFT" maxLines="1">¥4,640</Text></Positioned><Positioned left="52" top="920" width="201" height="24"><Text fontSize="14" fontFamily="Noto Sans CJK SC" color="#5C6674" textAlign="LEFT" maxLines="1">争议项也算你头上</Text></Positioned><Positioned left="287" top="812" width="241" height="150"><Container width="241" height="150" color="#FFFFFF" borderRadius="10" border="1 SOLID #D8D2C6"/></Positioned><Positioned left="307" top="834" width="201" height="26"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#5C6674" textAlign="LEFT" maxLines="1">争回争议项</Text></Positioned><Positioned left="307" top="864" width="201" height="52"><Text fontSize="34" fontFamily="Inter Black" color="#E0A33C" textAlign="LEFT" maxLines="1">¥5,240</Text><