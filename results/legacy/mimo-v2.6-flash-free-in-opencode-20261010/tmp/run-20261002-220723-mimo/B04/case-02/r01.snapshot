<Snapshot type="png" background="#F3EFE5"><Container width="1748" height="760" color="#F3EFE5"><Stack clipBehavior="NONE"><Positioned left="60" top="50" width="260" height="32.4"><Text fontSize="18" fontFamily="Noto Sans Mono CJK SC" color="#6E675A" textAlign="LEFT" maxLines="1">LEAP SECOND  —  02 / 10</Text></Positioned><Positioned left="1168" top="50" width="520" height="32.4"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#6E675A" textAlign="RIGHT" maxLines="1">定义演变</Text></Positioned><Positioned left="60" top="86" width="1628" height="2"><Container width="1628" height="2" color="#D6CEBC"/></Positioned><Positioned left="60" top="122" width="700" height="90"><Text fontSize="58" fontFamily="Noto Serif CJK SC" color="#0B1015" textAlign="LEFT" maxLines="1">一秒有多长？</Text></Positioned><Positioned left="988" top="140" width="700" height="40"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#6E675A" textAlign="RIGHT" maxLines="1">从天文到原子：定义的五次落点</Text></Positioned><Positioned left="60" top="222" width="1628" height="40"><Text fontSize="23" fontFamily="Noto Sans CJK SC" color="#6E675A" textAlign="LEFT" maxLines="1">「秒」不是量出来的，是约定出来的。今天这个约定正在被再次改写。</Text></Positioned><Positioned left="60" top="370" width="1628" height="2"><Container width="1628" height="2" color="#0B1015"/></Positioned><Positioned left="40" top="290" width="300" height="56"><Text fontSize="40" fontFamily="Noto Sans Mono CJK SC" color="#0B1015" textAlign="CENTER" maxLines="1">1820</Text></Positioned><Positioned left="179" top="359" width="22" height="22"><Container width="22" height="22" shape="CIRCLE" color="#FFB100" border="2 SOLID #0B1015"/></Positioned><Positioned left="40" top="410" width="300" height="300"><Container width="300" height="300" color="#FFFFFF" borderRadius="10" border="1 SOLID #D6CEBC" boxShadow="0 4 14 #C9C2B233"/></Positioned><Positioned left="62" top="434" width="256" height="40"><Text fontSize="25" fontFamily="Noto Serif CJK SC" color="#0B1015" textAlign="LEFT" maxLine