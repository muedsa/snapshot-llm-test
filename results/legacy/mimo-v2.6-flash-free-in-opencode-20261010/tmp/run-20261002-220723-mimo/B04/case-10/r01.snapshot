<Snapshot type="png" background="#F3EFE5"><Container width="1600" height="640" color="#F3EFE5"><Stack clipBehavior="NONE"><Positioned left="60" top="48" width="260" height="30.6"><Text fontSize="17" fontFamily="Noto Sans Mono CJK SC" color="#6E675A" textAlign="LEFT" maxLines="1">LEAP SECOND  —  10 / 10</Text></Positioned><Positioned left="1020" top="48" width="520" height="30.6"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#6E675A" textAlign="RIGHT" maxLines="1">收尾 / CLOSING</Text></Positioned><Positioned left="60" top="82" width="1480" height="2"><Container width="1480" height="2" color="#D6CEBC"/></Positioned><Positioned left="60" top="120" width="710" height="420"><Container width="710" height="420" color="#121A22" borderRadius="12" border="1 SOLID #FF5C4D"/></Positioned><Positioned left="88" top="148" width="654" height="40"><Text fontSize="28" fontFamily="Noto Serif CJK SC" color="#FF5C4D" textAlign="LEFT" maxLines="1">反向的一秒：负闰秒</Text></Positioned><Positioned left="88" top="194" width="60" height="3"><Container width="60" height="3" color="#FF5C4D"/></Positioned><Positioned left="88" top="216" width="654" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">CGPM 决议 4（2022）写道：地球自转的</Text></Positioned><Positioned left="88" top="246" width="654" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">近期观测显示，可能需要首次「负闰秒」，</Text></Positioned><Positioned left="88" top="276" width="654" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">而它的插入「从未被预见，也未被测试过」。</Text></Positioned><Positioned left="88" top="306" width="654" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">—— 以下为编辑解释，非引文：</Text></Positioned><Positioned left="88" top="336" width="654" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">负闰秒意味着删掉一个 23:59:59，世界时</Text></Positioned><Positioned left="88" top="366" width="654" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">第一次跳过一秒钟。目前没有现成系统、</Text></Positioned><Positioned left="88" top="396" width="654" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">没有历史样本，也没有可以照抄的先例。</Text></Positioned><Positioned left="88" top="452" width="654" height="1"><Container width="654" height="1" color="#3A4855"/></Positioned><Positioned left="88" top="470" width="54" height="54"><Container width="54" height="54" color="#182128" borderRadius="4"/></Positioned><Positioned left="100" top="484" width="30" height="26"><Container width="30" height="26" color="#3A4855"/></Positioned><Positioned left="88" top="530" width="200" height="26"><Text fontSize="16" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">保留</Text></Positioned><Positioned left="154" top="484" width="152" height="26"><Text fontSize="17" fontFamily="Noto Sans Mono CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">23:59:58</Text></Positioned><Positioned left="312" top="470" width="54" height="54"><Container width="54" height="54" color="#2E1A18" borderRadius="4"/></Positioned><Positioned left="316" top="494" width="46" height="3"><Container width="46" height="3" color="#FF5C4D"/></Positioned><Positioned left="312" top="470" width="4" height="54"><Container width="4" height="54" color="#FF5C4D"/></Positioned><Positioned left="312" top="530" width="200" height="26"><Text fontSize="16" fontFamily="Noto Sans CJK SC" color="#FF5C4D" textAlign="LEFT" maxLines="1">跳过（拟议）</Text></Positioned><Positioned left="378" top="484" width="152" height="26"><Text fontSize="17" fontFamily="Noto Sans Mono CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">23:59:59</Text></Positioned><Positioned left="536" top="470" width="54" height="54"><Container width="54" height="54" color="#182128" borderRadius="4"/></Positioned><Positioned left="548" top="484" width="30" height="26"><Container width="30" height="26" color="#3A4855"/></Positioned><Positioned left="536" top="530" width="200" height="26"><Text fontSize="16" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">保留</Text></Positioned><Positioned left="602" top="484" width="152" height="26"><Text fontSize="17" fontFamily="Noto Sans Mono CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">00:00:00</Text></Positioned><Positioned left="830" top="120" width="710" height="420"><Container width="710" height="420" color="#121A22" borderRadius="12" border="1 SOLID #FFB100"/></Positioned><Positioned left="858" top="148" width="460" height="40"><Text fontSize="28" fontFamily="Noto Serif CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">工具箱：给工程师的 6 条</Text></Positioned><Positioned left="858" top="194" width="60" height="3"><Container width="60" height="3" color="#FFB100"/></Positioned><Positioned left="1404" top="148" width="108" height="32"><Container width="108" height="32" color="#2C2410" borderRadius="4"/></Positioned><Positioned left="1404" top="148" width="108" height="32"><Text fontSize="16" fontFamily="Noto Sans CJK SC" color="#FFB100" textAlign="CENTER" maxLines="1">编辑建议</Text></Positioned><Positioned left="858" top="216" width="26" height="26"><Container width="26" height="26" color="#FFB100" borderRadius="3"/></Positioned><Positioned left="858" top="216" width="26" height="26"><Text fontSize="16" fontFamily="Noto Sans Mono CJK SC" color="#0B1015" textAlign="CENTER" maxLines="1">1</Text></Positioned><Positioned left="896" top="218" width="614" height="26"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">别假设一天总是 86 400 秒：按 UTC 语义处理。</Text></Positioned><Positioned left="858" top="268" width="26" height="26"><Container width="26" height="26" color="#FFB100" borderRadius="3"/></Positioned><Positioned left="858" top="268" width="26" height="26"><Text fontSize="16" fontFamily="Noto Sans Mono CJK SC" color="#0B1015" textAlign="CENTER" maxLines="1">2</Text></Positioned><Positioned left="896" top="270" width="614" height="26"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">存储与比对用连续时标（TAI 或 Unix 秒），并写明口径。</Text></Positioned><Positioned left="858" top="320" width="26" height="26"><Container width="26" height="26" color="#FFB100" borderRadius="3"/></Positioned><Positioned left="858" top="320" width="26" height="26"><Text fontSize="16" fontFamily="Noto Sans Mono CJK SC" color="#0B1015" textAlign="CENTER" maxLines="1">3</Text></Positioned><Positioned left="896" top="322" width="614" height="26"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">显示层与本地时区分开，闰秒只发生在 UTC 层。</Text></Positioned><Positioned left="858" top="372" width="26" height="26"><Container width="26" height="26" color="#FFB100" borderRadius="3"/></Positioned><Positioned left="858" top="372" width="26" height="26"><Text fontSize="16" fontFamily="Noto Sans Mono CJK SC" color="#0B1015" textAlign="CENTER" maxLines="1">4</Text></Positioned><Positioned left="896" top="374" width="614" height="26"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">测试用例里放一个 23:59:60，也放一个不存在的 23:59:59。</Text></Positioned><Positioned left="858" top="424" width="26" height="26"><Container width="26" height="26" color="#FFB100" borderRadius="3"/></Positioned><Positioned left="858" top="424" width="26" height="26"><Text fontSize="16" fontFamily="Noto Sans Mono CJK SC" color="#0B1015" textAlign="CENTER" maxLines="1">5</Text></Positioned><Positioned left="896" top="426" width="614" height="26"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">长周期（超过 27 年）调度按 TAI 计算，避免累积偏差。</Text></Positioned><Positioned left="858" top="476" width="26" height="26"><Container width="26" height="26" color="#FFB100" borderRadius="3"/></Positioned><Positioned left="858" top="476" width="26" height="26"><Text fontSize="16" fontFamily="Noto Sans Mono CJK SC" color="#0B1015" textAlign="CENTER" maxLines="1">6</Text></Positioned><Positioned left="896" top="478" width="614" height="26"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">每年 1 月与 7 月查 IERS Bulletin C；关注 2026 年 CGPM。</Text></Positioned><Positioned left="60" top="566" width="1480" height="1"><Container width="1480" height="1" color="#D6CEBC"/></Positioned><Positioned left="60" top="576" width="1480" height="30"><Text fontSize="16" fontFamily="Noto Sans CJK SC" color="#6E675A" textAlign="LEFT" maxLines="1">来源：BIPM CGPM 决议 4 / 5（2022）· IERS Bulletin C 72（2026-07-06）· 工具箱 6 条为编辑建议，非来源结论</Text></Positioned></Stack></Container></Snapshot>
