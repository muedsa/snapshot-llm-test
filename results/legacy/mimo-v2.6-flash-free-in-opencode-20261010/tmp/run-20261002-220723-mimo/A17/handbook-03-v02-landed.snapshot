<Snapshot type="png">
  <Container width="1200" height="1600" color="#F1F5F9">
    <Stack>
      <Positioned left="48" top="48"><Container color="#1D4ED8" borderRadius="8" padding="(6,14)"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#FFFFFF">P3 · 文本与颜色</Text></Container></Positioned>
      <Positioned left="48" top="103"><Text fontSize="40" fontFamily="Noto Sans CJK SC" color="#0F172A">原样保留的文本与尾随透明度</Text></Positioned>
      <Positioned left="48" top="169"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">谁修剪空白、谁保留空白，以及颜色末尾两位</Text></Positioned>
      <Positioned left="48" top="218"><Container width="1104" height="346" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="242"><ClipRect>
    <Container width="400" height="240" color="#0F172A" padding="12">
      <Column>
        <Text fontSize="20" color="#FFFFFF">tail alpha · Raw · CDATA</Text>
        <Container width="376" height="48"><Row>
          <Container width="125" height="48" color="#3B82F6FF"/>
          <Container width="125" height="48" color="#3B82F680"/>
          <Container width="126" height="48" color="#3B82F626"/>
        </Row></Container>
        <Text fontSize="20" color="#94A3B8">#RRGGBBAA not #AARRGGBB</Text>
        <Text fontSize="20" color="#94A3B8">old #80FF0000 = new #FF000080</Text>
        <Text fontSize="20" color="#CBD5E1"><![CDATA[CDATA keeps <tag> and &]]></Text>
        <Text fontSize="20" color="#CBD5E1">Text<Raw>    keeps spaces</Raw></Text>
        <Text fontSize="16" color="#94A3B8">FF = opaque, 26 = faint</Text>
        <Text fontSize="16" color="#94A3B8">Kotlin DSL: 0xAARRGGBB</Text>
      </Column>
    </Container>
      </ClipRect></Positioned>
      <Positioned left="496" top="242"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">这一步要弄清什么</Text></Positioned>
      <Positioned left="496" top="300"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• Text 会修剪自己首尾的空白</Text></Positioned>
      <Positioned left="496" top="340"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• Raw 只能写在 Text 里，用来保住空格</Text></Positioned>
      <Positioned left="496" top="380"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155"><![CDATA[• CDATA 原样保留 < > &，不走实体解码]]></Text></Positioned>
      <Positioned left="496" top="420"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 颜色写 #RRGGBBAA，末两位是透明度</Text></Positioned>
      <Positioned left="496" top="460"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• Kotlin 侧 0xAARRGGBB，顺序正好相反</Text></Positioned>
      <Positioned left="72" top="505"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#64748B">图 3 · example-03.snapshot 的真实渲染（400×240，未做后期处理）</Text></Positioned>
      <Positioned left="48" top="578"><Container width="1104" height="656" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="602"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">可复制的完整文件：打印 16 行原文 + 1 行省略标注</Text></Positioned>
      <Positioned left="72" top="646"><Container width="1056" height="564" color="#0F172A" borderRadius="8"/></Positioned>
