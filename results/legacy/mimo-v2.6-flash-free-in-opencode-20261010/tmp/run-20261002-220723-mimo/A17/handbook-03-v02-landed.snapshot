      <Positioned left="88" top="912"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      </Row></Container>]]></Raw></Text></Positioned>
      <Positioned left="88" top="944"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      <Text fontSize="20" color="#94A3B8">#RRGGBBAA not #AARRGGBB</Text>]]></Raw></Text></Positioned>
      <Positioned left="88" top="976"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      <Text fontSize="20" color="#94A3B8">old #80FF0000 = new #FF000080</Text>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1008"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      <Text fontSize="20" color="#CBD5E1"><![CDATA[CDATA keeps <tag> and &]]]]><![CDATA[></Text>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1040"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      <Text fontSize="20" color="#CBD5E1">Text<Raw>    keeps spaces</Raw></Text>]]></Raw></Text></Positioned>
