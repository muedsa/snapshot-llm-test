<Snapshot type="png">
  <Container width="1200" height="1600" color="#F1F5F9">
    <Stack>
      <Positioned left="48" top="48"><Container color="#1D4ED8" borderRadius="8" padding="(6,14)"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#FFFFFF">P4 · 滤镜与自检</Text></Container></Positioned>
      <Positioned left="48" top="103"><Text fontSize="40" fontFamily="Noto Sans CJK SC" color="#0F172A">背景滤镜、子树滤镜与自检</Text></Positioned>
      <Positioned left="48" top="169"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">先分清滤的是身后还是自己，再逐层做验证</Text></Positioned>
      <Positioned left="48" top="218"><Container width="1104" height="346" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="242"><ClipRect>
    <Container width="400" height="240" color="#0F172A">
      <Column>
        <Stack><Column>
          <Container width="400" height="48" color="#245CE4"/>
          <Container width="400" height="48" color="#E88E35"/>
          <Container width="400" height="48" color="#22C55E"/>
          <Container width="400" height="48" color="#E83D6B"/>
        </Column>
          <Positioned left="0" top="0" width="150" height="192">
            <ClipRect><BackdropFilter sigmaX="8" sigmaY="8">
              <Container width="150" height="192" color="#FFFFFF44"/>
            </BackdropFilter></ClipRect></Positioned>
        </Stack>
        <ImageFiltered sigmaX="5" sigmaY="5"><Text fontSize="30" color="#FFF">BLUR</Text>
        </ImageFiltered>
      </Column></Container>
      </ClipRect></Positioned>
      </Positioned>
      <Positioned left="496" top="242"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">这一步要弄清什么</Text></Positioned>
      <Positioned left="496" top="300"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• BackdropFilter 滤它身后已画好的内容</Text></Positioned>
      <Positioned left="496" top="340"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• ImageFiltered 滤子树自己的绘制结果</Text></Positioned>
      <Positioned left="496" top="380"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 毛玻璃需要 ClipRect 或 ClipRRect 限区</Text></Positioned>
      <Positioned left="496" top="420"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 背后没有内容时，背景滤镜等于没生效</Text></Positioned>
      <Positioned left="496" top="460"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 先量像素再看图，别只凭肉眼判断</Text></Positioned>
      <Positioned left="72" top="505"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#64748B">图 4 · example-04.snapshot 的真实渲染（400×240，未做后期处理）</Text></Positioned>
      <Positioned left="48" top="578"><Container width="1104" height="656" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="602"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">可复制的完整文件：打印 16 行原文 + 1 行省略标注</Text></Positioned>
      <Positioned left="72" top="646"><Container width="1056" height="564" color="#0F172A" borderRadius="8"/></Positioned>
      <Positioned left="88" top="656"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[<Snapshot type="png">]]></Raw></Text></Positioned>
      <Positioned left="88" top="688"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[  <Container width="400" height="240" color="#0F172A">]]></Raw></Text></Positioned>
      <Positioned left="88" top="720"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[    <Column>]]></Raw></Text></Positioned>
      <Positioned left="88" top="752"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      <Stack><Column>]]></Raw></Text></Positioned>
      <Positioned left="88" top="784"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#F59E0B"><Raw><![CDATA[<!--省略 example-04.snapshot 第 5、6 行（两条色带）；完整文件共 18 行 -->]]></Raw></Text></Positioned>
      <Positioned left="88" top="816"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[        <Container width="400" height="48" color="#22C55E"/>]]></Raw></Text></Positioned>
      <Positioned left="88" top="848"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[        <Container width="400" height="48" color="#E83D6B"/>]]></Raw></Text></Positioned>
      <Positioned left="88" top="880"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      </Column>]]></Raw></Text></Positioned>
      <Positioned left="88" top="912"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[        <Positioned left="0" top="0" width="150" height="192">]]></Raw></Text></Positioned>
      <Positioned left="88" top="944"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[          <ClipRect><BackdropFilter sigmaX="8" sigmaY="8">]]></Raw></Text></Positioned>
      <Positioned left="88" top="976"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[            <Container width="150" height="192" color="#FFFFFF44"/>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1008"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[          </BackdropFilter></ClipRect></Positioned>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1040"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      </Stack>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1072"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      <ImageFiltered sigmaX="5" sigmaY="5"><Text fontSize="30" color="#FFF">BLUR</Text>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1104"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      </ImageFiltered>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1136"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[    </Column></Container>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1168"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[</Snapshot>]]></Raw></Text></Positioned>
      <Positioned left="48" top="1248"><Container width="1104" height="254" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="1272"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">这一步的踩坑</Text></Positioned>
      <Positioned left="72" top="1326"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• ImageFiltered 在同一 Stack 里会让背景滤镜失效</Text></Positioned>
      <Positioned left="72" top="1365"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 布局、像素、黄金图、产物四层都要验</Text></Positioned>
      <Positioned left="72" top="1404"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 产物只是结果，不是断言</Text></Positioned>
      <Positioned left="72" top="1443"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 黄金图不稳时先查字体与抗锯齿</Text></Positioned>
      <Positioned left="48" top="1516"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#64748B">A17 文档手册 · 第 4 / 4 页 · 滤镜与自检</Text></Positioned>
      <Positioned left="528" top="1516"><Container width="624" height="35" alignment="CENTER_RIGHT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#64748B">来源：open-snapshot AI Guide、Snapshot DSL 文档</Text></Container></Positioned>
    </Stack>
  </Container>
</Snapshot>
