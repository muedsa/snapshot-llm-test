      <Positioned left="1274" top="198"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">可走格 . · 每格 2 米</Text></Positioned>
      <Positioned left="1238" top="238" width="26" height="26"><Container width="26" height="26" color="#22314F" border="1 SOLID #FBBF24" borderRadius="4"/></Positioned>
      <Positioned left="1274" top="240"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">门洞 · 单格通行</Text></Positioned>
      <Positioned left="1238" top="280" width="26" height="26"><Container width="26" height="26" color="#0F3A2E" border="2 SOLID #34D399" borderRadius="4"/></Positioned>
      <Positioned left="1274" top="282"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">入口 S (2,2)</Text></Positioned>
      <Positioned left="1238" top="322" width="26" height="26"><Container width="26" height="26" color="#3A2C0F" border="2 SOLID #FBBF24" borderRadius="4"/></Positioned>
      <Positioned left="1274" top="324"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">出口 E (23,15)</Text></Positioned>
      <Positioned left="1238" top="364" width="26" height="26"><Container width="26" height="26" color="#232B55" border="2 SOLID #818CF8" borderRadius="4"/></Positioned>
      <Positioned left="1274" top="366"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">展区 A/B/C/D</Text></Positioned>
      <Positioned left="1238" top="403" width="26" height="8"><Container width="26" height="8" color="#F43F5E" borderRadius="3"/></Positioned>
      <Positioned left="1274" top="408"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">路线一 S→E 实线</Text></Positioned>
      <Positioned left="1238" top="445" width="11" height="8"><Container width="11" height="8" color="#38BDF8" borderRadius="3"/></Positioned>
      <Positioned left="1253" top="445" width="11" height="8"><Container width="11" height="8" color="#38BDF8" borderRadius="3"/></Positioned>
      <Positioned left="1274" top="450"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">路线二 S→B→D→E 虚线</Text></Positioned>
      <Positioned left="1238" top="500"><Text fontSize="26" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#F8FAFC" fontStyle="BOLD">两条路线</Text></Positioned>
      <Positioned left="1238" top="542"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">路线二须先 B 后 D，</Text></Positioned>
      <Positioned left="1238" top="568"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">每一段都取最短路。</Text></Positioned>
      <Positioned left="1238" top="594"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">重合处：虚线叠在实线上</Text></Positioned>
      <Positioned left="1238" top="620"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">两种线型都能追踪。</Text></Positioned>
      <Positioned left="1238" top="650"><Text fontSize="26" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#F8FAFC" fontStyle="BOLD">移动与计步</Text></Positioned>
      <Positioned left="1238" top="692"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">只能上下左右跨格，</Text></Positioned>
      <Positioned left="1238" top="720"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">不能斜穿或穿墙。</Text></Positioned>
      <Positioned left="1238" top="748"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">门洞按原格通行，</Text></Positioned>
      <Positioned left="1238" top="776"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">不加宽、不新增开口。</Text></Positioned>
      <Positioned left="1238" top="804"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">步数 = 格间移动次数；</Text></Positioned>
      <Positioned left="1238" top="832"><Text fontSize="22" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#A8BCD8">米数 = 步数 × 2。</Text></Positioned>
      <Positioned left="1238" top="884"><Text fontSize="26" height="1.0" fontFamily="Inter,Noto Sans CJK SC" color="#F8FAFC" fontStyle="BOLD">尺度</Text></Positioned>
