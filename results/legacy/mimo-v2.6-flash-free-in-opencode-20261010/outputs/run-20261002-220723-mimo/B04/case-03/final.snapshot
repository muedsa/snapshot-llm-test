or="#C9D6E3"/></Positioned><Positioned left="1090" top="700.72" width="6" height="4.8"><Container width="6" height="4.8" color="#C9D6E3"/></Positioned><Positioned left="1095" top="701.53" width="6" height="5.09"><Container width="6" height="5.09" color="#C9D6E3"/></Positioned><Positioned left="1100" top="702.62" width="6" height="5.37"><Container width="6" height="5.37" color="#C9D6E3"/></Positioned><Positioned left="1105" top="703.98" width="6" height="5.63"><Container width="6" height="5.63" color="#C9D6E3"/></Positioned><Positioned left="1110" top="705.62" width="6" height="5.89"><Container width="6" height="5.89" color="#C9D6E3"/></Positioned><Positioned left="1115" top="707.51" width="6" height="6.13"><Container width="6" height="6.13" color="#C9D6E3"/></Positioned><Positioned left="1120" top="709.63" width="6" height="6.35"><Container width="6" height="6.35" color="#C9D6E3"/></Positioned><Positioned left="1125" top="711.98" width="6" height="6.55"><Container width="6" height="6.55" color="#C9D6E3"/></Positioned><Positioned left="1130" top="714.52" width="6" height="6.72"><Container width="6" height="6.72" color="#C9D6E3"/></Positioned><Positioned left="1135" top="717.25" width="6" height="6.88"><Container width="6" height="6.88" color="#C9D6E3"/></Positioned><Positioned left="1140" top="720.13" width="6" height="7.01"><Container width="6" height="7.01" color="#C9D6E3"/></Positioned><Positioned left="1145" top="723.14" width="6" height="7.12"><Container width="6" height="7.12" color="#C9D6E3"/></Positioned><Positioned left="1150" top="726.26" width="6" height="7.2"><Container width="6" height="7.2" color="#C9D6E3"/></Positioned><Positioned left="1155" top="729.46" width="6" height="7.26"><Container width="6" height="7.26" color="#C9D6E3"/></Positioned><Positioned left="300" top="788" width="860" height="28"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">不均匀：既会走快，也会走慢</Text></Positioned><Positioned left="300" top="836" width="860" height="56"><Container width="860" height="56" color="#1A242E" borderRadius="8" border="1 SOLID #FFB100"/></Positioned><Positioned left="300" top="836" width="860" height="56"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#FFB100" textAlign="CENTER" maxLines="1">规则：|UT1 − UTC| 必须保持在 0.9 秒以内</Text></Positioned><Positioned left="300" top="908" width="860" height="28"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">示意图，纵向未按比例（SCALE FREE）</Text></Positioned><Positioned left="1230" top="292" width="620" height="200"><Container width="620" height="200" color="#121A22" borderRadius="10" border="1 SOLID #27323E"/></Positioned><Positioned left="1256" top="318" width="568" height="40"><Text fontSize="28" fontFamily="Noto Sans Mono CJK SC" color="#49C9DC" textAlign="LEFT" maxLines="1">TAI · 国际原子时</Text></Positioned><Positioned left="1256" top="366" width="46" height="3"><Container width="46" height="3" color="#49C9DC"/></Positioned><Positioned left="1256" top="388" width="568" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">BIPM 用全球原子钟网络连续计算的时标。</Text></Positioned><Positioned left="1256" top="418" width="568" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">不跳变、不调整，是所有时间计量的原始</Text></Positioned><Positioned left="1256" top="448" width="568" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">参考，也是闰秒要对齐的那一端。</Text></Positioned><Positioned left="1230" top="512" width="620" height="200"><Container width="620" height="200" color="#121A22" borderRadius="10" border="1 SOLID #27323E"/></Positioned><Positioned left="1256" top="538" width="568" height="40"><Text fontSize="28" fontFamily="Noto Sans Mono CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">UTC · 协调世界时</Text></Positioned><Positioned left="1256" top="586" width="46" height="3"><Container width="46" height="3" color="#FFB100"/></Positioned><Positioned left="1256" top="608" width="568" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">与 TAI 保持同一速率，只相差一个整数秒。</Text></Positioned><Positioned left="1256" top="638" width="568" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">1972 年起成为各国民用时间的基础，也是</Text></Positioned><Positioned left="1256" top="668" width="568" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">航空、金融与计算机共用的时间口径。</Text></Positioned><Positioned left="1230" top="732" width="620" height="200"><Container width="620" height="200" color="#121A22" borderRadius="10" border="1 SOLID #27323E"/></Positioned><Positioned left="1256" top="758" width="568" height="40"><Text fontSize="28" fontFamily="Noto Sans Mono CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">UT1 · 世界时</Text></Positioned><Positioned left="1256" top="806" width="46" height="3"><Container width="46" height="3" color="#C9D6E3"/></Positioned><Positioned left="1256" top="828" width="568" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">由地球自转定义，现在用甚长基线干涉测量</Text></Positioned><Positioned left="1256" top="858" width="568" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">（VLBI）观测得到。它并不均匀，因此要靠</Text></Positioned><Positioned left="1256" top="888" width="568" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">闰秒把它拉回 UTC 附近。</Text></Positioned><Positioned left="70" top="1000" width="1780" height="1"><Container width="1780" height="1" color="#27323E"/></Positioned><Positioned left="70" top="1012" width="1780" height="30"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">来源：IERS 闰秒页与常用常数（hpiers.obspm.fr）· BIPM 第 27 届 CGPM 决议 4（2022）· 示意图由编辑绘制</Text></Positioned></Stack></Container></Snapshot>
