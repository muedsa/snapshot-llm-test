="8.2" shape="CIRCLE" color="#0B3B3A"/></Positioned><Positioned left="140" top="64" width="460" height="36"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#E8EDE9" fontStyle="BOLD" textAlign="LEFT" maxLines="1">候鸟湾观鸟站</Text></Positioned><Positioned left="140" top="98" width="470" height="24"><Text fontSize="13" fontFamily="Noto Sans CJK SC" color="#7FB2A8" textAlign="LEFT" maxLines="1">MIGRANT BAY BIRD OBSERVATORY</Text></Positioned><Positioned left="890" top="72" width="126" height="28"><Container width="126" height="28" color="#082C2B" borderRadius="999"/></Positioned><Positioned left="890" top="76" width="126" height="20.8"><Text fontSize="16" fontFamily="Noto Sans CJK SC" color="#7FB2A8" fontStyle="BOLD" textAlign="CENTER" maxLines="1">第 9 届迁徙季</Text></Positioned><Positioned left="64" top="142" width="952" height="1"><Container width="952" height="1" color="#7FB2A855"/></Positioned><Positioned left="64" top="148" width="952" height="2"><Container width="952" height="2" color="#7FB2A8"/></Positioned><Positioned left="64" top="176" width="952" height="30"><Text fontSize="20" fontFamily="Noto Sans CJK SC" color="#7FB2A8" fontStyle="BOLD" textAlign="LEFT" maxLines="1">AUTUMN MIGRATION COUNT</Text></Positioned><Positioned left="64" top="211" width="952" height="28"><Text fontSize="14" fontFamily="Noto Sans CJK SC" color="#9FC0BA" textAlign="LEFT" maxLines="1">2026 秋季迁徙同步调查 · 9/20 - 11/15</Text></Positioned><Positioned left="64" top="254" width="952" height="108"><Text fontSize="84" fontFamily="Noto Sans CJK SC" color="#E8EDE9" fontStyle="BOLD" textAlign="LEFT" maxLines="1">它们正飞过你的城市</Text></Positioned><Positioned left="64" top="360" width="952" height="108"><Text fontSize="84" fontFamily="Noto Sans CJK SC" color="#E8EDE9" fontStyle="BOLD" textAlign="LEFT" maxLines="1">而你还没抬头。</Text></Positioned><Positioned left="64" top="476" width="240" height="6"><Container width="240" height="6" color="#E4622C" borderRadius="3"/></Positioned><Positioned left="64" top="510" width="952" height="1"><Container width="952" height="1" color="#7FB2A855"/></Positioned><Positioned left="64" top="516" width="952" height="2"><Container width="952" height="2" color="#7FB2A8"/></Positioned><Positioned left="64" top="552" width="952" height="32.3"><Text fontSize="20" fontFamily="Noto Sans CJK SC" color="#C6D6D2" textAlign="LEFT" maxLines="1">从 9 月 20 日到 11 月 15 日，57 天里候鸟湾会记录到 143 种鸟。</Text></Positioned><Positioned left="64" top="586" width="952" height="32.3"><Text fontSize="20" fontFamily="Noto Sans CJK SC" color="#C6D6D2" textAlign="LEFT" maxLines="1">我们每天 06:00 出发，把每一种的数量与行为回传给地方鸟类记录中心。</Text></Positioned><Positioned left="64" top="620" width="952" height="32.3"><Text fontSize="20" fontFamily="Noto Sans CJK SC" color="#C6D6D2" textAlign="LEFT" maxLines="1">今年秋天，同步调查与新手场都开放给公众——你只要带一双眼睛。</Text></Positioned><Positioned left="216.64" top="761.33" width="26" height="6.19"><Transform matrix="(0.982287,0.187381,0,0,-0.187381,0.982287,0,0,0,0,1,0,0.810465,-2.381112,0,1)"><Container width="26" height="6.19" color="#16514F"/></Transform></Positioned><Positioned left="215.58" top="766.05" width="26" height="6.19"><Transform matrix="(0.968583,0.24869,0,0,-0.24869,0.968583,0,0,0,0,1,0,1.178451,-3.135691,0,1)"><Container width="26" height="6.19" color="#16514F"/></Transform></Positioned><Positioned left="214.23" top="770.7" width="26" height="6.19"><Transform matrix="(0.951057,0.309017,0,0,-0.309017,0.951057,0,0,0,0,1,0,1.593091,-3.865675,0,1)"><Container width="26" height="6.19" color="#16514F"/></Transform></Positioned><Positioned left="212.59" top="775.25" width="26" height="6.19"><Transform matrix="(0.929776,0.368125,0,0,-0.368125,0.929776,0,0,0,0,1,0,2.05275,-4.568182,0,1)"><Container width="26" height="6.19" color="#16514F"/></Transform></Positioned><Positioned left="210.67" top="779.69" width="26" height="6.19"><Transform matrix="(0.904827,0.425779,0,0,-0.425779,0.904827,0,0,0,0,1,0,2.555612,-5.240442,0,1)"><Container width="26" height="6.19" color