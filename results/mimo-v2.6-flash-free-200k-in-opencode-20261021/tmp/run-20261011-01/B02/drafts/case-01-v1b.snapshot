r x="88.0" y="427.12" width="5.0" height="24.7" color="#C1502E" /><Text x="102.0" y="424.0" width="886.0" height="33.8" fontSize="26" color="#2E2A25" font="Noto Sans CJK SC" fontStyle="BOLD">时间与地点</Text><Container x="88.0" y="461.7" width="900.0" height="1.0" color="#D8CFBC" /><Text x="88.0" y="486.0" width="170.0" height="34.0" fontSize="22" color="#7A7264" font="Noto Sans CJK SC">开放日</Text><Text x="262.0" y="484.0" width="700.0" height="38.0" fontSize="24" color="#2E2A25" font="Noto Sans CJK SC" fontStyle="BOLD">4 月 20 日（周六）09:00–16:00</Text><Text x="88.0" y="530.0" width="170.0" height="34.0" fontSize="22" color="#7A7264" font="Noto Sans CJK SC">市集时段</Text><Text x="262.0" y="528.0" width="700.0" height="38.0" fontSize="24" color="#2E2A25" font="Noto Sans CJK SC" fontStyle="BOLD">每周六 09:00–13:00 同场</Text><Text x="88.0" y="574.0" width="170.0" height="34.0" fontSize="22" color="#7A7264" font="Noto Sans CJK SC">地点</Text><Text x="262.0" y="572.0" width="700.0" height="38.0" fontSize="24" color="#2E2A25" font="Noto Sans CJK SC" fontStyle="BOLD">临风路 88 号 · 禾风里社区花园东门</Text><Text x="88.0" y="618.0" width="170.0" height="34.0" fontSize="22" color="#7A7264" font="Noto Sans CJK SC">认养规模</Text><Text x="262.0" y="616.0" width="700.0" height="38.0" fontSize="24" color="#2E2A25" font="Noto Sans CJK SC" fontStyle="BOLD">12 块 3m×4m 地块 · 已开放 24 户认养</Text><Container x="56.0" y="703.12" width="5.0" height="24.7" color="#C1502E" /><Text x="70.0" y="700.0" width="954.0" height="33.8" fontSize="26" color="#2E2A25" font="Noto Sans CJK SC" fontStyle="BOLD">来做什么</Text><Container x="56.0" y="737.7" width="968.0" height="1.0" color="#D8CFBC" /><Container x="56.0" y="760.0" width="968.0" height="104.0" color="#FDFAF2" borderRadius="14" border="1 SOLID #D8CFBC" /><Container x="88.0" y="782.0" width="60.0" height="60.0" color="#4A7C4E" borderRadius="30.0" /><Text x="88.0" y="794.0" width="60.0" height="40.0" fontSize="26" color="#F7F1E4" font="Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">逛</Text><Text x="170.0" y="776.0" width="600.0" height="40.0" fontSize="26" color="#2E2A25" font="Noto Sans CJK SC" fontStyle="BOLD">看 12 块地怎么种</Text><Text x="170.0" y="816.0" width="760.0" height="32.0" fontSize="19" color="#7A7264" font="Noto Sans CJK SC">番茄黄瓜正挂果，随手可问种植户</Text><Container x="56.0" y="884.0" width="968.0" height="104.0" color="#FDFAF2" borderRadius="14" border="1 SOLID #D8CFBC" /><Container x="88.0" y="906.0" width="60.0" height="60.0" color="#4A7C4E" borderRadius="30.0" /><Text x="88.0" y="918.0" width="60.0" height="40.0" fontSize="26" color="#F7F1E4" font="Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">学</Text><Text x="170.0" y="900.0" width="600.0" height="40.0" fontSize="26" color="#2E2A25" font="Noto Sans CJK SC" fontStyle="BOLD">厨余堆肥三步法</Text><Text x="170.0" y="940.0" width="760.0" height="32.0" fontSize="19" color="#7A7264" font="Noto Sans CJK SC">现场教，学完可领一袋成品堆肥</Text><Container x="56.0" y="1008.0" width="968.0" height="104.0" color="#FDFAF2" borderRadius="14" border="1 SOLID #D8CFBC" /><Container x="88.0" y="1030.0" width="60.0" height="60.0" color="#4A7C4E" borderRadius="30.0" /><Text x="88.0" y="1042.0" width="60.0" height="40.0" fontSize="26" color="#F7F1E4" font="Noto Sans CJK SC" fontStyle="BOLD" textAlign="CENTER">订</Text><Text x="170.0" y="1024.0" width="600.0" height="40.0" fontSize="26" color="#2E2A25" font="Noto Sans CJK SC" fontStyle="BOLD">周六市集尝鲜</Text><Text x="170.0" y="1064.0" width="760.0" height="32.0" fontSize="19" color="#7A7264" font="Noto Sans CJK SC">8 种当季菜，会员 8 折</Text><Container x="56.0" y="1160.0" width="968.0" height="280.0" color="#D9E4CE" borderRadius="18" /><Container x="88.0" y="1188.0" width="224.0" height="224.0" color="#FFFFFF" borderRadius="10" border="2 SOLID #4A7C4E" /><Container x="165.33" y="1196.0" width="10.2" height="10.2" color="#2E2A25" /><Container x="185.14" y="1196.0" width="10.2" height="10.2" color="#2E2A25" /><Container x="195.05" y="1196.0" width="10.2" height="10.2" color="#2E2A25