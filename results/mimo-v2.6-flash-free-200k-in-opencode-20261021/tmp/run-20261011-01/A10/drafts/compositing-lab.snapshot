<Snapshot type="png" background="#0B1120">
  <SizedBox width="1440" height="1100">
  <Stack alignment="TOP_LEFT" clipBehavior="NONE">
    <Positioned left="144" top="40"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="44" color="#F8FAFC" fontStyle="BOLD">看到差异，才能说用对了</Text></Positioned>
    <Positioned left="144" top="104"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="22" color="#94A3B8" fontStyle="NORMAL">六格对照：透明度作用层级 · 模糊作用层级 · 裁剪边界</Text></Positioned>
    <Positioned left="144" top="926"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#F8FAFC" fontStyle="BOLD">依据与证据</Text></Positioned>
    <Positioned left="144" top="966"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">合成：服务指南颜色语法 #RRGGBBAA（alpha 在最后两位）；0–255 sRGB 直通 alpha 逐层 source-over 混合。</Text></Positioned>
    <Positioned left="144" top="996"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">滤镜：标签参考 Opacity / ColorFiltered / ImageFiltered / BackdropFilter / ClipRRect / ClipOval 与各自页面说明。</Text></Positioned>
    <Positioned left="144" top="1026"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">证据：composite-audit.json 记录①②采样点理论/实际值，以及③–⑥整图与局部裁剪的实际观察（visual_checks）。</Text></Positioned>
    <Positioned left="144" top="150"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#F8FAFC" fontStyle="BOLD">① 逐层 alpha：两个半透明矩形</Text></Positioned>
    <Positioned left="144" top="442"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">两个半透明矩形：#FF000080 / #0000FF80</Text></Positioned>
    <Positioned left="144" top="470"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">逐层两次 source-over（蓝压红合白底）</Text></Positioned>
    <Positioned left="560" top="150"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#F8FAFC" fontStyle="BOLD">② 组级 Opacity(0.5)</Text></Positioned>
    <Positioned left="560" top="442"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">同样不透明红蓝放进 Opacity(0.5) 组</Text></Positioned>
    <Positioned left="560" top="470"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">组内先合成为一层，最后只混合一次</Text></Positioned>
    <Positioned left="976" top="150"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#F8FAFC" fontStyle="BOLD">③ 背景模糊（BackdropFilter）</Text></Positioned>
    <Positioned left="976" top="442"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">BackdropFilter σ=6：只模糊卡下条纹</Text></Positioned>
    <Positioned left="976" top="470"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">文字与前景在滤镜之后绘制，保持锐利</Text></Positioned>
    <Positioned left="144" top="546"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#F8FAFC" fontStyle="BOLD">④ 子树模糊（ImageFiltered）</Text></Positioned>
    <Positioned left="144" top="838"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">ImageFiltered σ=6：同一场景整体模糊</Text></Positioned>
    <Positioned left="144" top="866"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">条纹、文字、前景一起被模糊；区外不变</Text></Positioned>
    <Positioned left="560" top="546"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#F8FAFC" fontStyle="BOLD">⑤ MULTIPLY 滤色后再模糊</Text></Positioned>
    <Positioned left="560" top="838"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">先 ColorFiltered(MULTIPLY #F6B94A)</Text></Positioned>
    <Positioned left="560" top="866"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">再 ImageFiltered σ=6 高斯模糊，无裁剪</Text></Positioned>
    <Positioned left="976" top="546"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="24" color="#F8FAFC" fontStyle="BOLD">⑥ ⑤ 基础上加圆形裁剪</Text></Positioned>
    <Positioned left="976" top="838"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">同⑤，最外层加 ClipOval 圆形裁剪</Text></Positioned>
    <Positioned left="976" top="866"><Text fontFamily="Inter,Noto Sans CJK SC" fontSize="20" color="#CBD5E1" fontStyle="NORMAL">圆心(160,120) r=100，圆外内容被裁掉</Text></Positioned>
