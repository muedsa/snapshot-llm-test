  "layout_rules": {
    "mobile": "单列：页眉条 → 主标题 → 副标题 → meta 两列 → CTA → 六张卡纵向单列 → 页脚",
    "tablet": "单列宽版：页眉条 → 主标题 → 副标题 → meta 两列 → CTA → 六张卡 2 列 × 3 行 → 页脚",
    "desktop": "单列宽版：页眉条 → 主标题 → 副标题 → meta 四列一行 → CTA → 六张卡 3 列 × 2 行 → 页脚",
    "stage": "单列宽版：页眉条 → 主标题 → 副标题 → meta 四列一行 → CTA → 六张卡 3 列 × 2 行（加大留白）→ 页脚",
    "shared": "四个断点的色彩、圆角、卡片刻意式、CTA 形态与层级完全一致，只有列数、间距与字号缩放不同"
  },
  "component_rules": [
    {
      "component": "顶栏条",
      "rule": "左侧品牌块（6×字号高的品牌色圆角条 + 品牌名），右侧标注当前断点名；四个断点同一构件"
    },
    {
      "component": "Hero 几何组合",
      "rule": "描边方块 + 实心圆 + 两根圆角横条，按断点缩放并重排到主标题右上/右侧；不随文字裁切"
    },
    {
      "component": "主标题 display",
      "rule": "Inter Semi Bold + Noto Sans CJK SC，≥40px，按可用宽度自动折行，不缩字"
    },
    {
      "component": "meta 行",
      "rule": "标签（faint，小字）+ 值（ink，较大），按断点 2 列（手机/平板）或 4 列（桌面/大屏）排布"
    },
    {
      "component": "CTA 条",
      "rule": "品牌色填充圆角矩形 + 白色 CTA 文案 + 左侧实心圆点，四个断点同一形态"
    },
    {
      "component": "卡片",
      "rule": "白底 + 细边 + 圆角 + 左侧 6px 品牌色竖条；编号徽章（胶囊）+ 卡标题 + detail；四个断点同一构件，仅尺寸与列数变化"
    },
    {
      "component": "页脚",
      "rule": "细分隔线 + 断点尺寸 + 活动编号式说明；四个断点同一构件"
    }
  ],
  "constraints": {
    "mobile_body_min_px": 16,
    "card_title_min_px": 18,
    "other_body_min_px": 20,
    "display_min_px": 40,
    "safe_margin_min": {
      "mobile": 16,
      "tablet": 32,
      "desktop": 32,
      "stage": 32
    },
    "actual_margin_used": {
      "mobile": 16,
      "tablet": 32,
      "desktop": 32,
      "stage": 48
    },
    "forbidden": [
      "裁切",
      "拉伸",
      "整图 <Image> 适配",
      "省略号",
      "缩写",
      "改写",
      "删句",
      "二维码"
    ]
  },
  "schema_version": 1,
  "task_id": "A12",
  "path_base": "output_dir",
  "round": "round-01",
  "title": "四断点完整内容视觉系统",
  "source": {
    "content": "inputs/content.json",
    "modified": false
  },
