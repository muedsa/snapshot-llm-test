  "conclusions": [
    {
      "claim": "两个渠道的分组转化率都上升，但总体转化率下降，二者不同向。",
      "cited": [
        {
          "field": "groups[0..1]",
          "values": [
            "2400/8000=30.00%",
            "200/2000=10.00%"
          ]
        },
        {
          "field": "groups[2..3]",
          "values": [
            "700/2000=35.00%",
            "960/8000=12.00%"
          ]
        },
        {
          "field": "periods[0].overall_rate",
          "values": [
            "2600/10000=26.00%"
          ]
        },
        {
          "field": "periods[1].overall_rate",
          "values": [
            "1660/10000=16.60%"
          ]
        }
      ],
      "delta_pp": -9.4
    },
    {
      "claim": "下降由访问构成翻转解释：转化率更高的直接访问占比从 80.00% 降到 20.00%。",
      "cited": [
        {
          "field": "periods[0].visit_mix",
          "values": [
            "直接访问 8000/10000=80.00%",
            "推广访问 2000/10000=20.00%"
          ]
        },
        {
          "field": "periods[1].visit_mix",
          "values": [
            "直接访问 2000/10000=20.00%",
            "推广访问 8000/10000=80.00%"
          ]
        }
      ]
    },
    {
      "claim": "限制：该数据不能证明因果。",
      "limitation": "只有同期两期汇总，没有渠道定义、投放信息、落地页版本、时间趋势或实验分组；因此无法判定构成变化的原因，也无法判定其持续性。两期访问总量同为 10000 次是本数据的特征，不能推广为一般结论。",
      "cited": [
        {
          "field": "inputs.rows",
          "values": [
            4
          ]
        }
      ]
    }
  ],
