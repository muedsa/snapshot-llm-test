    <Positioned left="526" top="281.56" width="626">
      <Text fontSize="24" color="#42536E" fontFamily="Noto Sans CJK SC" textAlign="LEFT" softWrap="true">50% 不透明的红是 #FF000080，不是 #80FF0000</Text>
    </Positioned>
    <Positioned left="510" top="329">
      <Container width="4" height="24" color="#2B5BD7" borderRadius="2"/>
