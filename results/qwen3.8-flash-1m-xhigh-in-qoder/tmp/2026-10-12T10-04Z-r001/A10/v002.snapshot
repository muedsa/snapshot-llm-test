        </ClipOval>
      </Positioned>
      <Positioned left="912" top="714" width="320">
        <Text fontSize="18" color="#A6B8D4" textAlign="LEFT" fontFamily="Noto Sans CJK SC,Inter" height="1.3" softWrap="true">同样结果套上 r=100 圆裁，边界锐利</Text>
      </Positioned>
      <Positioned left="381" top="225">
        <Container width="14" height="14" borderRadius="7" border="2 SOLID #000000"/>
