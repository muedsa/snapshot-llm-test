      </Positioned>
      <Positioned left="560" top="714" width="320">
        <Text fontSize="18" color="#A6B8D4" textAlign="LEFT" fontFamily="Noto Sans CJK SC,Inter" height="1.3" softWrap="true">MULTIPLY #F6B94A 后 sigma=6，可外溢</Text>
      </Positioned>
      <Positioned left="912" top="428" width="230">
        <Text fontSize="24" color="#F2F6FC" textAlign="LEFT" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">⑥ 再加圆形裁剪</Text>
      </Positioned>
      <Positioned left="1170" top="430">
        <Container width="60" height="26" color="#16233C" borderRadius="13" border="1 SOLID #26385C"/>
      </Positioned>
      <Positioned left="1144" top="422.85" width="56">
