      </Positioned>
      <Positioned left="560" top="428" width="230">
        <Text fontSize="24" color="#F2F6FC" textAlign="LEFT" fontStyle="BOLD" fontFamily="Noto Sans CJK SC,Inter">⑤ 滤色 + 子树模糊</Text>
