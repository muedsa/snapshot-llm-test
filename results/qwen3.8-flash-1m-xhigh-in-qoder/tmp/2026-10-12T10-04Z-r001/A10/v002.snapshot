              <Positioned left="20" top="20">
                <Container width="120" height="60" color="#2E7DD1"/>
              </Positioned>
              <Positioned left="200" top="150">
                <Container width="90" height="60" color="#16233C"/>
              </Positioned>
              <Positioned left="90" top="95">
                <Container width="120" height="70" color="#FFFFFF" borderRadius="10" border="2 SOLID #9AA9BF" boxShadow="0 6 14 0 #00000066 NORMAL"/>
