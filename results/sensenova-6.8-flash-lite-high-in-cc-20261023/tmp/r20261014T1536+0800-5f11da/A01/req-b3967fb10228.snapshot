th="596" height="31.9"><Stack fit="EXPAND" clipBehavior="NONE"><Positioned left="0" top="0" height="31.9"><Text text="管理结论" fontSize="22" color="#0B0B0B" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" softWrap="FALSE" textDirection="LTR"/></Positioned></Stack></Container></Positioned><Positioned left="20" top="61.9" width="596" height="222.1"><Container width="596" height="222.1"><Stack fit="EXPAND" clipBehavior="NONE"><Positioned left="0" top="0" width="667.52"><Text text="增长成立，退款率是唯一的利润波动源。" fontSize="20" color="#0B0B0B" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" softWrap="FALSE" height="1.5" textDirection="LTR"/></Positioned><Positioned left="0" top="45" width="8" height="8"><ClipPath path="M4.00 0.00 H4.00 A4.00 4.00 0 0 1 8.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 8.00 H4.00 A4.00 4.00 0 0 1 0.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 0.00 Z" viewBox="0 0 8 8" fit="FILL"><Container width="8" height="8" color="#2A78D6"/></ClipPath></Positioned><Positioned left="26" top="40" width="570" height="26"><Text text="净收入 +69.1%、经营利润 +70.7%，体量与利润同向增长。" fontSize="16" color="#52514E" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" height="1.5" textDirection="LTR"/></Positioned><Positioned left="0" top="81" width="8" height="8"><ClipPath path="M4.00 0.00 H4.00 A4.00 4.00 0 0 1 8.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 8.00 H4.00 A4.00 4.00 0 0 1 0.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 0.00 Z" viewBox="0 0 8 8" fit="FILL"><Container width="8" height="8" color="#2A78D6"/></ClipPath></Positioned><Positioned left="26" top="76" width="570" height="50"><Text text="访问量 +60.0%（3,500→5,600），但转化率 12.00%→11.07%（-0.93pp）
：增长靠流量，不靠效率。" fontSize="16" color="#52514E" fontFamily="Inter,Noto Sans CJK SC" softWrap="TRUE" height="1.5" textDirection="LTR"/></Positioned><Positioned left="0" top="141" width="8" height="8"><ClipPath path="M4.00 0.00 H4.00 A4.00 4.00 0 0 1 8.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 8.00 H4.00 A4.00 4.00 0 0 1 0.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 0.00 Z" viewBox="0 0 8 8" fit="FILL"><Container width="8" height="8" color="#2A78D6"/></ClipPath></Positioned><Positioned left="26" top="136" width="570" height="50"><Text text="6、8 月退款率 8.00%（其余 4–5%），合计多退 ¥9,782，利润率降至 21.9
9% 与 23.72%。" fontSize="16" color="#52514E" fontFamily="Inter,Noto Sans CJK SC" softWrap="TRUE" height="1.5" textDirection="LTR"/></Positioned><Positioned left="0" top="201" width="8" height="8"><ClipPath path="M4.00 0.00 H4.00 A4.00 4.00 0 0 1 8.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 8.00 H4.00 A4.00 4.00 0 0 1 0.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 0.00 Z" viewBox="0 0 8 8" fit="FILL"><Container width="8" height="8" color="#0CA30C"/></ClipPath></Positioned><Positioned left="26" top="196" width="570" height="26"><Text text="建议：退款率压回 5% 基准线前暂缓放量。" fontSize="16" color="#52514E" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" height="1.5" textDirection="LTR"/></Positioned></Stack></Container></Positioned></Stack></Container></Container></Positioned><Positioned left="40" top="914" width="1520" height="1"><Container width="1520" height="1" color="#E1E0D9"/></Positioned><Positioned left="40" top="922" width="1520" height="24"><Text text="口径：净收入 = 收入 − 退款；经营利润 = 净收入 − 成本；退款率 = 退款 ÷ 退款前收入；总体转化率 = 总订单 3,045 ÷ 总访问 27,300（加权口径，不平均月比例）。" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned><Positioned left="40" top="948" width="1520" height="24"><Text text="数据源：inputs/monthly.csv（唯一业务数据）；派生量、轴映射与结论引用见 computed-data.json。多退基准取非异常月 5%，26-06、26-08 合计多退 ¥9,782。" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned></Stack></Container></Container></Snapshot>