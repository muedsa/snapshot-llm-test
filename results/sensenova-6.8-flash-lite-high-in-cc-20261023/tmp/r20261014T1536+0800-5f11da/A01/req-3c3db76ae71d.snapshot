" height="1"><Container width="828" height="1" color="#E1E0D9"/></Positioned><Positioned left="0" top="231" width="828" height="1"><Container width="828" height="1" color="#E1E0D9"/></Positioned></Stack></Container></Positioned></Stack></Container></Positioned></Stack></Container></Container></Positioned><Positioned left="924" top="582" width="636" height="306"><Container width="636" height="306" color="#FFFFFF" borderRadius="14" border="1 SOLID #0000001A"><Container width="636" height="306"><Stack fit="EXPAND" clipBehavior="NONE"><Positioned left="20" top="20" width="596" height="31.9"><Container width="596" height="31.9"><Stack fit="EXPAND" clipBehavior="NONE"><Positioned left="0" top="0" width="596" height="31.9"><Positioned left="0" top="0" width="596"><Text text="管理结论" fontSize="22" color="#0B0B0B" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" softWrap="FALSE" letterSpacing="None" textDirection="LTR" decorationColor="None" backgroundColor="None" textAlign="None"/></Positioned></Positioned></Stack></Container></Positioned><Positioned left="20" top="61.9" width="596" height="224.1"><Container width="596" height="224.1"><Stack fit="EXPAND" clipBehavior="NONE"><Positioned left="0" top="0" width="596" height="60"><Positioned left="0" top="0" width="596"><Text text="增长成立，退款率是唯一的利润波动源。" fontSize="20" color="#0B0B0B" fontFamily="Inter,Noto Sans CJK SC" fontStyle="BOLD" softWrap="FALSE" letterSpacing="None" textDirection="LTR" decorationColor="None" backgroundColor="None" textAlign="None"/></Positioned></Positioned><Positioned left="0" top="75" width="8" height="8"><ClipPath path="M4.00 0.00 H4.00 A4.00 4.00 0 0 1 8.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 8.00 H4.00 A4.00 4.00 0 0 1 0.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 0.00 Z" viewBox="0 0 8 8" fit="FILL"><Container width="8" height="8" color="#2A78D6"/></ClipPath></Positioned><Positioned left="26" top="70" width="570" height="24"><Positioned left="0" top="0" width="570"><Text text="净收入 ¥119,700 → ¥202,368（+69.1%），经营利润同步 +70.7%，体量与利润同向。" fontSize="16" color="#52514E" fontFamily="Inter,Noto Sans CJK SC" softWrap="TRUE" height="1.5" letterSpacing="None" textDirection="LTR" decorationColor="None" backgroundColor="None" textAlign="None"/></Positioned></Positioned><Positioned left="0" top="110" width="8" height="8"><ClipPath path="M4.00 0.00 H4.00 A4.00 4.00 0 0 1 8.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 8.00 H4.00 A4.00 4.00 0 0 1 0.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 0.00 Z" viewBox="0 0 8 8" fit="FILL"><Container width="8" height="8" color="#2A78D6"/></ClipPath></Positioned><Positioned left="26" top="105" width="570" height="24"><Positioned left="0" top="0" width="570"><Text text="访问量 +60.0%（3,500 → 5,600），转化率却 12.00% → 11.07%（-0.93pp），增长来自流量而非效率。" fontSize="16" color="#52514E" fontFamily="Inter,Noto Sans CJK SC" softWrap="TRUE" height="1.5" letterSpacing="None" textDirection="LTR" decorationColor="None" backgroundColor="None" textAlign="None"/></Positioned></Positioned><Positioned left="0" top="145" width="8" height="8"><ClipPath path="M4.00 0.00 H4.00 A4.00 4.00 0 0 1 8.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 8.00 H4.00 A4.00 4.00 0 0 1 0.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 0.00 Z" viewBox="0 0 8 8" fit="FILL"><Container width="8" height="8" color="#2A78D6"/></ClipPath></Positioned><Positioned left="26" top="140" width="570" height="24"><Positioned left="0" top="0" width="570"><Text text="6 月与 8 月退款率 8.00%，其余月份 4%–5%；两月合计多退款 ¥9,782，利润率被压至 21.99% 与 23.72%。" fontSize="16" color="#52514E" fontFamily="Inter,Noto Sans CJK SC" softWrap="TRUE" height="1.5" letterSpacing="None" textDirection="LTR" decorationColor="None" backgroundColor="None" textAlign="None"/></Positioned></Positioned><Positioned left="0" top="180" width="8" height="8"><ClipPath path="M4.00 0.00 H4.00 A4.00 4.00 0 0 1 8.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 8.00 H4.00 A4.00 4.00 0 0 1 0.00 4.00 V4.00 A4.00 4.00 0 0 1 4.00 0.00 Z" viewBox="0 0 8 8" fit="FILL"><Container width="8" height="8" color="#0CA30C"/></ClipPath></Positioned><Positioned left="26" top="175" width="570" height="24"><Positioned left="0" top="0" width="570"><Text text="建议：先把退款率压回 5% 基准线，再谈继续放量；退款根因未定位前，放量只会放大损耗。" fontSize="16" color="#52514E" fontFamily="Inter,Noto Sans CJK SC" softWrap="TRUE" height="1.5" letterSpacing="None" textDirection="LTR" decorationColor="None" backgroundColor="None" textAlign="None"/></Positioned></Positioned></Stack></Container></Positioned></Stack></Container></Container></Positioned><Positioned left="40" top="902" width="1520" height="1"><Container width="1520" height="1" color="#E1E0D9"/></Positioned><Positioned left="40" top="914" width="1520" height="24"><Positioned left="0" top="0" width="1520"><Text text="口径：净收入 = 收入 − 退款；经营利润 = 净收入 − 成本；退款率 = 退款 ÷ 退款前收入；总体转化率 = 总订单 3,045 ÷ 总访问 27,300（加权口径，不平均月比例）。" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" letterSpacing="None" textDirection="LTR" decorationColor="None" backgroundColor="None" textAlign="None"/></Positioned></Positioned><Positioned left="40" top="936" width="1520" height="24"><Positioned left="0" top="0" width="1520"><Text text="数据源：inputs/monthly.csv（唯一业务数据）；派生量、轴映射与结论引用见 computed-data.json。退款多退基准取非异常月 5%，26-06、26-08 合计多退 ¥9,782。" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" letterSpacing="None" textDirection="LTR" decorationColor="None" backgroundColor="None" textAlign="None"/></Positioned></Positioned></Stack></Container></Container></Snapshot>