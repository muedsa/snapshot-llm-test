<Snapshot type="png" background="#FFFFFF">
    <Container width="1200" height="1600">
        <Stack width="1200" height="1600" fit="EXPAND" clipBehavior="NONE">
            <Container width="1200" height="1600" color="#FFFFFF"/>
        <Positioned left="0" top="0" width="1200" height="6">
            <Container width="1200" height="6" color="#0EA5E9"/>
        </Positioned>
        <Positioned left="48" top="48" width="392" height="30">
            <Container width="392" height="30" color="#E0F2FE"
              borderRadius="15" alignment="CENTER">
            <Text fontFamily="Noto Sans CJK SC,Inter" fontSize="15"
                  color="#0369A1" text="第 2 页 / 4  ·  Snapshot DSL 入门手册"/></Container>
        </Positioned>
        <Positioned left="48" top="94" width="1104" height="58">
            <Text fontFamily="Noto Sans CJK SC,Inter" fontSize="44" color="#0F172A"
      height="1.28" fontStyle="BOLD"
      text="画布尺寸由布局决定，有界布局与 Stack 定位"/>
        </Positioned>
        <Positioned left="48" top="170" width="1104" height="76">
            <Text fontFamily="Noto Sans CJK SC,Inter" fontSize="25" color="#475569"
      height="1.52"
      text="根标签 Snapshot 本身不声明画布宽高；父节点向下传递 BoxConstraints，子节点在约束范围内选择自己的宽高，设置 width 或 height 就是在收紧约束。"/>
        </Positioned>
        <Positioned left="48" top="262" width="1104" height="1">
            <Container width="1104" height="1" color="#E2E8F0"/>
        </Positioned>
        <Positioned left="48" top="287" width="1104" height="34">
            <Container width="152" height="34" borderRadius="6" color="#0EA5E9"
           padding="(3,15)">
            <Text fontFamily="Noto Sans CJK SC,Inter" fontSize="19" color="#FFFFFF"
                  height="1.3" text="印刷代码片段"/></Container>
        </Positioned>
        <Positioned left="48" top="333" width="1104" height="606">
                <Stack width="1104" height="606" fit="EXPAND" clipBehavior="NONE">
        <Container width="1104" height="606" color="#0F172A" borderRadius="12"
               border="1 SOLID #1E293B"/>
            <Positioned left="22" top="18" width="1060" height="30">
                <Text fontFamily="Noto Sans CJK SC,Inter" fontSize="18" color="#7DD3FC"
                      height="1.5">…… 省略 Snapshot 根与 400×240 有界容器（example-02.snapshot 第 1–2 行）……</Text>
            </Positioned>
            <Positioned left="22" top="48" width="1060" height="240">
                <Text fontFamily="DejaVu Sans Mono" fontSize="20" color="#E2E8F0"
                      height="1.5"><Raw><![CDATA[<Container width="400" height="240" color="#F8FAFC" padding="(14,12)">
    <Column width="372" height="216" mainAxisAlignment="SPACE_BETWEEN"
            crossAxisAlignment="STRETCH">
        <Text fontFamily="DejaVu Sans Mono" fontSize="10" color="#64748B"
              text="parent constraint 400 x 240, finite"/>
        <Container width="372" height="60">
            <Row width="372" height="60" crossAxisAlignment="STRETCH">
                <Expanded flex="2"><Container width="284" height="60"]]></Raw></Text>
            </Positioned>
            <Positioned left="22" top="288" width="1060" height="30">
                <Text fontFamily="Noto Sans CJK SC,Inter" fontSize="18" color="#7DD3FC"
                      height="1.5">…… 省略 Expanded 的收尾、fixed 子项与 Row 闭合（example-02.snapshot 第 11–19 行）……</Text>
            </Positioned>
            <Positioned left="22" top="318" width="1060" height="240">
                <Text fontFamily="DejaVu Sans Mono" fontSize="20" color="#E2E8F0"
                      height="1.5"><Raw><![CDATA[        <Stack width="372" height="62">
            <Container width="372" height="62" color="#E2E8F0" borderRadius="8"/>
            <Positioned left="10" top="10" width="128" height="20">
                <Container width="128" height="20" color="#8B5CF6" borderRadius="6"
                       alignment="CENTER">
                    <Text fontFamily="Inter" fontSize="10" color="#FFFFFF"
                          text="left=10  top=10"/></Container>
            </Positioned>]]></Raw></Text>
            </Positioned>
            <Positioned left="22" top="558" width="1060" height="30">
                <Text fontFamily="Noto Sans CJK SC,Inter" fontSize="18" color="#7DD3FC"
                      height="1.5">…… 省略 right/bottom 定位与闭合标签（example-02.snapshot 第 28–38 行）……</Text>
            </Positioned>
    </Stack>
        </Positioned>
        <Positioned left="48" top="965" width="1104" height="34">
            <Container width="412" height="34" borderRadius="6" color="#0D9488"
           padding="(3,15)">
            <Text fontFamily="Noto Sans CJK SC,Inter" fontSize="19" color="#FFFFFF"
                  height="1.3" text="教学插图（本页 DSL 构件直接绘制）"/></Container>
        </Positioned>
            <Positioned left="388" top="1011" width="424" height="264">
                <Container width="424" height="264" color="#FFFFFF"
                       borderRadius="12" border="1 SOLID #CBD5E1">
                    <Container width="400" height="240">
<Container width="400" height="240" color="#F8FAFC" padding="(14,12)">
    <Column width="372" height="216" mainAxisAlignment="SPACE_BETWEEN"
            crossAxisAlignment="STRETCH">
        <Text fontFamily="DejaVu Sans Mono" fontSize="10" color="#64748B"
              text="parent constraint 400 x 240, finite"/>
        <Container width="372" height="60">
            <Row width="372" height="60" crossAxisAlignment="STRETCH">
                <Expanded flex="2"><Container width="284" height="60"
                        color="#0EA5E9" borderRadius="8" alignment="CENTER">
                    <Text fontFamily="Inter" fontSize="11" color="#FFFFFF"
                          text="Expanded flex=2"/></Container></Expanded>
                <Container width="88" height="60" color="#F59E0B" borderRadius="8"
                        alignment="CENTER">
                    <Text fontFamily="Inter" fontSize="11" color="#FFFFFF"
                          text="fixed 88"/></Container>
            </Row>
        </Container>
        <Stack width="372" height="62">
            <Container width="372" height="62" color="#E2E8F0" borderRadius="8"/>
            <Positioned left="10" top="10" width="128" height="20">
                <Container width="128" height="20" color="#8B5CF6" borderRadius="6"
                       alignment="CENTER">
                    <Text fontFamily="Inter" fontSize="10" color="#FFFFFF"
                          text="left=10  top=10"/></Container>
            </Positioned>
            <Positioned right="10" bottom="10" width="116" height="20">
                <Container width="116" height="20" color="#EC4899" borderRadius="6"
                       alignment="CENTER">
                    <Text fontFamily="Inter" fontSize="10" color="#FFFFFF"
                          text="right=10 bottom=10"/></Container>
            </Positioned>
        </Stack>
    </Column>
</Container>
                    </Container>
                </Container>
            </Positioned>
        <Positioned left="48" top="1301" width="1104" height="34">
            <Container width="72" height="34" borderRadius="6" color="#7C3AED"
           padding="(3,15)">
            <Text fontFamily="Noto Sans CJK SC,Inter" fontSize="19" color="#FFFFFF"
                  height="1.3" text="要点"/></Container>
        </Positioned>
        <Positioned left="48" top="1347" width="1104" height="179">
                <Stack width="1104" height="179" fit="EXPAND" clipBehavior="NONE">
        <Positioned left="0" top="0" width="1104" height="31">
<Text fontFamily="Noto Sans CJK SC,Inter" fontSize="24" color="#0F172A" height="1.35">
        <Text fontFamily="DejaVu Sans Mono" fontSize="22"
              color="#0EA5E9">1</Text>
        <Raw><![CDATA[  Row/Column 用 mainAxisAlignment 分主轴，mainAxisSize 默认 MAX 撑满主轴。]]></Raw>
    </Text>
        </Positioned>
        <Positioned left="0" top="37" width="1104" height="31">
<Text fontFamily="Noto Sans CJK SC,Inter" fontSize="24" color="#0F172A" height="1.35">
        <Text fontFamily="DejaVu Sans Mono" fontSize="22"
              color="#6366F1">2</Text>
        <Raw><![CDATA[  Expanded 等价于 Flexible fit=TIGHT，两者只能是 Flex 的直接子节点。]]></Raw>
    </Text>
        </Positioned>
        <Positioned left="0" top="74" width="1104" height="31">
<Text fontFamily="Noto Sans CJK SC,Inter" fontSize="24" color="#0F172A" height="1.35">
        <Text fontFamily="DejaVu Sans Mono" fontSize="22"
              color="#F59E0B">3</Text>
        <Raw><![CDATA[  交叉轴默认不撑满，只有 crossAxisAlignment=STRETCH 才强制填满交叉轴。]]></Raw>
    </Text>
        </Positioned>
        <Positioned left="0" top="111" width="1104" height="31">
<Text fontFamily="Noto Sans CJK SC,Inter" fontSize="24" color="#0F172A" height="1.35">
        <Text fontFamily="DejaVu Sans Mono" fontSize="22"
              color="#EC4899">4</Text>
        <Raw><![CDATA[  弹性分配只改变主轴约束；父级交叉轴无界时不会凭空产生有限约束。]]></Raw>
    </Text>
        </Positioned>
        <Positioned left="0" top="148" width="1104" height="31">
<Text fontFamily="Noto Sans CJK SC,Inter" fontSize="24" color="#0F172A" height="1.35">
        <Text fontFamily="DejaVu Sans Mono" fontSize="22"
              color="#10B981">5</Text>
        <Raw><![CDATA[  Stack 先布局普通子节点（默认 TOP_LEFT），再按 left/top/right/bottom 放 Positioned。]]></Raw>
    </Text>
        </Positioned>
    </Stack>
        </Positioned>
        </Stack>
    </Container>
</Snapshot>
