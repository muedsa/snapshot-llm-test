iner width="1" height="10" color="#C3C2B7"/></Positioned><Positioned left="1335.406" top="990" height="21.6"><Text text="14:00" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned><Positioned left="1616.643" top="978"><Container width="1" height="10" color="#C3C2B7"/></Positioned><Positioned left="1598.263" top="990" height="21.6"><Text text="15:00" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned><Positioned left="1879.5" top="978"><Container width="1" height="10" color="#C3C2B7"/></Positioned><Positioned left="1842.24" top="990" height="21.6"><Text text="16:00" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned><Positioned left="40" top="1016" height="22"><Text text="线性时间轴 09:00–16:00 · 共 420 分钟 · 1 分钟 = 4.3810px" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned><Positioned left="40" top="1054" width="1840" height="1"><Container width="1840" height="1" color="#E1E0D9"/></Positioned><Positioned left="40" top="1072" height="21.6"><Text text="读图方法：块左缘 = 开始时间，块宽 = 实际时长 × 4.38px/分钟，块间空档真实保留；午休 12:00–13:00 以灰带跨三泳道标出，不并入任何会议；短场次标题在块内折行，不为塞字改变块宽。" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned><Positioned left="40" top="1100" height="21.6"><Text text="会场容量：A 320 人 · B 80 人 · C 160 人（合计 560 人）。时长合计 720 分钟 = 12.0 小时，15 场；每会场跨 09:00–16:00 共 420 分钟，空档 A 155 / B 175 / C 210 分钟。" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned><Positioned left="40" top="1128" height="21.6"><Text text="冲突检查：同一会场内不存在时间重叠的活动对，conflicts 为空；输入时间未作任何调整。逐场时长、空档与冲突见 schedule-audit.json。" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned><Positioned left="40" top="1156" height="21.6"><Text text="数据源：inputs/agenda.csv（15 行）· inputs/venues.json。手机导览 agenda-mobile.png（720×1280，分时段列表，非本图缩放或裁切）。" fontSize="16" color="#898781" fontFamily="Inter,Noto Sans CJK SC" softWrap="FALSE" textDirection="LTR"/></Positioned></Stack></Container></Container></Snapshot>