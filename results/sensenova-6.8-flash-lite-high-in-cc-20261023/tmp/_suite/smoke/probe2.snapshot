      </Positioned>
      <Positioned left="330" top="295" width="300" height="40">
        <Container color="#F2F2F0" border="1 SOLID #C3C2B7">
          <Text text="右对齐" fontSize="20" fontFamily="Inter,Noto Sans CJK SC" color="#0B0B0B" textAlign="RIGHT"/>
        </Container>
      </Positioned>
      <Positioned left="0" top="360">
        <Text text="D: ClipPath 圆角柱与等宽折线" fontSize="16" fontFamily="Inter,Noto Sans CJK SC" color="#333333"/>
      </Positioned>
      <Positioned left="0" top="390" width="40" height="120">
        <ClipPath path="M4 0 H36 A4 4 0 0 1 40 4 V116 A4 4 0 0 1 36 120 H4 A4 4 0 0 1 0 116 V4 A4 4 0 0 1 4 0 Z" viewBox="0 0 40 120" fit="FILL">
          <Container color="#2A78D6"/>
        </ClipPath>
      </Positioned>
      <Positioned left="60" top="390" width="600" height="120">
        <ClipPath path="M0 100 L120 60 L240 80 L360 20 L480 50 L600 10 L600 12.5 L480 52.5 L360 22.5 L240 82.5 L120 62.5 L0 102.5 Z" viewBox="0 0 600 120" fit="FILL">
          <Container color="#EB6834"/>
