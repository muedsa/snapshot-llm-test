<Snapshot type="png" background="#FFFFFF">
  <Container width="700" height="620">
    <Stack fit="EXPAND" clipBehavior="NONE">
      <Positioned left="0" top="0">
        <Text text="A: Container w/h, alignment 未设置" fontSize="16" fontFamily="Inter,Noto Sans CJK SC" color="#333333"/>
      </Positioned>
      <Positioned left="0" top="24" width="220" height="60">
        <Container color="#EAF2FE" border="1 SOLID #2A78D6" borderRadius="6">
          <Text text="默认对齐" fontSize="20" color="#2A78D6"/>
        </Container>
      </Positioned>
      <Positioned left="240" top="24" width="220" height="60">
        <Container color="#EAF2FE" border="1 SOLID #2A78D6" borderRadius="6" alignment="CENTER">
          <Text text="CENTER" fontSize="20" color="#2A78D6"/>
        </Container>
      </Positioned>
      <Positioned left="480" top="24" width="220" height="60">
        <Container color="#EAF2FE" border="1 SOLID #2A78D6" borderRadius="6" alignment="TOP_LEFT">
          <Text text="TOP_LEFT" fontSize="20" color="#2A78D6"/>
        </Container>
      </Positioned>
      <Positioned left="0" top="110">
        <Text text="B: 字体样式" fontSize="16" fontFamily="Inter,Noto Sans CJK SC" color="#333333"/>
      </Positioned>
      <Positioned left="0" top="140">
        <Text text="fontStyle=BOLD 粗体 123" fontSize="24" fontFamily="Inter,Noto Sans CJK SC" color="#0B0B0B" fontStyle="BOLD"/>
      </Positioned>
      <Positioned left="0" top="175">
        <Text text="fontFamily='Inter Semi Bold' 半粗 123" fontSize="24" fontFamily="Inter Semi Bold,Noto Sans CJK SC" color="#0B0B0B"/>
      </Positioned>
      <Positioned left="0" top="215">
        <Text text="textStyle=BOLD(未知属性) 123" fontSize="24" fontFamily="Inter,Noto Sans CJK SC" color="#0B0B0B" textStyle="BOLD"/>
      </Positioned>
      <Positioned left="0" top="265">
        <Text text="C: 定位盒内 textAlign=CENTER" fontSize="16" fontFamily="Inter,Noto Sans CJK SC" color="#333333"/>
      </Positioned>
      <Positioned left="0" top="295" width="300" height="40">
        <Container color="#F2F2F0" border="1 SOLID #C3C2B7">
          <Text text="居中在 300px 盒内" fontSize="20" fontFamily="Inter,Noto Sans CJK SC" color="#0B0B0B" textAlign="CENTER"/>
