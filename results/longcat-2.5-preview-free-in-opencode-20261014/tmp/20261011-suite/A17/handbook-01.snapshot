<Snapshot type="png" background="#FFFFFF">
  <Column mainAxisSize="MAX" height="1600" width="1200">
    <Container height="100" padding="(48,48)">
      <Column crossAxisAlignment="START">
        <Text text="从文字到图片 · Snapshot DSL入门" color="#1E293B" fontSize="32" fontStyle="BOLD"/>
        <Text text="第01页：真实调用契约" color="#3B82F6" fontSize="28"/>
      </Column>
    </Container>
    <Container height="80" padding="(48,48)">
      <Text text="POST /snapshot 请求体是UTF-8纯文本DSL，响应是图片二进制。" color="#1E293B" fontSize="24"/>
    </Container>
    <Container height="400" color="#F1F5F9" borderRadius="8" padding="(16,16)">
      <Column crossAxisAlignment="START">
        <Text text="示例DSL（8-12行）" color="#64748B" fontSize="20"/>
        <SizedBox height="16"/>
        <Text text="&lt;Snapshot type=&quot;png&quot;&gt;" color="#1E293B" fontSize="20"/>
        <Text text="  &lt;Column&gt;" color="#1E293B" fontSize="20"/>
        <Text text="    &lt;Container width=&quot;400&quot; height=&quot;240&quot; color=&quot;#3B82F6&quot;&gt;" color="#1E293B" fontSize="20"/>
        <Text text="      &lt;Text text=&quot;Hello&quot; color=&quot;#FFFFFF&quot; fontSize=&quot;32&quot;/&gt;" color="#1E293B" fontSize="20"/>
        <Text text="    &lt;/Container&gt;" color="#1E293B" fontSize="20"/>
        <Text text="  &lt;/Column&gt;" color="#1E293B" fontSize="20"/>
        <Text text="&lt;/Snapshot&gt;" color="#1E293B" fontSize="20"/>
      </Column>
    </Container>
    <SizedBox height="24"/>
    <Container height="300" color="#F1F5F9" borderRadius="8" padding="(16,16)">
      <Column crossAxisAlignment="START">
        <Text text="渲染结果" color="#64748B" fontSize="20"/>
        <SizedBox height="16"/>
        <Container width="400" height="240" color="#3B82F6" borderRadius="8">
          <Column crossAxisAlignment="CENTER">
            <Text text="Hello" color="#FFFFFF" fontSize="32"/>
          </Column>
        </Container>
      </Column>
    </Container>
    <Container height="60" padding="(48,48)">
      <Text text="页码 01/4" color="#64748B" fontSize="20"/>
    </Container>
  </Column>
</Snapshot>