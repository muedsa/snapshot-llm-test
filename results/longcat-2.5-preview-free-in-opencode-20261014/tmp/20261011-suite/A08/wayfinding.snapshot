    </Container>
    <SizedBox height="16"/>
    <Container height="200" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12" padding="(16,16)">
      <Column crossAxisAlignment="START">
        <Text text="路线说明" color="#1E293B" fontSize="18" fontStyle="BOLD"/>
        <Text text="R1 直达出口：S→E 最短路线" color="#EF4444" fontSize="16"/>
        <Text text="R2 主题参观：S→B→D→E 按顺序经过结构剧场入口和作品巡览入口" color="#3B82F6" fontSize="16"/>
        <Text text="入口点：S(0,13) E(25,7) A(13,12) B(6,4) C(17,2) D(23,6)" color="#1E293B" fontSize="14"/>
        <Text text="图例：#=墙体 .=通道 S=入口 E=出口 A=材料实验 B=结构剧场 C=光影工坊 D=作品巡览" color="#64748B" fontSize="14"/>
      </Column>
    </Container>
  </Column>
</Snapshot>
