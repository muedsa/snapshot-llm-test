<Snapshot type="png" background="#F8FAFC">
  <Column mainAxisSize="MAX" height="1080" width="1560">
    <Container height="60" padding="(0,24)">
      <Column crossAxisAlignment="START">
        <Text text="云构展馆 · 双路线导览图" color="#1E293B" fontSize="24" fontStyle="BOLD"/>
        <Text text="R1=直达出口(红) R2=主题参观(蓝) | 1格=2米 | ●=入口点" color="#64748B" fontSize="14"/>
      </Column>
    </Container>
    <SizedBox height="12"/>
    <Container height="800" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12" padding="(16,16)">
      <Column crossAxisAlignment="START">
        <Text text="展馆网格 26×16（每格2米）" color="#1E293B" fontSize="18" fontStyle="BOLD"/>
        <Text text="" color="#1E293B" fontSize="8"/>
        <Text text="  01234567890123456789012345" color="#94A3B8" fontSize="14"/>
        <Text text="0 ##########################" color="#1E293B" fontSize="14"/>
