<Snapshot type="png" background="#F8FAFC">
  <Column mainAxisSize="MAX" height="1100" width="1440">
    <Container height="60" padding="(0,24)">
      <Column crossAxisAlignment="START">
        <Text text="看到差异，才能说用对了" color="#1E293B" fontSize="24" fontStyle="BOLD"/>
        <Text text="六格合成实验板" color="#64748B" fontSize="16"/>
      </Column>
    </Container>
    <SizedBox height="20"/>
    <Row mainAxisSize="MAX">
      <Container width="460" height="480" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="8" padding="(16,16)">
        <Column crossAxisAlignment="START">
          <Text text="① 红蓝50%alpha重叠" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
          <Text text="红#FF000080 蓝#0000FF80" color="#64748B" fontSize="14"/>
          <Text text="红(40,40,160,120) 蓝(120,80,160,120)" color="#64748B" fontSize="12"/>
          <Text text="采样点(180,100): 理论RGB=(64,64,128)" color="#1E293B" fontSize="12"/>
          <Text text="alpha=128/255" color="#EF4444" fontSize="12"/>
        </Column>
      </Container>
      <SizedBox width="30"/>
      <Container width="460" height="480" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="8" padding="(16,16)">
        <Column crossAxisAlignment="START">
          <Text text="② 不透明红蓝+Opacity(0.5)" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
          <Text text="组opacity=0.5" color="#64748B" fontSize="14"/>
          <Text text="红(40,40,160,120) 蓝(120,80,160,120)" color="#64748B" fontSize="12"/>
          <Text text="采样点(180,100): 理论RGB=(128,128,255)" color="#1E293B" fontSize="12"/>
          <Text text="alpha=0.5" color="#EF4444" fontSize="12"/>
        </Column>
      </Container>
      <SizedBox width="30"/>
      <Container width="460" height="480" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="8" padding="(16,16)">
        <Column crossAxisAlignment="START">
          <Text text="③ 背景模糊" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
          <Text text="仅背景模糊sigma=6" color="#64748B" fontSize="14"/>
          <Text text="条纹背景+圆角卡(40,40,240,160)" color="#64748B" fontSize="12"/>
          <Text text="卡内文字SHARP/BLUR清晰" color="#1E293B" fontSize="12"/>
          <Text text="效果限定在圆角区域内" color="#EF4444" fontSize="12"/>
        </Column>
      </Container>
    </Row>
    <SizedBox height="30"/>
    <Row mainAxisSize="MAX">
      <Container width="460" height="480" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="8" padding="(16,16)">
        <Column crossAxisAlignment="START">
          <Text text="④ 子树模糊" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
          <Text text="文字+形状+背景模糊sigma=6" color="#64748B" fontSize="14"/>
          <Text text="条纹背景+圆角卡(40,40,240,160)" color="#64748B" fontSize="12"/>
          <Text text="卡内文字SHARP/BLUR模糊" color="#1E293B" fontSize="12"/>
          <Text text="与③仅改变模糊作用的层" color="#EF4444" fontSize="12"/>
        </Column>
      </Container>
      <SizedBox width="30"/>
      <Container width="460" height="480" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="8" padding="(16,16)">
        <Column crossAxisAlignment="START">
          <Text text="⑤ MULTIPLY+模糊" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
          <Text text="滤色#F6B94A+高斯模糊sigma=6" color="#64748B" fontSize="14"/>
          <Text text="含透明间隙+深色矩形+阴影" color="#64748B" fontSize="12"/>
          <Text text="无裁剪，效果全区可见" color="#1E293B" fontSize="12"/>
          <Text text="与⑥共享相同基础场景" color="#EF4444" fontSize="12"/>
        </Column>
      </Container>
      <SizedBox width="30"/>
      <Container width="460" height="480" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="8" padding="(16,16)">
        <Column crossAxisAlignment="START">
          <Text text="⑥ MULTIPLY+模糊+圆形裁剪" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
          <Text text="滤色#F6B94A+模糊+圆形裁剪" color="#64748B" fontSize="14"/>
          <Text text="圆心(160,120)半径100" color="#64748B" fontSize="12"/>
          <Text text="有色形状跨过圆周，裁剪边界可检查" color="#1E293B" fontSize="12"/>
