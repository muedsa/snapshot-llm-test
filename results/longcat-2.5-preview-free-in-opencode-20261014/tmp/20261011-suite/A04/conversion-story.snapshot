<Snapshot type="png" background="#F8FAFC">
  <Column mainAxisSize="MAX" height="1000" width="1600">
    <Container height="70" padding="(0,24)">
      <Column crossAxisAlignment="START">
        <Text text="转化变化，为什么不能只看平均？" color="#1E293B" fontSize="28" fontStyle="BOLD"/>
        <Text text="辛普森悖论：分组改善但总体下降" color="#64748B" fontSize="16"/>
      </Column>
    </Container>
    <SizedBox height="16"/>
    <Row mainAxisSize="MAX">
      <Container width="500" height="300" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12" padding="(16,16)">
        <Column crossAxisAlignment="START">
          <Text text="渠道分组转化率" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
          <Text text="直接访问：前期30.00% → 后期35.00% ↑" color="#3B82F6" fontSize="14"/>
          <Text text="推广访问：前期10.00% → 后期12.00% ↑" color="#10B981" fontSize="14"/>
          <Text text="两渠道转化率均上升" color="#1E293B" fontSize="13"/>
        </Column>
      </Container>
      <SizedBox width="16"/>
      <Container width="500" height="300" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12" padding="(16,16)">
        <Column crossAxisAlignment="START">
          <Text text="访问构成变化" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
          <Text text="前期：直接访问80% / 推广访问20%" color="#3B82F6" fontSize="14"/>
          <Text text="后期：直接访问20% / 推广访问80%" color="#10B981" fontSize="14"/>
          <Text text="低转化渠道占比大幅上升" color="#1E293B" fontSize="13"/>
        </Column>
      </Container>
      <SizedBox width="16"/>
      <Container width="500" height="300" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12" padding="(16,16)">
        <Column crossAxisAlignment="START">
          <Text text="总体转化率" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
          <Text text="前期：2600/10000 = 26.00%" color="#3B82F6" fontSize="14"/>
          <Text text="后期：1660/10000 = 16.60%" color="#EF4444" fontSize="14"/>
          <Text text="总体转化率下降9.40个百分点" color="#1E293B" fontSize="13"/>
        </Column>
      </Container>
    </Row>
    <SizedBox height="20"/>
    <Container height="200" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12" padding="(16,16)">
      <Column crossAxisAlignment="START">
        <Text text="数据明细" color="#1E293B" fontSize="16" fontStyle="BOLD"/>
        <Text text="期间      渠道        访问数    成交数    转化率" color="#64748B" fontSize="12"/>
        <Text text="前期      直接访问    8000      2400      30.00%" color="#1E293B" fontSize="13"/>
        <Text text="前期      推广访问    2000      200       10.00%" color="#1E293B" fontSize="13"/>
        <Text text="后期      直接访问    2000      700       35.00%" color="#1E293B" fontSize="13"/>
        <Text text="后期      推广访问    8000      960       12.00%" color="#1E293B" fontSize="13"/>
        <Text text="总体      前期        10000     2600      26.00%" color="#3B82F6" fontSize="13"/>
        <Text text="总体      后期        10000     1660      16.60%" color="#EF4444" fontSize="13"/>
      </Column>
    </Container>
    <SizedBox height="20"/>
    <Container height="200" color="#FEF3C7" border="1 SOLID #FDE68A" borderRadius="12" padding="(16,16)">
      <Column crossAxisAlignment="START">
        <Text text="主结论" color="#92400E" fontSize="16" fontStyle="BOLD"/>
        <Text text="两渠道转化率均上升（直接访问+5%，推广访问+2%），但总体转化率从26.00%降至16.60%。原因是低转化的推广访问占比从20%升至80%，拉低了总体。" color="#92400E" fontSize="14"/>
        <Text text="限制说明：该数据不能证明因果关系，只能说明相关性。" color="#92400E" fontSize="13"/>
      </Column>
    </Container>
  </Column>
</Snapshot>
