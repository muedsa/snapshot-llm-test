<Positioned left="370" top="962" width="470"><Container alignment="CENTER_LEFT"><Text fontSize="16" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">30 min rest, then 3 folds / 45 min</Text></Container></Positioned>
<Positioned left="856" top="962" width="150"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#241E17FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">25 °C</Text></Container></Positioned>
