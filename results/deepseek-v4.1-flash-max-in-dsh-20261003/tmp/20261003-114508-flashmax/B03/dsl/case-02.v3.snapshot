<Positioned left="370" top="918" width="470"><Container alignment="CENTER_LEFT"><Text fontSize="16" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Autolyse 40 min, then salt 2.1%</Text></Container></Positioned>
<Positioned left="856" top="918" width="150"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#241E17FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">24 °C</Text></Container></Positioned>
