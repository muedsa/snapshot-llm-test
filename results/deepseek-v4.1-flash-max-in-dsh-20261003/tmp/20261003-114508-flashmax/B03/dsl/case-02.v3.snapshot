<Positioned left="72" top="918" width="96"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#B4531BFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">09:00</Text></Container></Positioned>
