<Positioned left="370" top="1094" width="470"><Container alignment="CENTER_LEFT"><Text fontSize="16" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Bench rest 25 min, medium tension</Text></Container></Positioned>
<Positioned left="856" top="1094" width="150"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#241E17FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">24 °C</Text></Container></Positioned>
<Positioned left="64" top="1132"><Container width="1112" height="44" color="#F1EAD9FF" borderRadius="4"/></Positioned>
<Positioned left="72" top="1138" width="96"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#B4531BFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">20:00</Text></Container></Positioned>
<Positioned left="184" top="1138" width="168"><Container alignment="CENTER_LEFT"><Text fontSize="16" color="#241E17FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Shape → retard</Text></Container></Positioned>
<Positioned left="370" top="1138" width="470"><Container alignment="CENTER_LEFT"><Text fontSize="16" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Into the 4 °C retarder overnight</Text></Container></Positioned>
<Positioned left="856" top="1138" width="150"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#241E17FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">4 °C</Text></Container></Positioned>
<Positioned left="72" top="1182" width="96"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#B4531BFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">06:30</Text></Container></Positioned>
<Positioned left="184" top="1182" width="168"><Container alignment="CENTER_LEFT"><Text fontSize="16" color="#241E17FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Bake</Text></Container></Positioned>
<Positioned left="370" top="1182" width="470"><Container alignment="CENTER_LEFT"><Text fontSize="16" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">250 °C deck, 22 min + 18 min</Text></Container></Positioned>
<Positioned left="856" top="1182" width="150"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#241E17FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">96 °C core</Text></Container></Positioned>
<Positioned left="72" top="1230"><Container width="1096" height="2" color="#241E17FF"/></Positioned>
<Positioned left="72" top="1260"><Text fontSize="15" color="#6B6152FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD" letterSpacing="2">BAKER'S NOTES</Text></Positioned>
<Positioned left="72" top="1290"><Text fontSize="17" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Dough entering the retarder at 4 °C is ready to bake between 06:00 and 09:00. If the room climbs above 24 °C, cut bulk</Text></Positioned>
<Positioned left="72" top="1316"><Text fontSize="17" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">by 25 minutes rather than chilling the dough — cold shock costs oven spring.</Text></Positioned>
<Positioned left="72" top="1342"><Text fontSize="17" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Score bâtards at 30° with a single cut. Steam for the first 12 minutes, then vent. Tin loaves go in 20 minutes after the</Text></Positioned>
<Positioned left="72" top="1368"><Text fontSize="17" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">deck batch.</Text></Positioned>
<Positioned left="0" top="1658"><Container width="1240" height="96" color="#F1EAD9FF"/></Positioned>
<Positioned left="72" top="1688"><Text fontSize="13" color="#6B6152FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">ARTISAN BREAD · PLAN № 26-1003 · 2026-10-03</Text></Positioned>
<Positioned left="1168" top="1688" width="520"><Container alignment="CENTER_RIGHT"><Text fontSize="13" color="#6B6152FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">temperatures are illustrative for a fictional bakery</Text></Container></Positioned>
<Positioned left="72" top="1712"><Text fontSize="13" color="#6B6152FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">1 / 1</Text></Positioned>
