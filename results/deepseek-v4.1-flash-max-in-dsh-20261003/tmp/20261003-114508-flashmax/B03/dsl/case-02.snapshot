<Positioned left="856" top="1006" width="150"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#241E17FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">26 °C</Text></Container></Positioned>
<Positioned left="64" top="1044"><Container width="1112" height="44" color="#F1EAD9FF" borderRadius="4"/></Positioned>
<Positioned left="72" top="1050" width="96"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#B4531BFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">15:00</Text></Container></Positioned>
<Positioned left="184" top="1050" width="168"><Container alignment="CENTER_LEFT"><Text fontSize="16" color="#241E17FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">Divide</Text></Container></Positioned>
<Positioned left="370" top="1050" width="470"><Container alignment="CENTER_LEFT"><Text fontSize="16" color="#6B6152FF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">4 × 620 g bâtard, 12 × 480 g tin</Text></Container></Positioned>
<Positioned left="856" top="1050" width="150"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#241E17FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">25 °C</Text></Container></Positioned>
<Positioned left="72" top="1094" width="96"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#B4531BFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">17:30</Text></Container></Positioned>
