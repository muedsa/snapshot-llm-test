<Positioned left="856" top="918" width="150"><Container alignment="CENTER_LEFT"><Text fontSize="15" color="#241E17FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">24 °C</Text></Container></Positioned>
