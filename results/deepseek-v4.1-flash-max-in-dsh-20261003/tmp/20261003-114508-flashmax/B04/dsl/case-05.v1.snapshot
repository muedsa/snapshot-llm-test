<Positioned left="637.0" top="528.94" width="140"><Container alignment="CENTER"><Text fontSize="16" color="#F5F8FCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">PSC</Text></Container></Positioned>
<Positioned left="637.0" top="548.94" width="140"><Container alignment="CENTER"><Text fontSize="12" color="#2DD4BFFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">particles</Text></Container></Positioned>
<Positioned left="510" top="722.94"><Container width="96.0" height="20" color="#2DD4BF22" borderRadius="10" border="1 SOLID #2DD4BF99"/></Positioned>
<Positioned left="510" top="725.94" width="96.0"><Container alignment="CENTER"><Text fontSize="10" color="#2DD4BFFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">PSC particles</Text></Container></Positioned>
<Positioned left="648" top="722.94"><Container width="72.0" height="20" color="#2DD4BF22" borderRadius="10" border="1 SOLID #2DD4BF99"/></Positioned>
<Positioned left="648" top="725.94" width="72.0"><Container alignment="CENTER"><Text fontSize="10" color="#2DD4BFFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">Cl₂ forms</Text></Container></Positioned>
<Positioned left="786" top="722.94"><Container width="120.0" height="20" color="#2DD4BF22" borderRadius="10" border="1 SOLID #2DD4BF99"/></Positioned>
<Positioned left="786" top="725.94" width="120.0"><Container alignment="CENTER"><Text fontSize="10" color="#2DD4BFFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">surface chemistry</Text></Container></Positioned>
<Positioned left="932" top="206.94"><Container width="434" height="560" color="#16264AFF" borderRadius="10" border="1 SOLID #25375FFF"/></Positioned>
<Positioned left="932" top="206.94"><Container width="434" height="4" color="#F5A524FF"/></Positioned>
<Positioned left="952" top="224.94"><Text fontSize="26" color="#F5A524FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">03</Text></Positioned>
<Positioned left="994" top="228.94"><Text fontSize="12" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD" letterSpacing="1">September–October</Text></Positioned>
<Positioned left="952" top="260.94"><Text fontSize="20" color="#F5F8FCFF" fontFamily="Inter" fontStyle="BOLD">Sunlight returns</Text></Positioned>
<Positioned left="952" top="286.94"><Text fontSize="13" color="#F5A524FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">Catalytic destruction</Text></Positioned>
<Positioned left="952" top="313"><Text fontSize="13" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">UV light splits Cl₂ and frees chlorine atoms. A</Text></Positioned>
<Positioned left="952" top="331"><Text fontSize="13" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">single chlorine atom destroys ozone and is</Text></Positioned>
<Positioned left="952" top="349"><Text fontSize="13" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">regenerated, so it can go on destroying thousands</Text></Positioned>
<Positioned left="952" top="367"><Text fontSize="13" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">of molecules. Bromine runs a second catalytic</Text></Positioned>
<Positioned left="952" top="385"><Text fontSize="13" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">cycle alongside it.</Text></Positioned>
