<Positioned left="1068.0" top="455.94"><Container width="162.0" height="162.0" color="#F5A5241A" borderRadius="81.0"/></Positioned>
<Positioned left="1079.0" top="528.94" width="140"><Container alignment="CENTER"><Text fontSize="18" color="#F5A524FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">hν</Text></Container></Positioned>
<Positioned left="1079.0" top="550.94" width="140"><Container alignment="CENTER"><Text fontSize="13" color="#F5F8FCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">Cl + O₃</Text></Container></Positioned>
<Positioned left="952" top="722.94"><Container width="96.0" height="20" color="#F5A52422" borderRadius="10" border="1 SOLID #F5A52499"/></Positioned>
<Positioned left="952" top="725.94" width="96.0"><Container alignment="CENTER"><Text fontSize="10" color="#F5A524FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">UV splits Cl₂</Text></Container></Positioned>
<Positioned left="1090" top="722.94"><Container width="60.0" height="20" color="#F5A52422" borderRadius="10" border="1 SOLID #F5A52499"/></Positioned>
<Positioned left="1090" top="725.94" width="60.0"><Container alignment="CENTER"><Text fontSize="10" color="#F5A524FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">O₃ → O₂</Text></Container></Positioned>
<Positioned left="1228" top="722.94"><Container width="102.0" height="20" color="#F5A52422" borderRadius="10" border="1 SOLID #F5A52499"/></Positioned>
<Positioned left="1228" top="725.94" width="102.0"><Container alignment="CENTER"><Text fontSize="10" color="#F5A524FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">Cl regenerated</Text></Container></Positioned>
<Positioned left="1374" top="206.94"><Container width="434" height="560" color="#16264AFF" borderRadius="10" border="1 SOLID #25375FFF"/></Positioned>
<Positioned left="1374" top="206.94"><Container width="434" height="4" color="#34D399FF"/></Positioned>
<Positioned left="1394" top="224.94"><Text fontSize="26" color="#34D399FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">04</Text></Positioned>
<Positioned left="1436" top="228.94"><Text fontSize="12" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD" letterSpacing="1">November–December</Text></Positioned>
<Positioned left="1394" top="260.94"><Text fontSize="20" color="#F5F8FCFF" fontFamily="Inter" fontStyle="BOLD">Vortex breaks down</Text></Positioned>
<Positioned left="1394" top="286.94"><Text fontSize="13" color="#34D399FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">The hole closes</Text></Positioned>
<Positioned left="1394" top="313"><Text fontSize="13" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">As the polar stratosphere warms the vortex</Text></Positioned>
<Positioned left="1394" top="331"><Text fontSize="13" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">weakens, ozone-rich air from lower latitudes mixes</Text></Positioned>
<Positioned left="1394" top="349"><Text fontSize="13" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">in and the reactive chlorine disperses. The hole</Text></Positioned>
<Positioned left="1394" top="367"><Text fontSize="13" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">closes until the next spring.</Text></Positioned>
