<Positioned left="48" top="1038.94"><Container width="1304" height="152" color="#16264AFF" borderRadius="8" border="1 SOLID #25375FFF"/></Positioned>
<Positioned left="72" top="1054.94"><Text fontSize="12" color="#2DD4BFFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD" letterSpacing="2">WHAT THE CALENDAR SHOWS</Text></Positioned>
<Positioned left="72" top="1084.94"><Text fontSize="13" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">Aug</Text></Positioned>
<Positioned left="72" top="1104.94"><Text fontSize="30" color="#F5F8FCFF" fontFamily="Inter" fontStyle="BOLD">0</Text></Positioned>
<Positioned left="98.0" top="1122.94"><Text fontSize="12" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">years</Text></Positioned>
<Positioned left="222" top="1084.94"><Text fontSize="13" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">Sep</Text></Positioned>
<Positioned left="222" top="1104.94"><Text fontSize="30" color="#F5F8FCFF" fontFamily="Inter" fontStyle="BOLD">36</Text></Positioned>
<Positioned left="266.0" top="1122.94"><Text fontSize="12" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">years</Text></Positioned>
<Positioned left="372" top="1084.94"><Text fontSize="13" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">Oct</Text></Positioned>
<Positioned left="372" top="1104.94"><Text fontSize="30" color="#F5F8FCFF" fontFamily="Inter" fontStyle="BOLD">10</Text></Positioned>
<Positioned left="416.0" top="1122.94"><Text fontSize="12" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">years</Text></Positioned>
<Positioned left="522" top="1084.94"><Text fontSize="13" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="BOLD">Nov</Text></Positioned>
<Positioned left="522" top="1104.94"><Text fontSize="30" color="#F5F8FCFF" fontFamily="Inter" fontStyle="BOLD">0</Text></Positioned>
<Positioned left="548.0" top="1122.94"><Text fontSize="12" color="#8FA0BCFF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">years</Text></Positioned>
<Positioned left="700" top="1078.94"><Container width="1" height="96" color="#25375FFF"/></Positioned>
<Positioned left="732" top="1081"><Text fontSize="14" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">All 46 of the 46 measured peaks fall in September or October, so the</Text></Positioned>
<Positioned left="732" top="1101"><Text fontSize="14" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">season never moved — only the depth of the peak did. The earliest</Text></Positioned>
<Positioned left="732" top="1121"><Text fontSize="14" color="#B9C7DE" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">peak is 07 Sep and the latest is 17 Oct.</Text></Positioned>
<Positioned left="48" top="1486"><Container width="1304" height="1" color="#7C8CB040"/></Positioned>
<Positioned left="48" top="1498" width="1304"><Container alignment="CENTER_LEFT"><Text fontSize="11" color="#6C7C99FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">SOURCES  S1 NASA Ozone Watch — Annual Records (Antarctic) · S2 NASA Ozone Watch — What is the Ozone Hole?</Text></Container></Positioned>
<Positioned left="48" top="1516" width="1304"><Container alignment="CENTER_LEFT"><Text fontSize="11" color="#6C7C99FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">Arc angle = published date of that year's maximum daily hole area; arc length = the published area. The amber sector is the 07 Sep – 13 Oct averaging window named in the source table. The grey profile is a schematic of the documented August–October cycle, not measured data.</Text></Container></Positioned>
<Positioned left="48" top="1538"><Text fontSize="11" color="#6C7C99FF" fontFamily="Noto Sans Mono CJK SC" fontStyle="NORMAL">STRATOSPHERE REVIEW · ISSUE 07 · FIG. 04</Text></Positioned>
