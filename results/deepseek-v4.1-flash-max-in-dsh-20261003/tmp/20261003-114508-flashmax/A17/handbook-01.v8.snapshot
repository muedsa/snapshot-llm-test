<Positioned left="68" top="208"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">1 · 请求：纯文本 DSL</Text></Positioned>
<Positioned left="70" top="259"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="250" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">方法与路径</Text></Container></Positioned>
<Positioned left="242" top="250"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">POST /snapshot，没有 JSON 包装，也没有 multipart。</Text></Positioned>
<Positioned left="70" top="300"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="291" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">请求头</Text></Container></Positioned>
<Positioned left="242" top="291"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Content-Type: text/plain; charset=utf-8</Text></Positioned>
<Positioned left="70" top="341"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="332" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">UTF-8</Text></Container></Positioned>
<Positioned left="242" top="332"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">本体必须是 UTF-8；带 BOM 会在位置 0 报 Not Support RAWTEXT。</Text></Positioned>
<Positioned left="70" top="382"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="373" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">请求体</Text></Container></Positioned>
<Positioned left="242" top="373"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">就是 .snapshot 原文：一棵以 Snapshot 为根的元素树。</Text></Positioned>
<Positioned left="70" top="423"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="414" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">根节点</Text></Container></Positioned>
<Positioned left="242" top="414"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">只允许一个根子节点；多一个就是 400 PARSE_ERROR。</Text></Positioned>
<Positioned left="48" top="498"><Container width="1104" height="252" color="#FFFFFFFF" borderRadius="14" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="48" top="516"><Container width="5" height="26" color="#0E9F8FFF" borderRadiusTopLeft="3" borderRadiusBottomLeft="3"/></Positioned>
<Positioned left="68" top="514"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">2 · 响应：两条分支</Text></Positioned>
<Positioned left="64" top="556"><Container width="520" height="182" color="#F0FDF9FF" borderRadius="10" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="80" top="568"><Text fontSize="20" color="#047857FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">HTTP 200 · Content-Type: image/png</Text></Positioned>
<Positioned left="86" top="617"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="106" top="608"><Text fontSize="20" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">本体就是 PNG 原始字节，直接写入 .png。</Text></Positioned>
<Positioned left="86" top="653"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="106" top="644"><Text fontSize="20" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">响应头带 X-Request-Id，可用来对账。</Text></Positioned>
<Positioned left="608" top="556"><Container width="520" height="182" color="#FEF2F2FF" borderRadius="10" border="1 SOLID #E2E8F0FF"/></Positioned>
<Positioned left="624" top="568"><Text fontSize="20" color="#B42318FF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">HTTP 400 · Content-Type: application/json</Text></Positioned>
<Positioned left="630" top="617"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="650" top="608"><Text fontSize="20" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">本体是 {code, message, requestId} 错误对象</Text></Positioned>
<Positioned left="650" top="634"><Text fontSize="20" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">。</Text></Positioned>
<Positioned left="630" top="679"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="650" top="670"><Text fontSize="20" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">绝不能把这份 JSON 存成 .png。</Text></Positioned>
