<Positioned left="68" top="208"><Text fontSize="24" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">1 · 请求：纯文本 DSL</Text></Positioned>
<Positioned left="70" top="259"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="250" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">方法与路径</Text></Container></Positioned>
<Positioned left="242" top="250"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">POST /snapshot，没有 JSON 包装，也没有 multi</Text></Positioned>
<Positioned left="242" top="279"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">part。</Text></Positioned>
<Positioned left="70" top="331"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="322" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">请求头</Text></Container></Positioned>
<Positioned left="242" top="322"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">Content-Type: text/plain; charset=utf-8</Text></Positioned>
<Positioned left="70" top="374"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="365" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">UTF-8</Text></Container></Positioned>
<Positioned left="242" top="365"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">本体必须是 UTF-8；带 BOM 会在位置 0 报 Not Su</Text></Positioned>
<Positioned left="242" top="394"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">pport RAWTEXT。</Text></Positioned>
<Positioned left="70" top="446"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="437" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">请求体</Text></Container></Positioned>
<Positioned left="242" top="437"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">就是 .snapshot 原文：一棵以 &lt;Snapshot&gt; 为根</Text></Positioned>
<Positioned left="242" top="466"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">的元素树。</Text></Positioned>
<Positioned left="70" top="518"><Container width="9" height="9" color="#0E9F8FFF" borderRadius="4"/></Positioned>
<Positioned left="90" top="509" width="148"><Container alignment="CENTER_LEFT"><Text fontSize="22" color="#0F172AFF" fontFamily="Noto Sans CJK SC" fontStyle="BOLD">根节点</Text></Container></Positioned>
<Positioned left="242" top="509"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">只允许一个根子节点；多一个就是 400 PARSE_ERRO</Text></Positioned>
<Positioned left="242" top="538"><Text fontSize="22" color="#1E293BFF" fontFamily="Noto Sans CJK SC" fontStyle="NORMAL">R。</Text></Positioned>
<Positioned left="792" top="250"><Container width="336" height="196" color="#F8FAFCFF" borderRadius="10" border="1 SOLID #E2E8F0FF"/></Positioned>
