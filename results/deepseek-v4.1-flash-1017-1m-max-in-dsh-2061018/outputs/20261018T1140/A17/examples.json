  "technical_claims": [
    {
      "id": "T1",
      "claim": "请求体是 UTF-8 文本 DSL；成功返回 image/png 二进制；失败返回 JSON（code/message/requestId）。",
      "source": "https://open-snapshot.muedsa.com/ai-guide.md",
      "example": "P01",
      "page": 1
    },
    {
      "id": "T2",
      "claim": "根尺寸由有界容器/布局决定，不是 HTML viewport；Row/Column 主轴必须有界，Expanded 只在其中分配剩余空间。",
      "source": "https://snapshot.muedsa.com/guides/layout/",
      "example": "P02",
      "page": 2
    },
    {
      "id": "T3",
      "claim": "普通 Text 会 trim 首尾空格；Raw 保留空白；字面 < > & 用 Text 的 text 属性。",
      "source": "https://snapshot.muedsa.com/reference/parser-tags/",
      "example": "P03",
      "page": 3
    },
    {
      "id": "T4",
      "claim": "颜色支持 #RRGGBBAA，最后两位是 alpha（约 50% 的 #F9736280）。",
      "source": "https://snapshot.muedsa.com/reference/parser-tags/",
      "example": "P03",
      "page": 3
    },
    {
      "id": "T5",
      "claim": "官方解析标签表没有 CDATA；不要把它当作 Snapshot 的转义机制。",
      "source": "https://snapshot.muedsa.com/reference/parser-tags/",
      "example": "P03",
      "page": 3
    },
    {
      "id": "T6",
      "claim": "ImageFiltered 对单个子树做高斯模糊，sigmaX/sigmaY 必须有限非负；ClipRRect 可限定范围。",
      "source": "https://snapshot.muedsa.com/reference/parser-tags/",
      "example": "P04",
      "page": 4
    },
    {
      "id": "T7",
      "claim": "本套实测 BackdropFilter 容易受背景/裁剪影响；可靠背景模糊用裁剪后的背景副本 + ImageFiltered。",
      "source": "tmp/20261018T1140/A03/composite-audit.json; tmp/20261018T1140/A10/composite-audit.json",
      "example": "P04",
      "page": 4
    }
  ]
