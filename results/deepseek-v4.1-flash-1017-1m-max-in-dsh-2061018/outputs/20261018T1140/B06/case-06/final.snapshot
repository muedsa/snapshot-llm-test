sitioned><Positioned left="84" top="534"><Text fontSize="18" color="#6B5948" fontFamily="Inter,Noto Sans CJK SC">油热下蛋，凝固即盛出；番茄炒到出汁。</Text></Positioned><Positioned left="56" top="650"><Container width="1088" height="180" color="#FFFFFF" borderRadius="12" border="1 SOLID #DCCDB8" /></Positioned><Positioned left="56" top="650"><Container width="10" height="180" color="#C68A2E" borderRadius="5" /></Positioned><Positioned left="84" top="670"><Text fontSize="18" color="#C68A2E" fontStyle="BOLD" fontFamily="Noto Sans Mono CJK SC,Inter">7–11</Text></Positioned><Positioned left="84" top="702"><Text fontSize="26" color="#33251A" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">煮面 / 合锅</Text></Positioned><Positioned left="84" top="744"><Text fontSize="18" color="#6B5948" fontFamily="Inter,Noto Sans CJK SC">面煮 3 分钟；把蛋回锅，加盐/糖。</Text></Positioned><Positioned left="56" top="860"><Container width="1088" height="180" color="#FFFFFF" borderRadius="12" border="1 SOLID #DCCDB8" /></Positioned><Positioned left="56" top="860"><Container width="10" height="180" color="#3E5F7A" borderRadius="5" /></Positioned><Positioned left="84" top="880"><Text fontSize="18" color="#3E5F7A" fontStyle="BOLD" fontFamily="Noto Sans Mono CJK SC,Inter">11–15</Text></Positioned><Positioned left="84" top="912"><Text fontSize="26" color="#33251A" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">装碗 / 收尾</Text></Positioned><Positioned left="84" top="954"><Text fontSize="18" color="#6B5948" fontFamily="Inter,Noto Sans CJK SC">尝咸淡；葱花/香油可选。关火再盛。</Text></Positioned><Positioned left="56" top="1120"><Text fontSize="18" color="#B84A35" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">食材</Text></Positioned><Positioned left="56" top="1152" width="1000" height="80"><Text fontSize="19" color="#33251A" fontFamily="Inter,Noto Sans CJK SC" height="1.6">面条 200g · 番茄 2 个 · 鸡蛋 2 个
盐 2g · 糖 3g · 油 10g · 葱花少许</Text></Positioned><Positioned left="56" top="1270"><Text fontSize="18" color="#B84A35" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">别烧糊</Text></Positioned><Positioned left="56" top="1302" width="1000" height="80"><Text fontSize="18" color="#33251A" fontFamily="Inter,Noto Sans CJK SC" height="1.5">水开后转中火；面下锅后设 3 分钟计时。
番茄出汁前不要加盐。</Text></Positioned><Positioned left="56" top="1480"><Text fontSize="11" color="#8A7B66" fontFamily="Noto Sans Mono CJK SC,Inter">演示菜谱 · 可按口味调整</Text></Positioned></Stack>
