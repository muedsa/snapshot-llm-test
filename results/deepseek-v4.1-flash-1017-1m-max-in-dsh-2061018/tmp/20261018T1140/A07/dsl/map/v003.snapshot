ight="8" /><Row><Container width="16" height="16" color="#F8FAFC" borderRadius="8" /><SizedBox width="8" /><Column crossAxisAlignment="START"><Text fontSize="20" color="#EAF2FB" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">S05 东桥</Text><Text fontSize="15" color="#F87171" fontFamily="Inter,Noto Sans CJK SC">R ↔ G · N 无设施</Text></Column></Row><SizedBox height="16" /><Container width="280" height="1" color="#22314B" /><SizedBox height="12" /><Text fontSize="18" color="#EAF2FB" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">无障碍规则</Text><SizedBox height="4" /><Text fontSize="15" color="#93A6C2" fontFamily="Inter,Noto Sans CJK SC" height="1.45">A 站可作起点/终点/换乘；N 站可乘车通过，但不可上下车或换乘。</Text><SizedBox height="12" /><Text fontSize="18" color="#EAF2FB" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">读图规则</Text><SizedBox height="4" /><Text fontSize="15" color="#93A6C2" fontFamily="Inter,Noto Sans CJK SC" height="1.45">站距不代表实际距离；相邻站耗时相同；区间数 = 边数，不是站数。</Text><SizedBox height="12" /><Container width="280" height="1" color="#22314B" /><SizedBox height="12" /><Text fontSize="20" color="#EAF2FB" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">16 站 / 3 线</Text><Text fontSize="16" color="#93A6C2" fontFamily="Inter,Noto Sans CJK SC">R 7 · B 6 · G 6 站</Text></Column></Container></Positioned><Positioned left="32" top="958" width="1536" height="20"><Row crossAxisAlignment="CENTER"><Text fontSize="15" color="#5F7290" fontFamily="Inter,Noto Sans CJK SC">非地理示意图 · 所有相邻站耗时相同 · 仅用于拓扑关系</Text><Spacer /><Text fontSize="14" color="#5F7290" fontFamily="Inter" letterSpacing="1">NETWORK MAP · THREE LINES</Text></Row></Positioned></Stack>
