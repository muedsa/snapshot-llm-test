{
  "colors": {
    "background": "#080E1A",
    "panel": "#0E1A2C",
    "panel_alt": "#111F35",
    "ink": "#F1F5F9",
    "muted": "#93A6C2",
    "accent_coral": "#F97362",
    "accent_cyan": "#22D3EE",
    "accent_gold": "#F5C451",
    "line": "#22314B"
  },
  "typography": {
    "mobile": {
      "main_title": 40,
      "subtitle": 16,
      "body": 16,
      "card_title": 18,
      "card_detail": 16,
      "meta": 16,
      "cta": 16
    },
    "tablet": {
      "main_title": 64,
      "subtitle": 24,
      "body": 20,
      "card_title": 22,
      "card_detail": 20,
      "meta": 18,
      "cta": 20
    },
    "desktop": {
      "main_title": 72,
      "subtitle": 24,
      "body": 20,
      "card_title": 24,
      "card_detail": 20,
      "meta": 18,
      "cta": 20
    },
    "stage": {
      "main_title": 88,
      "subtitle": 30,
      "body": 21,
      "card_title": 26,
      "card_detail": 20,
      "meta": 20,
      "cta": 22
    }
  },
  "spacing": {
    "mobile": {
      "canvas": [
        360,
        800
      ],
      "margin": 16,
      "gap": 8,
      "card_gap": 3
    },
    "tablet": {
      "canvas": [
        768,
        1024
      ],
      "margin": 32,
      "gap": 16,
      "card_gap": 24
    },
    "desktop": {
      "canvas": [
        1440,
        900
      ],
      "margin": 32,
      "gap": 18,
      "card_gap": 28
    },
    "stage": {
      "canvas": [
        1920,
        1080
      ],
      "margin": 32,
      "gap": 20,
      "card_gap": 16
    }
  },
  "components": [
    {
      "name": "event-card",
      "rules": "panel + 1px line + 3px top accent + index + title + detail; no truncation"
    },
    {
      "name": "title-slash",
      "rules": "Structure <coral>/</coral> Vision; same motif at all breakpoints"
    },
    {
      "name": "meta-chip",
      "rules": "date/time/location in mono/sans chips; wrap to lines only on mobile"
    },
    {
      "name": "cta-text",
      "rules": "text CTA only, no QR; bordered pill on tablet+; plain text on mobile"
    },
    {
      "name": "layout",
      "rules": "mobile 1col; tablet 2col; desktop 3x2; stage 6x1"
    }
  ]
}