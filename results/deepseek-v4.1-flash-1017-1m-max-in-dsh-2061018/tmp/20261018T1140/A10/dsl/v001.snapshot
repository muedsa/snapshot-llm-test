 color="#F6B94A" blendMode="MULTIPLY"><Stack width="320" height="240"><SizedBox width="320" height="240" /><Positioned left="20" top="70"><Container width="280" height="100" color="#1F2937" borderRadius="14" /></Positioned><Positioned left="60" top="30"><Container width="70" height="58" color="#2563EB" borderRadius="10" /></Positioned><Positioned left="190" top="30"><Container width="70" height="58" color="#0EA5E9" borderRadius="10" /></Positioned><Positioned left="60" top="150"><Container width="80" height="30" color="#F59E0B" borderRadius="6" /></Positioned><Positioned left="150" top="150"><Container width="100" height="30" color="#EF4444" borderRadius="6" /></Positioned><Positioned left="110" top="84"><Container width="100" height="72" color="#FFFFFF" borderRadius="12" boxShadow="0 10 22 0 #00000066 NORMAL" /></Positioned></Stack></ColorFiltered></ImageFiltered></ClipPath></Positioned></Stack></Container></Positioned><Positioned left="952" top="846" width="400" height="20"><Text fontSize="16" color="#9CA3AF" fontFamily="Inter">局部 320×240 · origin (952,600)</Text></Positioned><Positioned left="44" top="900" width="1352" height="176"><Container width="1352" height="176" color="#FFFFFF" borderRadius="14" border="1 SOLID #D9E0E8" padding="(14,22)"><Column crossAxisAlignment="START"><Row><Text fontSize="22" color="#111827" fontStyle="BOLD" fontFamily="Inter,Noto Sans CJK SC">读数与判断</Text><SizedBox width="10" /><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">采样点：局部 (180,100)；① ② 分别在各自实验区</Text></Row><SizedBox height="4" /><Text fontSize="20" color="#111827" fontFamily="Inter,Noto Sans CJK SC">① 128/255 逐层：红 over 白 → 蓝 over 红 ⇒ 理论 (127.000, 63.247, 191.247)，取整 (127,63,191)。</Text><Text fontSize="20" color="#111827" fontFamily="Inter,Noto Sans CJK SC">② 组 0.5：不透明蓝整体 over 白 ⇒ 理论 (127.5, 127.5, 255.0)，取整 (128,128,255)。128/255 与 0.5 不是同一个 alpha。</Text><Text fontSize="20" color="#6B7280" fontFamily="Inter,Noto Sans CJK SC">③ 文字清晰、卡内背景模糊、卡外不外溢；④ 文字与前景一起模糊；⑤ 无裁剪、模糊向圆周外溢出；⑥ 同样结果被 r=100 圆裁剪，边界可见。</Text></Column></Container></Positioned><Positioned left="44" top="1080" width="1352" height="18"><Row crossAxisAlignment="CENTER"><Text fontSize="15" color="#9CA3AF" fontFamily="Inter,Noto Sans CJK SC">数据源：任务说明中的固定参数 · 无外部素材</Text><Spacer /><Text fontSize="14" color="#9CA3AF" fontFamily="Inter" letterSpacing="1">COMPOSITING LAB · 1440×1100</Text></Row></Positioned></Stack>
</Snapshot>
