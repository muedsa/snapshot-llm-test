<Container color="#9BE8A0FF" width="4" height="116" />
</Positioned>
<Positioned left="98" top="384">
<Text color="#6E8AA0FF" fontSize="13.0" fontFamily="DejaVu Sans Mono" text="01" />
</Positioned>
<Positioned left="138" top="382" width="958">
<Text color="#F1F7FBFF" fontSize="17.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="海洋吸收了大约四分之一的人为排放 CO2" />
</Positioned>
<Positioned left="1100" top="380" width="104" height="26">
<Container color="#9BE8A026" borderRadius="13.0" border="1 SOLID #9BE8A077" width="104" height="26" />
</Positioned>
<Positioned left="1100" top="385" width="104">
<Text color="#9BE8A0FF" fontSize="13.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" textAlign="CENTER" text="已证实" />
</Positioned>
<Positioned left="138" top="412" width="1066" height="22.6">
<Text color="#A8C2D4FF" fontSize="12.0" fontFamily="Inter,Noto Sans CJK SC" letterSpacing="0.1" text="IPCC SROCC：最近二十年海洋吸收占人为排放的 20–30%（very likely）；Gruber et al. 2023：1960s 初至 2010s 末为 25±2%；Jiang et al. 2023：20–30%。三个独立来源给出同一量级。" />
</Positioned>
<Positioned left="76" top="496" width="1148" height="116">
<Container color="#0A1A28B4" borderRadius="14.0" border="1 SOLID #1D3A50FF" width="1148" height="116" />
</Positioned>
<Positioned left="76" top="496" width="4" height="116">
<Container color="#9BE8A0FF" width="4" height="116" />
</Positioned>
<Positioned left="98" top="512">
<Text color="#6E8AA0FF" fontSize="13.0" fontFamily="DejaVu Sans Mono" text="02" />
</Positioned>
<Positioned left="138" top="510" width="958">
<Text color="#F1F7FBFF" fontSize="17.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="表层 pH 自工业革命以来下降约 0.1 个单位" />
</Positioned>
<Positioned left="1100" top="508" width="104" height="26">
<Container color="#9BE8A026" borderRadius="13.0" border="1 SOLID #9BE8A077" width="104" height="26" />
</Positioned>
<Positioned left="1100" top="513" width="104">
<Text color="#9BE8A0FF" fontSize="13.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" textAlign="CENTER" text="已证实" />
</Positioned>
<Positioned left="138" top="540" width="1066" height="22.6">
<Text color="#A8C2D4FF" fontSize="12.0" fontFamily="Inter,Noto Sans CJK SC" letterSpacing="0.1" text="NOAA 教育页与 NOAA OA Program 均如此表述。Jiang et al. 2023 给出的全球面积平均口径是 1750 年 8.19 → 2010 年 8.07，即 0.12。" />
</Positioned>
<Positioned left="76" top="624" width="1148" height="116">
<Container color="#0A1A28B4" borderRadius="14.0" border="1 SOLID #1D3A50FF" width="1148" height="116" />
</Positioned>
<Positioned left="76" top="624" width="4" height="116">
<Container color="#5EE0D0FF" width="4" height="116" />
</Positioned>
<Positioned left="98" top="640">
<Text color="#6E8AA0FF" fontSize="13.0" fontFamily="DejaVu Sans Mono" text="03" />
</Positioned>
<Positioned left="138" top="638" width="958">
<Text color="#F1F7FBFF" fontSize="17.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="这等于酸度增加约 30%" />
</Positioned>
<Positioned left="1100" top="636" width="104" height="26">
<Container color="#5EE0D026" borderRadius="13.0" border="1 SOLID #5EE0D077" width="104" height="26" />
</Positioned>
<Positioned left="1100" top="641" width="104">
<Text color="#5EE0D0FF" fontSize="13.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" textAlign="CENTER" text="来源结论" />
</Positioned>
<Positioned left="138" top="668" width="1066" height="22.6">
<Text color="#A8C2D4FF" fontSize="12.0" fontFamily="Inter,Noto Sans CJK SC" letterSpacing="0.1" text="换算依赖 ΔpH 取 0.10（→+25.9%）还是 0.12（→+31.8%）。NOAA 两个页面分别写了「约 30%」和「约 26%」。两种取整都对，不能只引用其中一个当成精确值。" />
</Positioned>
<Positioned left="76" top="752" width="1148" height="116">
<Container color="#0A1A28B4" borderRadius="14.0" border="1 SOLID #1D3A50FF" width="1148" height="116" />
</Positioned>
<Positioned left="76" top="752" width="4" height="116">
<Container color="#FFC15EFF" width="4" height="116" />
</Positioned>
<Positioned left="98" top="768">
<Text color="#6E8AA0FF" fontSize="13.0" fontFamily="DejaVu Sans Mono" text="04" />
</Positioned>
<Positioned left="138" top="766" width="958">
<Text color="#F1F7FBFF" fontSize="17.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="海洋正在变成酸性" />
</Positioned>
<Positioned left="1100" top="764" width="104" height="26">
<Container color="#FFC15E26" borderRadius="13.0" border="1 SOLID #FFC15E77" width="104" height="26" />
</Positioned>
<Positioned left="1100" top="769" width="104">
<Text color="#FFC15EFF" fontSize="13.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" textAlign="CENTER" text="需限定" />
</Positioned>
<Positioned left="138" top="796" width="1066" height="22.6">
<Text color="#A8C2D4FF" fontSize="12.0" fontFamily="Inter,Noto Sans CJK SC" letterSpacing="0.1" text="NOAA 教育页明确：海洋平均 pH 仍约 8.1，高于中性的 7。NOAA OA Program 的原话是「海洋本身不是酸的，吸收 CO2 增加了它的酸度」。说「酸化」是对自身历史状态的相对描述。" />
</Positioned>
<Positioned left="76" top="880" width="1148" height="116">
<Container color="#0A1A28B4" borderRadius="14.0" border="1 SOLID #1D3A50FF" width="1148" height="116" />
</Positioned>
<Positioned left="76" top="880" width="4" height="116">
<Container color="#FF7A6BFF" width="4" height="116" />
</Positioned>
<Positioned left="98" top="896">
<Text color="#6E8AA0FF" fontSize="13.0" fontFamily="DejaVu Sans Mono" text="05" />
</Positioned>
<Positioned left="138" top="894" width="958">
<Text color="#F1F7FBFF" fontSize="17.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="珊瑚礁会被酸化溶掉" />
</Positioned>
<Positioned left="1100" top="892" width="104" height="26">
<Container color="#FF7A6B26" borderRadius="13.0" border="1 SOLID #FF7A6B77" width="104" height="26" />
</Positioned>
<Positioned left="1100" top="897" width="104">
<Text color="#FF7A6BFF" fontSize="13.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" textAlign="CENTER" text="目前不足" />
</Positioned>
<Positioned left="138" top="924" width="1066" height="22.6">
<Text color="#A8C2D4FF" fontSize="12.0" fontFamily="Inter,Noto Sans CJK SC" letterSpacing="0.1" text="SROCC：全球升温 1.5 °C 时珊瑚礁就面临 very high risk，且即使升温低于 2 °C，几乎所有珊瑚礁都会从现状退化——但驱动是热，不是酸化。把它简化成「酸把珊瑚溶掉」会指错方向。" />
</Positioned>
<Positioned left="76" top="1008" width="1148" height="116">
<Container color="#0A1A28B4" borderRadius="14.0" border="1 SOLID #1D3A50FF" width="1148" height="116" />
</Positioned>
<Positioned left="76" top="1008" width="4" height="116">
<Container color="#9BE8A0FF" width="4" height="116" />
</Positioned>
<Positioned left="98" top="1024">
<Text color="#6E8AA0FF" fontSize="13.0" fontFamily="DejaVu Sans Mono" text="06" />
</Positioned>
<Positioned left="138" top="1022" width="958">
<Text color="#F1F7FBFF" fontSize="17.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="翼足类在 Ωarag 1.5 就开始溶壳" />
</Positioned>
<Positioned left="1100" top="1020" width="104" height="26">
<Container color="#9BE8A026" borderRadius="13.0" border="1 SOLID #9BE8A077" width="104" height="26" />
</Positioned>
<Positioned left="1100" top="1025" width="104">
<Text color="#9BE8A0FF" fontSize="13.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" textAlign="CENTER" text="已证实" />
</Positioned>
<Positioned left="138" top="1052" width="1066" height="22.6">
<Text color="#A8C2D4FF" fontSize="12.0" fontFamily="Inter,Noto Sans CJK SC" letterSpacing="0.1" text="Bednaršek et al. 2019 的专家共识：轻度溶壳阈值 Ω=1.50（暴露 5 天），重度溶壳 Ω=1.20（14 天），致死 Ω=0.95（14 天），置信度 99%。括号里的暴露时长不能省略。" />
</Positioned>
<Positioned left="76" top="1136" width="1148" height="116">
<Container color="#0A1A28B4" borderRadius="14.0" border="1 SOLID #1D3A50FF" width="1148" height="116" />
</Positioned>
<Positioned left="76" top="1136" width="4" height="116">
<Container color="#FF7A6BFF" width="4" height="116" />
</Positioned>
<Positioned left="98" top="1152">
<Text color="#6E8AA0FF" fontSize="13.0" fontFamily="DejaVu Sans Mono" text="07" />
</Positioned>
<Positioned left="138" top="1150" width="958">
<Text color="#F1F7FBFF" fontSize="17.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC">
<![CDATA[2100 年前整个大洋都会变成 Ωarag < 1]]>
</Text>
</Positioned>
<Positioned left="1100" top="1148" width="104" height="26">
<Container color="#FF7A6B26" borderRadius="13.0" border="1 SOLID #FF7A6B77" width="104" height="26" />
</Positioned>
<Positioned left="1100" top="1153" width="104">
<Text color="#FF7A6BFF" fontSize="13.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" textAlign="CENTER" text="目前不足" />
</Positioned>
<Positioned left="138" top="1180" width="1066" height="22.6">
<Text color="#A8C2D4FF" fontSize="12.0" fontFamily="Inter,Noto Sans CJK SC" letterSpacing="0.1" text="SROCC 只在 RCP8.5 下判断北冰洋、南大洋、北太平洋与西北大西洋会变得「腐蚀性」，并指出这一后果在 RCP2.6 下 virtually certain 可避免。这是一条情景依赖的判断，不是无条件预测。" />
</Positioned>
<Positioned left="76" top="1264" width="1148" height="116">
<Container color="#0A1A28B4" borderRadius="14.0" border="1 SOLID #1D3A50FF" width="1148" height="116" />
</Positioned>
<Positioned left="76" top="1264" width="4" height="116">
<Container color="#FFC15EFF" width="4" height="116" />
</Positioned>
<Positioned left="98" top="1280">
<Text color="#6E8AA0FF" fontSize="13.0" fontFamily="DejaVu Sans Mono" text="08" />
</Positioned>
<Positioned left="138" top="1278" width="958">
<Text color="#F1F7FBFF" fontSize="17.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="酸化和增温的效应可以分开评估" />
</Positioned>
<Positioned left="1100" top="1276" width="104" height="26">
<Container color="#FFC15E26" borderRadius="13.0" border="1 SOLID #FFC15E77" width="104" height="26" />
</Positioned>
<Positioned left="1100" top="1281" width="104">
<Text color="#FFC15EFF" fontSize="13.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" textAlign="CENTER" text="需限定" />
</Positioned>
<Positioned left="138" top="1308" width="1066" height="22.6">
<Text color="#A8C2D4FF" fontSize="12.0" fontFamily="Inter,Noto Sans CJK SC" letterSpacing="0.1" text="Bednaršek et al. 2019 与 Kroeker et al. 2013 都发现叠加暴露会放大敏感度（翼足类溶壳与存活）。分开评估只在归因分析里有意义，不等于分开决策。" />
</Positioned>
<Positioned left="76" top="1392" width="1148" height="116">
<Container color="#0A1A28B4" borderRadius="14.0" border="1 SOLID #1D3A50FF" width="1148" height="116" />
</Positioned>
<Positioned left="76" top="1392" width="4" height="116">
<Container color="#FFC15EFF" width="4" height="116" />
</Positioned>
<Positioned left="98" top="1408">
<Text color="#6E8AA0FF" fontSize="13.0" fontFamily="DejaVu Sans Mono" text="09" />
</Positioned>
<Positioned left="138" top="1406" width="958">
<Text color="#F1F7FBFF" fontSize="17.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="观测已经证明海洋在酸化" />
