<Snapshot type="png" background="#F3F4F6FF">
<Container width="1480" height="510">
<Container width="1480" height="510">
<Stack fit="EXPAND">
<Positioned left="40" top="30" width="1400" height="24">
<Text text="同一张 Stack 里，fit=EXPAND（上面那张）会给非 Positioned 子节点紧约束 → 它的 width/height 被忽略，整块被拉成满屏。fit=LOOSE（下面这张）才按自身尺寸画。" color="#111827FF" fontSize="14" fontFamily="Inter,Noto Sans CJK SC" />
</Positioned>
<Positioned left="60" top="90" width="460" height="110">
<Stack fit="EXPAND" alignment="TOP_LEFT" clipBehavior="HARD_EDGE">
<Container width="460" height="110" color="#FFFFFF00" border="2 SOLID #9CA3AFFF" alignment="BOTTOM_RIGHT">
<Text text="Stack 460x110" color="#6B7280FF" fontSize="12" fontFamily="DejaVu Sans Mono" />
</Container>
<Container width="300" height="110" color="#DC2626FF" />
</Stack>
</Positioned>
<Positioned left="560" top="130" width="200" height="30">
<Text text="EXPAND" color="#111827FF" fontSize="18" fontFamily="DejaVu Sans Mono" />
</Positioned>
<Positioned left="790" top="130" width="660" height="30">
<Text text="fit=EXPAND → 红色非定位 Container(300x110) 实际尺寸见红色块" color="#111827FF" fontSize="13" fontFamily="DejaVu Sans Mono" />
</Positioned>
<Positioned left="60" top="220" width="460" height="110">
<Stack fit="LOOSE" alignment="TOP_LEFT" clipBehavior="HARD_EDGE">
<Container width="460" height="110" color="#FFFFFF00" border="2 SOLID #9CA3AFFF" alignment="BOTTOM_RIGHT">
<Text text="Stack 460x110" color="#6B7280FF" fontSize="12" fontFamily="DejaVu Sans Mono" />
</Container>
<Container width="300" height="110" color="#DC2626FF" />
</Stack>
</Positioned>
<Positioned left="560" top="260" width="200" height="30">
<Text text="LOOSE" color="#111827FF" fontSize="18" fontFamily="DejaVu Sans Mono" />
</Positioned>
<Positioned left="790" top="260" width="660" height="30">
<Text text="fit=LOOSE → 红色非定位 Container(300x110) 实际尺寸见红色块" color="#111827FF" fontSize="13" fontFamily="DejaVu Sans Mono" />
</Positioned>
<Positioned left="60" top="350" width="460" height="110">
<Stack fit="PASSTHROUGH" alignment="TOP_LEFT" clipBehavior="HARD_EDGE">
<Container width="460" height="110" color="#FFFFFF00" border="2 SOLID #9CA3AFFF" alignment="BOTTOM_RIGHT">
<Text text="Stack 460x110" color="#6B7280FF" fontSize="12" fontFamily="DejaVu Sans Mono" />
</Container>
<Container width="300" height="110" color="#DC2626FF" />
</Stack>
</Positioned>
<Positioned left="560" top="390" width="200" height="30">
<Text text="PASSTHROUGH" color="#111827FF" fontSize="18" fontFamily="DejaVu Sans Mono" />
</Positioned>
<Positioned left="790" top="390" width="660" height="30">
<Text text="fit=PASSTHROUGH → 红色非定位 Container(300x110) 实际尺寸见红色块" color="#111827FF" fontSize="13" fontFamily="DejaVu Sans Mono" />
</Positioned>
<Positioned left="60" top="470" width="1380" height="22">
<Text text="结论：Stack 自己也遵守「矩形要包在Positioned 里」这条约定 —— fit=EXPAND 会给非定位子节点紧约束，它的 width/height 被忽略并拉满 Stack。" color="#B91C1CFF" fontSize="14" fontFamily="Inter,Noto Sans CJK SC" />
</Positioned>
</Stack>
</Container>
</Container>
</Snapshot>
