<Positioned left="172" top="1052" width="464">
<Text color="#0F172AFF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="矩阵读法" />
</Positioned>
<Positioned left="172" top="1080" width="464" height="24">
<Text color="#334155FF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="右下两行 = 列主序 2D 仿射 M（a b e / c d f）" />
</Positioned>
<Positioned left="172" top="1104" width="464" height="24">
<Text color="#334155FF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="x' = a·x + c·y + e ； y' = b·x + d·y + f" />
</Positioned>
<Positioned left="172" top="1128" width="464" height="24">
<Text color="#334155FF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="顺时针：a=cos t, b=sin t, c=−sin t, d=cos t" />
</Positioned>
<Positioned left="656" top="1052" width="364">
<Text color="#0F172AFF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="组合规则" />
</Positioned>
<Positioned left="656" top="1080" width="364" height="24">
<Text color="#334155FF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="按 transforms.json 顺序作用" />
</Positioned>
<Positioned left="656" top="1104" width="364" height="24">
<Text color="#334155FF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="每步围绕局部 pivot (60,60)" />
</Positioned>
<Positioned left="656" top="1128" width="364" height="24">
<Text color="#334155FF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="mirror_h 左右；mirror_v 上下" />
</Positioned>
<Positioned left="1040" top="1052" width="388">
<Text color="#0F172AFF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="T07 与 T08 的顺序差异" />
</Positioned>
<Positioned left="1040" top="1080" width="388" height="24">
<Text color="#334155FF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="T07 mirH → rot90°：(u,v)→(−v,−u)" />
</Positioned>
<Positioned left="1040" top="1104" width="388" height="24">
<Text color="#334155FF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="T08 rot90 → mirH：(u,v)→(v,u)" />
</Positioned>
<Positioned left="1040" top="1128" width="388" height="24">
<Text color="#334155FF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="两者皆反射，镜像轴不同（紫色虚线）" />
</Positioned>
<Positioned left="152" top="1166" width="1296" height="26">
<Text color="#64748BFF" fontSize="20.0" fontFamily="Inter,Noto Sans CJK SC" text="核对：geometry-audit.json 记录每格列主序 4×4 矩阵、每矩形四角、圆点中心与最终外接框；像素核对容差 ±1.5 px（反走样边缘像素例外）。" />
</Positioned>
