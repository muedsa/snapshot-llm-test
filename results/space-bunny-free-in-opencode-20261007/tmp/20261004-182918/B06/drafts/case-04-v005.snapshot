<Text color="#FFFFFF" fontSize="14.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="你看到的现象" />
</Positioned>
<Positioned left="600" top="1178" width="100.0" height="19.88">
<Text color="#FFFFFF" fontSize="14.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="它实际意味着" />
</Positioned>
<Positioned left="960" top="1178" width="72.0" height="19.88">
<Text color="#FFFFFF" fontSize="14.0" fontFamily="Inter Semi Bold,Noto Sans CJK SC" text="该做什么" />
</Positioned>
<Positioned left="56" top="1206" width="1288" height="32">
<Container color="#F1F5F9FF" borderRadius="8.0" width="1288" height="32" />
</Positioned>
<Positioned left="70" top="1214" width="500" height="19.88">
<Text color="#475569FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="参考值上限 15.0、你的结果 15.1" />
</Positioned>
<Positioned left="600" top="1214" width="350" height="19.88">
<Text color="#475569FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="这 0.1 的差值很可能没有什么意义" />
</Positioned>
<Positioned left="960" top="1214" width="370" height="19.88">
<Text color="#475569FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="结合年龄性别与前期准备情况判断，必要时复查" />
</Positioned>
<Positioned left="56" top="1242" width="1288" height="32">
<Container color="#BE123C1A" borderRadius="8.0" width="1288" height="32" />
</Positioned>
<Positioned left="70" top="1250" width="500" height="19.88">
<Text color="#0B1220FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="首次异常，或结果落在临界值附近" />
</Positioned>
<Positioned left="600" top="1250" width="350" height="19.88">
<Text color="#475569FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="单次轻微波动很常见，趋势比单次数值更重要" />
</Positioned>
<Positioned left="960" top="1250" width="370" height="19.88">
<Text color="#0B1220FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="1–3 个月后复查，尽量在同一机构、同一方法下" />
</Positioned>
<Positioned left="56" top="1278" width="1288" height="32">
<Container color="#F1F5F9FF" borderRadius="8.0" width="1288" height="32" />
</Positioned>
<Positioned left="70" top="1286" width="500" height="19.88">
<Text color="#475569FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="同一项目，不同机构的参考区间不一样" />
</Positioned>
<Positioned left="600" top="1286" width="350" height="19.88">
<Text color="#475569FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="方法 / 仪器 / 试剂不同，参考值就不同" />
</Positioned>
<Positioned left="960" top="1286" width="370" height="19.88">
<Text color="#475569FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="换院前先确认那张单子用的是哪一套参考区间" />
</Positioned>
<Positioned left="56" top="1314" width="1288" height="32">
<Container color="#BE123C24" borderRadius="8.0" width="1288" height="32" />
</Positioned>
<Positioned left="70" top="1322" width="500" height="19.88">
<Text color="#BE123CFF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="明显偏离 / 严重偏离 / 出现危急值" />
</Positioned>
<Positioned left="600" top="1322" width="350" height="19.88">
<Text color="#475569FF" fontSize="14.0" fontFamily="Inter,Noto Sans CJK SC" text="已经不是观察的问题" />
</Positioned>
<Positioned left="960" top="1322" width="370" height="19.88">
