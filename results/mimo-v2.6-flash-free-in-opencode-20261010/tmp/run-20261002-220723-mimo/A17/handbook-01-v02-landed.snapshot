<Snapshot type="png">
  <Container width="1200" height="1600" color="#F1F5F9">
    <Stack>
      <Positioned left="48" top="48"><Container color="#1D4ED8" borderRadius="8" padding="(6,14)"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#FFFFFF">P1 · 调用契约</Text></Container></Positioned>
      <Positioned left="48" top="103"><Text fontSize="40" fontFamily="Noto Sans CJK SC" color="#0F172A">一次快照调用的完整形状</Text></Positioned>
      <Positioned left="48" top="169"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">先记住请求与响应长什么样，再学标签与属性</Text></Positioned>
      <Positioned left="48" top="218"><Container width="1104" height="346" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="242"><ClipRect>
    <Container width="400" height="240" color="#0F172A">
      <Column>
        <Container width="400" height="56" color="#1D4ED8" padding="(14,24)">
          <Text fontSize="26" color="#FFFFFF">POST /snapshot</Text>
        </Container>
        <Container width="400" height="184" padding="(12,24)">
          <Column crossAxisAlignment="START">
            <Text fontSize="20" color="#4ADE80">HTTP/1.1 200 OK  image/png</Text>
            <Text fontSize="20" color="#94A3B8">请求体 = UTF-8 纯文本 DSL</Text>
            <Text fontSize="20" color="#94A3B8">X-Request-Id 两边都有</Text>
            <Text fontSize="20" color="#94A3B8">429 / 503 看 Retry-After</Text>
            <Text fontSize="20" color="#FDE68A">error = {code, message, requestId}</Text>
          </Column>
        </Container>
      </Column>
    </Container>
      </ClipRect></Positioned>
      <Positioned left="496" top="242"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">这一步要弄清什么</Text></Positioned>
      <Positioned left="496" top="300"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 请求体是 UTF-8 纯文本，不是 JSON</Text></Positioned>
      <Positioned left="496" top="340"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• Content-Type: text/plain; charset=utf-8</Text></Positioned>
      <Positioned left="496" top="380"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 成功返回 PNG 字节，失败返回 JSON 错误体</Text></Positioned>
      <Positioned left="496" top="420"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• X-Request-Id 两边都要留，方便对账</Text></Positioned>
      <Positioned left="496" top="460"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 429 / 503 先读 Retry-After 再重试</Text></Positioned>
      <Positioned left="72" top="505"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#64748B">图 1 · example-01.snapshot 的真实渲染（400×240，未做后期处理）</Text></Positioned>
      <Positioned left="48" top="578"><Container width="1104" height="656" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="602"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">可复制的完整文件：打印 16 行原文 + 1 行省略标注</Text></Positioned>
      <Positioned left="72" top="646"><Container width="1056" height="564" color="#0F172A" borderRadius="8"/></Positioned>
      <Positioned left="88" top="656"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[<Snapshot type="png">]]></Raw></Text></Positioned>
      <Positioned left="88" top="688"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[  <Container width="400" height="240" color="#0F172A">]]></Raw></Text></Positioned>
      <Positioned left="88" top="720"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[    <Column>]]></Raw></Text></Positioned>
      <Positioned left="88" top="752"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      <Container width="400" height="56" color="#1D4ED8" padding="(14,24)">]]></Raw></Text></Positioned>
      <Positioned left="88" top="784"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[        <Text fontSize="26" color="#FFFFFF">POST /snapshot</Text>]]></Raw></Text></Positioned>
      <Positioned left="88" top="816"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      </Container>]]></Raw></Text></Positioned>
      <Positioned left="88" top="848"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      <Container width="400" height="184" padding="(12,24)">]]></Raw></Text></Positioned>
      <Positioned left="88" top="880"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[        <Column crossAxisAlignment="START">]]></Raw></Text></Positioned>
      <Positioned left="88" top="912"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[          <Text fontSize="20" color="#4ADE80">HTTP/1.1 200 OK  image/png</Text>]]></Raw></Text></Positioned>
      <Positioned left="88" top="944"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[          <Text fontSize="20" color="#94A3B8">请求体 = UTF-8 纯文本 DSL</Text>]]></Raw></Text></Positioned>
      <Positioned left="88" top="976"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#F59E0B"><Raw><![CDATA[<!--省略 example-01.snapshot 第 11、12 行（两条响应提示文本）；完整文件共 18 行 -->]]></Raw></Text></Positioned>
      <Positioned left="88" top="1008"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[          <Text fontSize="20" color="#FDE68A">error = {code, message, requestId}</Text>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1040"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[        </Column>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1072"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[      </Container>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1104"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[    </Column>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1136"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[  </Container>]]></Raw></Text></Positioned>
      <Positioned left="88" top="1168"><Text fontSize="22" fontFamily="Noto Sans Mono CJK SC" color="#E2E8F0"><Raw><![CDATA[</Snapshot>]]></Raw></Text></Positioned>
      <Positioned left="48" top="1248"><Container width="1104" height="254" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="1272"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">这一步的踩坑</Text></Positioned>
      <Positioned left="72" top="1326"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 错误体是 JSON，别当纯文本读</Text></Positioned>
      <Positioned left="72" top="1365"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• code / message / requestId 三个字段都要取</Text></Positioned>
      <Positioned left="72" top="1404"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 400 是解析失败，422 是参数或状态不合法</Text></Positioned>
      <Positioned left="72" top="1443"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 省略标注是注释，删掉后示例照样能解析</Text></Positioned>
      <Positioned left="48" top="1516"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#64748B">A17 文档手册 · 第 1 / 4 页 · 调用契约</Text></Positioned>
      <Positioned left="528" top="1516"><Container width="624" height="35" alignment="CENTER_RIGHT"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#64748B">来源：open-snapshot AI Guide、Snapshot DSL 文档</Text></Container></Positioned>
    </Stack>
  </Container>
</Snapshot>
