<Snapshot type="png">
  <Container width="1200" height="1600" color="#F1F5F9">
    <Stack>
      <Positioned left="48" top="48"><Container color="#1D4ED8" borderRadius="8" padding="(6,14)"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#FFFFFF">P2 · 尺寸与定位</Text></Container></Positioned>
      <Positioned left="48" top="103"><Text fontSize="40" fontFamily="Noto Sans CJK SC" color="#0F172A">根尺寸与有界布局</Text></Positioned>
      <Positioned left="48" top="169"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">从根尺寸出发，约束只能逐层收窄不能凭空放大</Text></Positioned>
      <Positioned left="48" top="218"><Container width="1104" height="346" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="242"><ClipRect>
    <Container width="400" height="240" color="#0F172A" padding="24">
      <Column>
        <Container width="352" height="56"><Row>
          <Expanded><Container height="56" color="#245CE4"/></Expanded>
          <Container width="88" height="56" color="#E88E35"/>
        </Row></Container>
        <Container width="352" height="120" color="#E2E8F0">
          <Stack>
            <Positioned left="16" top="16" width="120" height="56"><Container color="lime"/>
            </Positioned>
            <Positioned right="16" bottom="14"><Text fontSize="20">right + bottom</Text>
            </Positioned>
          </Stack>
        </Container>
      </Column>
    </Container>
      </ClipRect></Positioned>
      <Positioned left="496" top="242"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">这一步要弄清什么</Text></Positioned>
      <Positioned left="496" top="300"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 根尺寸由 Snapshot 的 width / height 决定</Text></Positioned>
      <Positioned left="496" top="340"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 约束从外向内收紧，子节点不能凭空放大</Text></Positioned>
      <Positioned left="496" top="380"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• Expanded 只能是 Row / Column 的直接子级</Text></Positioned>
      <Positioned left="496" top="420"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• 有界主轴才能用 Expanded 拆分剩余空间</Text></Positioned>
      <Positioned left="496" top="460"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#334155">• Stack 不提供尺寸，靠 Positioned 摆位置</Text></Positioned>
      <Positioned left="72" top="505"><Text fontSize="24" fontFamily="Noto Sans CJK SC" color="#64748B">图 2 · example-02.snapshot 的真实渲染（400×240，未做后期处理）</Text></Positioned>
      <Positioned left="48" top="578"><Container width="1104" height="656" color="#FFFFFF" border="1 SOLID #E2E8F0" borderRadius="12"/></Positioned>
      <Positioned left="72" top="602"><Text fontSize="26" fontFamily="Noto Sans CJK SC" color="#0F172A">可复制的完整文件：打印 16 行原文 + 1 行省略标注</Text></Positioned>
      <Positioned left="72" top="646"><Container width="1056" height="564" color="#0F172A" borderRadius="8"/></Positioned>
