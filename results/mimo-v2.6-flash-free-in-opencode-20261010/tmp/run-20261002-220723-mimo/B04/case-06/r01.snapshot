extAlign="CENTER" maxLines="1">8</Text></Positioned><Positioned left="922" top="694" width="4" height="46"><Container width="4" height="46" color="#FFB100"/></Positioned><Positioned left="918" top="684" width="12" height="12"><Container width="12" height="12" color="#FFB100"/></Positioned><Positioned left="894" top="758" width="60" height="24"><Text fontSize="16" fontFamily="Noto Sans Mono CJK SC" color="#8B97A4" textAlign="CENTER" maxLines="1">9</Text></Positioned><Positioned left="1018" top="694" width="4" height="46"><Container width="4" height="46" color="#FFB100"/></Positioned><Positioned left="1008" top="684" width="12" height="12"><Container width="12" height="12" color="#FFB100"/></Positioned><Positioned left="990" top="758" width="60" height="24"><Text fontSize="16" fontFamily="Noto Sans Mono CJK SC" color="#8B97A4" textAlign="CENTER" maxLines="1">10</Text></Positioned><Positioned left="60" top="792" width="960" height="30"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">灰色刻度是 0.1 秒，琥珀色才是允许的落点。</Text></Positioned><Positioned left="60" top="836" width="960" height="1"><Container width="960" height="1" color="#27323E"/></Positioned><Positioned left="60" top="852" width="400" height="34"><Text fontSize="20" fontFamily="Noto Sans Mono CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">编辑按 · 量级估算</Text></Positioned><Positioned left="60" top="890" width="960" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">0.2 毫秒 / 天 × 4 500 天 ≈ 0.9 秒：若地球匀速变慢，约 12 年触及阈值。</Text></Positioned><Positioned left="60" top="920" width="960" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">但 UT1−UTC 的漂移并不匀速，真正的节奏由不规则波动决定。</Text></Positioned><Positioned left="60" top="950" width="960" height="29.4"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">上式是本编辑的算术演示，不是任何来源的结论。</Text></Positioned><Positioned left="60" top="990" width="960" height="1"><Container width="960" height="1" color="#27323E"/></Positioned><Positioned left="60" top="1002" width="960" height="30"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">来源：IERS 常用常数（0.2 ms/天）· IERS 闰秒页（0.9 秒阈值）· BIPM CGPM 决议 4（整数秒）</Text></Positioned></Stack></Container></Snapshot>
