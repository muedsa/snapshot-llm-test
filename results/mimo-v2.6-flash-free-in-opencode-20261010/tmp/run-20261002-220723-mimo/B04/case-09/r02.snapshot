<Snapshot type="png" background="#0B1015"><Container width="800" height="2000" color="#0B1015"><Stack clipBehavior="NONE"><Positioned left="64" top="64" width="260" height="32.4"><Text fontSize="18" fontFamily="Noto Sans Mono CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">LEAP SECOND  —  09 / 10</Text></Positioned><Positioned left="216" top="64" width="520" height="32.4"><Text fontSize="18" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="RIGHT" maxLines="1">决策 / DECISION</Text></Positioned><Positioned left="64" top="100" width="672" height="2"><Container width="672" height="2" color="#27323E"/></Positioned><Positioned left="64" top="134" width="672" height="64"><Text fontSize="46" fontFamily="Noto Serif CJK SC" color="#FFFFFF" textAlign="LEFT" maxLines="1">决定：从 0.9 秒到 2035</Text></Positioned><Positioned left="64" top="206" width="672" height="34"><Text fontSize="20" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">谁在决定，以及 2035 年到底会发生什么。</Text></Positioned><Positioned left="110" top="290" width="3" height="1320"><Container width="3" height="1320" color="#3A4855"/></Positioned><Positioned left="102" top="282" width="19" height="19"><Container width="19" height="19" shape="CIRCLE" color="#49C9DC" border="3 SOLID #0B1015"/></Positioned><Positioned left="140" top="280" width="130" height="34"><Text fontSize="24" fontFamily="Noto Sans Mono CJK SC" color="#49C9DC" textAlign="LEFT" maxLines="1">1972</Text></Positioned><Positioned left="140" top="320" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">UTC 改用原子时标：TAI−UTC = 10 s，</Text></Positioned><Positioned left="140" top="348" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">并规定 |UT1 − UTC| 必须小于 0.9 秒。</Text></Positioned><Positioned left="102" top="447" width="19" height="19"><Container width="19" height="19" shape="CIRCLE" color="#49C9DC" border="3 SOLID #0B1015"/></Positioned><Positioned left="140" top="445" width="130" height="34"><Text fontSize="24" fontFamily="Noto Sans Mono CJK SC" color="#49C9DC" textAlign="LEFT" maxLines="1">2012</Text></Positioned><Positioned left="140" top="485" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">6 月 30 日插入闰秒，TAI−UTC 变为 35 s。</Text></Positioned><Positioned left="140" top="513" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">这是 1972 年以来的第 25 次。</Text></Positioned><Positioned left="102" top="612" width="19" height="19"><Container width="19" height="19" shape="CIRCLE" color="#49C9DC" border="3 SOLID #0B1015"/></Positioned><Positioned left="140" top="610" width="130" height="34"><Text fontSize="24" fontFamily="Noto Sans Mono CJK SC" color="#49C9DC" textAlign="LEFT" maxLines="1">2016</Text></Positioned><Positioned left="140" top="650" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">12 月 31 日第 27 次，也是至今最后一次。</Text></Positioned><Positioned left="140" top="678" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">TAI−UTC 由 36 秒变为 37 秒。</Text></Positioned><Positioned left="102" top="777" width="19" height="19"><Container width="19" height="19" shape="CIRCLE" color="#49C9DC" border="3 SOLID #0B1015"/></Positioned><Positioned left="140" top="775" width="130" height="34"><Text fontSize="24" fontFamily="Noto Sans Mono CJK SC" color="#49C9DC" textAlign="LEFT" maxLines="1">2017</Text></Positioned><Positioned left="140" top="815" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">1 月 1 日起 UTC−TAI = −37 s，至今未变。</Text></Positioned><Positioned left="140" top="843" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">至此共加过 27 秒，此后一直空窗。</Text></Positioned><Positioned left="102" top="942" width="19" height="19"><Container width="19" height="19" shape="CIRCLE" color="#FFB100" border="3 SOLID #0B1015"/></Positioned><Positioned left="140" top="940" width="130" height="34"><Text fontSize="24" fontFamily="Noto Sans Mono CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">2018</Text></Positioned><Positioned left="140" top="980" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">第 26 届 CGPM：UTC 是唯一推荐的国际参考时标。</Text></Positioned><Positioned left="140" top="1008" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">民用时间与国际参考均以它为准。</Text></Positioned><Positioned left="102" top="1107" width="19" height="19"><Container width="19" height="19" shape="CIRCLE" color="#FFB100" border="3 SOLID #0B1015"/></Positioned><Positioned left="140" top="1105" width="130" height="34"><Text fontSize="24" fontFamily="Noto Sans Mono CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">2022</Text></Positioned><Positioned left="140" top="1145" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">第 27 届 CGPM 决议 4：|UT1−UTC| 上限将在 2035 年</Text></Positioned><Positioned left="140" top="1173" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">之前提高；并指出可能出现首次负闰秒。</Text></Positioned><Positioned left="102" top="1272" width="19" height="19"><Container width="19" height="19" shape="CIRCLE" color="#FFB100" border="3 SOLID #0B1015"/></Positioned><Positioned left="140" top="1270" width="130" height="34"><Text fontSize="24" fontFamily="Noto Sans Mono CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">2026</Text></Positioned><Positioned left="140" top="1310" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">第 28 届 CGPM：决议 4 要求提交实施计划。</Text></Positioned><Positioned left="140" top="1338" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">同届会议还要审定新的秒定义物种。</Text></Positioned><Positioned left="102" top="1437" width="19" height="19"><Container width="19" height="19" shape="CIRCLE" color="#FFB100" border="3 SOLID #0B1015"/></Positioned><Positioned left="140" top="1435" width="130" height="34"><Text fontSize="24" fontFamily="Noto Sans Mono CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">2030</Text></Positioned><Positioned left="140" top="1475" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">第 29 届 CGPM：通过新的秒定义（决议 5）。</Text></Positioned><Positioned left="140" top="1503" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">决议 5 把通过时间定在这一年。</Text></Positioned><Positioned left="102" top="1602" width="19" height="19"><Container width="19" height="19" shape="CIRCLE" color="#FF5C4D" border="3 SOLID #0B1015"/></Positioned><Positioned left="140" top="1600" width="130" height="34"><Text fontSize="24" fontFamily="Noto Sans Mono CJK SC" color="#FF5C4D" textAlign="LEFT" maxLines="1">2035</Text></Positioned><Positioned left="140" top="1640" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">闰秒机制的调整目标年份。</Text></Positioned><Positioned left="140" top="1668" width="596" height="27.44"><Text fontSize="19" fontFamily="Noto Sans CJK SC" color="#C9D6E3" textAlign="LEFT" maxLines="1">目标：提高 |UT1−UTC| 上限，改变 UTC 的调整方式。</Text></Positioned><Positioned left="64" top="1770" width="672" height="130"><Container width="672" height="130" color="#121A22" borderRadius="10" border="1 SOLID #FF5C4D"/></Positioned><Positioned left="88" top="1794" width="624" height="31.36"><Text fontSize="20" fontFamily="Noto Sans CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">决议 4 同时提醒：地球自转的近期观测显示，</Text></Positioned><Positioned left="88" top="1826" width="624" height="31.36"><Text fontSize="20" fontFamily="Noto Sans CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">可能出现有史以来第一次「负闰秒」——</Text></Positioned><Positioned left="88" top="1858" width="624" height="31.36"><Text fontSize="20" fontFamily="Noto Sans CJK SC" color="#FFB100" textAlign="LEFT" maxLines="1">它的插入从未被预见，也从未被测试过。</Text></Positioned><Positioned left="64" top="1910" width="672" height="1"><Container width="672" height="1" color="#27323E"/></Positioned><Positioned left="64" top="1918" width="672" height="23.52"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">来源：BIPM 第 27 届 CGPM 决议 4 / 5（2022）</Text></Positioned><Positioned left="64" top="1942" width="672" height="23.52"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">DOI 10.59161/CGPM2022RES4E · IERS 闰秒页 · Bulletin C 72</Text></Positioned><Positioned left="64" top="1966" width="672" height="23.52"><Text fontSize="17" fontFamily="Noto Sans CJK SC" color="#8B97A4" textAlign="LEFT" maxLines="1">· 抓取 2026-10-07 · 时间线由本编辑整理，节点均为来源原话</Text></Positioned></Stack></Container></Snapshot>
